2115234626, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "User abandons the payment page", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "User abandons the payment page", "autoResize": true, "lineHeight": 1.25}, {"id": "e744", "type": "text", "x": 509, "y": 12201.5, "width": 280.4, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 712314929, "version": 1, "versionNonce": 950122255, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Hold never consumed, rooms unsellable", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Hold never consumed, rooms unsellable", "autoResize": true, "lineHeight": 1.25}, {"id": "e745", "type": "text", "x": 1029, "y": 12201.5, "width": 849.2, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 363485116, "version": 1, "versionNonce": 233984750, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Expiry sweeper every 30 s: release held_rooms, mark hold EXPIRED. Redis TTL is the fast path, the DB sweep is the truth", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Expiry sweeper every 30 s: release held_rooms, mark hold EXPIRED. Redis TTL is the fast path, the DB sweep is the truth", "autoResize": true, "lineHeight": 1.25}, {"id": "e746", "type": "rectangle", "x": 60, "y": 12229.2, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 6164838, "version": 1, "versionNonce": 168023450, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e747", "type": "text", "x": 69, "y": 12238.2, "width": 302.1, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 600879731, "version": 1, "versionNonce": 173437158, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Booking created, payment never completes", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Booking created, payment never completes", "autoResize": true, "lineHeight": 1.25}, {"id": "e748", "type": "text", "x": 509, "y": 12238.2, "width": 349.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 754769341, "version": 1, "versionNonce": 902336460, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "PENDING_PAYMENT forever, inventory locked up", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "PENDING_PAYMENT forever, inventory locked up", "autoResize": true, "lineHeight": 1.25}, {"id": "e749", "type": "text", "x": 1029, "y": 12238.2, "width": 730.9, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 2051952478, "version": 1, "versionNonce": 1900893814, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Reconciliation worker queries the provider by booking reference, then confirms or cancels + compensates", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Reconciliation worker queries the provider by booking reference, then confirms or cancels + compensates", "autoResize": true, "lineHeight": 1.25}, {"id": "e750", "type": "rectangle", "x": 60, "y": 12266.0, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 265661507, "version": 1, "versionNonce": 1205015164, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e751", "type": "text", "x": 69, "y": 12275.0, "width": 302.1, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 2070756658, "version": 1, "versionNonce": 1629521257, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Payment succeeded, our webhook was lost", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Payment succeeded, our webhook was lost", "autoResize": true, "lineHeight": 1.25}, {"id": "e752", "type": "text", "x": 509, "y": 12275.0, "width": 283.0, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 445393340, "version": 1, "versionNonce": 816322296, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Charged customer, unconfirmed booking", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Charged customer, unconfirmed booking", "autoResize": true, "lineHeight": 1.25}, {"id": "e753", "type": "text", "x": 1029, "y": 12275.0, "width": 685.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 765855418, "version": 1, "versionNonce": 1650839581, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Same worker - poll; never trust webhooks as the only path. Always have a pull to match every push", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Same worker - poll; never trust webhooks as the only path. Always have a pull to match every push", "autoResize": true, "lineHeight": 1.25}, {"id": "e754", "type": "rectangle", "x": 60, "y": 12302.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1764315916, "version": 1, "versionNonce": 662926510, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e755", "type": "text", "x": 69,