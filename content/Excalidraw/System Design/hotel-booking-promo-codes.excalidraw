null, "locked": false, "text": "Steps 1, 2 and 4 are local and atomic. Only step 3 crosses a boundary, so only step 3 needs the saga machinery - a reconciliation worker that polls the provider for any booking stuck in PENDING_PAYMENT past its window and drives it to CONFIRMED or CANCELLED.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Steps 1, 2 and 4 are local and atomic. Only step 3 crosses a boundary, so only step 3 needs the saga machinery - a reconciliation worker that polls the provider for any booking stuck in PENDING_PAYMENT past its window and drives it to CONFIRMED or CANCELLED.", "autoResize": true, "lineHeight": 1.25}, {"id": "e738", "type": "rectangle", "x": 60, "y": 12159.0, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 2009790325, "version": 1, "versionNonce": 1126994210, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e739", "type": "text", "x": 69, "y": 12167.0, "width": 46.5, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1602685169, "version": 1, "versionNonce": 1004197350, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Failure", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Failure", "autoResize": true, "lineHeight": 1.25}, {"id": "e740", "type": "text", "x": 509, "y": 12167.0, "width": 63.5, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent