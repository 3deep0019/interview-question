se, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "11 45-minute script", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "11 45-minute script", "autoResize": true, "lineHeight": 1.25}, {"id": "e113", "type": "rectangle", "x": 0, "y": 330, "width": 2400, "height": 966.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#dbe4ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1107009420, "version": 1, "versionNonce": 2040590398, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e45", "type": "rectangle", "x": 60, "y": 370, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g17"], "frameId": null, "roundness": {"type": 3}, "seed": 524193278, "version": 1, "versionNonce": 175782304, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e46", "type": "text", "x": 74, "y": 377, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g17"], "frameId": null, "roundness": null, "seed": 1233565528, "version": 1, "versionNonce": 644780075, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "01", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "01", "autoResize": true, "lineHeight": 1.25}, {"id": "e47", "type": "text", "x": 144, "y": 372, "width": 300.7, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g17"], "frameId": null, "roundness": null, "seed": 1127850897, "version": 1, "versionNonce": 1063254276, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Frame the problem", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Frame the problem", "autoResize": true, "lineHeight": 1.25}, {"id": "e48", "type": "text", "x": 60, "y": 432, "width": 852.1, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1879343460, "version": 1, "versionNonce": 737608423, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "The one-line thesis to open with - it reframes the whole question and every later answer follows from it.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The one-line thesis to open with - it reframes the whole question and every later answer follows from it.", "autoResize": true, "lineHeight": 1.25}, {"id": "e49", "type": "rectangle", "x": 60, "y": 482.5, "width": 1120, "height": 111.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g18"], "frameId": null, "roundness": {"type": 3}, "seed": 1566471825, "version": 1, "versionNonce": 963864094, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e50", "type": "text", "x": 74, "y": 496.5, "width": 121.5, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g18"], "frameId": null, "roundness": null, "seed": 618341637, "version": 1, "versionNonce": 1307729535, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "OPEN WITH THIS", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "OPEN WITH THIS", "autoResize": true, "lineHeight": 1.25}, {"id": "e51", "type": "text", "x": 74, "y": 520.0, "width": 1056.9, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g18"], "frameId": null, "roundness": null, "seed": 2104909469, "version": 1, "versionNonce": 157197672, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"There are two independent scarce resources here - rooms on specific dates, and coupon redemptions - and a booking has to consume both\natomically or neither. So the core of this design isn't the schema, it's where I put the concurrency control. That pushes me straight to a relational\ndatabase, because it already does this correctly and I'd otherwise be rebuilding it badly.\"", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"There are two independent scarce resources here - rooms on specific dates, and coupon redemptions - and a booking has to consume both\natomically or neither. So the core of this design isn't the schema, it's where I put the concurrency control. That pushes me straight to a relational\ndatabase, because it already does this correctly and I'd otherwise be rebuilding it badly.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e52", "type": "rectangle", "x": 60, "y": 618.0, "width": 1120, "height": 216.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": {"type": 3}, "seed": 253544329, "version": 1, "versionNonce": 1099367391, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e53", "type": "text", "x": 74, "y": 632.0, "width": 220.5, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 897911925, "version": 1, "versionNonce": 354253419, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Clarifying questions to ask", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Clarifying questions to ask", "autoResize": true, "lineHeight": 1.25}, {"id": "e54", "type": "text", "x": 74, "y": 660.5, "width": 1062.9, "height": 160.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1625947776, "version": 1, "versionNonce": 734559256, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "- Is the room count real inventory or a channel allocation? Hotels sell the same rooms via Booking.com, Expedia and their own site - is our count\nauthoritative, or a slice we sync?\n- Can we oversell? Airlines deliberately do. Hotels usually do not. Decides whether the guard is a hard constraint or a soft one.\n- Pay now or pay at hotel? Decides whether payment is on the booking critical path at all.\n- Does a cancelled booking give the coupon back? A product decision that changes the uniqueness constraint - show both.\n- Multi-currency? A INR 500 coupon cannot apply to a USD booking. Does the promo carry a currency, or do we convert?\n- Can coupons stack? Assume no - but design the engine so stacking is a later change, not a rewrite.\n- Promo scope: global, or restricted to certain hotels / cities / room types / first-time users?", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "- Is the room count real inventory or a channel allocation? Hotels sell the same rooms via Booking.com, Expedia and their own site - is our count\nauthoritative, or a slice we sync?\n- Can we oversell? Airlines deliberately do. Hotels usually do not. Decides whether the guard is a hard constraint or a soft one.\n- Pay now or pay at hotel? Decides whether payment is on the booking critical path at all.\n- Does a cancelled booking give the coupon back? A product decision that changes the uniqueness constraint - show both.\n- Multi-currency? A INR 500 coupon cannot apply to a USD booking. Does the promo carry a currency, or do we convert?\n- Can coupons stack? Assume no - but design the engine so stacking is a later change, not a rewrite.\n- Promo scope: global, or restricted to certain hotels / cities / room types / first-time users?", "autoResize": true, "lineHeight": 1.25}, {"id": "e55", "type": "text", "x": 1220, "y": 480.5, "width": 144.4, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 326384299, "version": 1, "versionNonce": 2004182514, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Requirements", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Requirements", "autoResize": true, "lineHeight": 1.25}, {"id": "e56", "type": "rectangle", "x": 1220, "y": 518.5, "width": 1120, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g20"], "frameId": null, "roundness": null, "seed": 1050040258, "version": 1, "versionNonce": 905590325, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e57", "type": "text", "x": 1229, "y": 526.5, "width": 69.2, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g20"], "frameId": null, "roundness": null, "seed": 84196940, "version": 1, "versionNonce": 2065920251, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Functional", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Functional", "autoResize": true, "lineHeight": 1.25}, {"id": "e58", "type": "text", "x": 1789, "y": 526.5, "width": 95.9, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g20"], "frameId": null, "roundness": null, "seed": 1434982633, "version": 1, "versionNonce": 166688708, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Non-functional", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Non-functional", "autoResize": true, "lineHeight": 1.25}, {"id": "e59", "type": "rectangle", "x": 1220, "y": 552.0, "width": 1120, "height": 