{"id": "e486", "type": "text", "x": 100, "y": 7215.0, "width": 658.6, "height": 25.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 570281951, "version": 1, "versionNonce": 504198284, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "ANY GUARD FAILS  ->  ROLLBACK  ->  NOTHING WAS CONSUMED", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ANY GUARD FAILS  ->  ROLLBACK  ->  NOTHING WAS CONSUMED", "autoResize": true, "lineHeight": 1.25}, {"id": "e487", "type": "text", "x": 100, "y": 7251.0, "width": 1292.6, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1566235066, "version": 1, "versionNonce": 1624445551, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "no distributed lock  -  no SELECT-then-check  -  no application-level mutex.  The pattern is the same each time: attempt the write conditionally, then check whether it happened.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "no distributed lock  -  no SELECT-then-check  -  no application-level mutex.  The pattern is the same each time: attempt the write conditionally, then check whether it happened.", "autoResize": true, "lineHeight": 1.25}, {"id": "e488", "type": "text", "x": 60, "y": 7337.0, "width": 299.5, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 440701292, "version": 1, "versionNonce": 495502061, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Race 1 - two users, last room", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Race 1 - two users, last room", "autoResize": true, "lineHeight": 1.25}, {"id": "e489", "type": "rectangle", "x": 60, "y": 7377.0, "width": 733, "height": 281.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g75"], "frameId": null, "roundness": {"type": 3}, "seed": 1588769799, "version": 1, "versionNonce": 1395718935, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e490", "type": "text", "x": 74, "y": 7391.0, "width": 94.2, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g75"], "frameId": null, "roundness": null, "seed": 2095375165, "version": 1, "versionNonce": 988572755, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "inventory.sql", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "inventory.sql", "autoResize": true, "lineHeight": 1.25}, {"id": "e491", "type": "text", "x": 74, "y": 7417.0, "width": 438.8, "height": 227.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g75"], "frameId": null, "roundness": null, "seed": 1060746928, "version": 1, "versionNonce": 1815764541, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "-- take the hold across EVERY night in one statement\nUPDATE room_inventory\n   SET held_rooms = held_rooms + $rooms\n WHERE room_type_id = $room_type\n   AND stay_date >= $check_in\n   AND stay_date <  $check_out\n   -- [check_in, check_out): no last night\n   AND total_rooms - booked_rooms\n       - held_rooms >= $rooms;\n\n-- rowcount MUST equal number of nights.\n-- Fewer rows updated => ROLLBACK.\n-- A partial stay is not a booking.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "-- take the hold across EVERY night in one statement\nUPDATE room_inventory\n   SET held_rooms = held_rooms + $rooms\n WHERE room_type_id = $room_type\n   AND stay_date >= $check_in\n   AND stay_date <  $check_out\n   -- [check_in, check_out): no last night\n   AND total_rooms - booked_rooms\n       - held_rooms >= $rooms;\n\n-- rowcount MUST equal number of nights.\n-- Fewer rows updated => ROLLBACK.\n-- A partial stay is not a booking.", "autoResize": true, "lineHeight": 1.25}, {"id": "e492", "type": "rectangle", "x": 60, "y": 7678.5, "width": 733, "height": 126.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g76"], "frameId": null, "roundness": {"type": 3}, "seed": 821542377, "version": 1, "versionNonce": 164797632, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e493", "type": "text", "x": 74, "y": 7692.5, "width": 296.2, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g76"], "frameId": null, "roundness": null, "seed": 1028666489, "version": 1, "versionNonce": 1955212270, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "DEADLOCK, AND HOW TO NOT HAVE ONE", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "DEADLOCK, AND HOW TO NOT HAVE ONE", "autoResize": true, "lineHeight": 1.25}, {"id": "e494", "type": "text", "x": 74, "y": 7716.0, "width": 702.7, "height": 75.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g76"], "frameId": null, "roundness": null, "seed": 1468227196, "version": 1, "versionNonce": 617013205, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Two transactions each updating several inventory rows in different orders will deadlock. Postgres kills\none - correct, but it shows as random 500s under load. Fix: acquire rows in a canonical order - sort by\n(room_type_id, stay_date). Within the single ranged UPDATE you get that free from index scan order,\none more reason to prefer one ranged statement over a loop of per-night updates.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Two transactions each updating several inventory rows in different orders will deadlock. Postgres kills\none - correct, but it shows as random 500s under load. Fix: acquire rows in a canonical order - sort by\n(room_type_id, stay_date). Within the single ranged UPDATE you get that free from index scan order,\none more reason to prefer one ranged statement over a loop of per-night updates.", "autoResize": true, "lineHeight": 1.25}, {"id": "e495", "type": "text", "x": 833, "y": 7337.0, "width": 332.6, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1647055768, "version": 1, "versionNonce": 100389471, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Race 2 - same user, two devices", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Race 2 - same user, two devices", "autoResize": true, "lineHeight": 1.25}, {"id": "e496", "type": "rectangle", "x": 833, "y": 7377.0, "width": 733, "height": 334.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g77"], "frameId": null, "roundness": {"type": 3}, "seed": 1324941616, "version": 1, "versionNonce": 1358912275, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e497", "type": "text", "x": 847, "y": 7391.0, "width": 233.2, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g77"], "frameId": null, "roundness": null, "seed": 1380322991, "version": 1, "versionNonce": 425824803, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "redeem.js - let the index decide", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "redeem.js - let the index decide", "autoResize": true, "lineHeight": 1.25}, {"id": "e498", "type": "text", "x": 847, "y": 7417.0, "width": 396.8, "height": 280.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g77"], "frameId": null, "roundness": null, "seed": 166369464, "version": 1, "versionNonce": 1287857265, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "// WRONG - check-then-act. Both read zero,\n// both insert, both succeed.\n// SELECT 1 FROM promo_redemptions WHERE ...\n// if (rowCount === 0) INSERT ...\n\n// RIGHT - attempt the write, let the\n// unique index arbitrate.\ntry {\n  await tx.query(INSERT_REDEMPTION, [...]);\n} catch (err) {\n  if (err.code === '23505' &&\n      err.constraint === 'promo_once_per_user')\n    throw new PromoError(\n      'PROMO_ALREADY_USED_BY_USER', 409);\n  throw err;\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "// WRONG - check-then-act. Both read zero,\n// both insert, both succeed.\n// SELECT 1 FROM promo_redemptions WHERE ...\n// if (rowCount === 0) INSERT ...\n\n// RIGHT - attempt the write, let the\n// unique index arbitrate.\ntry {\n  await tx.query(INSERT_REDEMPTION, [...]);\n} catch (err) {\n  if (err.code === '23505' &&\n      err.constraint === 'promo_once_per_user')\n    throw new PromoError(\n      'PROMO_ALREADY_USED_BY_USER', 409);\n  throw err;\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e499", "type": "rectangle", "x": 833, "y": 7731.0, "width": 733, "height": 112.8, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g78"], "frameId": null, "roundness": {"type": 3}, "seed": 316592941, "version": 1, "versionNonce": 712476974, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e500", "type": "text", "x": 847, "y": 7745.0, "width": 151.3, "height": 22.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g78"], "frameId": null, "roundness": null, "seed": 545332599, "version": 1, "versionNonce": 1399159378, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "per_user_limit > 1", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "per_user_limit > 1", "autoResize": true, "lineHeight": 1.25}, {"id": "e501", "type": "text", "x": 847, "y": 7773.5, "width": 691.5, "height": 56.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g78"], "frameId": null, "roundness": null, "seed": 1596046910, "version": 1, "versionNonce": 1487963129, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Try use_ordinal 1..limit until one INSERT succeeds (claimSlot). Bounded by the limit and still fully\nrace-safe, because each ordinal is its own unique slot. An earlier use makes the slot taken (23505) -\ntry the next one.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Try use_ordinal 1..limit until one INSERT succeeds (claimSlot). Bounded by the limit and still fully\nrace-safe, because each ordinal is its own unique slot. An earlier use makes the slot taken (23505) -\ntry the next one.", "autoResize": true, "lineHeight": 1.25}, {"id": "e502", "type": "text", "x": 1606, "y": 7337.0, "width": 401.4, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 653730826, "version": 1, "versionNonce": 1333911086, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Race 3 - the global cap and the hot row", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Race 3 - the global cap and the hot row", "autoResize": true, "lineHeight": 1.25}, {"id": "e503", "type": "rectangle", "x": 1606, "y": 7377.0, "width": 733, "height": 246.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": {"type": 3}, "seed": 1219258965, "version": 1, "versionNonce": 286562392, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e504", "type": "text", "x": 1620, "y": 7391.0, "width": 322.0, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": null, "seed": 26777431, "version": 1, "versionNonce": 1035990566, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "consume-promo.sql - one atomic statement", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "consume-promo.sql - one atomic statement", "autoResize": true, "lineHeight": 1.25}, {"id": "e505", "type": "text", "x": 1620, "y": 7417.0, "width": 396.8, "height": 192.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": null, "seed": 130268530, "version": 1, "versionNonce": 1043243375, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "UPDATE promo_codes\n   SET used_count = used_count + 1\n WHERE id = $promo_id\n   AND status = 'ACTIVE'\n   AND now() BETWEEN starts_at AND ends_at\n   AND (max_redemptions IS NULL\n        OR used_count < max_redemptions)\nRETURNING used_count, max_redemptions;\n\n-- 0 rows: exhausted, paused or outside window.\n-- Final guard, not the user-facing validation.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "UPDATE promo_codes\n   SET used_count = used_count + 1\n WHERE id = $promo_id\n   AND status = 'ACTIVE'\n   AND now() BETWEEN starts_at AND ends_at\n   AND (max_redemptions IS NULL\n        OR used_count < max_redemptions)\nRETURNING used_count, max_redemptions;\n\n-- 0 rows: exhausted, paused or outside window.\n-- Final guard, not the user-facing validation.", "autoResize": true, "lineHeight": 1.25}, {"id": "e506", "type": "rectangle", "x": 1606, "y": 7643.5, "width": 733, "height": 126.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g80"], "frameId": null, "roundness": {"type": 3}, "seed": 577185114, "version": 1, "versionNonce": 2088447191, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e507", "type": "text", "x": 1620, "y": 7657.5, "width": 383.1, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g80"], "frameId": null, "roundness": null, "seed": 1443112403, "version": 1, "versionNonce": 213715570, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "THE HOT-ROW PROBLEM - BRING THIS UP YOURSELF", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE HOT-ROW PROBLEM - BRING THIS UP YOURSELF", "autoResize": true, "lineHeight": 1.25}, {"id": "e508", "type": "text", "x": 1620, "y": 7681.0, "width": 705.6, "height": 75.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g80"], "frameId": null, "roundness": null, "seed": 1486456352, "version": 1, "versionNonce": 467493146, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Every booking using DIWALI20 updates the SAME row. Postgres holds a row lock until commit, so\nthose transactions serialise. If your transaction holds it 20 ms (because a payment call is inside it), the\ncoupon caps at ~50 bookings/sec regardless of database size. Fix 1: do the counter update LAST and\nkeep all network I/O outside - lock window shrinks to microseconds. Fix 2: shard the counter.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Every booking using DIWALI20 updates the SAME row. Postgres holds a row lock until commit, so\nthose transactions serialise. If your transaction holds it 20 ms (because a payment call is inside it), the\ncoupon caps at ~50 bookings/sec regardless of database size. Fix 1: do the counter update LAST and\nkeep all network I/O outside - lock window shrinks to microseconds. Fix 2: shard the counter.", "autoResize": true, "lineHeight": 1.25}, {"id": "e509", "type": "rectangle", "x": 60, "y": 7879.8, "width": 1120, "height": 264.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g81"], "frameId": null, "roundness": {"type": 3}, "seed": 1451071152, "version": 1, "versionNonce": 1051438732, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e510", "type": "text", "x": 74, "y": 7893.8, "width": 478.4, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g81"], "frameId": null, "roundness": null, "seed": 624609530, "version": 1, "versionNonce": 1522288719, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "sharded-counter.sql - only when a single row genuinely caps you", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "sharded-counter.sql - only when a single row genuinely caps you", "autoResize": true, "lineHeight": 1.25}, {"id": "e511", "type": "text", "x": 74, "y": 7919.8, "width": 548.0, "height": 210.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g81"], "frameId": null, "roundness": null, "seed": 1109251957, "version": 1, "versionNonce": 613200081, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "CREATE TABLE promo_counter_shards (\n  promo_id   BIGINT NOT NULL REFERENCES promo_codes(id),\n  shard_no   SMALLINT NOT NULL,\n  used_count INT NOT NULL DEFAULT 0,\n  max_count  INT NOT NULL,   -- max_redemptions / shard_count\n  PRIMARY KEY (promo_id, shard_no),\n  CHECK (used_count <= max_count));\n\n-- pick a shard at random so load self-balances\nUPDATE promo_counter_shards SET used_count = used_count + 1\n WHERE promo_id = $1 AND shard_no = $2 AND used_count < max_count\nRETURNING used_count;", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CREATE TABLE promo_counter_shards (\n  promo_id   BIGINT NOT NULL REFERENCES promo_codes(id),\n  shard_no   SMALLINT NOT NULL,\n  used_count INT NOT NULL DEFAULT 0,\n  max_count  INT NOT NULL,   -- max_redemptions / shard_count\n  PRIMARY KEY (promo_id, shard_no),\n  CHECK (used_count <= max_count));\n\n-- pick a shard at random so load self-balances\nUPDATE promo_counter_shards SET used_count = used_count + 1\n WHERE promo_id = $1 AND shard_no = $2 AND used_count < max_count\nRETURNING used_count;", "autoResize": true, "lineHeight": 1.25}, {"id": "e512", "type": "rectangle", "x": 1220, "y": 7879.8, "width": 1120, "height": 96.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g82"], "frameId": null, "roundness": {"type": 3}, "seed": 997855888, "version": 1, "versionNonce": 1000507494, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e513", "type": "text", "x": 1234, "y": 7893.8, "width": 375.3, "height": 22.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g82"], "frameId": null, "roundness": null, "seed": 1001455707, "version": 1, "versionNonce": 1647484528, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Sharded counter - state the trade-off out loud", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Sharded counter - state the trade-off out loud", "autoResize": true, "lineHeight": 1.25}, {"id": "e514", "type": "text", "x": 1234, "y": 7922.2, "width": 1007.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g82"], "frameId": null, "roundness": null, "seed": 254482949, "version": 1, "versionNonce": 2133096370, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "A request can be told \"exhausted\" while other shards still have room. Mitigate by retrying 2-3 other shards before giving up. Cost: a small\nfalse-negative rate near the very end of the campaign. Benefit: ~16x the write throughput. Same trick as a hot key in a rate limiter.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A request can be told \"exhausted\" while other shards still have room. Mitigate by retrying 2-3 other shards before giving up. Cost: a small\nfalse-negative rate near the very end of the campaign. Benefit: ~16x the write throughput. Same trick as a hot key in a rate limiter.", "autoResize": true, "lineHeight": 1.25}, {"id": "e515", "type": "rectangle", "x": 1220, "y": 7996.2, "width": 1120, "height": 111.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g83"], "frameId": null, "roundness": {"type": 3}, "seed": 1919126527, "version": 1, "versionNonce": 1179132832, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e516", "type": "text", "x": 1234, "y": 8010.2, "width": 251.7, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g83"], "frameId": null, "roundness": null, "seed": 427886183, "version": 1, "versionNonce": 669316237, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "WHY NOT SELECT ... FOR UPDATE?", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHY NOT SELECT ... FOR UPDATE?", "autoResize": true, "lineHeight": 1.25}, {"id": "e517", "type": "text", "x": 1234, "y": 8033.8, "width": 1090.9, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g83"], "frameId": null, "roundness": null, "seed": 2100509031, "version": 1, "versionNonce": 184370611, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "It works and is defensible - but strictly worse: an extra round trip, and the lock is held from the SELECT all the way to COMMIT instead of just for the\nUPDATE. The guarded UPDATE ... RETURNING gets the same guarantee in one statement with a shorter lock. Use FOR UPDATE only when you\nmust read several columns, branch on them in application code, and then write.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "It works and is defensible - but strictly worse: an extra round trip, and the lock is held from the SELECT all the way to COMMIT instead of just for the\nUPDATE. The guarded UPDATE ... RETURNING gets the same guarantee in one statement with a shorter lock. Use FOR UPDATE only when you\nmust read several columns, branch on them in application code, and then write.", "autoResize": true, "lineHeight": 1.25}, {"id": "e624", "type": "rectangle", "x": 0, "y": 8303.8, "width": 2400, "height": 1863.8, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 726285630, "version": 1, "versionNonce": 1615146092, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e519", "type": "rectangle", "x": 60, "y": 8343.8, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g84"], "frameId": null, "roundness": {"type": 3}, "seed": 37590537, "version": 1, "versionNonce": 621887389, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e520", "type": "text", "x": 74, "y": 8350.8, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g84"], "frameId": null, "roundness": null, "seed": 985632350, "version": 1, "versionNonce": 164205699, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "07", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "07", "autoResize": true, "lineHeight": 1.25}, {"id": "e521", "type": "text", "x": 144, "y": 8345.8, "width": 483.1, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g84"], "frameId": null, "roundness": null, "seed": 1760716882, "version": 1, "versionNonce": 1087954963, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"The user pressed Book twice\"", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"The user pressed Book twice\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e522", "type": "text", "x": 60, "y": 8405.8, "width": 1238.9, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2078996627, "version": 1, "versionNonce": 2135906903, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "They asked this specifically. It is not really about double-clicks - the button is the easiest case. It is about every way one intent becomes two requests.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "They asked this specifically. It is not really about double-clicks - the button is the easiest case. It is about every way one intent becomes two requests.", "autoResize": true, "lineHeight": 1.25}, {"id": "e523", "type": "rectangle", "x": 60, "y": 8456.2, "width": 1120, "height": 176.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g85"], "frameId": null, "roundness": {"type": 3}, "seed": 965188601, "version": 1, "versionNonce": 2134527796, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e524", "type": "text", "x": 74, "y": 8470.2, "width": 552.5, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g85"], "frameId": null, "roundness": null, "seed": 576937035, "version": 1, "versionNonce": 830750506, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "All the ways it happens - name several, it shows you have shipped", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "All the ways it happens - name several, it shows you have shipped", "autoResize": true, "lineHeight": 1.25}, {"id": "e525", "type": "text", "x": 74, "y": 8498.8, "width": 699.6, "height": 120.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g85"], "frameId": null, "roundness": null, "seed": 450621989, "version": 1, "versionNonce": 1968286391, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "- Impatient double-click, or a double-tap on mobile\n- The client HTTP library retries on timeout - the first request succeeded, the response was lost\n- A load balancer or proxy retries an idle-timed-out connection\n- User refreshes the payment page, or hits Back and re-submits\n- The payment provider sends the same webhook twice - they guarantee AT-LEAST-once\n- A queue consumer re-processes a message after a crash before its ack", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "- Impatient double-click, or a double-tap on mobile\n- The client HTTP library retries on timeout - the first request succeeded, the response was lost\n- A load balancer or proxy retries an idle-timed-out connection\n- User refreshes the payment page, or hits Back and re-submits\n- The payment provider sends the same webhook twice - they guarantee AT-LEAST-once\n- A queue consumer re-processes a message after a crash before its ack", "autoResize": true, "lineHeight": 1.25}, {"id": "e526", "type": "rectangle", "x": 1220, "y": 8456.2, "width": 1120, "height": 131.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g86"], "frameId": null, "roundness": {"type": 3}, "seed": 2030633203, "version": 1, "versionNonce": 1998310963, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e527", "type": "text", "x": 1234, "y": 8470.2, "width": 205.1, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g86"], "frameId": null, "roundness": null, "seed": 452493697, "version": 1, "versionNonce": 160229907, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "WRONG ANSWERS, RANKED", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WRONG ANSWERS, RANKED", "autoResize": true, "lineHeight": 1.25}, {"id": "e528", "type": "text", "x": 1234, "y": 8493.8, "width": 1016.8, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g86"], "frameId": null, "roundness": null, "seed": 1248702408, "version": 1, "versionNonce": 193924423, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"Disable the button.\" A UI nicety, not a guarantee - it does nothing for retries, refreshes or webhooks, and the client is not a trust boundary.\n\"Use a Redis lock on user_id.\" Better, but a lock only prevents CONCURRENT duplicates; a retry 5 seconds later sails through.\n\"Check if a similar booking exists.\" Check-then-act, so it has the exact race you are trying to fix.\nThe correct answer: the operation must be IDEMPOTENT, not merely serialised.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Disable the button.\" A UI nicety, not a guarantee - it does nothing for retries, refreshes or webhooks, and the client is not a trust boundary.\n\"Use a Redis lock on user_id.\" Better, but a lock only prevents CONCURRENT duplicates; a retry 5 seconds later sails through.\n\"Check if a similar booking exists.\" Check-then-act, so it has the exact race you are trying to fix.\nThe correct answer: the operation must be IDEMPOTENT, not merely serialised.", "autoResize": true, "lineHeight": 1.25}, {"id": "e529", "type": "text", "x": 60, "y": 8668.8, "width": 833.7, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 304385788, "version": 1, "versionNonce": 1605214350, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Two identical requests, same Idempotency-Key - one row is the whole mechanism", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Two identical requests, same Idempotency-Key - one row is the whole mechanism", "autoResize": true, "lineHeight": 1.25}, {"id": "e530", "type": "rectangle", "x": 60, "y": 8712.8, "width": 2280, "height": 390, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g87"], "frameId": null, "roundness": {"type": 3}, "seed": 1125422555, "version": 1, "versionNonce": 562230468, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e531", "type": "text", "x": 80, "y": 8726.8, "width": 108.8, "height": 22.5, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2045994298, "version": 1, "versionNonce": 772135432, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "REQUEST A", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "REQUEST A", "autoResize": true, "lineHeight": 1.25}, {"id": "e532", "type": "text", "x": 80, "y": 8926.8, "width": 329.4, "height": 22.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 284767218, "version": 1, "versionNonce": 1295718059, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "REQUEST B  (same Idempotency-Key)", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "REQUEST B  (same Idempotency-Key)", "autoResize": true, "lineHeight": 1.25}, {"id": "e533", "type": "line", "x": 100, "y": 8812.8, "width": 2200, "height": 0.0, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1761402624, "version": 1, "versionNonce": 1356497132, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [2200, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e534", "type": "line", "x": 100, "y": 9012.8, "width": 2200, "height": 0.0, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1092520183, "version": 1, "versionNonce": 600367477, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [2200, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e535", "type": "ellipse", "x": 351, "y": 8803.8, "width": 18, "height": 18, "angle": 0, "strokeColor": "#0b7285", "background