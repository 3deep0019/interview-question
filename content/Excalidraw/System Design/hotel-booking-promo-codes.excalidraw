lse, "text": "id           BIGSERIAL PK\npromo_id      BIGINT FK -> promo_codes\nuser_id       BIGINT\nbooking_id    BIGINT FK -> bookings\namount_off    BIGINT >= 0\ncurrency      CHAR(3)\nuse_ordinal   INT DEFAULT 1\nstatus        CONSUMED | REVERTED\ncreated_at / reverted_at\n\nUNIQUE (promo_id, user_id,\n        use_ordinal)\n  WHERE status = CONSUMED\n\n=> once-per-user, race-proof;\n   REVERTED rows free the slot;\n   per_user_limit=3 works unchanged", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "id           BIGSERIAL PK\npromo_id      BIGINT FK -> promo_codes\nuser_id       BIGINT\nbooking_id    BIGINT FK -> bookings\namount_off    BIGINT >= 0\ncurrency      CHAR(3)\nuse_ordinal   INT DEFAULT 1\nstatus        CONSUMED | REVERTED\ncreated_at / reverted_at\n\nUNIQUE (promo_id, user_id,\n        use_ordinal)\n  WHERE status = CONSUMED\n\n=> once-per-user, race-proof;\n   REVERTED rows free the slot;\n   per_user_limit=3 works unchanged", "autoResize": true, "lineHeight": 1.25}, {"id": "e294", "type": "rectangle", "x": 1818, "y": 3914.5, "width": 520, "height": 470.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g49"], "frameId": null, "roundness": {"type": 3}, "seed": 949441370, "version": 1, "versionNonce": 678561451, "isDeleted": false, "boundElements": [{"id": "e327", "type": "arrow"}], "updated": 1792010425260, "link": null, "locked": false}, {"id": "e295", "type": "rectangle", "x": 1818, "y": 3914.5, "width": 520, "height": 44, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g49"], "frameId": null, "roundness": null, "seed": 155791555, "version": 1, "versionNonce": 1441295358, "isDeleted": false, "boundElements": null, "updated"