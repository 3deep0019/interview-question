idth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g104"], "frameId": null, "roundness": null, "seed": 1433134049, "version": 1, "versionNonce": 911225420, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "WHY THE QUOTE CAN'T BE TRUSTED AT BOOKING TIME", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHY THE QUOTE CAN'T BE TRUSTED AT BOOKING TIME", "autoResize": true, "lineHeight": 1.25}, {"id": "e698", "type": "text", "x": 74, "y": 11205.0, "width": 2174.6, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g104"], "frameId": null, "roundness": null, "seed": 1986767750, "version": 1, "versionNonce": 795037170, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Between quote and booking, the coupon can hit its global cap, the user can redeem it in another tab, or the promo can be paused by an admin. So POST /v1/bookings recomputes the quote INSIDE the transaction and compares. If the total changed, return 409 with the new quote and let the user\nre-confirm - never silently charge a different amount than the one they saw.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Between quote and booking, the coupon can hit its global cap, the user can redeem it in another tab, or the promo can be paused by an admin. So POST /v1/bookings recomputes the quote INSIDE the transaction and compares. If the total changed, return 409 with the new quote and let the user\nre-confirm - never silently charge a different amount than the one they saw.", "autoResize": true, "lineHeight": 1.25}, {"id": "e782", "type": "rectangle", "x": 0, "y": 11419.0, "width": 2400, "height": 1530.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 591911628, "version": 1, "versionNonce": 638674268, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e700", "type": "rectangle", "x": 60, "y": 11459.0, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g105"], "frameId": null, "roundness": {"type": 3}, "seed": 73223661, "version": 1, "versionNonce": 1494268061, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e701", "type": "text", "x": 74, "y": 11466.0, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g105"], "frameId": null, "roundness": null, "seed": 725960213, "version": 1, "versionNonce": 1542606748, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "09", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "09", "autoResize": true, "lineHeight": 1.25}, {"id": "e702", "type": "text", "x": 144, "y": 11461.0, "width": 520.9, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g105"], "frameId": null, "roundness": null, "seed": 903138945, "version": 1, "versionNonce": 778076036, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Failure modes & the money saga", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Failure modes & the money saga", "autoResize": true, "lineHeight": 1.25}, {"id": "e703", "type": "text", "x": 60, "y": 11521.0, "width": 1084.9, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1465800790, "version": 1, "versionNonce": 851172779, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "The booking transaction is local and safe. The problem is the payment, which lives at a third party and cannot join your transaction.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The booking transaction is local and safe. The problem is the payment, which lives at a third party and cannot join your transaction.", "autoResize": true, "lineHeight": 1.25}, {"id": "e704", "type": "rectangle", "x": 60, "y": 11571.5, "width": 2280, "height": 91.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g106"], "frameId": null, "roundness": {"type": 3}, "seed": 425372799, "version": 1, "versionNonce": 14502958, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e705", "type": "text", "x": 74, "y": 11585.5, "width": 248.2, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g106"], "frameId": null, "roundness": null, "seed": 1711682370, "version": 1, "versionNonce": 627304034, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "THE MISTAKE TO AVOID OUT LOUD", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE MISTAKE TO AVOID OUT LOUD", "autoResize": true, "lineHeight": 1.25}, {"id": "e706", "type": "text", "x": 74, "y": 11609.0, "width": 2194.1, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g106"], "frameId": null, "roundness": null, "seed": 1587267919, "version": 1, "versionNonce": 1814945206, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Never call the payment provider from inside the database transaction. You would hold a row lock on the promo counter and on every inventory row for the 300-3000 ms the provider takes, and if it times out you do not know whether the charge happened. Booking commits PENDING_PAYMENT first;\npayment is a separate step reconciled by webhook.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Never call the payment provider from inside the database transaction. You would hold a row lock on the promo counter and on every inventory row for the 300-3000 ms the provider takes, and if it times out you do not know whether the charge happened. Booking commits PENDING_PAYMENT first;\npayment is a separate step reconciled by webhook.", "autoResize": true, "lineHeight": 1.25}, {"id": "e707", "type": "text", "x": 60, "y": 11703.0, "width": 337.8, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1084218087, "version": 1, "versionNonce": 144810112, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "The saga, and its compensations", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The saga, and its compensations", "autoResize": true, "lineHeight": 1.25}, {"id": "e708", "type": "text", "x": 60, "y": 11745.0, "width": 120.3, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 440703565, "version": 1, "versionNonce": 1064498220, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "LOCAL + ATOMIC", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "LOCAL + ATOMIC", "autoResize": true, "lineHeight": 1.25}, {"id": "e709", "type": "text", "x": 1120, "y": 11745.0, "width": 330.8, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2082755756, "version": 1, "versionNonce": 430385368, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "CROSSES A BOUNDARY - needs saga machinery", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CROSSES A BOUNDARY - needs saga machinery", "autoResize": true, "lineHeight": 1.25}, {"id": "e710", "type": "rectangle", "x": 60, "y": 11775.0, "width": 420, "height": 120, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": 