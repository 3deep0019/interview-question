ist", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "EXCLUDE gist", "autoResize": true, "lineHeight": 1.25}, {"id": "e364", "type": "text", "x": 499, "y": 5250.2, "width": 605.0, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": null, "seed": 512037766, "version": 1, "versionNonce": 2014610073, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "EXCLUDE USING gist (room_id WITH =, daterange(check_in, check_out, [)) WITH &&)", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "EXCLUDE USING gist (room_id WITH =, daterange(check_in, check_out, [)) WITH &&)", "autoResize": true, "lineHeight": 1.25}, {"id": "e365", "type": "text", "x": 1379, "y": 5250.2, "width": 509.4, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": null, "seed": 235045220, "version": 1, "versionNonce": 2081368687, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Locking code for named-room double-booking - gone, at any concurrency", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Locking code for named-room double-booking - gone, at any concurrency", "autoResize": true, "lineHeight": 1.25}, {"id": "e366", "type": "line", "x": 490, "y": 4950.5, "width": 0, "height": 327.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": null, "seed": 346709295, "version": 1, "versionNonce": 562415863, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 327.5]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e367", "type": "line", "x": 1370, "y": 4950.5, "width": 0, "height": 327.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": null, "seed": 108189621, "version": 1, "versionNonce": 389008007, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 327.5]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e368", "type": "rectangle", "x": 60, "y": 5308.0, "width": 1120, "height": 111.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": {"type": 3}, "seed": 433294005, "version": 1, "versionNonce": 2001984947, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e369", "type": "text", "x": 74, "y": 5322.0, "width": 345.6, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": null, "seed": 669998583, "version": 1, "versionNonce": 1350060910, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "THE LINE TO SAY WHILE YOU DRAW THAT INDEX", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE LINE TO SAY WHILE YOU DRAW THAT INDEX", "autoResize": true, "lineHeight": 1.25}, {"id": "e370", "type": "text", "x": 74, "y": 5345.5, "width": 1065.2, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": null, "seed": 654994105, "version": 1, "versionNonce": 1140498159, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"I'm not going to write SELECT ... WHERE user_id = ? and then INSERT if it's empty - that's a check-then-act race, and under two concurrent\nrequests both checks pass. I'm putting a unique index on it and letting the INSERT fail. The database does the concurrency control; my code just\nhandles error 23505.\"", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"I'm not going to write SELECT ... WHERE user_id = ? and then INSERT if it's empty - that's a check-then-act race, and under two concurrent\nrequests both checks pass. I'm putting a unique index on it and letting the INSERT fail. The database does the concurrency control; my code just\nhandles error 23505.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e371", "type": "rectangle", "x": 1220, "y": 5308.0, "width": 1120, "height": 156.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g56"], "frameId": null, "roundness": {"type": 3}, "seed": 1631010082, "version": 1, "versionNonce": 442105777, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e372", "type": "text", "x": 1234, "y": 5322.0, "width": 249.7, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g56"], "frameId": null, "roundness": null, "seed": 622686157, "version": 1, "versionNonce": 957105280, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Design details worth narrating", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Design details worth narrating", "autoResize": true, "lineHeight": 1.25}, {"id": "e373", "type": "text", "x": 1234, "y": 5350.5, "width": 1082.3, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g56"], "frameId": null, "roundness": null, "seed": 1073932091, "version": 1, "versionNonce": 1443446602, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "- Money is integer minor units (paise / cents) - never a float.\n- Basis points keep percentages integral: 1500 = 15.00%.\n- room_inventory is materialised per (room type, night) for a rolling 400-day horizon; partitioned monthly so old months are DROPPED, not deleted.\n- Holds freeze the price (quoted_total) for their life; expiry sweeper releases held_rooms.\n- The idempotency record is a table with request_hash, state and the stored response.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "- Money is integer minor units (paise / cents) - never a float.\n- Basis points keep percentages integral: 1500 = 15.00%.\n- room_inventory is materialised per (room type, night) for a rolling 400-day horizon; partitioned monthly so old months are DROPPED, not deleted.\n- Holds freeze the price (quoted_total) for their life; expiry sweeper releases held_rooms.\n- The idempotency record is a table with request_hash, state and the stored response.", "autoResize": true, "lineHeight": 1.25}, {"id": "e462", "type": "rectangle", "x": 0, "y": 5624.5, "width": 2400, "height": 1074.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1917337253, "version": 1, "versionNonce": 1527260611, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e375", "type": "rectangle", "x": 60, "y": 5664.5, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g57"], "frameId": null, "roundness": {"type": 3}, "seed": 745179022, "version": 1, "versionNonce": 1725887396, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e376", "type": "text", "x": 74, "y": 5671.5, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g57"], "frameId": null, "roundness": null, "seed": 39004969, "version": 1, "versionNonce": 2135670316, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "05", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "05", "autoResize": true, "lineHeight": 1.25}, {"id": "e377", "type": "text", "x": 144, "y": 5666.5, "width": 320.5, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, 