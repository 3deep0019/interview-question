ght": 1.25}, {"id": "e286", "type": "rectangle", "x": 646, "y": 3914.5, "width": 520, "height": 470.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g47"], "frameId": null, "roundness": {"type": 3}, "seed": 1882345611, "version": 1, "versionNonce": 1881145519, "isDeleted": false, "boundElements": [{"id": "e315", "type": "arrow"}, {"id": "e317", "type": "arrow"}, {"id": "e325", "type": "arrow"}], "updated": 1792010425260, "link": null, "locked": false}, {"id": "e287", "type": "rectangle", "x": 646, "y": 3914.5, "width": 520, "height": 44, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g47"], "frameId": null, "roundness": null, "seed": 2023317399, "version": 1, "versionNonce": 1992455312, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e288", "type": "text", "x": 660, "y": 3923.5, "width": 134.0, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g47"], "frameId": null, "roundness": null, "seed": 557470198, "version": 1, "versionNonce": 1981664003, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "promo_codes", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "promo_codes", "autoResize": true, "lineHeight": 1.25}, {"id": "e289", "type": "text", "x": 660, "y": 3970.5, "width": 329.6, "height": 402.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g47"], "frameId": null, "roundness": null, "seed": 1201546738, "version": 1, "versionNonce": 1917176626, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "id              BIGSERIAL PK\ncode            TEXT\ndiscount_type   PERCENT | FIXED\npercent_bps     INT   (1500 = 15.00%)\nfixed_amount    BIGINT  minor units\ncurrency        CHAR(3)\nmax_discount    BIGINT  cap for PERCENT\nmin_order_value BIGINT  DEFAULT 0\nstarts_at       TIMESTAMPTZ\nends_at         TIMESTAMPTZ\nmax_redemptions INT   NULL = unlimited\nused_count      INT   DEFAULT 0\nper_user_limit  INT   DEFAULT 1\nstatus          ACTIVE|PAUSED|ARCHIVED\n\nCHECK window_valid  ends_at > starts_at\nCHECK shape_valid   exactly one of\n      percent_bps / fixed_amount set\nCHECK amounts_positive, bps <= 10000\nCHECK cap_not_exceeded\n      used_count <= max_redemptions\nUNIQUE (UPPER(code))\n      WHERE status <> ARCHIVED", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "id              BIGSERIAL PK\ncode            TEXT\ndiscount_type   PERCENT | FIXED\npercent_bps     INT   (1500 = 15.00%)\nfixed_amount    BIGINT  minor units\ncurrency        CHAR(3)\nmax_discount    BIGINT  cap for PERCENT\nmin_order_value BIGINT  DEFAULT 0\nstarts_at       TIMESTAMPTZ\nends_at         TIMESTAMPTZ\nmax_redemptions INT   NULL = unlimited\nused_count      INT   DEFAULT 0\nper_user_limit  INT   DEFAULT 1\nstatus          ACTIVE|PAUSED|ARCHIVED\n\nCHECK window_valid  ends_at > starts_at\nCHECK shape_valid   exactly one of\n      percent_bps / fixed_amount set\nCHECK amounts_positive, bps <= 10000\nCHECK cap_not_exceeded\n      used_count <= max_redemptions\nUNIQUE (UPPER(code))\n      WHERE status <> ARCHIVED", "autoResize": true, "lineHeight": 1.25}, {"id": "e290", "type": "rectangle", "x": 1232, "y": 3914.5, "width": 520, "height": 470.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "