: false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "No two bookings for the same physical room", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "No two bookings for the same physical room", "autoResize": true, "lineHeight": 1.25}, {"id": "e175", "type": "text", "x": 489, "y": 2506.5, "width": 576.9, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g28"], "frameId": null, "roundness": null, "seed": 1757356620, "version": 1, "versionNonce": 860463132, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "EXCLUDE USING gist on a daterange - Postgres-specific, and exactly this problem", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "EXCLUDE USING gist on a daterange - Postgres-specific, and exactly this problem", "autoResize": true, "lineHeight": 1.25}, {"id": "e176", "type": "line", "x": 480, "y": 2243.5, "width": 0, "height": 290.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g28"], "frameId": null, "roundness": null, "seed": 1588865204, "version": 1, "versionNonce": 1725129599, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 290.8]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e177", "type": "text", "x": 1220, "y": 2205.5, "width": 461.1, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 486919347, "version": 1, "versionNonce": 429320601, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Why not the alternatives - one sentence each", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Why not the alternatives - one sentence each", "autoResize": true, "lineHeight": 1.25}, {"id": "e178", "type": "rectangle", "x": 1220, "y": 2243.5, "width": 1120, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 1111620701, "version": 1, "versionNonce": 1058240950, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e179", "type": "text", "x": 1229, "y": 2251.5, "width": 44.9, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 763564744, "version": 1, "versionNonce": 1569819131, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Option", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Option", "autoResize": true, "lineHeight": 1.25}, {"id": "e180", "type": "text", "x": 1419, "y": 2251.5, "width": 88.6, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 62234396, "version": 1, "versionNonce": 2125157524, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Why not here", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Why not here", "autoResize": true, "lineHeight": 1.25}, {"id": "e181", "type": "rectangle", "x": 1220, "y": 2277.0, "width": 1120, "height": 55.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 59994415, "version": 1, "versionNonce": 1696757188, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e182", "type": "text", "x": 1229, "y": 2286.0, "width": 71.4, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 600046750, "version": 1, "versionNonce": 1014127815, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "MongoDB", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "MongoDB", "autoResize": true, "lineHeight": 1.25}, {"id": "e183", "type": "text", "x": 1419, "y": 2286.0, "width": 877.6, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 556572714, "version": 1, "versionNonce": 415849347, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "It has transactions now, so the old answer is stale. Real objection: my invariants are cross-document uniqueness and\ncross-collection atomicity. Mongo makes me implement both in application code - exactly the code that has the race conditions.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "It has transactions now, so the old answer is stale. Real objection: my invariants are cross-document uniqueness and\ncross-collection atomicity. Mongo makes me implement both in application code - exactly the code that has the race conditions.", "autoResize": true, "lineHeight": 1.25}, {"id": "e184", "type": "rectangle", "x": 1220, "y": 2332.5, "width": 1120, "height": 55.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 1487179539, "version": 1, "versionNonce": 1299526165, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e185", "type": "text", "x": 1229, "y": 2341.5, "width": 170.2, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 2054100485, "version": 1, "versionNonce": 739337660, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Cassandra / DynamoDB", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Cassandra / DynamoDB", "autoResize": true, "lineHeight": 1.25}, {"id": "e186", "type": "text", "x": 1419, "y": 2341.5, "width": 903.9, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 960414117, "version": 1, "versionNonce": 1736381712, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Built for write throughput I don't have. Conditional writes are single-partition only, so \"decrement promo counter + insert redemption\n+ decrement inventory, atomically\" isn't expressible. Cassandra LWT = Paxos per op: slow and still not multi-partition.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Built for write throughput I don't have. Conditional writes are single-partition only, so \"decrement promo counter + insert redemption\n+ decrement inventory, atomically\" isn't expressible. Cassandra LWT = Paxos per op: slow and still not multi-partition.", "autoResize": true, "lineHeight": 1.25}, {"id": "e187", "type": "rectangle", "x": 1220, "y": 2388.0, "width": 1120, "height": 55.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 2012237700, "version": 1, "versionNonce": 1552905459, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e188", "type": "text", "x": 1229, "y": 2397.0, "width": 166.8, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 2121795575, "version": 1, "versionNonce": 750587752, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Redis as source of truth", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Redis as source of truth", "autoResize": true, "lineHeight": 1.25}, {"id": "e189", "type": "text", "x": 1419, "y": 2397.0, "width": 869.0, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 2050848239, "version": 1, "versionNonce": 2092754982, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Perfect for the HOLD layer (native TTLs) and hot counters. Not durable enough for a paid booking - async replication can lose\nacknowledged writes on failover, and that is someone's honeymoon.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Perfect for the HOLD layer (native TTLs) and hot counters. Not durable enough for a paid booking - async replication can lose\nacknowledged writes on failover, and that is someone's honeymoon.", "autoResize": true, "lineHeight": 1.25}, {"id": "e190", "type": "rectangle", "x": 1220, "y": 2443.5, "width": 1120, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 783049603, "version": 1, "versionNonce": 172954318, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e191", "type": "text", "x": 1229, "y": 2452.5, "width": 54.0, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 473439233, "version": 1, "versionNonce": 219380805, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "MySQL", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "MySQL", "autoResize": true, "lineHeight": 1.25}, {"id": "e192", "type": "text", "x": 1419, "y": 2452.5, "width": 825.9, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 487147711, "version": 1, "versionNonce": 1009489084, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Genuinely fine. I'd pick Postgres for partial indexes, exclusion constraints and richer types, but this design ports directly.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Genuinely fine. I'd pick Postgres for partial indexes, exclusion constraints and richer types, but this design ports directly.", "autoResize": true, "lineHeight": 1.25}, {"id": "e193", "type": "line", "x": 1410, "y": 2243.5, "width": 0, "height": 236.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g29"], "frameId": null, "roundness": null, "seed": 422423279, "version": 1, "versionNonce": 725285719, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 236.8]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e194", "type": "text", "x": 60, "y": 2578.2, "width": 353.0, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null