verticalAlign": "top", "containerId": null, "originalText": "Idempotent handler keyed on provider event id; state transitions guarded by WHERE status = PENDING_PAYMENT", "autoResize": true, "lineHeight": 1.25}, {"id": "e758", "type": "rectangle", "x": 60, "y": 12339.5, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1016756317, "version": 1, "versionNonce": 420296545, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e759", "type": "text", "x": 69, "y": 12348.5, "width": 87.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 800398061, "version": 1, "versionNonce": 1162924751, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Cancellation", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Cancellation", "autoResize": true, "lineHeight": 1.25}, {"id": "e760", "type": "text", "x": 509, "y": 12348.5, "width": 208.4, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1974624995, "version": 1, "versionNonce": 958523967, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Does the coupon come back?", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Does the coupon come back?", "autoResize": true, "lineHeight": 1.25}, {"id": "e761", "type": "text", "x": 1029, "y": 12348.5, "width": 1054.5, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 414520586, "version": 1, "versionNonce": 694301198, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Product decision. If yes: redemption -> REVERTED (partial index frees the slot) AND used_count = used_count - 1. If no: leave both. Say which and why", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Product decision. If yes: redemption -> REVERTED (partial index frees the slot) AND used_count = used_count - 1. If no: leave both. Say which and why", "autoResize": true, "lineHeight": 1.25}, {"id": "e762", "type": "rectangle", "x": 60, "y": 12376.2, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 782218472, "version": 1, "versionNonce": 1583382221, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e763", "type": "text", "x": 69, "y": 12385.2, "width": 224.0, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1926278589, "version": 1, "versionNonce": 1019054749, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Promo counter drifts from reality", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Promo counter drifts from reality", "autoResize": true, "lineHeight": 1.25}, {"id": "e764", "type": "text", "x": 509, "y": 12385.2, "width": 360.6, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 65030223, "version": 1, "versionNonce": 1356484092, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "used_count != COUNT(*) of consumed redemptions", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "used_count != COUNT(*) of consumed redemptions", "autoResize": true, "lineHeight": 1.25}, {"id": "e765", "type": "text", "x": 1029, "y": 12385.2, "width": 763.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 882190216, "version": 1, "versionNonce": 532603958, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Nightly reconciliation job compares and alerts. This is WHY redemptions are a real table and not just a number", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Nightly reconciliation job compares and alerts. This is WHY redemptions are a real table and not just a number", "autoResize": true, "lineHeight": 1.25}, {"id": "e766", "type": "rectangle", "x": 60, "y": 12413.0, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1743379899, "version": 1, "versionNonce": 1343054110, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e767", "type": "text", "x": 69, "y": 12422.0, "width": 303.8, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1646407000, "version": 1, "versionNonce": 869242576, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Coupon abuse: many accounts, one person", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Coupon abuse: many accounts, one person", "autoResize": true, "lineHeight": 1.25}, {"id": "e768", "type": "text", "x": 509, "y": 12422.0, "width": 173.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 87294111, "version": 1, "versionNonce": 806525423, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Cap burned by one actor", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Cap burned by one actor", "autoResize": true, "lineHeight": 1.25}, {"id": "e769", "type": "text", "x": 1029, "y": 12422.0, "width": 923.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 74849230, "version": 1, "versionNonce": 996541114, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Per-user limit is only the first line. Add device fingerprint, payment instrument, phone-number caps; run as a risk score, not a hard rule", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Per-user limit is only the first line. Add device fingerprint, payment instrument, phone-number caps; run as a risk score, not a hard rule", "autoResize": true, "lineHeight": 1.25}, {"id": "e770", "type": "rectangle", "x": 60, "y": 12449.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 134389399, "version": 1, "versionNonce": 1725155388, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e771", "type": "text", "x": 69, "y": 12458.8, "width": 223.7, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1975849727, "version": 1, "versionNonce": 133152356, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Admin sets 100% off by mistake", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Admin sets 100% off by mistake", "autoResize": true, "lineHeight": 1.25}, {"id": "e772", "type": "text", "x": 509, "y": 12458.8, "width": 170.2, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 551937566, "version": 1, "versionNonce": 418633577, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Free hotel rooms, briefly", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Free hotel rooms, briefly", "autoResize": true, "lineHeight": 1.25}, {"id": "e773", "type": "text", "x": 1029, "y": 12458.8, "width": 881.9, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1604786199, "version": 1, "versionNonce": 134973078, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Validate on write (max_discount mandatory above some %), two-person approval above a threshold, cap total campaign liability", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Validate on write (max_discount mandatory above some %), two-person approval above a threshold, cap total campaign liability", "autoResize": true, "lineHeight": 1.25}, {"id": "e774", "type": "line", "x": 500, "y": 12159.0, "width": 0, "height": 327.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 1929625277, "version": 1, "versionNonce": 1300551083, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 327.5]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e775", "type": "line", "x": 1020, "y": 12159.0, "width": 0, "height": 327.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 728146282, "version": 1, "versionNonce": 779481354, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 327.5]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e776", "type": "rectangle", "x": 60, "y": 12522.5, "width": 1120, "height": 386.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g116"], "frameId": null, "roundness": {"type": 3}, "seed": 584791292, "version": 1, "versionNonce": 719344551, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e777", "type": "text", "x": 74, "y": 12536.5, "width": 330.4, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g116"], "frameId": null, "roundness": null, "seed": 2056622757, "version": 1, "versionNonce": 2048189202, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "cancel.js - compensation, done idempotently", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "cancel.js - compensation, done idempotently", "autoResize": true, "lineHeight": 1.25}, {"id": "e778", "type": "text", "x": 74, "y": 12562.5, "width": 581.6, "height": 332.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g116"], "frameId": null, "roundness": null, "seed": 1324951216, "version": 1, "versionNonce": 93599289, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "async function cancelBooking(bookingId, { returnCoupon }) {\n  await db.transaction(async (tx) => {\n    // guarded transition: a 2nd cancel updates 0 rows\n    const b = await tx.query(\n      `UPDATE bookings SET status = 'CANCELLED'\n        WHERE id = $1 AND status IN\n          ('PENDING_PAYMENT','CONFIRMED') RETURNING *`);\n    if (b.rowCount === 0) return;   // already cancelled\n    // restore inventory for [check_in, check_out)\n    // UPDATE room_inventory SET booked_rooms = booked_rooms - $1 ...\n    if (bk.promo_id && returnCoupon) {\n      // CONSUMED -> REVERTED drops the row out of the partial\n      // unique index = gives the user their single use back\n      // then used_count = used_count - 1 WHERE used_count > 0\n    }\n  });\n  // refund AFTER commit, keyed idempotently - outside the tx\n  await payments.refund({ idempotencyKey: `refund:${bookingId}` });\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "async function cancelBooking(bookingId, { returnCoupon }) {\n  await db.transaction(async (tx) => {\n    // guarded transition: a 2nd cancel updates 0 rows\n    const b = await tx.query(\n      `UPDATE bookings SET status = 'CANCELLED'\n        WHERE id = $1 AND status IN\n          ('PENDING_PAYMENT','CONFIRMED') RETURNING *`);\n    if (b.rowCount === 0) return;   // already cancelled\n    // restore inventory for [check_in, check_out)\n    // UPDATE room_inventory SET booked_rooms = booked_rooms - $1 ...\n    if (bk.promo_id && returnCoupon) {\n      // CONSUMED -> REVERTED drops the row out of the partial\n      // unique index = gives the user their single use back\n      // then used_count = used_count - 1 WHERE used_count > 0\n    }\n  });\n  // refund AFTER commit, keyed idempotently - outside the tx\n  await payments.refund({ idempotencyKey: `refund:${bookingId}` });\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e779", "type": "rectangle", "x": 1220, "y": 12522.5, "width": 1120, "height": 136.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g117"], "frameId": null, "roundness": {"type": 3}, "seed": 563011104, "version": 1, "versionNonce": 1602963156, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e780", "type": "text", "x": 1234, "y": 12536.5, "width": 228.9, "height": 22.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g117"], "frameId": null, "roundness": null, "seed": 1538963539, "version": 1, "versionNonce": 1480856073, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Cancellation rules of thumb", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Cancellation rules of thumb", "autoResize": true, "lineHeight": 1.25}, {"id": "e781", "type": "text", "x": 1234, "y": 12565.0, "width": 759.3, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g117"], "frameId": null, "roundness": null, "seed": 679643414, "version": 1, "versionNonce": 1984764679, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "- Guarded status transition (WHERE status IN ...) makes cancel a no-op the second time.\n- Restore inventory over the half-open range [check_in, check_out).\n- Returning the coupon is a PRODUCT decision - both steps (REVERTED + used_count - 1) or neither.\n- Refund after COMMIT, never inside the transaction, with a derived idempotency key.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "- Guarded status transition (WHERE status IN ...) makes cancel a no-op the second time.\n- Restore inventory over the half-open range [check_in, check_out).\n- Returning the coupon is a PRODUCT decision - both steps (REVERTED + used_count - 1) or neither.\n- Refund after COMMIT, never inside the transaction, with a derived idempotency key.", "autoResize": true, "lineHeight": 1.25}, {"id": "e811", "type": "rectangle", "x": 0, "y": 13069.0, "width": 2400, "height": 795.5, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 531088847, "version": 1, "versionNonce": 875651005, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e783", "type": "rectangle", "x": 60, "y": 13109.0, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g118"], "frameId": null, "roundness": {"type": 3}, "seed": 8099487, "version": 1, "versionNonce": 1549564217, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e784", "type": "text", "x": 74, "y": 13116.0, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g118"], "frameId": null, "roundness": null, "seed": 1622751108, "version": 1, "versionNonce": 1278972873, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "10", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "10", "autoResize": true, "lineHeight": 1.25}, {"id": "e785", "type": "text", "x": 144, "y": 13111.0, "width": 314.5, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g118"], "frameId": null, "roundness": null, "seed": 1968082010, "version": 1, "versionNonce": 1730138133, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Follow-ups they ask", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Follow-ups they ask", "autoResize": true, "lineHeight": 1.25}, {"id": "e786", "type": "text", "x": 60, "y": 13171.0, "width": 797.1, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1361461764, "version": 1, "versionNonce": 2032566911, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "You mentioned there were more questions. These are the ones that follow this setup most often.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "You mentioned there were more questions. These are the ones that follow this setup most often.", "autoResize": true, "lineHeight": 1.25}, {"id": "e787", "type": "rectangle", "x": 60, "y": 13221.5, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g119"], "frameId": null, "roundness": {"type": 3}, "seed": 2025614272, "version": 1, "versionNonce": 140299621, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e788", "type": "text", "x": 74, "y": 13235.5, "width": 388.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g119"], "frameId": null, "roundness": null, "seed": 52090872, "version": 1, "versionNonce": 1773860857, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Q  What if two coupons could be combined?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  What if two coupons could be combined?", "autoResize": true, "lineHeight": 1.25}, {"id": "e789", "type": "text", "x": 74, "y": 13265.2, "width": 1061.4, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g119"], "frameId": null, "roundness": null, "seed": 502223970, "version": 1, "versionNonce": 230342033, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Stacking turns a value into a PIPELINE. Give each promo an apply_order and a stackable flag, sort the applicable set, and fold: each promo\ncomputes its discount against the running subtotal. Order changes the answer - 10% then INR 500 off is not INR 500 off then 10% - so the order\nmust be deterministic and stored, not incidental. Cap total stacked discount as a % of subtotal so a stacking bug cannot zero out a booking, and\nconsume every promo's counter inside the same transaction.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Stacking turns a value into a PIPELINE. Give each promo an apply_order and a stackable flag, sort the applicable set, and fold: each promo\ncomputes its discount against the running subtotal. Order changes the answer - 10% then INR 500 off is not INR 500 off then 10% - so the order\nmust be deterministic and stored, not incidental. Cap total stacked discount as a % of subtotal so a stacking bug cannot zero out a booking, and\nconsume every promo's counter inside the same transaction.", "autoResize": true, "lineHeight": 1.25}, {"id": "e790", "type": "rectangle", "x": 1220, "y": 13221.5, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g120"], "frameId": null, "roundness": {"type": 3}, "seed": 1020460722, "version": 1, "versionNonce": 1536677414, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e791", "type": "text", "x": 1234, "y": 13235.5, "width": 498.5, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g120"], "frameId": null, "roundness": null, "seed": 2054664354, "version": 1, "versionNonce": 1000177410, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Q  How do you generate a million unique coupon codes?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How do you generate a million unique coupon codes?", "autoResize": true, "lineHeight": 1.25}, {"id": "e792", "type": "text", "x": 1234, "y": 13265.2, "width": 1082.4, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g120"], "frameId": null, "roundness": null, "seed": 2048507369, "version": 1, "versionNonce": 1667213266, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Two different products. SHARED code (DIWALI20): one row, a global cap, the hot-row problem from section 06. UNIQUE per-user codes:\npre-generate offline into a promo_code_instances table, one row per code with max_redemptions = 1 - removes contention entirely at the cost of\nstorage and a generation job. Use a base32 alphabet with ambiguous characters removed (no O/0, I/1) plus a checksum digit so typos are rejected\nclient-side without a database hit.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Two different products. SHARED code (DIWALI20): one row, a global cap, the hot-row problem from section 06. UNIQUE per-user codes:\npre-generate offline into a promo_code_instances table, one row per code with max_redemptions = 1 - removes contention entirely at the cost of\nstorage and a generation job. Use a base32 alphabet with ambiguous characters removed (no O/0, I/1) plus a checksum digit so typos are rejected\nclient-side without a database hit.", "autoResize": true, "lineHeight": 1.25}, {"id": "e793", "type": "rectangle", "x": 60, "y": 13383.2, "width": 1120, "height": 117.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g121"], "frameId": null, "roundness": {"type": 3}, "seed": 830034190, "version": 1, "versionNonce": 1696080141, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e794", "type": "text", "x": 74, "y": 13397.2, "width": 621.1, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g121"], "frameId": null, "roundness": null, "seed": 539118929, "version": 1, "versionNonce": 1961820733, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Q  The hold expires while the user is on the payment page. Now what?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  The hold expires while the user is on the payment page. Now what?", "autoResize": true, "lineHeight": 1.25}, {"id": "e795", "type": "text", "x": 74, "y": 13427.0, "width": 1059.2, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g121"], "frameId": null, "roundness": null, "seed": 923285000, "version": 1, "versionNonce": 1749770220, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Return 410 Gone so the client can tell this apart from a generic conflict, and have it silently attempt a re-hold. If rooms are still available the user\nnever notices. If gone, show it honestly BEFORE payment rather than after. Bonus: a soft grace period - keep inventory reserved 60 s past\nexpires_at and only release if the sweeper sees no in-flight booking - absorbs a slow payment redirect.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Return 410 Gone so the client can tell this apart from a generic conflict, and have it silently attempt a re-hold. If rooms are still available the user\nnever notices. If gone, show it honestly BEFORE payment rather than after. Bonus: a soft grace period - keep inventory reserved 60 s past\nexpires_at and only release if the sweeper sees no in-flight booking - absorbs a slow payment redirect.", "autoResize": true, "lineHeight": 1.25}, {"id": "e796", "type": "rectangle", "x": 1220, "y": 13383.2, "width": 1120, "height": 117.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g122"], "frameId": null, "roundness": {"type": 3}, "seed": 1059727020, "version": 1, "versionNonce": 284986701, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e797", "type": "text", "x": 1234, "y": 13397.2, "width": 690.7, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g122"], "frameId": null, "roundness": null, "seed": 1993078332, "version": 1, "versionNonce": 1066312840, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Q  Prices are dynamic. What if the price changed between quote and booking?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  Prices are dynamic. What if the price changed between quote and booking?", "autoResize": true, "lineHeight": 1.25}, {"id": "e798", "type": "text", "x": 1234, "y": 13427.0, "width": 1088.5, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g122"], "frameId": null, "roundness": null, "seed": 392859018, "version": 1, "versionNonce": 18694226, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "The hold freezes the price - a large part of what a hold is FOR, alongside inventory. holds.quoted_total is the contract for its lifetime. At booking time\nrecompute from that frozen price, not live pricing. If the hold expired and re-holding produces a different price, surface the new total and require\nexplicit re-confirmation. Never charge a total the user did not see.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The hold freezes the price - a large part of what a hold is FOR, alongside inventory. holds.quoted_total is the contract for its lifetime. At booking time\nrecompute from that frozen price, not live pricing. If the hold expired and re-holding produces a different price, surface the new total and require\nexplicit re-confirmation. Never charge a total the user did not see.", "autoResize": true, "lineHeight": 1.25}, {"id": "e799", "type": "rectangle", "x": 60, "y": 13525.0, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g123"], "frameId": null, "roundness": {"type": 3}, "seed": 1723502341, "version": 1, "versionNonce": 1999428044, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e800", "type": "text", "x": 74, "y": 13539.0, "width": 246.9, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g123"], "frameId": null, "roundness": null, "seed": 1585890944, "version": 1, "versionNonce": 651363529, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Q  How would you test this?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How would you test this?", "autoResize": true, "lineHeight": 1.25}, {"id": "e801", "type": "text", "x": 74, "y": 13568.8, "width": 1076.9, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g123"], "frameId": null, "roundness": null, "seed": 1766853455, "version": 1, "versionNonce": 1486294770, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Three layers. UNIT: the discount engine is pure functions - cap, minimum, clamping, rounding at boundaries (zero booking, discount > subtotal,\n100% coupon). INTEGRATION against a real Postgres: fire N concurrent bookings for a coupon with max_redemptions = 1 and assert exactly one\nsucceeded - can not be written against a mock. PROPERTY test: for any random sequence of book/cancel, assert used_count == COUNT(*)\nWHERE status = CONSUMED and booked + held <= total hold at the end.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Three layers. UNIT: the discount engine is pure functions - cap, minimum, clamping, rounding at boundaries (zero booking, discount > subtotal,\n100% coupon). INTEGRATION against a real Postgres: fire N concurrent bookings for a coupon with max_redemptions = 1 and assert exactly one\nsucceeded - can not be written against a mock. PROPERTY test: for any random sequence of book/cancel, assert used_count == COUNT(*)\nWHERE status = CONSUMED and booked + held <= total hold at the end.", "autoResize": true, "lineHeight": 1.25}, {"id": "e802", "type": "rectangle", "x": 1220, "y": 13525.0, "width": 1120, "height": 117.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g124"], "frameId": null, "roundness": {"type": 3}, "seed": 1659595509, "version": 1, "versionNonce": 324946989, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e803", "type": "text", "x": 1234, "y": 13539.0, "width": 492.9, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g124"], "frameId": null, "roundness": null, "seed": 1304068530, "version": 1, "versionNonce": 507112187, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Q  Where does search fit - 10k QPS will not hit Postgres", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  Where does search fit - 10k QPS will not hit Postgres", "autoResize": true, "lineHeight": 1.25}, {"id": "e804", "type": "text", "x": 1234, "y": 13568.8, "width": 1086.4, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g124"], "frameId": null, "roundness": null, "seed": 703944729, "version": 1, "versionNonce": 1849503919, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Search leaves the OLTP database entirely: an Elasticsearch (or equivalent) index fed by CDC, holding hotel attributes, geo and a coarse availability\nbitmap. Eventually consistent, and that is acceptable because search results are ADVISORY - the authoritative check happens at POST /holds, the\nonly place that must be correct. The expensive path is approximate, the correct path is cheap and rare.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Search leaves the OLTP database entirely: an Elasticsearch (or equivalent) index fed by CDC, holding hotel attributes, geo and a coarse availability\nbitmap. Eventually consistent, and that is acceptable because search results are ADVISORY - the authoritative check happens at POST /holds, the\nonly place that must be correct. The expensive path is approximate, the correct path is cheap and rare.", "autoResize": true, "lineHeight": 1.25}, {"id": "e805", "type": "rectangle", "x": 60, "y": 13686.8, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g125"], "frameId": null, "roundness": {"type": 3}, "seed": 686225789, "version": 1, "versionNonce": 989520081, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e806", "type": "text", "x": 74, "y": 13700.8, "width": 142.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g125"], "frameId": null, "roundness": null, "seed": 777085082, "version": 1, "versionNonce": 1683268619, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Q  Multi-region?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  Multi-region?", "autoResize": true, "lineHeight": 1.25}, {"id": "e807", "type": "text", "x": 74, "y": 13730.5, "width": 1092.2, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g125"], "frameId": null, "roundness": null, "seed": 1679866128, "version": 1, "versionNonce": 1279292486, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Partition by geography, not by replicating writes. Hotels in India are served from an Indian primary; European hotels from an EU primary. A booking\ntouches one hotel, so it stays in one region - no cross-region transaction is ever needed. Search is global and replicated read-only. Promo codes are\nthe awkward case: a globally-capped coupon needs regional sub-caps (split-the-quota, as in a distributed rate limiter) or a single owning region for\nthat promo. Say which and why.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Partition by geography, not by replicating writes. Hotels in India are served from an Indian primary; European hotels from an EU primary. A booking\ntouches one hotel, so it stays in one region - no cross-region transaction is ever needed. Search is global and replicated read-only. Promo codes are\nthe awkward case: a globally-capped coupon needs regional sub-caps (split-the-quota, as in a distributed rate limiter) or a single owning region for\nthat promo. Say which and why.", "autoResize": true, "lineHeight": 1.25}, {"id": "e808", "type": "rectangle", "x": 1220, "y": 13666.8, "width": 1120, "height": 117.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g126"], "frameId": null, "roundness": {"type": 3}, "seed": 169683137, "version": 1, "versionNonce": 1099264208, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e809", "type": "text", "x": 1234, "y": 13680.8, "width": 422.7, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g126"], "frameId": null, "roundness": null, "seed": 423723845, "version": 1, "versionNonce": 841138003, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Q  How do you handle the last night of the stay?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How do you handle the last night of the stay?", "autoResize": true, "lineHeight": 1.25}, {"id": "e810", "type": "text", "x": 1234, "y": 13710.5, "width": 1056.6, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g126"], "frameId": null, "roundness": null, "seed": 1616809667, "version": 1, "versionNonce": 343462926, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "A stay from the 10th to the 13th occupies the nights of the 10th, 11th and 12th - THREE nights, not four. Every range is half-open: stay_date >=\ncheck_in AND stay_date < check_out. An off-by-one silently oversells or under-charges by one night, and reaches production because the tests\nused a one-night stay.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A stay from the 10th to the 13th occupies the nights of the 10th, 11th and 12th - THREE nights, not four. Every range is half-open: stay_date >=\ncheck_in AND stay_date < check_out. An off-by-one silently oversells or under-charges by one night, and reaches production because the tests\nused a one-night stay.", "autoResize": true, "lineHeight": 1.25}, {"id": "e860", "type": "rectangle", "x": 0, "y": 13984.5, "width": 2400, "height": 779.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#dbe4ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 407105307, "version": 1, "versionNonce": 1289549556, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e812", "type": "rectangle", "x": 60, "y": 14024.5, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g127"], "frameId": null, "roundness": {"type": 3}, "seed": 139013116, "version": 1, "versionNonce": 1394889415, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e813", "type": "text", "x": 74, "y": 14031.5, "width": 27.9, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g127"], "frameId": null, "roundness": null, "seed": 72721779, "version": 1, "versionNonce": 1034421200, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "11", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "11", "autoResize": true, "lineHeight": 1.25}, {"id": "e814", "type": "text", "x": 144, "y": 14026.5, "width": 324.3, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g127"], "frameId": null, "roundness": null, "seed": 1186687953, "version": 1, "versionNonce": 1169555288, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "The 45-minute script", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The 45-minute script", "autoResize": true, "lineHeight": 1.25}, {"id": "e815", "type": "text", "x": 60, "y": 14086.5, "width": 854.8, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 699560743, "version": 1, "versionNonce": 345084266, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "How to pace this specific question, given they asked DB -> schema -> API -> concurrency in that order.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "How to pace this specific question, given they asked DB -> schema -> API -> concurrency in that order.", "autoResize": true, "lineHeight": 1.25}, {"id": "e816", "type": "rectangle", "x": 60, "y": 14137.0, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 2105083233, "version": 1, "versionNonce": 916018305, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e817", "type": "text", "x": 69, "y": 14145.0, "width": 53.0, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1897247316, "version": 1, "versionNonce": 225961266, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Minutes", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Minutes", "autoResize": true, "lineHeight": 1.25}, {"id": "e818", "type": "text", "x": 219, "y": 14145.0, "width": 20.6, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 2121335527, "version": 1, "versionNonce": 154973255, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Do", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Do", "autoResize": true, "lineHeight": 1.25}, {"id": "e819", "type": "text", "x": 1219, "y": 14145.0, "width": 27.1, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 568849776, "version": 1, "versionNonce": 1341321677, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Say", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Say", "autoResize": true, "lineHeight": 1.25}, {"id": "e820", "type": "rectangle", "x": 60, "y": 14170.5, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 180566014, "version": 1, "versionNonce": 447408984, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e821", "type": "text", "x": 69, "y": 14179.5, "width": 24.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 207065911, "version": 1, "versionNonce": 904220064, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "0-4", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "0-4", "autoResize": true, "lineHeight": 1.25}, {"id": "e822", "type": "text", "x": 219, "y": 14179.5, "width": 338.0, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1070467473, "version": 1, "versionNonce": 2122641855, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Clarify. Land the \"two scarce resources\" framing.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Clarify. Land the \"two scarce resources\" framing.", "autoResize": true, "lineHeight": 1.25}, {"id": "e823", "type": "text", "x": 1219, "y": 14179.5, "width": 526.2, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1524221970, "version": 1, "versionNonce": 2087604613, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"Rooms and coupon redemptions are both inventory. Both can be oversold.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Rooms and coupon redemptions are both inventory. Both can be oversold.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e824", "type": "rectangle", "x": 60, "y": 14207.2, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 959845963, "version": 1, "versionNonce": 371926700, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e825", "type": "text", "x": 69, "y": 14216.2, "width": 24.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 502932735, "version": 1, "versionNonce": 285467489, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "4-7", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4-7", "autoResize": true, "lineHeight": 1.25}, {"id": "e826", "type": "text", "x": 219, "y": 14216.2, "width": 415.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 895158440, "version": 1, "versionNonce": 989826255, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Numbers, briefly. Show writes are small and search is huge.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Numbers, briefly. Show writes are small and search is huge.", "autoResize": true, "lineHeight": 1.25}, {"id": "e827", "type": "text", "x": 1219, "y": 14216.2, "width": 528.6, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1332100528, "version": 1, "versionNonce": 1913971775, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"500 bookings/sec peak - one Postgres. So I won't trade away transactions.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"500 bookings/sec peak - one Postgres. So I won't trade away transactions.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e828", "type": "rectangle", "x": 60, "y": 14244.0, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1447637241, "version": 1, "versionNonce": 504515446, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e829", "type": "text", "x": 69, "y": 14253.0, "width": 33.2, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1606268471, "version": 1, "versionNonce": 1156558653, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "7-12", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "7-12", "autoResize": true, "lineHeight": 1.25}, {"id": "e830", "type": "text", "x": 219, "y": 14253.0, "width": 241.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1818890887, "version": 1, "versionNonce": 1661881198, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "DB choice, with the invariant table.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "DB choice, with the invariant table.", "autoResize": true, "lineHeight": 1.25}, {"id": "e831", "type": "text", "x": 1219, "y": 14253.0, "width": 517.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1426842303, "version": 1, "versionNonce": 1631156948, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"Postgres, because every requirement here is a constraint spanning rows.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Postgres, because every requirement here is a constraint spanning rows.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e832", "type": "rectangle", "x": 60, "y": 14280.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 260199296, "version": 1, "versionNonce": 1674501642, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e833", "type": "text", "x": 69, "y": 14289.8, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1805757113, "version": 1, "versionNonce": 631195740, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "12-22", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "12-22", "autoResize": true, "lineHeight": 1.25}, {"id": "e834", "type": "text", "x": 219, "y": 14289.8, "width": 664.2, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 630892362, "version": 1, "versionNonce": 600000294, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Schema. Write the CHECK and UNIQUE constraints as you go and narrate what each prevents.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Schema. Write the CHECK and UNIQUE constraints as you go and narrate what each prevents.", "autoResize": true, "lineHeight": 1.25}, {"id": "e835", "type": "text", "x": 1219, "y": 14289.8, "width": 469.2, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1217374575, "version": 1, "versionNonce": 574808104, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"This unique index IS the once-per-user rule. No application check.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"This unique index IS the once-per-user rule. No application check.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e836", "type": "rectangle", "x": 60, "y": 14317.5, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 800949213, "version": 1, "versionNonce": 545582188, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e837", "type": "text", "x": 69, "y": 14326.5, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1584987739, "version": 1, "versionNonce": 559065266, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "22-28", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "22-28", "autoResize": true, "lineHeight": 1.25}, {"id": "e838", "type": "text", "x": 219, "y": 14326.5, "width": 393.6, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 427757468, "version": 1, "versionNonce": 943599519, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Discount engine + the API split between quote and book.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Discount engine + the API split between quote and book.", "autoResize": true, "lineHeight": 1.25}, {"id": "e839", "type": "text", "x": 1219, "y": 14326.5, "width": 482.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 531350006, "version": 1, "versionNonce": 398865925, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"Quoting has no side effects; booking consumes. Never merge them.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Quoting has no side effects; booking consumes. Never merge them.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e840", "type": "rectangle", "x": 60, "y": 14354.2, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 526864279, "version": 1, "versionNonce": 505741023, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e841", "type": "text", "x": 69, "y": 14363.2, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 329256913, "version": 1, "versionNonce": 604203320, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "28-36", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "28-36", "autoResize": true, "lineHeight": 1.25}, {"id": "e842", "type": "text", "x": 219, "y": 14363.2, "width": 473.5, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1898735925, "version": 1, "versionNonce": 1948987929, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "The three races. Guarded UPDATE, unique index, rowcount checks.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The three races. Guarded UPDATE, unique index, rowcount checks.", "autoResize": true, "lineHeight": 1.25}, {"id": "e843", "type": "text", "x": 1219, "y": 14363.2, "width": 438.5, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1241848476, "version": 1, "versionNonce": 404264090, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"No distributed lock anywhere. The WHERE clause is the lock.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"No distributed lock anywhere. The WHERE clause is the lock.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e844", "type": "rectangle", "x": 60, "y": 14391.0, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 700805345, "version": 1, "versionNonce": 139165732, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e845", "type": "text", "x": 69, "y": 14400.0, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 850552987, "version": 1, "versionNonce": 540422298, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "36-41", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "36-41", "autoResize": true, "lineHeight": 1.25}, {"id": "e846", "type": "text", "x": 219, "y": 14400.0, "width": 401.5, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 2131267423, "version": 1, "versionNonce": 528171948, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Double-submit: idempotency key, in the same transaction.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Double-submit: idempotency key, in the same transaction.", "autoResize": true, "lineHeight": 1.25}, {"id": "e847", "type": "text", "x": 1219, "y": 14400.0, "width": 554.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1089471102, "version": 1, "versionNonce": 1130239437, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"The key comes from the client, once per intent. That's what makes retries free.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"The key comes from the client, once per intent. That's what makes retries free.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e848", "type": "rectangle", "x": 60, "y": 14427.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 496886794, "version": 1, "versionNonce": 1395092684, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e849", "type": "text", "x": 69, "y": 14436.8, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1736117890, "version": 1, "versionNonce": 215913249, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "41-45", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "41-45", "autoResize": true, "lineHeight": 1.25}, {"id": "e850", "type": "text", "x": 219, "y": 14436.8, "width": 453.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1403008090, "version": 1, "versionNonce": 996251367, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Failure: the payment saga, the reconciliation worker, cancellation.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Failure: the payment saga, the reconciliation worker, cancellation.", "autoResize": true, "lineHeight": 1.25}, {"id": "e851", "type": "text", "x": 1219, "y": 14436.8, "width": 389.4, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 2128061066, "version": 1, "versionNonce": 79506594, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "\"Never call the payment provider inside the transaction.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Never call the payment provider inside the transaction.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e852", "type": "line", "x": 210, "y": 14137.0, "width": 0, "height": 327.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 219757212, "version": 1, "versionNonce": 9646716, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 327.5]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e853", "type": "line", "x": 1210, "y": 14137.0, "width": 0, "height": 327.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1019545261, "version": 1, "versionNonce": 1895852301, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 327.5]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e854", "type": "rectangle", "x": 60, "y": 14504.5, "width": 1120, "height": 219.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g129"], "frameId": null, "roundness": {"type": 3}, "seed": 1759009670, "version": 1, "versionNonce": 496312590, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e855", "type": "text", "x": 74, "y": 14518.5, "width": 321.1, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g129"], "frameId": null, "roundness": null, "seed": 1805081041, "version": 1, "versionNonce": 962710805, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Six sentences that carry this round", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Six sentences that carry this round", "autoResize": true, "lineHeight": 1.25}, {"id": "e856", "type": "text", "x": 74, "y": 14549.5, "width": 1059.3, "height": 160.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g129"], "frameId": null, "roundness": null, "seed": 1963606558, "version": 1, "versionNonce": 802893227, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "1.  \"There are two scarce resources here - rooms and redemptions - and a booking consumes both atomically or neither.\"\n2.  \"Postgres, because my invariants are cross-row constraints and it enforces them declaratively; anywhere else I'd hand-roll them and the\nhand-rolled version is where the race lives.\"\n3.  \"Store used_count and the cap separately, not a remaining counter - so the cap can change without racing consumption, and the count stays\nauditable.\"\n4.  \"I won't SELECT then check. I'll attempt a guarded UPDATE and look at the rowcount - that's atomic in one statement.\"\n5.  \"Double-click is just the visible case of duplicate delivery. The fix is idempotency, and the key has to be client-generated per intent.\"\n6.  \"The promo row is hot during a sale. I keep all network I/O out of the transaction, and if that's not enough, I shard the counter.\"", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1.  \"There are two scarce resources here - rooms and redemptions - and a booking consumes both atomically or neither.\"\n2.  \"Postgres, because my invariants are cross-row constraints and it enforces them declaratively; anywhere else I'd hand-roll them and the\nhand-rolled version is where the race lives.\"\n3.  \"Store used_count and the cap separately, not a remaining counter - so the cap can change without racing consumption, and the count stays\nauditable.\"\n4.  \"I won't SELECT then check. I'll attempt a guarded UPDATE and look at the rowcount - that's atomic in one statement.\"\n5.  \"Double-click is just the visible case of duplicate delivery. The fix is idempotency, and the key has to be client-generated per intent.\"\n6.  \"The promo row is hot during a sale. I keep all network I/O out of the transaction, and if that's not enough, I shard the counter.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e857", "type": "rectangle", "x": 1220, "y": 14504.5, "width": 1120, "height": 111.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g130"], "frameId": null, "roundness": {"type": 3}, "seed": 86676434, "version": 1, "versionNonce": 1883090157, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e858", "type": "text", "x": 1234, "y": 14518.5, "width": 281.7, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g130"], "frameId": null, "roundness": null, "seed": 630667555, "version": 1, "versionNonce": 500133222, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "WHAT THEY WERE PROBABLY TESTING", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHAT THEY WERE PROBABLY TESTING", "autoResize": true, "lineHeight": 1.25}, {"id": "e859", "type": "text", "x": 1234, "y": 14542.0, "width": 1091.0, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g130"], "frameId": null, "roundness": null, "seed": 256015772, "version": 1, "versionNonce": 108214202, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "This question has a specific shape: it looks like a schema question, and it is actually a concurrency question wearing a schema's clothes. Every field\nthey listed - expiry, max discount, currentAvailable, once per user - is a CONSTRAINT, and the interesting part of each one is what happens when\ntwo requests hit it at the same instant. If you spent the round drawing tables and never said the word \"atomic\", that is the gap worth closing.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "This question has a specific shape: it looks like a schema question, and it is actually a concurrency question wearing a schema's clothes. Every field\nthey listed - expiry, max discount, currentAvailable, once per user - is a CONSTRAINT, and the interesting part of each one is what happens when\ntwo requests hit it at the same instant. If you spent the round drawing tables and never said the word \"atomic\", that is the gap worth closing.", "autoResize": true, "lineHeight": 1.25}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}