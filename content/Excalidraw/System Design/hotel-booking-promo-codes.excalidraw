s": 1, "opacity": 100, "groupIds": ["g101"], "frameId": null, "roundness": null, "seed": 652367431, "version": 1, "versionNonce": 2066813208, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "POST /v1/quotes - request", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "POST /v1/quotes - request", "autoResize": true, "lineHeight": 1.25}, {"id": "e669", "type": "text", "x": 74, "y": 10843.5, "width": 522.8, "height": 280.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g101"], "frameId": null, "roundness": null, "seed": 274806713, "version": 1, "versionNonce": 1345339959, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "{\n  \"holdId\": \"5f3c...-ab21\",\n  \"promoCode\": \"DIWALI20\"   // optional; omit for base price\n}\n\n// <-- 200, promo valid\n{ \"currency\": \"INR\", \"nights\": 3, \"rooms\": 2,\n  \"lineItems\": [{ \"label\": \"Deluxe King x 2 x 3 nights\",\n                  \"amountMinor\": 4200000 }],\n  \"subtotalMinor\": 4200000,   // INR 42,000.00 - integers\n  \"discountMinor\":  840000,   // 20% capped at 10,000 -> 8,400\n  \"taxMinor\":       604800,\n  \"totalMinor\":    3964800,\n  \"promo\": { \"code\": \"DIWALI20\", \"applied\": true,\n             \"savedMinor\": 840000 },\n  \"holdExpiresAt\": \"2026-08-24T14:32:10Z\" }", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "{\n  \"holdId\": \"5f3c...-ab21\",\n  \"promoCode\": \"DIWALI20\"   // optional; omit for base price\n}\n\n// <-- 200, promo valid\n{ \"currency\": \"INR\", \"nights\": 3, \"rooms\": 2,\n  \"lineItems\": [{ \"label\": \"Deluxe King x 2 x 3 nights\",\n                  \"amountMinor\": 4200000 }],\n  \"subtotalMinor\": 4200000,   // INR 42,000.00 - integers\n  \"discountMinor\":  840000,   // 20% capped at 10,000 -> 8,400\n  \"taxMinor\":       604800,\n  \"totalMinor\":    3964800,\n  \"promo\": { \"code\": \"DIWALI20\", \"applied\": true,\n             \"savedMinor\": 840000 },\n  \"holdExpiresAt\": \"2026-08-24T14:32:10Z\" }", "autoResize": true, "lineHeight": 1.25}, {"id": "e670", "type": "rectangle", "x": 800, "y": 10803.5, "width": 700, "height": 264.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g102"], "frameId": null, "roundness": {"type": 3}, "seed": 540723384, "version": 1, "versionNonce": 1134414978, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e671", "type": "text", "x": 814, "y": 10817.5, "width": 319.2, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g102"], "frameId": null, "roundness": null, "seed": 1366424734, "version": 1, "versionNonce": 939374902, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "200 - promo REJECTED (still 200, not 4xx)", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "200 - promo REJECTED (still 200, not 4xx)", "autoResize": true, "lineHeight": 1.25}, {"id": "e672", "type": "text", "x": 814, "y": 10843.5, "width": 464.0, "height": 210.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g102"], "frameId": null, "roundness": null, "seed": 1500193234, "version": 1, "versionNonce": 1640342610, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "// The quote itself succeeded; the coupon just does not\n// apply. A 4xx would make the client treat a valid\n// price as an error.\n{ \"subtotalMinor\": 4200000,\n  \"discountMinor\": 0,\n  \"totalMinor\":    4956000,\n  \"promo\": {\n    \"code\": \"DIWALI20\",\n    \"applied\": false,\n    \"rejectionCode\": \"ORDER_BELOW_MINIMUM\",\n    \"message\": \"Applies to bookings over INR 50,000\"\n  } }", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "// The quote itself succeeded; the coupon just does not\n// apply. A 4xx would make the client treat a valid\n// price as an error.\n{ \"subtotalMinor\": 4200000,\n  \"discountMinor\": 0,\n  \"totalMinor\":    4956000,\n  \"promo\": {\n    \"code\": \"DIWALI20\",\n    \"applied\": false,\n    \"rejectionCode\": \"ORDER_BELOW_MINIMUM\",\n    \"message\": \"Applies to bookings over INR 50,000\"\n  } }", "autoResize": true, "lineHeight": 1.25}, {"id": "e673", "type": "text", "x": 1540, "y": 10801.5, "width": 293.4, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 240803115, "version": 1, "versionNonce": 213556057, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Status codes worth getting right", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Status codes worth getting right", "autoResize": true, "lineHeight": 1.25}, {"id": "e674", "type": "rectangle", "x": 1540, "y": 10837.5, "width": 800, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "