 "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": {"type": 3}, "seed": 1587060216, "version": 1, "versionNonce": 1586443402, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e595", "type": "text", "x": 1234, "y": 9762.8, "width": 300.8, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": null, "seed": 2096580069, "version": 1, "versionNonce": 1401915610, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "DETAIL 2 - WHERE THE KEY COMES FROM", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "DETAIL 2 - WHERE THE KEY COMES FROM", "autoResize": true, "lineHeight": 1.25}, {"id": "e596", "type": "text", "x": 1234, "y": 9786.2, "width": 1092.5, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": null, "seed": 558708797, "version": 1, "versionNonce": 872327757, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "If the server generates it, every request gets a new one and it does nothing. It must be generated CLIENT-SIDE, ONCE PER BOOKING INTENT -\nwhen the form opens, not when the button is clicked - so all retries of that intent carry the same value. A double-click then sends the same key twice.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "If the server generates it, every request gets a new one and it does nothing. It must be generated CLIENT-SIDE, ONCE PER BOOKING INTENT -\nwhen the form opens, not when the button is clicked - so all retries of that intent carry the same value. A double-click then sends the same key twice.", "autoResize": true, "lineHeight": 1.25}, {"id": "e597", "type": "text", "x": 60, "y": 9870.2, "width": 384.8, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1408739247, "version": 1, "versionNonce": 512529239, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Defence in depth - the layers, in order", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Defence in depth - the layers, in order", "autoResize": true, "lineHeight": 1.25}, {"id": "e598", "type": "rectangle", "x": 60, "y": 9910.2, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": null, "seed": 646041018, "version": 1, "versionNonce": 1037625491, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e599", "type": "text", "x": 69, "y": 9918.2, "width": 38.4, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": null, "seed": 1196839237, "version": 1, "versionNonce": 1436400256, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Layer", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Layer", "autoResize": t