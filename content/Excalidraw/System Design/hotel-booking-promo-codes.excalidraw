true, "lineHeight": 1.25}, {"id": "e442", "type": "rectangle", "x": 800, "y": 6184.5, "width": 780, "height": 35.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g64"], "frameId": null, "roundness": null, "seed": 1887832895, "version": 1, "versionNonce": 1281101364, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e443", "type": "text", "x": 809, "y": 6193.5, "width": 10.1, "height": 17.5, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g64"], "frameId": null, "roundness": null, "seed": 836480251, "version": 1, "versionNonce": 1641346117, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "9", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "9", "autoResize": true, "lineHeight": 1.25}, {"id": "e444", "type": "text", "x": 859, "y": 6193.5, "width": 174.9, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g64"], "frameId": null, "roundness": null, "seed": 700369045, "version": 1, "versionNonce": 1547642646, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "subtotal >= minOrderValue", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "subtotal >= minOrderValue", "autoResize": true, "lineHeight": 1.25}, {"id": "e445", "type": "text", "x": 1259, "y": 6193.5, "width": 188.9, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g64"], "frameId": null, "roundness": null, "seed": 2114689613, "version": 1, "versionNonce": 1061266563, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "ORDER_BELOW_MINIMUM", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ORDER_BELOW_MINIMUM", "autoResize": true, "lineHeight": 1.25}, {"id": "e446", "type": "line", "x": 850, "y": 5867.0, "width": 0, "height": 353.0, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g64"], "frameId": null, "roundness": null, "seed": 320969677, "version": 1, "versionNonce": 610264552, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 353.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e447", "type": "line", "x": 1250, "y": 5867.0, "width": 0, "height": 353.0, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g64"], "frameId": null, "roundness": null, "seed": 1555112682, "version": 1, "versionNonce": 1328663531, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "points": [[0, 0.0], [0, 353.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e448", "type": "rectangle", "x": 800, "y": 6240.0, "width": 780, "height": 65.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g65"], "frameId": null, "roundness": {"type": 3}, "seed": 1381303259, "version": 1, "versionNonce": 310853019, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e449", "type": "text", "x": 814, "y": 6254.0, "width": 690.5, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g65"], "frameId": null, "roundness": null, "seed": 94034160, "version": 1, "versionNonce": 1771367215, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Adding a rule later (new-users-only, weekday-only) is one array entry. Validation is pure: no I/O, fully\nunit-testable.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Adding a rule later (new-users-only, weekday-only) is one array entry. Validation is pure: no I/O, fully\nunit-testable.", "autoResize": true, "lineHeight": 1.25}, {"id": "e450", "type": "rectangle", "x": 1620, "y": 5777.0, "width": 720, "height": 456.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g66"], "frameId": null, "roundness": {"type": 3}, "seed": 1793770640, "version": 1, "versionNonce": 1535474426, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e451", "type": "text", "x": 1634, "y": 5791.0, "width": 239.7, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g66"], "frameId": null, "roundness": null, "seed": 1915431631, "version": 1, "versionNonce": 1101618755, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "promo/engine.js - pure functions", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "promo/engine.js - pure functions", "autoResize": true, "lineHeight": 1.25}, {"id": "e452", "type": "text", "x": 1634, "y": 5817.0, "width": 514.4, "height": 402.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g66"], "frameId": null, "roundness": null, "seed": 1347185481, "version": 1, "versionNonce": 921795984, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "function computeDiscount(promo, subtotalMinor) {\n  let off = promo.discountType === 'PERCENT'\n    ? Math.floor((subtotalMinor * promo.percentBps) / 10_000)\n    : promo.fixedAmountMinor;\n  if (promo.maxDiscountMinor != null)\n    off = Math.min(off, promo.maxDiscountMinor);\n  // clamp: INR 500 off on INR 300 booking = 300\n  return Math.max(0, Math.min(off, subtotalMinor));\n}\n\nfunction quote({promo, subtotalMinor, currency,\n                stay, now, userUses, taxBps}) {\n  const v = validate({promo, subtotalMinor,\n                      currency, stay, now, userUses});\n  const discount = v.valid\n    ? computeDiscount(promo, subtotalMinor) : 0;\n  const taxable = subtotalMinor - discount;\n  const tax = Math.round(taxable * taxBps / 10_000);\n  return { subtotalMinor, discountMinor: discount,\n           taxMinor: tax, totalMinor: taxable + tax,\n           promoApplied: v.valid,\n           rejectionCode: v.valid ? null : v.reason };\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "function computeDiscount(promo, subtotalMinor) {\n  let off = promo.discountType === 'PERCENT'\n    ? Math.floor((subtotalMinor * promo.percentBps) / 10_000)\n    : promo.fixedAmountMinor;\n  if (promo.maxDiscountMinor != null)\n    off = Math.min(off, promo.maxDiscountMinor);\n  // clamp: INR 500 off on INR 300 booking = 300\n  return Math.max(0, Math.min(off, subtotalMinor));\n}\n\nfunction quote({promo, subtotalMinor, currency,\n                stay, now, userUses, taxBps}) {\n  const v = validate({promo, subtotalMinor,\n                      currency, stay, now, userUses});\n  const discount = v.valid\n    ? computeDiscount(promo, subtotalMinor) : 0;\n  const taxable = subtotalMinor - discount;\n  const tax = Math.round(taxable * taxBps / 10_000);\n  return { subtotalMinor, discountMinor: discount,\n           taxMinor: tax, totalMinor: taxable + tax,\n           promoApplied: v.valid,\n           rejectionCode: v.valid ? null : v.reason };\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e453", "type": "rectangle", "x": 60, "y": 6527.0, "width": 733, "height": 131.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g67"], "frameId": null, "roundness": {"type": 3}, "seed": 1575935438, "version": 1, "versionNonce": 1505500479, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e454", "type": "text", "x": 74, "y": 6541.0, "width": 213.2, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g67"], "frameId": null, "roundness": null, "seed": 1744226846, "version": 1, "versionNonce": 1085641114, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "ROUNDING POLICY - STATE IT", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ROUNDING POLICY - STATE IT", "autoResize": true, "lineHeight": 1.25}, {"id": "e455", "type": "text", "x": 74, "y": 6564.5, "width": 697.8, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g67"], "frameId": null, "roundness": null, "seed": 299160814, "version": 1, "versionNonce": 1953968849, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Math.floor on the discount rounds in the merchant's favour; Math.round on tax matches most\ntax authorities. What matters is that the policy is declared and IDENTICAL everywhere - quote,\nbooking, invoice, refund. If quote floors and booking rounds you get a one-paisa mismatch\nfinance will find and nobody can explain.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Math.floor on the discount rounds in the merchant's favour; Math.round on tax matches most\ntax authorities. What matters is that the policy is declared and IDENTICAL everywhere - quote,\nbooking, invoice, refund. If quote floors and booking rounds you get a one-paisa mismatch\nfinance will find and nobody can explain.", "autoResize": true, "lineHeight": 1.25}, {"id": "e456", "type": "rectangle", "x": 833, "y": 6527.0, "width": 733, "height": 131.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g68"], "frameId": null, "roundness": {"type": 3}, "seed": 1124760195, "version": 1, "versionNonce": 1616769911, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e457", "type": "text", "x": 847, "y": 6541.0, "width": 205.6, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g68"], "frameId": null, "roundness": null, "seed": 1083128588, "version": 1, "versionNonce": 1220800418, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "RECOMPUTE, NEVER TRUST", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RECOMPUTE, NEVER TRUST", "autoResize": true, "lineHeight": 1.25}, {"id": "e458", "type": "text", "x": 847, "y": 6564.5, "width": 663.1, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g68"], "frameId": null, "roundness": null, "seed": 1793014830, "version": 1, "versionNonce": 1745701031, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "The client sends {holdId, promoCode}, never {discount: 5000}. The server recomputes the\nentire quote at booking time from the frozen hold price. If the client could send a discount\namount, the coupon system is a free-money endpoint. Say this even if nobody asks -\ninterviewers listen for it.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The client sends {holdId, promoCode}, never {discount: 5000}. The server recomputes the\nentire quote at booking time from the frozen hold price. If the client could send a discount\namount, the coupon system is a free-money endpoint. Say this even if nobody asks -\ninterviewers listen for it.", "autoResize": true, "lineHeight": 1.25}, {"id": "e459", "type": "rectangle", "x": 1606, "y": 6527.0, "width": 733, "height": 111.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g69"], "frameId": null, "roundness": {"type": 3}, "seed": 1728032015, "version": 1, "versionNonce": 34531019, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false}, {"id": "e460", "type": "text", "x": 1620, "y": 6541.0, "width": 303.2, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g69"], "frameId": null, "roundness": null, "seed": 1774700067, "version": 1, "versionNonce": 1474186837, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "MONEY IS ALWAYS INTEGER MINOR UNITS", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "MONEY IS ALWAYS INTEGER MINOR UNITS", "autoResize": true, "lineHeight": 1.25}, {"id": "e461", "type": "text", "x": 1620, "y": 6564.5, "width": 700.8, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g69"], "frameId": null, "roundness": null, "seed": 1254262545, "version": 1, "versionNonce": 1713621484, "isDeleted": false, "boundElements": null, "updated": 1792010425260, "link": null, "locked": false, "text": "Never a float. 0.1 + 0.2 !== 0.3, and on a booking flow that difference is a support ticket and a\nreconciliation break. Percentages are basis points (1500 = 15%); the clamp line is what stops a\nnegative total from refunding a stranger.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Never a float. 0.1 + 0.2 !== 0.3, and on a booking flow that difference is a support ticket and a\nreconciliation break. Percentages are basis points (1500 = 15%); the clamp line is what stops a\nnegative total from r