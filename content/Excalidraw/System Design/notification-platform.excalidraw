"type": "rectangle", "x": 60, "y": 919.0, "width": 2280, "height": 71.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g20"], "frameId": null, "roundness": {"type": 3}, "seed": 611164248, "version": 1, "versionNonce": 1538946474, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e77", "type": "text", "x": 74, "y": 933.0, "width": 145.8, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g20"], "frameId": null, "roundness": null, "seed": 828480808, "version": 1, "versionNonce": 1904904517, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "SAY THIS OUT LOUD", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "SAY THIS OUT LOUD", "autoResize": true, "lineHeight": 1.25}, {"id": "e78", "type": "text", "x": 74, "y": 956.5, "width": 1424.3, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g20"], "frameId": null, "roundness": null, "seed": 1435920784, "version": 1, "versionNonce": 745188127, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "\"Exactly-once delivery is an illusion. What I build is at-least-once delivery with idempotent receivers on both sides, and every guarantee I state has an owner who can prove it from the audit trail.\"", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Exactly-once delivery is an illusion. What I build is at-leas