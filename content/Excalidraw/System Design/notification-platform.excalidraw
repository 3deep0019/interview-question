ents": null, "updated": 1792011952237, "link": null, "locked": false, "text": "step-up.js   -   claim names vary by identity provider", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "step-up.js   -   claim names vary by identity provider", "autoResize": true, "lineHeight": 1.25}, {"id": "e1714", "type": "text", "x": 74, "y": 28628.0, "width": 1068.8, "height": 157.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g336"], "frameId": null, "roundness": null, "seed": 1265573614, "version": 1, "versionNonce": 433511736, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "function requireStepUp({ maxAgeSec = 300 } = {}) {\n  return (req, res, next) => {\n    const { amr = [], auth_time } = req.session.claims;               // from the IdP token\n    const fresh  = Date.now() / 1000 - auth_time <= maxAgeSec;\n    const strong = amr.includes('mfa') && (amr.includes('hwk') || amr.includes('swk'));  // phishing-resistant key, not SMS OTP\n    if (fresh && strong) return next();\n    return res.status(401).set('WWW-Authenticate', 'step-up').json({ error: 'step_up_required' });\n  };\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "function requireStepUp({ maxAgeSec = 300 } = {}) {\n  return (req, res, next) => {\n    const { amr = [], auth_time } = req.session.claims;               // from the IdP token\n    const fresh  = Date.now() / 1000 - auth_time <= maxAgeSec;\n    const strong = amr.includes('mfa') && (amr.includes('hwk') || amr.includes('swk'));  // phishing-resistant key, not SMS OTP\n    if (fresh && strong) return next();\n    return res.status(401).set('WWW-Authenticate', 'step-up').json({ error: 'step_up_required' });\n  };\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e1715", "type": "text", "x": 1220, "y": 28588.0, "width": 417.1, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 406199598, "version": 1, "versionNonce": 456756135, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Step-up check - fresh AND phishing-resistant", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Step-up check - fresh AND phishing-resistant", "autoResize": true, "lineHeight": 1.25}, {"id": "e1716", "type": "rectangle", "x": 1220, "y": 28627.0, "width": 1120, "height": 380, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g337"], "frameId": null, "roundness": {"type": 3}, "seed": 412991253, "version": 1, "versionNonce": 197972974, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1717", "type": "rectangle", "x": 1244, "y": 28667.0, "width": 300, "height": 130, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g338"], "frameId": null, "roundness": {"type": 3}, "seed": 388035844, "version": 1, "versionNonce": 1730581782, "isDeleted": false, "boundElements": [{"id": "e1729", "type": "arrow"}], "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1718", "type": "text", "x": 1255, "y": 28700.9, "width": 278, "height": 21.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "