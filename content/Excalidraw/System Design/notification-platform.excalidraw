1792011952237, "link": null, "locked": false, "text": "The classic mistake", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The classic mistake", "autoResize": true, "lineHeight": 1.25}, {"id": "e525", "type": "rectangle", "x": 60, "y": 8010.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 450621989, "version": 1, "versionNonce": 1968286391, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e526", "type": "text", "x": 69, "y": 8019.8, "width": 96.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 2030633203, "version": 1, "versionNonce": 1998310963, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Inbox dedupe", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Inbox dedupe", "autoResize": true, "lineHeight": 1.25}, {"id": "e527", "type": "text", "x": 449, "y": 8019.8, "width": 324.6, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 452493697, "version": 1, "versionNonce": 160229907, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Duplicate bus messages and partner callbacks", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Duplicate bus messages and partner callbacks", "autoResize": true, "lineHeight": 1.25}, {"id": "e528", "type": "text", "x": 1069, "y": 8019.8, "width": 294.5, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 1248702408, "version": 1, "versionNonce": 193924423, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Postgres unique key, same tx as the effect", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Postgres unique key, same tx as the effect", "autoResize": true, "lineHeight": 1.25}, {"id": "e529", "type": "text", "x": 1689, "y": 8019.8, "width": 297.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 304385788, "version": 1, "versionNonce": 1605214350, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Check-then-insert, or dedupe in Redis only", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Check-then-insert, or dedupe in Redis only", "autoResize": true, "lineHeight": 1.25}, {"id": "e530", "type": "rectangle", "x": 60, "y": 8047.5, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 1125422555, "version": 1, "versionNonce": 562230468, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e531", "type": "text", "x": 69, "y": 8056.5, "width": 87.0, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 2045994298, "version": 1, "versionNonce": 772135432, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Retry ladder", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Retry ladder", "autoResize": true, "lineHeight": 1.25}, {"id": "e532", "type": "text", "x": 449, "y": 8056.5, "width": 292.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 284767218, "version": 1, "versionNonce": 1295718059, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Transient partner failure, thundering herds", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Transient partner failure, thundering herds", "autoResize": true, "lineHeight": 1.25}, {"id": "e533", "type": "text", "x": 1069, "y": 8056.5, "width": 205.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 1761402624, "version": 1, "versionNonce": 1356497132, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Delivery table + worker policy", "fontSize": 15, "fontFamily": 2,