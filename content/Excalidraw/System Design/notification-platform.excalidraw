kgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 2011313669, "version": 1, "versionNonce": 1721214107, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0.0, 0.0], [0.0, 100.0], [290.0, 100.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e1070", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e1082", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1089", "type": "text", "x": 407.8, "y": 17129.3, "width": 74.4, "height": 17.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 523101812, "version": 1, "versionNonce": 1519285880, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "explicit call", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "explicit call", "autoResize": true, "lineHeight": 1.25}, {"id": "e1090", "type": "arrow", "x": 1150, "y": 17150.8, "width": 100, "height": 0.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 320647401, "version": 1, "versionNonce": 968199666, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [100, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e1082", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e1085", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1091", "type": "rectangle", "x": 1750, "y": 16920.8, "width": 540, "height": 290, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": ["g225"], "frameId": null, "roundness": {"type": 3}, "seed": 205738974, "version": 1, "versionNonce": 136727366, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1092", "type": "text", "x": 1761, "y": 17032.8, "width": 518, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g225"], "frameId": null, "roundness": null, "seed": 1370545746, "version": 1, "versionNonce": 310722898, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Canary test (finds what review cannot)", "fontSize": 18, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Canary test (finds what review cannot)", "autoResize": true, "lineHeight": 1.25}, {"id": "e1093", "type": "text", "x": 1761, "y": 17061.2, "width": 518, "height": 37.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g225"], "frameId": null, "roundness": null, "seed": 1871071581, "version": 1, "versionNonce": 1429091340, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "seed unique canary PANs into test traffic and grep every sink - logs,\ntraces, DLQ, FCM capture, webhook capture, audit store - for them", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "seed unique canary PANs into test traffic and grep every sink - logs,\ntraces, DLQ, FCM capture, webhook capture, audit store - for them", "autoResize": true, "lineHeight": 1.25}, {"id": "e1094", "type": "rectangle", "x": 60, "y": 17280.8, "width": 1120, "height": 596.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g226"], "frameId": null, "roundness": {"type": 3}, "seed": 1679667509, "version": 1, "versionNonce": 579305494, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1095", "type": "text", "x": 74, "y": 17294.8, "width": 35.3, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g226"], "frameId": null, "roundness": null, "seed": 863187255, "version": 1, "versionNonce": 1742834433, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "pii.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "pii.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e1096", "type": "text", "x": 74, "y": 17320.8, "width": 1077.2, "height": 542.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g226"], "frameId": null, "roundness": null, "seed": 567450723, "version": 1, "versionNonce": 2076907458, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "const MASKERS = {\n  pan:     v => v.replace(/^([A-Z]{5})\\d{4}([A-Z])$/, '$1****$2'),          // ABCDE1234F -> ABCDE****F\n  phone:   v => 'XXXXXX' + v.replace(/\\D/g, '').slice(-4),                    // last 4 only\n  account: v => 'X'.repeat(Math.max(0, v.length - 4)) + v.slice(-4),\n};\n\nclass Pii {\n  #kind; #value;\n  constructor(kind, value) { this.#kind = kind; this.#value = value; }\n\n  masked()   { return MASKERS[this.#kind](this.#value); }\n  toString() { return this.masked(); }\n  toJSON()   { return this.masked(); }\n  [Symbol.for('nodejs.util.inspect.custom')]() { return this.masked(); }\n\n  /** The only road to the raw value: needs a purpose and an actor, and leaves an audit record. */\n  async reveal({ purpose, actor, audit }) {\n    await audit.record({ kind: 'pii_reveal', field: this.#kind, purpose, actor });\n    return this.#value;\n  }\n}\n\n/** Allowlist, never denylist: an unknown field is redacted by default. */\nfunction safeLog(logger, level, msg, fields, allowed) {\n  const out = {};\n  for (const [k, v] of Object.entries(fields)) out[k] = allowed.has(k) ? v : '[redacted]';\n  logger[level](out, msg);\n}\n\n/** DETECTIVE control only: scan log sinks and DLQs offline and alert. Never the primary defence. */\nconst DETECTORS = [/\\b[A-Z]{5}\\d{4}[A-Z]\\b/, /\\b[6-9]\\d{9}\\b/];   // PAN, Indian mobile. Account numbers are too noisy to regex.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "const MASKERS = {\n  pan:     v => v.replace(/^([A-Z]{5})\\d{4}([A-Z])$/, '$1****$2'),          // ABCDE1234F -> ABCDE****F\n  phone:   v => 'XXXXXX' + v.replace(/\\D/g, '').slice(-4),                    // last 4 only\n  account: v => 'X'.repeat(Math.max(0, v.length - 4)) + v.slice(-4),\n};\n\nclass Pii {\n  #kind; #value;\n  constructor(kind, value) { this.#kind = kind; this.#value = value; }\n\n  masked()   { return MASKERS[this.#kind](this.#value); }\n  toString() { return this.masked(); }\n  toJSON()   { return this.masked(); }\n  [Symbol.for('nodejs.util.inspect.custom')]() { return this.masked(); }\n\n  /** The only road to the raw value: needs a purpose and an actor, and leaves an audit record. */\n  async reveal({ purpose, actor, audit }) {\n    await audit.record({ kind: 'pii_reveal', field: this.#kind, purpose, actor });\n    return this.#value;\n  }\n}\n\n/** Allowlist, never denylist: an unknown field is redacted by default. */\nfunction safeLog(logger, level, msg, fields, allowed) {\n  const out = {};\n  for (const [k, v] of Object.entries(fields)) out[k] = allowed.has(k) ? v : '[redacted]';\n  logger[level](out, msg);\n}\n\n/** DETECTIVE control only: scan log sinks and DLQs offline and alert. Never the primary defence. */\nconst DETECTORS = [/\\b[A-Z]{5}\\d{4}[A-Z]\\b/, /\\b[6-9]\\d{9}\\b/];   // PAN, Indian mobile. Account numbers are too noisy to regex.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1097", "type": "rectangle", "x": 1220, "y": 17280.8, "width": 1120, "height": 131.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g227"], "frameId": null, "roundness": {"type": 3}, "seed": 24687568, "version": 1, "versionNonce": 120539463, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1098", "type": "text", "x": 1234, "y": 17294.8, "width": 246.1, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g227"], "frameId": null, "roundness": null, "seed": 1385013920, "version": 1, "versionNonce": 1762827844, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "LAYERS, IN ORDER OF STRENGTH", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "LAYERS, IN ORDER OF STRENGTH", "autoResize": true, "lineHeight": 1.25}, {"id": "e1099", "type": "text", "x": 1234, "y": 17318.2, "width": 1088.5, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g227"], "frameId": null, "roundness": null, "seed": 1207597002, "version": 1, "versionNonce": 1917008319, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "(1) Events carry tokens, not values. (2) The schema registry annotates PII fields and CI fails on any unclassified field that looks like PII. (3) Typed\nwrappers and allowlist logging. (4) Per-partner field allowlists on outbound payloads. (5) Tracing and error-reporting body capture switched off. (6)\nOffline DLP scanning as the backstop. Seed unique canary PANs into test traffic and grep every sink for them - that test finds leaks that code review\ndoes not.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "(1) Events carry tokens, not values. (2) The schema registry annotates PII fields and CI fails on any unclassified field that looks like PII. (3) Typed\nwrappers and allowlist logging. (4) Per-partner field allowlists on outbound payloads. (5) Tracing and error-reporting body capture switched off. (6)\nOffline DLP scanning as the backstop. Seed unique canary PANs into test traffic and grep every sink for them - that test finds leaks that code review\ndoes not.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1330", "type": "rectangle", "x": 0, "y": 18037.2, "width": 2400, "height": 4180.5, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1074786694, "version": 1, "versionNonce": 2106426498, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1101", "type": "rectangle", "x": 60, "y": 18077.2, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g228"], "frameId": null, "roundness": {"type": 3}, "seed": 1386424247, "version": 1, "versionNonce": 1242260233, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1102", "type": "text", "x": 74, "y": 18084.2, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g228"], "frameId": null, "roundness": null, "seed": 952954970, "version": 1, "versionNonce": 1292530606, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "06", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "06", "autoResize": true, "lineHeight": 1.25}, {"id": "e1103", "type": "text", "x": 144, "y": 18079.2, "width": 269.3, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g228"], "frameId": null, "roundness": null, "seed": 2012529594, "version": 1, "versionNonce": 1111499938, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Going distributed", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Going distributed", "autoResize": true, "lineHeight": 1.25}, {"id": "e1104", "type": "text", "x": 60, "y": 18139.2, "width": 1480.3, "height": 45.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1575227307, "version": 1, "versionNonce": 1058390889, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Four things make this a distributed-systems question: how events leave a database safely, what ordering you can actually promise, how workers share one delivery table, and how\ntenant isolation survives a bug.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Four things make this a distributed-systems question: how events leave a database safely, what ordering you can actually promise, how workers share one delivery table, and how\ntenant isolation survives a bug.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1105", "type": "text", "x": 60, "y": 18212.2, "width": 714.2, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 533643283, "version": 1, "versionNonce": 354547748, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Getting events out: outbox and relay - and why a duplicate is harmless", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Getting events out: outbox and relay - and why a duplicate is harmless", "autoResize": true, "lineHeight": 1.25}, {"id": "e1106", "type": "rectangle", "x": 60, "y": 18253.8, "width": 2280, "height": 650, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g229"], "frameId": null, "roundness": {"type": 3}, "seed": 1940258939, "version": 1, "versionNonce": 858090, "isDeleted": fa