ull, "locked": false, "points": [[0, 0.0], [81, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e709", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e714", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e718", "type": "text", "x": 2066.2, "y": 10727.3, "width": 22.6, "height": 17.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 402252063, "version": 1, "versionNonce": 1925167945, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "fail", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "fail", "autoResize": true, "lineHeight": 1.25}, {"id": "e719", "type": "text", "x": 110, "y": 10641.8, "width": 1407.6, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 479584938, "version": 1, "versionNonce": 1041642820, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "LADDER_MS = [0, 30 s, 2 min, 10 min, 1 h, 4 h, 12 h, 24 h]   -   each wait is jittered +/-25%, and a Retry-After hint is honoured but capped at 6 h. The ladder is written into the partner contract.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "LADDER_MS = [0, 30 s, 2 min, 10 min, 1 h, 4 h, 12 h, 24 h]   -   each wait is jittered +/-25%, and a Retry-After hint is honoured but capped at 6 h. The ladder is written into the partner contract.", "autoResize": true, "lineHeight": 1.25}, {"id": "e720", "type": "text", "x": 110, "y": 10827.8, "width": 1020.3, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 895563121, "version": 1, "versionNonce": 1955060521, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Times are nominal elapsed time since the first attempt. Parking a delivery because the endpoint gate is closed does NOT consume a rung.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Times are nominal elapsed time since the first attempt. Parking a delivery because the endpoint gate is closed does NOT consume a rung.", "autoResize": true, "lineHeight": 1.25}, {"id": "e721", "type": "rectangle", "x": 60, "y": 10933.8, "width": 1120, "height": 719.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g140"], "frameId": null, "roundness": {"type": 3}, "seed": 1428708536, "version": 1, "versionNonce": 121154750, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e722", "type": "text", "x": 74, "y": 10947.8, "width": 98.8, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g140"], "frameId": null, "roundness": null, "seed": 2037449383, "version": 1, "versionNonce": 1277327932, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "retry-policy.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "retry-policy.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e723", "type": "text", "x": 74, "y": 10973.8, "width": 976.4, "height": 665.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g140"], "frameId": null, "roundness": null, "seed": 314355213, "version": 1, "versionNonce": 1979815734, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "const LADDER_MS = [0, 30_000, 120_000, 600_000, 3_600_000, 14_400_000, 43_200_000, 86_400_000];\nconst MAX_RETRY_AFTER_MS = 6 * 3_600_000;\n\n/** Never follow redirects: a 3xx from a partner endpoint is dead, not retry (SSRF and loop risk). */\nfunction classify({ status, timedOut = false, networkError = false }) {\n  if (networkError || timedOut)                       return 'retry';\n  if (status >= 200 && status < 300)                return 'ok';\n  if (status === 408 || status === 429 || status >= 500) return 'retry';\n  if (status === 401 || status === 403)               return 'pause';    // credentials or allowlist: stop and alert\n  if (status === 410)                                 return 'disable';  // partner says the endpoint is gone\n  return 'dead';                                                         // other 4xx, any 3xx\n}\n\nfunction nextAttemptAt({ attempt, retryAfterMs, now, rng }) {\n  const base   = LADDER_MS[Math.min(attempt, LADDER_MS.length - 1)];\n  const jitter = base * (0.75 + rng.next() * 0.5);               // +/-25%: desynchronises a herd\n  const hinted = Math.min(retryAfterMs ?? 0, MAX_RETRY_AFTER_MS); // honour Retry-After, capped\n  return now + Math.max(jitter, hinted);\n}\n\n/** Per-endpoint bulkhead + breaker. A slow partner, not a failing one, is what exhausts workers. */\nclass EndpointGate {\n  constructor({ maxConcurrency, failThreshold = 5, cooldownMs = 30_000, clock = SystemClock }) {\n    Object.assign(this, { max: maxConcurrency, failThreshold, cooldownMs, clock });\n    this.inFlight = 0; this.fails = 0; this.openUntil = 0;\n  }\n  tryAcquire() {\n    if (this.clock.now() < this.openUntil || this.inFlight >= this.max) return false;\n    this.inFlight++; return true;\n  }\n  release(ok) {\n    this.inFlight--;\n    if (ok) this.fails = 0;\n    else if (++this.fails >= this.failThreshold) this.openUntil = this.clock.now() + this.cooldownMs;\n  }\n}\n// When tryAcquire() is false the worker re-schedules the delivery a few seconds out\n// WITHOUT incrementing attempt: parking is not failing, and must not burn the ladder.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "const LADDER_MS = [0, 30_000, 120_000, 600_000, 3_600_000, 14_400_000, 43_200_000, 86_400_000];\nconst MAX_RETRY_AFTER_MS = 6 * 3_600_000;\n\n/** Never follow redirects: a 3xx from a partner endpoint is dead, not retry (SSRF and loop risk). */\nfunction classify({ status, timedOut = false, networkError = false }) {\n  if (networkError || timedOut)                       return 'retry';\n  if (status >= 200 && status < 300)                return 'ok';\n  if (status === 408 || status === 429 || status >= 500) return 'retry';\n  if (status === 401 || status === 403)               return 'pause';    // credentials or allowlist: stop and alert\n  if (status === 410)                                 return 'disable';  // partner says the endpoint is gone\n  return 'dead';                                                         // other 4xx, any 3xx\n}\n\nfunction nextAttemptAt({ attempt, retryAfterMs, now, rng }) {\n  const base   = LADDER_MS[Math.min(attempt, LADDER_MS.length - 1)];\n  const jitter = base * (0.75 + rng.next() * 0.5);               // +/-25%: desynchronises a herd\n  const hinted = Math.min(retryAfterMs ?? 0, MAX_RETRY_AFTER_MS); // honour Retry-After, capped\n  return now + Math.max(jitter, hinted);\n}\n\n/** Per-endpoint bulkhead + breaker. A slow partner, not a failing one, is what exhausts workers. */\nclass EndpointGate {\n  constructor({ maxConcurrency, failThreshold = 5, cooldownMs = 30_000, clock = SystemClock }) {\n    Object.assign(this, { max: maxConcurrency, failThreshold, cooldownMs, clock });\n    this.inFlight = 0; this.fails = 0; this.openUntil = 0;\n  }\n  tryAcquire() {\n    if (this.clock.now() < this.openUntil || this.inFlight >= this.max) return false;\n    this.inFlight++; return true;\n  }\n  release(ok) {\n    this.inFlight--;\n    if (ok) this.fails = 0;\n    else if (++this.fails >= this.failThreshold) this.openUntil = this.clock.now() + this.cooldownMs;\n  }\n}\n// When tryAcquire() is false the worker re-schedules the delivery a few seconds out\n// WITHOUT incrementing attempt: parking is not failing, and must not burn the ladder.", "autoResize": true, "lineHeight": 1.25}, {"id": "e724", "type": "text", "x": 1220, "y": 10933.8, "width": 448.3, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 844948879, "version": 1, "versionNonce": 116733736, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Where each attempt lands, with the jitter window", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where each attempt lands, with the jitter window", "autoResize": true, "lineHeight": 1.25}, {"id": "e725", "type": "rectangle", "x": 1220, "y": 10969.8, "width": 1120, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 457304671, "version": 1, "versionNonce": 50742275, "isDeleted": 