db, router, consent, audit, clock\n\nhandle(envelope)\n  once per bus message; the bus is\n  at-least-once so MUST be idempotent\n  router.resolve(envelope) -> targets\n  db.withTenant(tenantId, tx => {\n    1 claimInbox   2 consent.decide\n    3 audit.intent 4 insertDelivery })", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "deps: db, router, consent, audit, clock\n\nhandle(envelope)\n  once per bus message; the bus is\n  at-least-once so MUST be idempotent\n  router.resolve(envelope) -> targets\n  db.withTenant(tenantId, tx => {\n    1 claimInbox   2 consent.decide\n    3 audit.intent 4 insertDelivery })", "autoResize": true, "lineHeight": 1.25}, {"id": "e416", "type": "rectangle", "x": 670, "y": 5386.8, "width": 480, "height": 282.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": {"type": 3}, "seed": 2065420853, "version": 1, "versionNonce": 706363564, "isDeleted": false, "boundElements": [{"id": "e445", "type": "arrow"}, {"id": "e447", "type": "arrow"}], "updated": 1792011952237, "link": null, "locked": false}, {"id": "e417", "type": "rectangle", "x": 670, "y": 5386.8, "width": 480, "height": 66, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": null, "seed": 2088691973, "version": 1, "versionNonce": 2115080917, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e418", "type": "text", "x": 684, "y": 5395.8, "width": 62.0, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupI