339", "type": "text", "x": 74, "y": 4134.5, "width": 116.5, "height": 25.0, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g68"], "frameId": null, "roundness": null, "seed": 1758743964, "version": 1, "versionNonce": 2031522882, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "In-app inbox", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "In-app inbox", "autoResize": true, "lineHeight": 1.25}, {"id": "e340", "type": "text", "x": 74, "y": 4165.5, "width": 503.3, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g68"], "frameId": null, "roundness": null, "seed": 555358635, "version": 1, "versionNonce": 871766326, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "The source of truth for borrower notifications. A persisted, paginated\nlist with an unread count. Everything else is a nudge that points at it.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The source of truth for borrower notifications. A persisted, paginated\nlist with an unread count. Everything else is a nudge that points at it.", "autoResize": true, "lineHeight": 1.25}, {"id": "e341", "type": "rectangle", "x": 640, "y": 4120.5, "width": 540, "height": 139.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g69"], "frameId": null, "roundness": {"type": 3}, "seed": 320765232, "version": 1, "versionNonce": 1152337334, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e342", "type": "text", "x": 654, "y": 4134.5, "width": 183.5, "height": 25.0, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g69"], "frameId": null, "roundness": null, "seed": 1973905778, "version": 1, "versionNonce": 1105487253, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Push (FCM / APNs)", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Push (FCM / APNs)", "autoResize": true, "lineHeight": 1.25}, {"id": "e343", "type": "text", "x": 654, "y": 4165.5, "width": 509.8, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g69"], "frameId": null, "roundness": null, "seed": 1225343271, "version": 1, "versionNonce": 1062171279, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Generic text only - no amounts, no account fragments: lock screens\nand a third-party transit path. Set a TTL and a collapse key so a stale\n\"EMI due\" never lands after \"EMI paid\"; prune UNREGISTERED\ntokens.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Generic text only - no amounts, no account fragments: lock screens\nand a third-party transit path. Set a TTL and a collapse key so a stale\n\"EMI due\" never lands after \"EMI paid\"; prune UNREGISTERED\ntokens.", "autoResize": true, "lineHeight": 1.25}, {"id": "e344", "type": "rectangle", "x": 1220, "y": 4120.5, "width": 540, "height": 139.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "s