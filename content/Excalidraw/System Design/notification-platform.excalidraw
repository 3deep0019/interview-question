ith partners", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "My own back-of-envelope, load tests, and agreement with partners", "autoResize": true, "lineHeight": 1.25}, {"id": "e1813", "type": "rectangle", "x": 60, "y": 31112.5, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 208278905, "version": 1, "versionNonce": 1988440758, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1814", "type": "text", "x": 69, "y": 31121.5, "width": 263.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 1994536925, "version": 1, "versionNonce": 826951168, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Regulatory interpretation (DPDP, RBI)", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Regulatory interpretation (DPDP, RBI)", "autoResize": true, "lineHeight": 1.25}, {"id": "e1815", "type": "text", "x": 629, "y": 31121.5, "width": 365.4, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 1808716626, "version": 1, "versionNonce": 46677993, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Confident summaries that may be outdated or wrong", "fontSize": 15, "fontFamily": 2