 "e1672", "type": "text", "x": 74, "y": 27829.0, "width": 138.9, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g325"], "frameId": null, "roundness": null, "seed": 608402106, "version": 1, "versionNonce": 1478658908, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "callback-handler.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "callback-handler.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e1673", "type": "text", "x": 74, "y": 27855.0, "width": 1094.0, "height": 315.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g325"], "frameId": null, "roundness": null, "seed": 3618514, "version": 1, "versionNonce": 690471584, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "// Capture RAW bytes. Do not let a JSON middleware parse first: the signature covers the exact bytes.\napp.post('/v1/partner-callbacks', express.raw({ type: 'application/json', limit: '256kb' }), async (req, res) => {\n  const partner = await partners.byKeyId(req.get('x-key-id'));\n  if (!partner) return res.sendStatus(401);\n\n  const ok = verify({ header: req.get('x-event-signature') ?? '', rawBody: req.body,\n                      secrets: partner.activeSecrets(), nowSec: Math.floor(Date.now() / 1000) });\n  if (!ok) { metrics.inc('callback_signature_failure', { partner: partner.id }); return res.sendStatus(401); }\n\n  const body   = JSON.parse(req.body);\n  const result = await db.withTenant(partner.tenantId, tx =>\n    receiveOnce(tx, { tenantId: partner.tenantId, source: `partner:${partner.id}`,\n                      externalId: body.id, rawBody: req.body },\n                tx2 => applyPartnerEvent(tx2, body)));\n\n  if (result === 'conflict') { alerts.raise('inbox_conflict', { partner: partner.id, id: body.id }); return res.sendStatus(409); }\n  return res.sendStatus(200);                 // 'applied' and 'duplicate' both answer 200: the sender must stop retrying\n});", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "// Capture RAW bytes. Do not let a JSON middleware parse first: the signature covers the exact bytes.\napp.post('/v1/partner-callbacks', express.raw({ type: 'application/json', limit: '256kb' }), async (req, res) => {\n  const partner = await partners.byKeyId(req.get('x-key-id'));\n  if (!partner) return res.sendStatus(401);\n\n  const ok = verify({ header: req.get('x-event-signature') ?? '', rawBody: req.body,\n                      secrets: partner.activeSecrets(), nowSec: Math.floor(Date.now() / 1000) });\n  if (!ok) { metrics.inc('callback_signature_failure', { partner: partner.id }); return res.sendStatus(401); }\n\n  const body   = JSON.parse(req.body);\n  const result = await db.withTenant(partner.tenantId, tx =>\n    receiveOnce(tx, { tenantId: partner.tenantId, source: `partner:${partner.id}`,\n                      externalId: body.id, rawBody: req.body },\n                tx2 => applyPartnerEvent(tx2, body)));\n\n  if (result === 'conflict') { alerts.raise('inbox_conflict', { partner: partner.id, id: body.id }); return res.sendStatus(409); }\n  return res.sendStatus(200);                 // 'applied' and 'duplicate' both answer 200: the sender must stop retrying\n});", "autoResize": true, "lineHeight": 1.25}, {"id": "e1674", "type": "text", "x": 1220, "y": 27815.0, "width": 453.0, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": n