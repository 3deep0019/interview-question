": 4}, "endBinding": {"elementId": "e1726", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1733", "type": "text", "x": 1744.3, "y": 28805.5, "width": 20.2, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1115525024, "version": 1, "versionNonce": 1303816027, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "no", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "no", "autoResize": true, "lineHeight": 1.25}, {"id": "e1734", "type": "text", "x": 60, "y": 29051.0, "width": 414.1, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 44173976, "version": 1, "versionNonce": 202045503, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Tests that prove the design, not the code", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Tests that prove the design, not the code", "autoResize": true, "lineHeight": 1.25}, {"id": "e1735", "type": "rectangle", "x": 60, "y": 29092.5, "width": 1120, "height": 719.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g342"], "frameId": null, "roundness": {"type": 3}, "seed": 72110528, "version": 1, "versionNonce": 439469161, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1736", "type": "text", "x": 74, "y": 29106.5, "width": 121.3, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g342"], "frameId": null, "roundness": null, "seed": 2126877775, "version": 1, "versionNonce": 1869965546, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "invariants.test.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "invariants.test.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e1737", "type": "text", "x": 74, "y": 29132.5, "width": 917.6, "height": 665.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g342"], "frameId": null, "roundness": null, "seed": 1859897994, "version": 1, "versionNonce": 1214346935, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "import fc from 'fast-check';\n\nconst applyEvent = (state, ev) => (!state || ev.sequence > state.sequence) ? ev : state;\n\ntest('any duplication or reordering of a loan\\'s events converges to the highest-sequence state', () => {\n  fc.assert(fc.property(\n    fc.array(fc.constantFrom('DISBURSED', 'EMI_DEBITED', 'EMI_BOUNCED'), { minLength: 1, maxLength: 30 }),\n    fc.array(fc.nat(), { minLength: 1, maxLength: 80 }),\n    (statuses, picks) => {\n      const events = statuses.map((status, i) => ({ sequence: i + 1, status }));\n      const stream = picks.map(p => events[p % events.length]);       // arbitrary duplication and reordering\n      const state  = stream.reduce(applyEvent, null);\n      const top    = stream.reduce((a, b) => (b.sequence > a.sequence ? b : a));\n      return state.sequence === top.sequence && state.status === top.status;\n    }));\n});\n\ntest('a seeded canary PAN never reaches any sink', async () => {\n  const canary = 'ZZZZZ9999Z';\n  await runFullPipelineAgainstFakes({ pan: canary });\n  for (const sink of [logs, traces, dlq, fcmCapture, webhookCapture, auditStore])\n    expect(sink.dump()).not.toContain(canary);\n});\n\ntest('tenant B cannot see or alter tenant A rows on any query path', async () => {\n  await asTenant('A', tx => tx.insertDelivery(sample));\n  await asTenant('B', async tx => {\n    expect((await tx.query('SELECT * FROM deliveries')).rowCount).toBe(0);\n    expect((await tx.query(`UPDATE deliveries SET state = 'dead'`)).rowCount).toBe(0);\n    await expect(tx.insertDelivery({ ...sample, tenantId: 'A' })).rejects.toThrow();   // WITH CHECK\n  });\n});\n\ntest('editing any stored audit record breaks independent verification', async () => {\n  await writeBatches(tenant, 50);\n  await tamper(tenant, { batch: 17, record: 3 });\n  expect(await independentVerifier.run(tenant)).toMatchObject({ ok: false, firstBadBatch: 17 });\n});", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "import fc from 'fast-check';\n\nconst applyEvent = (state, ev) => (!state || ev.sequence > state.sequence) ? ev : state;\n\ntest('any duplication or reordering of a loan\\'s events converges to the highest-sequence state', () => {\n  fc.assert(fc.property(\n    fc.array(fc.constantFrom('DISBURSED', 'EMI_DEBITED', 'EMI_BOUNCED'), { minLength: 1, maxLength: 30 }),\n    fc.array(fc.nat(), { minLength: 1, maxLength: 80 }),\n    (statuses, picks) => {\n      const events = statuses.map((status, i) => ({ sequence: i + 1, status }));\n      const stream = picks.map(p => events[p % events.length]);       // arbitrary duplication and reordering\n      const state  = stream.reduce(applyEvent, null);\n      const top    = stream.reduce((a, b) => (b.sequence > a.sequence ? b : a));\n      return state.sequence === top.sequence && state.status === top.status;\n    }));\n});\n\ntest('a seeded canary PAN never reaches any sink', async () => {\n  const canary = 'ZZZZZ9999Z';\n  await runFullPipelineAgainstFakes({ pan: canary });\n  for (const sink of [logs, traces, dlq, fcmCapture, webhookCapture, auditStore])\n    expect(sink.dump()).not.toContain(canary);\n});\n\ntest('tenant B cannot see or alter tenant A rows on any query path', async () => {\n  await asTenant('A', tx => tx.insertDelivery(sample));\n  await asTenant('B', async tx => {\n    expect((await tx.query('SELECT * FROM deliveries')).rowCount).toBe(0);\n    expect((await tx.query(`UPDATE deliveries SET state = 'dead'`)).rowCount).toBe(0);\n    await expect(tx.insertDelivery({ ...sample, tenantId: 'A' })).rejects.toThrow();   // WITH CHECK\n  });\n});\n\ntest('editing any stored audit record breaks independent verification', async () => {\n  await writeBatches(tenant, 50);\n  await tamper(tenant, { batch: 17, record: 3 });\n  expect(await independentVerifier.run(tenant)).toMatchObject({ ok: false, firstBadBatch: 17 });\n});", "autoResize": true, "lineHeight": 1.25}, {"id": "e1738", "type": "rectangle", "x": 1220, "y": 29092.5, "width": 1120, "height": 97.8, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g343"], "frameId": null, "roundness": {"type": 3}, "seed": 1044354654, "version": 1, "versionNonce": 1259952201, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1739", "type": "text", "x": 1234, "y": 29106.5, "width": 431.5, "height": 23.8, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g343"], "frameId": null, "roundness": null, "seed": 1218018263, "version": 1, "versionNonce": 458666223, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "1  Convergence under duplication and reordering", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1  Convergence under duplication and reordering", "autoResize": true, "lineHeight": 1.25}, {"id": "e1740", "type": "text", "x": 1234, "y": 29136.2, "width": 1059.7, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g343"], "frameId": null, "roundness": null, "seed": 561775099, "version": 1, "versionNonce": 1987486081, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "fast-check generates arbitrary duplication and reordering of a loan's events; the folded state must equal the highest-sequence event. Proves the\nsequence + full-state contract (section 06).", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "fast-check generates arbitrary duplication and reordering of a loan's events; the folded state must equal the highest-sequence event. Proves the\nsequence + full-state contract (section 06).", "autoResize": true, "lineHeight": 1.25}, {"id": "e1741", "type": "rectangle", "x": 1220, "y": 29210.2, "width": 1120, "height": 97.8, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g344"], "frameId": null, "roundness": {"type": 3}, "seed": 1673299484, "version": 1, "versionNonce": 600918522, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1742", "type": "text", "x": 1234, "y": 29224.2, "width": 423.4, "height": 23.8, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g344"], "frameId": null, "roundness": null, "seed": 914720640, "version": 1, "versionNonce": 208537326, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "2  A seeded canary PAN never reaches any sink", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2  A seeded canary PAN never reaches any sink", "autoResize": true, "lineHeight": 1.25}, {"id": "e1743", "type": "text", "x": 1234, "y": 29254.0, "width": 1057.4, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g344"], "frameId": null, "roundness": null, "seed": 2032592377, "version": 1, "versionNonce": 959628314, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Run the whole pipeline against fakes, then dump logs, traces, DLQ, FCM capture, webhook capture and the audit store and search each for the\ncanary. Proves PII masking in depth (section 05.6).", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Run the whole pipeline against fakes, then dump logs, traces, DLQ, FCM capture, webhook capture and the audit store and search each for the\ncanary. Proves PII masking in depth (section 05.6).", "autoResize": true, "lineHeight": 1.25}, {"id": "e1744", "type": "rectangle", "x": 1220, "y": 29328.0, "width": 1120, "height": 97.8, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g345"], "frameId": null, "roundness": {"type": 3}, "seed": 1647654597, "version": 1, "versionNonce": 1273715854, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1745", "type": "text", "x": 1234, "y": 29342.0, "width": 394.9, "height": 23.8, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g345"], "frameId": null, "roundness": null, "seed": 1758425632, "version": 1, "versionNonce": 1307222262, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "3  Tenant B cannot see or alter tenant A rows", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3  Tenant B cannot see or alter tenant A rows", "autoResize": true, "lineHeight": 1.25}, {"id": "e1746", "type": "text", "x": 1234, "y": 29371.8, "width": 1071.4, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g345"], "frameId": null, "roundness": null, "seed": 2069032211, "version": 1, "versionNonce": 281113793, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "As tenant B: SELECT returns 0 rows, UPDATE touches 0 rows, and inserting a row with tenantId A is rejected by WITH CHECK. Proves row-level\nsecurity (section 06).", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "As tenant B: SELECT returns 0 rows, UPDATE touches 0 rows, and inserting a row with tenantId A is rejected by WITH CHECK. Proves row-level\nsecurity (section 06).", "autoResize": true, "lineHeight": 1.25}, {"id": "e1747", "type": "rectangle", "x": 1220, "y": 29445.8, "width": 1120, "height": 97.8, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g346"], "frameId": null, "roundness": {"type": 3}, "seed": 545451261, "version": 1, "versionNonce": 1811932263, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1748", "type": "text", "x": 1234, "y": 29459.8, "width": 396.3, "height": 23.8, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g346"], "frameId": null, "roundness": null, "seed": 81326334, "version": 1, "versionNonce": 727660182, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "4  Editing any audit record breaks verification", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4  Editing any audit record breaks verification", "autoResize": true, "lineHeight": 1.25}, {"id": "e1749", "type": "text", "x": 1234, "y": 29489.5, "width": 1061.7, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g346"], "frameId": null, "roundness": null, "seed": 431620832, "version": 1, "versionNonce": 2135918043, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Write 50 batches, tamper with batch 17 record 3, and the independent verifier must return ok: false with firstBadBatch 17. Proves the hash chain\n(section 05.4).", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Write 50 batches, tamper with batch 17 record 3, and the independent verifier must return ok: false with firstBadBatch 17. Proves the hash chain\n(section 05.4).", "autoResize": true, "l