yle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g162"], "frameId": null, "roundness": {"type": 3}, "seed": 219757212, "version": 1, "versionNonce": 9646716, "isDeleted": false, "boundElements": [{"id": "e855", "type": "arrow"}, {"id": "e859", "type": "arrow"}], "updated": 1792011952237, "link": null, "locked": false}, {"id": "e853", "type": "text", "x": 681, "y": 12626.4, "width": 478, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g162"], "frameId": null, "roundness": null, "seed": 1019545261, "version": 1, "versionNonce": 1895852301, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "2  Overlap window", "fontSize": 18, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "2  Overlap window", "autoResize": true, "lineHeight": 1.25}, {"id": "e854", "type": "text", "x": 681, "y": 12654.9, "width": 478, "height": 18.8, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g162"], "frameId": null, "roundness": null, "seed": 1759009670, "version": 1, "versionNonce": 496312590, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "sign outbound with BOTH (two v1 values); accept either inbound", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "sign outbound with BOTH (two v1 values); accept either inbound", "autoResize": true, "lineHeight": 1.25}, {"id": "e855", "type": "arrow", "x": 610, "y": 12650.0, "width": 60, "height": 0.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1805081041, "version": 1, "versionNonce": 962710805, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [60, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e849", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e852", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e856", "type": "rectangle", "x": 1230, "y": 12595.0, "width": 500, "height": 110, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g163"], "frameId": null, "roundness": {"type": 3}, "seed": 1963606558, "version": 1, "versionNonce": 802893227, "isDeleted": false, "boundElements": [{"id": "e859", "type": "arrow"}], "updated": 1792011952237, "link": null, "locked": false}, {"id": "e857", "type": "text", "x": 1241, "y": 12626.4, "width": 478, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g163"], "frameId": null, "roundness": null, "seed": 86676434, "version": 1, "versionNonce": 1883090157, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "3  Retire the old secret", "fontSize": 18, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "3  Retire the old secret", "autoResize": true, "lineHeight": 1.25}, {"id": "e858", "type": "text", "x": 1241, "y": 12654.9, "width": 478, "height": 18.8, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g163"], "frameId": null, "roundness": null, "seed": 630667555, "version": 1, "versionNonce": 500133222, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "notAfter reached; only the new secret verifies", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "notAfter reached; only the new secret verifies", "autoResize": true, "lineHeight": 1.25}, {"id": "e859", "type": "arrow", "x": 1170, "y": 12650.0, "width": 60, "height": 0.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 256015772, "version": 1, "versionNonce": 108214202, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [60, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e852", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e856", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e860", "type": "rectangle", "x": 1790, "y": 12595.0, "width": 500, "height": 110, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": ["g164"], "frameId": null, "roundness": {"type": 3}, "seed": 407105307, "version": 1, "versionNonce": 1289549556, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e861", "type": "text", "x": 1801, "y": 12617.0, "width": 478, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g164"], "frameId": null, "roundness": null, "seed": 2089426811, "version": 1, "versionNonce": 1777955479, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "On top of signing", "fontSize": 18, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "On top of signing", "autoResize": true, "lineHeight": 1.25}, {"id": "e862", "type": "text", "x": 1801, "y": 12645.5, "width": 478, "height": 37.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g164"], "frameId": null, "roundness": null, "seed": 1252399073, "version": 1, "versionNonce": 416958871, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "mTLS or an IP allowlist where a partner or bank supports it: signing\nproves the origin of the message, not the network path", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "mTLS or an IP allowlist where a partner or bank supports it: signing\nproves the origin of the message, not the network path", "autoResize": true, "lineHeight": 1.25}, {"id": "e863", "type": "rectangle", "x": 60, "y": 12775.0, "width": 1120, "height": 386.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g165"], "frameId": null, "roundness": {"type": 3}, "seed": 1997532913, "version": 1, "versionNonce": 161311647, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e864", "type": "text", "x": 74, "y": 12789.0, "width": 705.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g165"], "frameId": null, "roundness": null, "seed": 799372790, "version": 1, "versionNonce": 1100948304, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "signing.js   -   header: X-Event-Signature: t=1760443200,v1=<hex>[,v1=<hex, previous secret>]", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "signing.js   -   header: X-Event-Signature: t=1760443200,v1=<hex>[,v1=<hex, previous secret>]", "autoResize": true, "lineHeight": 1.25}, {"id": "e865", "type": "text", "x": 74, "y": 12815.0, "width": 909.2, "height": 332.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g165"], "frameId": null, "roundness": null, "seed": 1859994276, "version": 1, "versionNonce": 381734557, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "import { createHmac, timingSafeEqual } from 'node:crypto';\n\nfunction sign(secret, timestampSec, rawBody) {\n  return createHmac('sha256', secret).update(`${timestampSec}.`).update(rawBody).digest('hex');\n}\n\n/** rawBody MUST be the exact bytes received. Verify BEFORE JSON.parse; re-serialising changes the bytes. */\nfunction verify({ header, rawBody, secrets, nowSec, toleranceSec = 300 }) {\n  const t    = Number(/t=(\\d+)/.exec(header)?.[1]);\n  const sigs = [...header.matchAll(/v1=([0-9a-f]{64})/g)].map(m => Buffer.from(m[1], 'hex'));\n  if (!t || sigs.length === 0)               return false;\n  if (Math.abs(nowSec - t) > toleranceSec)   return false;      // replay window\n\n  // two secrets are live during rotation; compare in constant time over equal-length buffers\n  return secrets.some(secret => {\n    const expected = Buffer.from(sign(secret, t, rawBody), 'hex');\n    return sigs.some(got => got.length === expected.length && timingSafeEqual(got, expected));\n  });\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "import { createHmac, timingSafeEqual } from 'node:crypto';\n\nfunction sign(secret, timestampSec, rawBody) {\n  return createHmac('sha256', secret).update(`${timestampSec}.`).update(rawBody).digest('hex');\n}\n\n/** rawBody MUST be the exact bytes received. Verify BEFORE JSON.parse; re-serialising changes the bytes. */\nfunction verify({ header, rawBody, secrets, nowSec, toleranceSec = 300 }) {\n  const t    = Number(/t=(\\d+)/.exec(header)?.[1]);\n  const sigs = [...header.matchAll(/v1=([0-9a-f]{64})/g)].map(m => Buffer.from(m[1], 'hex'));\n  if (!t || sigs.length === 0)               return false;\n  if (Math.abs(nowSec - t) > toleranceSec)   return false;      // replay window\n\n  // two secrets are live during rotation; compare in constant time over equal-length buffers\n  return secrets.some(secret => {\n    const expected = Buffer.from(sign(secret, t, rawBody), 'hex');\n    return sigs.some(got => got.length === expected.length && timingSafeEqual(got, expected));\n  });\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e866", "type": "rectangle", "x": 1220, "y": 12775.0, "width": 1120, "height": 111.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": {"type": 3}, "seed": 964464660, "version": 1, "versionNonce": 1295023245, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e867", "type": "text", "x": 1234, "y": 12789.0, "width": 234.7, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 558234554, "version": 1, "versionNonce": 1664295970, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "ROTATION WITHOUT AN OUTAGE", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ROTATION WITHOUT AN OUTAGE", "autoResize": true, "lineHeight": 1.25}, {"id": "e868", "type": "text", "x": 1234, "y": 12812.5, "width": 1085.7, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 1670261831, "version": 1, "versionNonce": 1427551773, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Issue the new secret, sign outbound with both for an overlap window, accept either inbound, then retire the old one. Per-partner secrets, stored in a\nsecrets manager and never in the delivery table. Where a partner or a bank supports it, add mTLS or an IP allowlist on top - signing proves origin of\nthe message, not the network path.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Issue the new secret, sign outbound with both for an overlap window, accept either inbound, then retire the old one. Per-partner secrets, stored in a\nsecrets manager and never in the delivery table. Where a partner or a bank supports it, add mTLS or an IP allowlist on top - signing proves origin of\nthe message, not the network path.", "autoResize": true, "lineHeight": 1.25}, {"id": "e869", "type": "rectangle", "x": 60, "y": 13211.5, "width": 2280, "height": 52, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g167"], "frameId": null, "roundness": {"type": 3}, "seed": 2030879763,