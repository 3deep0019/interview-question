 1, "versionNonce": 984987973, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "State split across two systems; reconciling becomes your job", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "State split across two systems; reconciling becomes your job", "autoResize": true, "lineHeight": 1.25}, {"id": "e322", "type": "text", "x": 1789, "y": 3906.0, "width": 460.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g67"], "frameId": null, "roundness": null, "seed": 945876561, "version": 1, "versionNonce": 1510006083, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "You are already on that cloud and want the ladder as configuration", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "You are already on that cloud and want the ladder as configuration", "autoResize": true, "lineHeight": 1.25}, {"id": "e323", "type": "rectangle", "x": 60, "y": 3933.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g67"], "frameId": null, "roundness": null, "seed": 38830756, "version": 1, "versionNonce": 825373662, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e324", "type": "text", "x": 69, "y": 3942.8, "width": 161.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g67"], "frameId": null, "roundness": null, "seed": 711886291, "