600.8, "width": 2280, "height": 71.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g362"], "frameId": null, "roundness": {"type": 3}, "seed": 582198144, "version": 1, "versionNonce": 1226192442, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1833", "type": "text", "x": 74, "y": 31614.8, "width": 112.0, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g362"], "frameId": null, "roundness": null, "seed": 1802948592, "version": 1, "versionNonce": 636838531, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "THE PRINCIPLE", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE PRINCIPLE", "autoResize": true, "lineHeight": 1.25}, {"id": "e1834", "type": "text", "x": 74, "y": 31638.2, "width": 1194.3, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g362"], "frameId": null, "roundness": null, "seed": 718352301, "version": 1, "versionNonce": 1726887020, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "AI speeds up producing and attacking designs. Anything that must be deterministic, auditable or legally accountable stays in tested code and with named humans.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "AI speeds up producing and attacking designs. Anything that must be deterministic, auditable or legally accountable stays in tested code and with named humans.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1835", "type": "text", "x": 60, "y": 31716.2, "width": 209.3, "height": 27.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 360343155, "version": 1, "versionNonce": 559789168, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "The other follow-ups", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The other follow-ups", "autoResize": true, "lineHeight": 1.25}, {"id": "e1836", "type": "rectangle", "x": 60, "y": 31757.8, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g363"], "frameId": null, "roundness": {"type": 3}, "seed": 1054429376, "version": 1, "versionNonce": 234586477, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1837", "type": "text", "x": 74, "y": 31771.8, "width": 444.0, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g363"], "frameId": null, "roundness": null, "seed": 683043375, "version": 1, "versionNonce": 979649086, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Q  Why not rely on the bus's exactly-once feature?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  Why not rely on the bus's exactly-once feature?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1838", "type": "text", "x": 74, "y": 31801.5, "width": 1071.3, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g363"], "frameId": null, "roundness": null, "seed": 1939538993, "version": 1, "versionNonce": 1036024074, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "It guarantees something real but narrower: within the bus, an acknowledged message is not redelivered to that subscription. It says nothing about\nthe HTTP call to a partner or the database write that follows. A worker can crash after the side effect and before the ack, and the message comes\nback. So the guarantee that matters - one effect per event - has to come from an idempotent receiver, which is why the inbox claim shares a\ntransaction with the effect. I would still turn the bus feature on where it exists, since it reduces duplicates, but I would design as if it were absent.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "It guarantees something real but narrower: within the bus, an acknowledged message is not redelivered to that subscription. It says nothing about\nthe HTTP call to a partner or the database write that follows. A worker can crash after the side effect and before the ack, and the message comes\nback. So the guarantee that matters - one effect per event - has to come from an idempotent receiver, which is why the inbox claim shares a\ntransaction with the effect. I would still turn the bus feature on where it exists, since it reduces duplicates, but I would design as if it were absent.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1839", "type": "rectangle", "x": 1220, "y": 31757.8, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g364"], "frameId": null, "roundness": {"type": 3}, "seed": 245174275, "version": 1, "versionNonce": 329357478, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1840", "type": "text", "x": 1234, "y": 31771.8, "width": 455.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g364"], "frameId": null, "roundness": null, "seed": 2101574256, "version": 1, "versionNonce": 1102641914, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Q  A partner is down for three days. What happens?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  A partner is down for three days. What happens?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1841", "type": "text", "x": 1234, "y": 31801.5, "width": 1052.2, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g364"], "frameId": null, "roundness": null, "seed": 122090722, "version": 1, "versionNonce": 1355063804, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "The ladder runs for about 41 hours, the breaker keeps us from hammering a dead endpoint, and deliveries are then dead-lettered with an audit\nrecord and a notice to the partner's technical contact. When they recover, an operator or the partner replays from a date range. Because status\nevents carry full state and a sequence, replay only needs to send the latest event per loan, not every intermediate one - a three-day outage\nbecomes a bounded catch-up rather than a flood. Large replays are bulk actions: step-up plus a second approver.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The ladder runs for about 41 hours, the breaker keeps us from hammering a dead endpoint, and deliveries are then dead-lettered with an audit\nrecord and a notice to the partner's technical contact. When they recover, an operator or the partner replays from a date range. Because status\nevents carry full state and a sequence, replay only needs to send the latest event per loan, not every intermediate one - a three-day outage\nbecomes a bounded catch-up rather than a flood. Large replays are bulk actions: step-up plus a second approver.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1842", "type": "rectangle", "x": 60, "y": 31919.5, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g365"], "frameId": null, "roundness": {"type": 3}, "seed": 1922078595, "version": 1, "versionNonce": 1691367961, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1843", "type": "text", "x": 74, "y": 31933.5, "width": 711.5, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g365"], "frameId": null, "roundness": null, "seed": 1435120392, "version": 1, "versionNonce": 1986912830, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Q  A borrower withdraws consent while their message is queued. What happens?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  A borrower withdraws consent while their message is queued. What happens?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1844", "type": "text", "x": 74, "y": 31963.2, "width": 1081.1, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g365"], "frameId": null, "roundness": null, "seed": 453459521, "version": 1, "versionNonce": 1202467334, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Consent is evaluated at dispatch, and for borrower channels I re-check immediately before the actual send - a cached ledger snapshot with a\nseconds-long TTL makes that cheap. Withdrawal therefore beats anything queued. Partner webhooks are governed differently: what a partner may\nreceive is set by contract and a per-partner field allowlist, and a withdrawal that affects data sharing triggers a review with compliance rather than a\nsilent flag flip.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Consent is evaluated at dispatch, and for borrower channels I re-check immediately before the actual send - a cached ledger snapshot with a\nseconds-long TTL makes that cheap. Withdrawal therefore beats anything queued. Partner webhooks are governed differently: what a partner may\nreceive is set by contract and a per-partner field allowlist, and a withdrawal that affects data sharing triggers a review with compliance rather than a\nsilent flag flip.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1845", "type": "rectangle", "x": 1220, "y": 31919.5, "width": 1120, "height": 117.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g366"], "frameId": null, "roundness": {"type": 3}, "seed": 1025327563, "version": 1, "versionNonce": 1793755068, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1846", "type": "text", "x": 1234, "y": 31933.5, "width": 565.4, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g366"], "frameId": null, "roundness": null, "seed": 614681013, "version": 1, "versionNonce": 255956666, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Q  Erasure request versus audit retention - how do they coexist?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  Erasure request versus audit retention - how do they coexist?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1847", "type": "text", "x": 1234, "y": 31963.2, "width": 1069.4, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g366"], "frameId": null, "roundness": null, "seed": 553606555, "version": 1, "versionNonce": 1621029864, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Audit records hold tokens, hashes and decision ids, never raw PII. Erasure is crypto-shredding the vault entry: the token then resolves to nothing,\nwhile the chain stays verifiable. How long records must be retained, and what an erasure request can override, is a legal determination - I would\nbuild both mechanisms and let compliance set the retention rules as configuration.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Audit records hold tokens, hashes and decision ids, never raw PII. Erasure is crypto-shredding the vault entry: the token then resolves to nothing,\nwhile the chain stays verifiable. How long records must be retained, and what an erasure request can override, is a legal determination - I would\nbuild both mechanisms and let compliance set the retention rules as configuration.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1848", "type": "rectangle", "x": 1220, "y": 32061.2, "width": 1120, "height": 117.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g367"], "frameId": null, "roundness": {"type": 3}, "seed": 432979581, "version": 1, "versionNonce": 2084562888, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1849", "type": "text", "x": 1234, "y": 32075.2, "width": 495.1, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g367"], "frameId": null, "roundness": null, "seed": 782285242, "version": 1, "versionNonce": 927840674, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Q  How do you prove to an auditor that the trail is intact?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How do you prove to an auditor that the trail is intact?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1850", "type": "text", "x": 1234, "y": 32105.0, "width": 1085.8, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g367"], "frameId": null, "roundness": null, "seed": 2128201266, "version": 1, "versionNonce": 561615908, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Three things I can show live. The independent verifier recomputing the chain from stored records and matching the latest signed checkpoints. A\ndeliberate tamper test that the verifier catches. And separation of duties: the identity that writes audit records cannot sign checkpoints, and the\nbucket holding checkpoints is under retention lock that even administrators cannot shorten. The proof rests on that separation, not on the database.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Three things I can show live. The independent verifier recomputing the chain from stored records and matching the latest signed checkpoints. A\ndeliberate tamper test that the verifier catches. And separation of duties: the identity that writes audit records cannot sign checkpoints, and the\nbucket holding checkpoints is under retention lock that even administrators cannot shorten. The proof rests on that separation, not on the database.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1851", "type": "rectangle", "x": 60, "y": 32081.2, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g368"], "frameId": null, "roundness": {"type": 3}, "seed": 2143372569, "version": 1, "versionNonce": 512550664, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1852", "type": "text", "x": 74, "y": 32095.2, "width": 337.0, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g368"], "frameId": null, "roundness": null, "seed": 1986593695, "version": 1, "versionNonce": 511418795, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Q  Multi-region and disaster recovery?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  Multi-region and disaster recovery?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1853", "type": "text", "x": 74, "y": 32125.0, "width": 1084.5, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g368"], "frameId": null, "roundness": null, "seed": 209518928, "version": 1, "versionNonce": 837830618, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Assuming India-resident storage, I would use a primary region with synchronous replication for the delivery and audit tables inside it, and a second\nin-country region with asynchronous replication and a stated RPO. Failover is safe to replay because every step is idempotent: the worst case is\nduplicates, which the inbox absorbs, not loss. The WORM checkpoint bucket and the KMS keys need their own cross-region story, and the runbook\nmust say who can promote and how the audit chain's head is reconciled afterwards.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Assuming India-resident storage, I would use a primary region with synchronous replication for the delivery and audit tables inside it, and a second\nin-country region with asynchronous replication and a stated RPO. Failover is safe to replay because every step is idempotent: the worst case is\nduplicates, which the inbox absorbs, not loss. The WORM checkpoint bucket and the KMS keys need their own cross-region story, and the runbook\nmust say who can promote and how the audit chain's head is reconciled afterwards.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1854", "type": "rectangle", "x": 1220, "y": 32203.0, "width": 1120, "height": 117.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g369"], "frameId": null, "roundness": {"type": 3}, "seed": 621543242, "version": 1, "versionNonce": 892571495, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1855", "type": "text", "x": 1234, "y": 32217.0, "width": 383.1, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g369"], "frameId": null, "roundness": null, "seed": 1924573699, "version": 1, "versionNonce": 348308297, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Q  Build or buy the webhook delivery layer?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  Build or buy the webhook delivery layer?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1856", "type": "text", "x": 1234, "y": 32246.8, "width": 1090.1, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g369"], "frameId": null, "roundness": null, "seed": 123442443, "version": 1, "versionNonce": 1787400448, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Managed webhook services exist and are good at exactly the ladder, signing and replay UI. The questions are data residency, vendor-risk review for\nborrower-adjacent data, and whether it can carry our tenant model and feed our audit chain. If a vendor can run inside our boundary and expose\nwhat the audit trail needs, buy. Otherwise the build is smaller than it looks: most of it is the six mechanisms in section 05.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Managed webhook services exist and are good at exactly the ladder, signing and replay UI. The questions are data residency, vendor-risk review for\nborrower-adjacent data, and whether it can carry our tenant model and feed our audit chain. If a vendor can run inside our boundary and expose\nwhat the audit trail needs, buy. Otherwise the build is smaller than it looks: most of it is the six mechanisms in section 05.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1857", "type": "rectangle", "x": 60, "y": 32243.0, "width": 1120, "height": 97.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g370"], "frameId": null, "roundness": {"type": 3}, "seed": 1560088702, "version": 1, "versionNonce": 2101382583, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1858", "type": "text", "x": 74, "y": 32257.0, "width": 572.0, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g370"], "frameId": null, "roundness": null, "seed": 630338897, "version": 1, "versionNonce": 309991767, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Q  How do you evolve event schemas without breaking partners?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How do you evolve event schemas without breaking partners?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1859", "type": "text", "x": 74, "y": 32286.8, "width": 1066.6, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g370"], "frameId": null, "roundness": null, "seed": 2101594464, "version": 1, "versionNonce": 1373980337, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Additive changes only within a version; a schema registry with compatibility checks in CI; api_version pinned per partner endpoint so we upgrade\nthem one at a time; dual-publish during a migration; contract tests per partner. Never change the meaning of an existing field - add a new one.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Additive changes only within a version; a schema registry with compatibility checks in CI; api_version pinned per partner endpoint so we upgrade\nthem one at a time; dual-publish during a migration; contract tests per partner. Never change the meaning of an existing field - add a new one.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1860", "type": "rectangle", "x": 1220, "y": 32344.8, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g371"], "frameId": null, "roundness": {"type": 3}, "seed": 34421002, "version": 1, "versionNonce": 949423100, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1861", "type": "text", "x": 1234, "y": 32358.8, "width": 221.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g371"], "frameId": null, "roundness": null, "seed": 1733068856, "version": 1, "versionNonce": 1090475926, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Q  What do you monitor?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  What do you monitor?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1862", "type": "text", "x": 1234, "y": 32388.5, "width": 1079.7, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g371"], "frameId": null, "roundness": null, "seed": 732089975, "version": 1, "versionNonce": 1096901214, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "The age of the oldest due delivery per lane and tenant (the single best health signal); outbox oldest-unpublished age; per-partner success rate and\np99 latency; DLQ size and age; inbox conflicts (same id, different body); signature-failure rate; consent denials by reason; audit lag and\nchain-verification status; RLS violations blocked; and canary-PAN detector hits on log sinks. Alert on direction of change as well as thresholds, and\npage on a verification mismatch.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The age of the oldest due delivery per lane and tenant (the single best health signal); outbox oldest-unpublished age; per-partner success rate and\np99 latency; DLQ size and age; inbox conflicts (same id, different body); signature-failure rate; consent denials by reason; audit lag and\nchain-verification status; RLS violations blocked; and canary-PAN detector hits on log sinks. Alert on direction of change as well as thresholds, and\npage on a verification mismatch.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1943", "type": "rectangle", "x": 0, "y": 32642.5, "width": 2400, "height": 1123.5, "angle": 0, "strokeColo