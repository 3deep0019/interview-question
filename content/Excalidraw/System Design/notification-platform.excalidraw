": [], "frameId": null, "roundness": null, "seed": 1587060216, "version": 1, "versionNonce": 1586443402, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "yes", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "yes", "autoResize": true, "lineHeight": 1.25}, {"id": "e595", "type": "arrow", "x": 1390, "y": 8704.5, "width": 60, "height": 82.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 2096580069, "version": 1, "versionNonce": 1401915610, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [30, 0.0], [30, 82.0], [60, 82.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e576", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e581", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e596", "type": "text", "x": 1428, "y": 8736.8, "width": 20.2, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 558708797, "version": 1, "versionNonce": 872327757, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "no", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "no", "autoResize": true, "lineHeight": 1.25}, {"id": "e597", "type": "arrow", "x": 1750, "y": 8756.5, "width": 100, "height": 165.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 1408739247, "version": 1, "versionNonce": 512529239, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [50, 0.0], [50, -165.0], [100, -165.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e581", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e584", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e598", "type": "arrow", "x": 1750, "y": 8816.5, "width": 100, "height": 35.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 646041018, "version": 1, "versionNonce": 1037625491, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [50, 0.0], [50, -35.0], [100, -35.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e581", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e587", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e599", "type": "rectangle", "x": 60, "y": 8926.5, "width": 1120, "height": 316.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g111"], "frameId": null, "roundness": {"type": 3}, "seed": 1196839237, "version": 1, "versionNonce": 1436400256, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e600", "type": "text", "x": 74, "y": 8940.5, "width": 186.0, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g111"], "frameId": null, "roundness": null, "seed": 846898357, "version": 1, "versionNonce": 257145109, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "schema.sql   -   the claim", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "schema.sql   -   the claim", "autoResize": true, "lineHeight": 1.25}, {"id": "e601", "type": "text", "x": 74, "y": 8966.5, "width": 716.0, "height": 262.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g111"], "frameId": null, "roundness": null, "seed": 359343733, "version": 1, "versionNonce": 1381272297, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "CREATE TABLE inbox (\n  tenant_id   text        NOT NULL,\n  source      text        NOT NULL,     -- 'bus' | 'partner:acme' | ...\n  external_id text        NOT NULL,     -- the sender's event or delivery id\n  body_sha256 bytea       NOT NULL,\n  received_at timestamptz NOT NULL DEFAULT now(),\n  PRIMARY KEY (tenant_id, source, external_id)\n);\nCREATE INDEX inbox_received_at ON inbox (received_at);   -- for the batched purge job\n\n-- claim: returns a row only for the FIRST writer\nINSERT INTO inbox (tenant_id, source, external_id, body_sha256)\nVALUES ($1, $2, $3, $4)\nON CONFLICT (tenant_id, source, external_id) DO NOTHING\nRETURNING 1;", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CREATE TABLE inbox (\n  tenant_id   text        NOT NULL,\n  source      text        NOT NULL,     -- 'bus' | 'partner:acme' | ...\n  external_id text        NOT NULL,     -- the sender's event or delivery id\n  body_sha256 bytea       NOT NULL,\n  received_at timestamptz NOT NULL DEFAULT now(),\n  PRIMARY KEY (tenant_id, source, external_id)\n);\nCREATE INDEX inbox_received_at ON inbox (received_at);   -- for the batched purge job\n\n-- claim: returns a row only for the FIRST writer\nINSERT INTO inbox (tenant_id, source, external_id, body_sha256)\nVALUES ($1, $2, $3, $4)\nON CONFLICT (tenant_id, source, external_id) DO NOTHING\nRETURNING 1;", "autoResize": true, "lineHeight": 1.25}, {"id": "e602", "type": "rectangle", "x": 60, "y": 9267.0, "width": 1120, "height": 131.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g112"], "frameId": null, "roundness": {"type": 3}, "seed": 347155685, "version": 1, "versionNonce": 161427626, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e603", "type": "text", "x": 74, "y": 9281.0, "width": 161.6, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g112"], "frameId": null, "roundness": null, "seed": 446402843, "version": 1, "versionNonce": 1075040594, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "TRAP WORTH NAMING", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "TRAP WORTH NAMING", "autoResize": true, "lineHeight": 1.25}, {"id": "e604", "type": "text", "x": 74, "y": 9304.5, "width": 1068.5, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g112"], "frameId": null, "roundness": null, "seed": 1945534087, "version": 1, "versionNonce": 1743384250, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "It is tempting to range-partition the inbox by day so expiry is a free DROP PARTITION. But a unique key on a partitioned table must include the\npartition column, which silently shrinks your dedupe window to one partition - a duplicate that arrives the next day sails through. Hash-partition on\nthe key and purge in batches by received_at instead. Keep keys for the partner's longest retry horizon plus a margin (30 days is a sound default);\nthey are tiny.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "It is tempting to range-partition the inbox by day so expiry is a free DROP PARTITION. But a unique key on a partitioned table must include the\npartition column, which silently shrinks your dedupe window to one partition - a duplicate that arrives the next day sails through. Hash-partition on\nthe key and purge in batches by received_at instead. Keep keys for the partner's longest retry horizon plus a margin (30 days is a sound default);\nthey are tiny.", "autoResize": true, "lineHeight": 1.25}, {"id": "e605", "type": "rectangle", "x": 1220, "y": 8926.5, "width": 1120, "height": 456.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g113"], "frameId": null, "roundness": {"type": 3}, "seed": 1067462117, "version": 1, "versionNonce": 1181946104, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e606", "type": "text", "x": 1234, "y": 8940.5, "width": 58.4, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g113"], "frameId": null, "roundness": null, "seed": 472500639, "version": 1, "versionNonce": 972780191, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "inbox.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "inbox.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e607", "type": "text", "x": 1234, "y": 8966.5, "width": 900.8, "height": 402.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g113"], "frameId": null, "roundness": null, "seed": 1946177225, "version": 1, "versionNonce": 714756123, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "import { createHash } from 'node:crypto';\nconst sha256 = (buf) => createHash('sha256').update(buf).digest();\n\n/**\n * Runs applyEffect at most once per (tenant, source, externalId).\n * Returns 'applied' | 'duplicate' | 'conflict'.\n *  - duplicate: same id, same body  -> reply 200 with the original result so the sender stops retrying\n *  - conflict : same id, DIFFERENT body -> 409 and raise an alert; that is a bug or an attack, not a retry\n */\nasync function receiveOnce(tx, { tenantId, source, externalId, rawBody }, applyEffect) {\n  const hash = sha256(rawBody);\n  const ins = await tx.query(\n    `INSERT INTO inbox (tenant_id, source, external_id, body_sha256)\n     VALUES ($1, $2, $3, $4) ON CONFLICT (tenant_id, source, external_id) DO NOTHING RETURNING 1`,\n    [tenantId, source, externalId, hash]);\n\n  if (ins.rowCount === 1) { await applyEffect(tx); return 'applied'; }\n\n  const prev = await tx.query(\n    `SELECT body_sha256 FROM inbox WHERE tenant_id = $1 AND source = $2 AND external_id = $3`,\n    [tenantId, source, externalId]);\n  return prev.rows[0].body_sha256.equals(hash) ? 'duplicate' : 'conflict';\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "import { createHash } from 'node:crypto';\nconst sha256 = (buf) => createHash('sha256').update(buf).digest();\n\n/**\n * Runs applyEffect at most once per (tenant, source, externalId).\n * Returns 'applied' | 'duplicate' | 'conflict'.\n *  - duplicate: same id, same body  -> reply 200 with the original result so the sender stops retrying\n *  - conflict : same id, DIFFERENT body -> 409 and raise an alert; that is a bug or an attack, not a retry\n */\nasync function receiveOnce(tx, { tenantId, source, externalId, rawBody }, applyEffect) {\n  const hash = sha256(rawBody);\n  const ins = await tx.query(\n    `INSERT INTO inbox (tenant_id, source, external_id, body_sha256)\n     VALUES ($1, $2, $3, $4) ON CONFLICT (tenant_id, source, external_id) DO NOTHING RETURNING 1`,\n    [tenantId, source, externalId, hash]);\n\n  if (ins.rowCount === 1) { await applyEffect(tx); return 'applied'; }\n\n  const prev = await tx.query(\n    `SELECT body_sha256 FROM inbox WHERE tenant_id = $1 AND source = $2 AND external_id = $3`,\n    [tenantId, source, externalId]);\n  return prev.rows[0].body_sha256.equals(hash) ? 'duplicate' : 'conflict';\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e608", "type": "rectangle", "x": 60, "y": 9448.5, "width": 2280, "height": 52, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g114"], "frameId": null, "roundness": {"type": 3}, "seed": 2139914010, "version": 1, "versionNonce": 1630472360, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e609", "type": "rectangle", "x": 60, "y": 9448.5, "width": 110, "height": 52, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#0b7285", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g114"], "frameId": null, "roundness": null, "seed": 966282699, "version": 1, "versionNonce": 917883966, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e610", "type": "text", "x": 76, "y": 9458.5, "width": 54.6, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g114"], "frameId": null, "roundness": null, "seed": 299780266, "version": 1, "versionNonce": 1176359981, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "05.2", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "05.2", "autoResize": true, "lineHeight": 1.25}, {"id": "e611", "type": "text", "x": 190, "y": 9458.5, "width": 189.2, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g114"], "frameId": null, "roundness": null, "seed": 413191099, "version": 1, "versionNonce": 524169908, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "retry_ladder", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "retry_ladder", "autoResize": true, "lineHeight": 1.25}, {"id": "e612", "type": "rectangle", "x": 60, "y": 9522.5, "width": 2280, "height": 49.2, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": {"type": 3}, "seed": 194807922, "version": 1, "versionNonce": 375154855, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e613", "type": "text", "x": 74, "y": 9536.5, "width": 1829.8, "height": 21.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g115"], "frameId": null, "roundness": null, "seed": 734343277, "version": 1, "versionNonce": 1193730514, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Classify the response, then decide. Retrying a 400 is noise; retrying a 503 is the whole point; a 401 means stop and tell someone. Eight attempts over about 41 hours, then dead-letter - and the ladder is written into the partner contract.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Classify the response, then decide. Retrying a 400 is noise; retrying a 503 is the whole point; a 401 means stop and tell someone. Eight attempts over about 41 hours, then dead-letter - and the ladder is written into the partner contract.", "autoResize": true, "lineHeight": 1.25}, {"id": "e614", "type": "text", "x": 60, "y": 9599.8, "width": 473.8, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 195623613, "version": 1, "versionNonce": 685665214, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "One attempt: gate, send, classify the response", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "One attempt: gate, send, classify the response", "autoResize": true, "lineHeight": 1.25}, {"id": "e615", "type": "rectangle", "x": 60, "y": 9641.8, "width": 2280, "height": 900, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle