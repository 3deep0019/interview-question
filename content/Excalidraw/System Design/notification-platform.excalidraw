81"], "frameId": null, "roundness": null, "seed": 1116311370, "version": 1, "versionNonce": 2001710127, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "\"An event exists if and only if the state change committed.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"An event exists if and only if the state change committed.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1911", "type": "rectangle", "x": 60, "y": 33162.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 957278161, "version": 1, "versionNonce": 2080342548, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1912", "type": "text", "x": 69, "y": 33171.8, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1107297178, "version": 1, "versionNonce": 153205327, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "14-22", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "14-22", "autoResize": true, "lineHeight": 1.25}, {"id": "e1913", "type": "text", "x": 219, "y": 33171.8, "width": 316.0, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 259355805, "version": 1, "versionNonce": 766046561, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Inbox dedupe and the retry ladder. Code one.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Inbox dedupe and the retry ladder. Code one.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1914", "type": "text", "x": 1219, "y": 33171.8, "width": 468.1, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1534570239, "version": 1, "versionNonce": 525545197, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "\"The dedupe record and the effect commit in the same transaction.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"The dedupe record and the effect commit in the same transaction.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1915", "type": "rectangle", "x": 60, "y": 33199.5, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1753496681, "version": 1, "versionNonce": 1782508514, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1916", "type": "text", "x": 69, "y": 33208.5, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1858586731, "version": 1, "versionNonce": 1959673641, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "22-28", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "22-28", "autoResize": true, "lineHeight": 1.25}, {"id": "e1917", "type": "text", "x": 219, "y": 33208.5, "width": 275.2, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 689296675, "version": 1, "versionNonce": 1673156816, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Signing, PII layers, consent at dispatch.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Signing, PII layers, consent at dispatch.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1918", "type": "text", "x": 1219, "y": 33208.5, "width": 512.6, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1527261235, "version": 1, "versionNonce": 1864212207, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "\"Consent is a decision at send time, a pure function of a ledger snapshot.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Consent is a decision at send time, a pure function of a ledger snapshot.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1919", "type": "rectangle", "x": 60, "y": 33236.2, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 819026902, "version": 1, "versionNonce": 1237620125, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1920", "type": "text", "x": 69, "y": 33245.2, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1613438839, "version": 1, "versionNonce": 1928531564, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "28-34", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "28-34", "autoResize": true, "lineHeight": 1.25}, {"id": "e1921", "type": "text", "x": 219, "y": 33245.2, "width": 289.9, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 131443187, "version": 1, "versionNonce": 626080956, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Audit chain and tenant isolation with RLS.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Audit chain and tenant isolation with RLS.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1922", "type": "text", "x": 1219, "y": 33245.2, "width": 650.0, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1874330928, "version": 1, "versionNonce": 231259407, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "\"A hash chain only proves tampering if its head is signed and stored out of the admin's reach.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"A hash chain only proves tampering if its head is signed and stored out of the admin's reach.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1923", "type": "rectangle", "x": 60, "y": 33273.0, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 2048811038, "version": 1, "versionNonce": 1569694367, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1924", "type": "text", "x": 69, "y": 33282.0, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1062582505, "version": 1, "versionNonce": 958720165, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "34-40", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "34-40", "autoResize": true, "lineHeight": 1.25}, {"id": "e1925", "type": "text", "x": 219, "y": 33282.0, "width": 308.1, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1102333572, "version": 1, "versionNonce": 55065431, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Failure modes, fairness, what breaks at 10x.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Failure modes, fairness, what breaks at 10x.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1926", "type": "text", "x": 1219, "y": 33282.0, "width": 500.5, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1139262630, "version": 1, "versionNonce": 1727655210, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "\"Fail closed on what can hurt a person; toward delivery on what cannot.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Fail closed on what can hurt a person; toward delivery on what cannot.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1927", "type": "rectangle", "x": 60, "y": 33309.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 1153910510, "version": 1, "versionNonce": 288560884, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1928", "type": "text", "x": 69, "y": 33318.8, "width": 41.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 44426726, "version": 1, "versionNonce": 522993458, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "40-45", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "40-45", "autoResize": true, "lineHeight": 1.25}, {"id": "e1929", "type": "text", "x": 219, "y": 33318.8, "width": 584.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 2077532142, "version": 1, "versionNonce": 190237413, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Trade-offs you made, then the AI answer: where it helps, where you refuse to trust it.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Trade-offs you made, then the AI answer: where it helps, where you refuse to trust it.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1930", "type": "text", "x": 1219, "y": 33318.8, "width": 848.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 480389909, "version": 1, "versionNonce": 1329462213, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "\"AI speeds up producing and attacking designs. Deterministic, auditable and legally accountable parts stay in tested code.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"AI speeds up producing and attacking designs. Deterministic, auditable and legally accountable parts stay in tested code.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1931", "type": "line", "x": 210, "y": 33019.0, "width": 0, "height": 327.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 391687762, "version": 1, "versionNonce": 360520483, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [0, 327.5]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e1932", "type": "line", "x": 1210, "y": 33019.0, "width": 0, "height": 327.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g381"], "frameId": null, "roundness": null, "seed": 220493776, "version": 1, "versionNonce": 669827866, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [0, 327.5]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e1933", "type": "text", "x": 60, "y": 33390.5, "width": 360.6, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 537854629, "version": 1, "versionNonce": 1192627011, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Five sentences that carry the round", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Five sentences that carry the round", "autoResize": true, "lineHeight": 1.25}, {"id": "e1934", "type": "rectangle", "x": 60, "y": 33432.0, "width": 1120, "height": 186.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g382"], "frameId": null, "roundness": {"type": 3}, "seed": 1754824160, "version": 1, "versionNonce": 2051607197, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1935", "type": "text", "x": 74, "y": 33446.0, "width": 94.5, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g382"], "frameId": null, "roundness": null, "seed": 64582470, "version": 1, "versionNonce": 41771064, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Say these", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Say these", "autoResize": true, "lineHeight": 1.25}, {"id": "e1936", "type": "text", "x": 74, "y": 33477.0, "width": 1074.4, "height": 127.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g382"], "frameId": null, "roundness": null, "seed": 207170727, "version": 1, "versionNonce": 1989239193, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "1.  \"Exactly-once is an illusion; I build at-least-once with idempotent receivers, and the dedupe record commits in the same transaction as\nthe effect.\"\n2.  \"I promise a per-loan sequence and full-state payloads, not ordering - so out-of-order delivery is harmless.\"\n3.  \"Consent is evaluated at send time as a pure function of a ledger snapshot; compliance owns the legal-basis mapping as data.\"\n4.  \"A hash chain proves tampering only if its head is signed and stored somewhere the database administrator cannot rewrite.\"\n5.  \"Isolation is enforced in the database, so a forgotten WHERE clause is a failed request, not a data breach.\"", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1.  \"Exactly-once is an illusion; I build at-least-once with idempotent receivers, and the dedupe record commits in the same transaction as\nthe effect.\"\n2.  \"I promise a per-loan sequence and full-state payloads, not ordering - so out-of-order delivery is harmless.\"\n3.  \"Consent is evaluated at send time as a pure function of a ledger snapshot; compliance owns the legal-basis mapping as data.\"\n4.  \"A hash chain proves tampering only if its head is signed and stored somewhere the database administrator cannot rewrite.\"\n5.  \"Isolation is enforced in the database, so a forgotten WHERE clause is a failed request, not a data breach.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1937", "type": "rectangle", "x": 1220, "y": 33432.0, "width": 1120, "height": 131.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g383"], "frameId": null, "roundness": {"type": 3}, "seed": 1501020795, "version": 1, "versionNonce": 1586450549, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1938", "type": "text", "x": 1234, "y": 33446.0, "width": 291.8, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g383"], "frameId": null, "roundness": null, "seed": 418941704, "version": 1, "versionNonce": 561393672, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "IF THEY SAY \"NOW MAKE IT 10X BIGGER\"", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "IF THEY SAY \"NOW MAKE IT 10X BIGGER\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1939", "type": "text", "x": 1234, "y": 33469.5, "width": 1088.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g383"], "frameId": null, "roundness": null, "seed": 37983282, "version": 1, "versionNonce": 1798156473, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Go in this order: bulkheads and per-tenant fair scheduling first (the thing that actually breaks), then batch and partition the delivery table or move\nscheduling to a managed task queue, then larger audit batches with a chain per tenant shard, then push-provider quotas requested ahead of known\npeaks. Quantify each: \"the delivery table is the first real limit, at roughly 6-8k writes a second, so that is where I would load-test before believing any\nother number.\"", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Go in this order: bulkheads and per-tenant fair scheduling first (the thing that actually breaks), then batch and partition the delivery table or move\nscheduling to a managed task queue, then larger audit batches with a chain per tenant shard, then push-provider quotas requested ahead of known\npeaks. Quantify each: \"the delivery table is the first real limit, at roughly 6-8k writes a second, so that is where I would load-test before believing any\nother number.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1940", "type": "rectangle", "x": 60, "y": 33654.5, "width": 2280, "height": 71.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g384"], "frameId": null, "roundness": {"type": 3}, "seed": 1287197960, "version": 1, "versionNonce": 1367597456, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1941", "type": "text", "x": 74, "y": 33668.5, "width": 85.3, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g384"], "frameId": null, "roundness": null, "seed": 1237986807, "version": 1, "versionNonce": 996303784, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "COLOPHON", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "COLOPHON", "autoResize": true, "lineHeight": 1.25}, {"id": "e1942", "type": "text", "x": 74, "y": 33692.0, "width": 1716.0, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g384"], "frameId": null, "roundness": null, "seed": 1122943405, "version": 1, "versionNonce": 511890022, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Notification Platform Kit - JavaScript + Postgres. All code is illustrative and written to be explained aloud, not pasted into production. Regulatory points (DPDP, RBI) are design considerations, not legal advice - confirm with compliance.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notification Platform Kit - JavaScript + Postgres. All code is illustrative and written to be explained aloud, not pasted into production. Regulatory points (DPDP, RBI) are design considerations, not legal advice - confirm with compliance.", "autoResize": true, "lineHeight": 1.25}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}