: 2280, "height": 49.2, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g168"], "frameId": null, "roundness": {"type": 3}, "seed": 467389989, "version": 1, "versionNonce": 80432959, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e874", "type": "text", "x": 74, "y": 13299.5, "width": 2088.8, "height": 21.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g168"], "frameId": null, "roundness": null, "seed": 791795596, "version": 1, "versionNonce": 730180007, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Chain the batches, Merkle-hash within a batch. Chaining every record forces a serial writer; chaining batches keeps the writer cheap and still makes any change to any record detectable. Then sign the head and store it where a database administrator cannot rewrite it.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Chain the batches, Merkle-hash within a batch. Chaining every record forces a serial writer; chaining batches keeps the writer cheap and still makes any change to any record detectable. Then sign the head and store it where a database administrator cannot rewrite it.", "autoResize": true, "lineHeight": 1.25}, {"id": "e875", "type": "rectangle", "x": 60, "y": 13362.8, "width": 2280, "height": 800, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g169"], "frameId": null, "roundness": {"type": 3}, "seed": 303588663, "version": 1, "versionNonce": 94846911, "isDeleted": false, "boundEl