t": 1.25}, {"id": "e1807", "type": "text", "x": 629, "y": 31048.0, "width": 407.6, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 473632484, "version": 1, "versionNonce": 167045215, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Non-deterministic, adds latency, sends data to a third party", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Non-deterministic, adds latency, sends data to a third party", "autoResize": true, "lineHeight": 1.25}, {"id": "e1808", "type": "text", "x": 1389, "y": 31048.0, "width": 508.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 2005699827, "version": 1, "versionNonce": 1328548472, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Schema-driven masking; DLP or regex only as an offline detective control", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Schema-driven masking; DLP or regex only as an offline detective control", "autoResize": true, "lineHeight": 1.25}, {"id": "e1809", "type": "rectangle", "x": 60, "y": 31075.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 1861335657, "version": 1, "versionNonce": 801216348, "isDeleted": false, "boundElements": null, "updated": 17