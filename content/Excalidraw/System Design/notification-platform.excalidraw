: null, "locked": false}, {"id": "e46", "type": "rectangle", "x": 60, "y": 441.0, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g17"], "frameId": null, "roundness": {"type": 3}, "seed": 1233565528, "version": 1, "versionNonce": 644780075, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e47", "type": "text", "x": 74, "y": 448.0, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g17"], "frameId": null, "roundness": null, "seed": 1127850897, "version": 1, "versionNonce": 1063254276, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "01", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "01", "autoResize": true, "lineHeight": 1.25}, {"id": "e48", "type": "text", "x": 144, "y": 443.0, "width": 300.7, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g17"], "frameId": null, "roundness": null, "seed": 1879343460, "version": 1, "versionNonce": 737608423, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Frame the problem", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Frame the problem", "autoResize": true, "lineHeight": 1.25}, {"id": "e49", "type": "text", "x": 60, "y": 503.0, "width": 1268.5, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1566471825, "version": 1, "versionNonce": 963864094, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Spend the first four minutes here. In a regulated lender, the requirements section is where you show you know what can go wrong, not how fast it can go.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Spend the first four minutes here. In a regulated lender, the requirements section is where you show you know what can go wrong, not how fast it can go.", "autoResize": true, "lineHeight": 1.25}, {"id": "e50", "type": "rectangle", "x": 60, "y": 553.5, "width": 1120, "height": 259.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g18"], "frameId": null, "roundness": {"type": 3}, "seed": 618341637, "version": 1, "versionNonce": 1307729535, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e51", "type": "text", "x": 74, "y": 567.5, "width": 156.9, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g18"], "frameId": null, "roundness": null, "seed": 2104909469, "version": 1, "versionNonce": 157197672, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Questions to ask", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Questions to ask", "autoResize": true, "lineHeight": 1.25}, {"id": "e52", "type": "text", "x": 74, "y": 598.5, "width": 1088.8, "height": 200.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g18"], "frameId": null, "roundness": null, "seed": 253544329, "version": 1, "versionNonce": 1099367391, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "- Who consumes events? Borrowers (in-app inbox, push, SMS), partner systems (webhooks), internal teams (the bus)? Each has a different\nguarantee.\n- How critical is each event class? Disbursement confirmed and mandate bounced are critical; KYC outcome is high; reminders and nudges are low.\nCriticality drives lanes, retries and SMS fallback.\n- What ordering do consumers need? Usually per loan, not global - and it is far cheaper if status events carry full state.\n- What is a tenant? An internal team, a product line, or a separate legal entity? Can tenants share a partner? Can one ever see another's events?\n- Which notifications rest on consent, and which on another legal basis? Who owns that mapping - engineering or compliance?\n- What must the audit trail prove, to whom, for how long? Internal audit, a regulator inspection, a partner dispute?\n- Which fields may ever leave our boundary? Per partner, in writing.\n- How do partners really behave? They retry, duplicate, reorder, and go down for a day. Do they sign callbacks? Do they allowlist our IPs?", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "- Who consumes events? Borrowers (in-app inbox, push, SMS), partner systems (webhooks), internal teams (the bus)? Each has a different\nguarantee.\n- How critical is each event class? Disbursement confirmed and mandate bounced are critical; KYC outcome is high; reminders and nudges are low.\nCriticality drives lanes, retries and SMS fallback.\n- What ordering do consumers need? Usually per loan, not global - and it is far cheaper if status events carry full state.\n- What is a tenant? An internal team, a product line, or a separate legal entity? Can tenants share a partner? Can one ever see another's events?\n- Which notifications rest on consent, and which on another legal basis? Who owns that mapping - engineering or compliance?\n- What must the audit trail prove, to whom, for how long? Internal audit, a regulator inspection, a partner dispute?\n- Which fields may ever leave our boundary? Per partner, in writing.\n- How do partners really behave? They retry, duplicate, reorder, and go down for a day. Do they sign callbacks? Do they allowlist our IPs?", "autoResize": true, "lineHeight": 1.25}, {"id": "e53", "type": "text", "x": 1220, "y": 551.5, "width": 414.1, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 897911925, "version": 1, "versionNonce": 354253419, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "The requirements you write on the board", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The requirements you write on the board", "autoResize": true, "lineHeight": 1.25}, {"id": "e54", "type": "rectangle", "x": 1220, "y": 591.5, "width": 1120, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1625947776, "version": 1, "versionNonce": 734559256, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e55", "type": "text", "x": 1229, "y": 599.5, "width": 69.2, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 326384299, "version": 1, "versionNonce": 2004182514, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Functional", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Functional", "autoResize": true, "lineHeight": 1.25}, {"id": "e56", "type": "text", "x": 1789, "y": 599.5, "width": 95.9, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1050040258, "version": 1, "versionNonce": 905590325, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Non-functional", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Non-functional", "autoResize": true, "lineHeight": 1.25}, {"id": "e57", "type": "rectangle", "x": 1220, "y": 625.0, "width": 1120, "height": 55.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 84196940, "version": 1, "versionNonce": 2065920251, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e58", "type": "text", "x": 1229, "y": 634.0, "width": 520.7, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1434982633, "version": 1, "versionNonce": 166688708, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Fan each domain event out to borrower channels and partner webhooks by\nper-tenant routing rules", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Fan each domain event out to borrower channels and partner webhooks by\nper-tenant routing rules", "autoResize": true, "lineHeight": 1.25}, {"id": "e59", "type": "text", "x": 1789, "y": 634.0, "width": 498.9, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1641903440, "version": 1, "versionNonce": 1198458558, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Zero loss: a committed state change is delivered or dead-lettered, never\nsilently dropped", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Zero loss: a committed state change is delivered or dead-lettered, never\nsilently dropped", "autoResize": true, "lineHeight": 1.25}, {"id": "e60", "type": "rectangle", "x": 1220, "y": 680.5, "width": 1120, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1230563834, "version": 1, "versionNonce": 1694566832, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e61", "type": "text", "x": 1229, "y": 689.5, "width": 491.1, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1880074284, "version": 1, "versionNonce": 1757400422, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Accept partner callbacks idempotently - duplicates, retries, out-of-order", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Accept partner callbacks idempotently - duplicates, retries, out-of-order", "autoResize": true, "lineHeight": 1.25}, {"id": "e62", "type": "text", "x": 1789, "y": 689.5, "width": 515.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 673767655, "version": 1, "versionNonce": 730407202, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Dispatch p99 < 5 s from commit; first webhook attempt in the same budget", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Dispatch p99 < 5 s from commit; first webhook attempt in the same budget", "autoResize": true, "lineHeight": 1.25}, {"id": "e63", "type": "rectangle", "x": 1220, "y": 717.2, "width": 1120, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1493135432, "version": 1, "versionNonce": 752002366, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e64", "type": "text", "x": 1229, "y": 726.2, "width": 412.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor