ull, "locked": false, "text": "Targets that are not borrowers", "fontSize": 17, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Targets that are not borrowers", "autoResize": true, "lineHeight": 1.25}, {"id": "e1031", "type": "text", "x": 121, "y": 15786.6, "width": 638, "height": 35.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g208"], "frameId": null, "roundness": null, "seed": 346237381, "version": 1, "versionNonce": 1367027484, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "partner webhooks: ConsentPolicy.NOT_APPLICABLE (allow = true, decisionId null). What a\npartner may receive is set by contract and a per-partner field allowlist", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "partner webhooks: ConsentPolicy.NOT_APPLICABLE (allow = true, decisionId null). What a\npartner may receive is set by contract and a per-partner field allowlist", "autoResize": true, "lineHeight": 1.25}, {"id": "e1032", "type": "rectangle", "x": 60, "y": 15935.5, "width": 1120, "height": 474.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g209"], "frameId": null, "roundness": {"type": 3}, "seed": 2010911763, "version": 1, "versionNonce": 597426025, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1033", "type": "text", "x": 74, "y": 15949.5, "width": 123.8, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g209"], "frameId": null, "roundness": null, "seed": 1459601587, "version": 1, "versionNonce": 703997386, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "consent-policy.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "consent-policy.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e1034", "type": "text", "x": 74, "y": 15975.5, "width": 976.4, "height": 420.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g209"], "frameId": null, "roundness": null, "seed": 1922885004, "version": 1, "versionNonce": 809259524, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "class ConsentPolicy {\n  static NOT_APPLICABLE = Object.freeze({\n    allow: true, reason: 'not_applicable', basis: 'n/a', decisionId: null, ledgerVersion: null });\n\n  constructor({ ledger, newId }) { this.ledger = ledger; this.newId = newId; }\n\n  async decide({ borrowerRef, purpose, channel, legalBasis }) {\n    const snap  = await this.ledger.snapshot(borrowerRef);     // { version, latest(purpose, channel) }\n    const entry = snap.latest(purpose, channel);               // status: granted | withdrawn | objected | undefined\n\n    let allow, reason;\n    if (legalBasis === 'consent') {\n      allow  = entry?.status === 'granted';\n      reason = allow ? 'consent_granted' : entry ? `consent_${entry.status}` : 'no_consent_on_record';\n    } else if (legalBasis === 'legitimate_use') {\n      allow  = entry?.status !== 'objected';\n      reason = allow ? 'legitimate_use' : 'objection_on_record';\n    } else {\n      allow = false; reason = 'unclassified_template';          // fail closed on anything unclassified\n    }\n    return new ConsentDecision({ allow, reason, basis: legalBasis,\n                                 decisionId: this.newId(), ledgerVersion: snap.version });\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class ConsentPolicy {\n  static NOT_APPLICABLE = Object.freeze({\n    allow: true, reason: 'not_applicable', basis: 'n/a', decisionId: null, ledgerVersion: null });\n\n  constructor({ ledger, newId }) { this.ledger = ledger; this.newId = newId; }\n\n  async decide({ borrowerRef, purpose, channel, legalBasis }) {\n    const snap  = await this.ledger.snapshot(borrowerRef);     // { version, latest(purpose, channel) }\n    const entry = snap.latest(purpose, channel);               // status: granted | withdrawn | objected | undefined\n\n    let allow, reason;\n    if (legalBasis === 'consent') {\n      allow  = entry?.status === 'granted';\n      reason = allow ? 'consent_granted' : entry ? `consent_${entry.status}` : 'no_consent_on_record';\n    } else if (legalBasis === 'legitimate_use') {\n      allow  = entry?.status !== 'objected';\n      reason = allow ? 'legitimate_use' : 'objection_on_record';\n    } else {\n      allow = false; reason = 'unclassified_template';          // fail closed on anything unclassified\n    }\n    return new ConsentDecision({ allow, reason, basis: legalBasis,\n                                 decisionId: this.newId(), ledgerVersion: snap.version });\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e1035", "type": "rectangle", "x": 1220, "y": 15935.5, "width": 1120, "height": 131.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g210"], "frameId": null, "roundness": {"type": 3}, "seed": 362370773, "version": 1, "versionNonce": 1701073679, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1036", "type": "text", "x": 1234, "y": 15949.5, "width": 132.8, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g210"], "frameId": null, "roundness": null, "seed": 1685494026, "version": 1, "versionNonce": 567667671, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "WHO OWNS WHAT", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHO OWNS WHAT", "autoResize": true, "lineHeight": 1.25}, {"id": "e1037", "type": "text", "x": 1234, "y": 15973.0, "width": 1072.2, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g210"], "frameId": null, "roundness": null, "seed": 247129618, "version": 1, "versionNonce": 1649838084, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Engineering owns the evaluator; compliance owns the mapping of each template to a legal basis, stored as data on the template so it can change\nwithout a deploy. Consent must be specific to a purpose and withdrawable as easily as it was given, and withdrawal has to beat anything already\nqueued - hence evaluation at dispatch time. Whether a given notification qualifies as a legitimate use is a legal determination, and I would confirm\nwith compliance which DPDP provisions are in force rather than quote a timeline from memory.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Engineering owns the evaluator; compliance owns the mapping of each template to a legal basis, stored as data on the template so it can change\nwithout a deploy. Consent must be specific to a purpose and withdrawable as easily as it was given, and withdrawal has to beat anything already\nqueued - hence evaluation at dispatch time. Whether a given notification qualifies as a legitimate use is a legal determination, and I would confirm\nwith compliance which DPDP provisions are in force rather than quote a timeline from memory.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1038", "type": "rectangle", "x": 60, "y": 16459.5, "width": 2280, "height": 52, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g211"], "frameId": null, "roundness": {"type": 3}, "seed": 1139715181, "version": 1, "versionNonce": 104306663, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1039", "type": "rectangle", "x": 60, "y": 16459.5, "width": 110, "height": 52, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#0b7285", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g211"], "frameId": null, "roundness": null, "seed": 1366483948, "version": 1, "versionNonce": 1843161526, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1040", "type": "text", "x": 76, "y": 16469.5, "width": 54.6, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g211"], "frameId": null, "roundness": null, "seed": 772619777, "version": 1, "versionNonce": 2074801886, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "05.6", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "05.6", "autoResize": true, "lineHeight": 1.25}, {"id": "e1041", "type": "text", "x": 190, "y": 16469.5, "width": 173.6, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g211"], "frameId": null, "roundness": null, "seed": 1874650360, "version": 1, "versionNonce": 972892965, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "pii_masking", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "pii_masking", "autoResize": true, "lineHeight": 1.25}, {"id": "e1042", "type": "rectangle", "x": 60, "y": 16533.5, "width": 2280, "height": 49.2, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g212"], "frameId": null, "roundness": {"type": 3}, "seed": 1192240239, "version": 1, "versionNonce": 1119810743, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1043", "type": "text", "x": 74, "y": 16547.5, "width": 1961.4, "height": 21.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g212"], "frameId": null, "roundness": null, "seed": 1245634327, "version": 1, "versionNonce": 1479033640, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Make the unsafe thing impossible to do by accident. Raw PII lives in the vault. Everything else holds a token or a Pii wrapper that renders masked in every implicit conversion: string interpolation, JSON, console.log. Revealing is an explicit, audited call.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Make the unsafe thing impossible to do by accident. Raw PII lives in the vault. Everything else holds a token or a Pii wrapper that renders masked in every implicit conversion: string interpolation, JSON, console.log. Revealing is an explicit, audited call.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1044", "type": "rectangle", "x": 60, "y": 16610.8, "width": 2280, "height": 640, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g213"], "frameId": null, "roundness": {"type": 3}, "seed": 1895229344, "version": 1, "versionNonce": 1924362394, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1045", "type": "text", "x": 110, "y": 16626.8, "width": 824.4, "height": 21.2, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 224645687, "version": 1, "versionNonce": 541233724, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "SIX LAYERS, STRONGEST FIRST  -  prevent by construction on the left, detect after the fact on the right", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "SIX LAYERS, STRONGEST FIRST  -  prevent by construction on the left, detect after the fact on the right", "autoResize": true, "lineHeight": 1.25}, {"id": "e1046", "type": "rectangle", "x": 110, "y": 16670.8, "width": 330, "height": 170, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g214"], "frameId": null, "roundness": {"type": 3}, "seed": 2132353792, "version": 1, "versionNonce": 1150409724, "isDeleted": false, "boundElements": [{"id": "e1052", "type": "arrow"}], "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1047", "type": "text", "x": 121, "y": 16722.8, "width": 308, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g214"], "frameId": null, "roundness": null, "seed": 1352434115, "version": 1, "versionNonce": 1839533183, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "1  Tokens, not values", "fontSize": 18, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "1  Tokens, not values", "autoResize": true, "lineHeight": 1.25}, {"id": "e1048", "type": "text", "x": 121, "y": 16751.2, "width": 308, "height": 37.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g214"], "frameId": null, "roundness": null, "seed": 846659187, "version": 1, "versionNonce": 1584677836, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "events carry tokens; raw PII lives in the\nTokenVault", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "events carry tokens; raw PII lives in the\nTokenVault", "autoResize": true, "lineHeight": 1.25}, {"id": "e1049", "type": "rectangle", "x": 480, "y": 16670.8, "width": 330, "height": 170, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g215"], "frameId": null, "roundness": {"type": 3}, "seed": 1712984588, "version": 1, "versionNonce": 797717635, "isDeleted": false, "boundElements": [{"id": "e1052", "type": "arrow"}, {"id": "e1056", "type": "arro