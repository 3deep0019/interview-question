tent; FOR UPDATE SKIP LOCKED workers;\ntrivially inspectable", "autoResize": true, "lineHeight": 1.25}, {"id": "e316", "type": "text", "x": 1229, "y": 3850.5, "width": 538.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g67"], "frameId": null, "roundness": null, "seed": 728246375, "version": 1, "versionNonce": 904684348, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "6-8k writes/s is the limit you must measure; vacuum and partitioning discipline", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "6-8k writes/s is the limit you must measure; vacuum and partitioning discipline", "autoResize": true, "lineHeight": 1.25}, {"id": "e317", "type": "text", "x": 1789, "y": 3850.5, "width": 496.8, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g67"], "frameId": null, "roundness": null, "seed": 420358476, "version": 1, "versionNonce": 765824443, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "<= ~10k deliveries/s, and you want transactional enqueue with the audit\nrecord", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "<= ~10k deliveries/s, and you want transactional enqueue with the audit\nrecord", "autoResize": true, "lineHeight": 1.25}, {"id": "e318", "type": "rectangle", "x": 60, "y": 3897.0, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g67"], "frameId": null, "