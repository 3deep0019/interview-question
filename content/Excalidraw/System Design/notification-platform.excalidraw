": 340, "y": 6328.2, "width": 60, "height": 0.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1028666489, "version": 1, "versionNonce": 1955212270, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [60, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e462", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e465", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e494", "type": "arrow", "x": 650, "y": 6328.2, "width": 80, "height": 0.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1468227196, "version": 1, "versionNonce": 617013205, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [80, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e465", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e470", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e495", "type": "arrow", "x": 1010, "y": 6328.2, "width": 60, "height": 0.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1647055768, "version": 1, "versionNonce": 100389471, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [60, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e470", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e473", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e496", "type": "text", "x": 1026.3, "y": 6306.7, "width": 27.5, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1324941616, "version": 1, "versionNonce": 1358912275, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "first", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "first", "autoResize": true, "lineHeight": 1.25}, {"id": "e497", "type": "arrow", "x": 1340, "y": 6328.2, "width": 60, "height": 0.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1380322991, "version": 1, "versionNonce": 425824803, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [60, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e473", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e476", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e498", "type": "arrow", "x": 1670, "y": 6328.2, "width": 60, "height": 0.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 166369464, "version": 1, "versionNonce": 1287857265, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [60, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e476", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e479", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e499", "type": "arrow", "x": 1880, "y": 6328.2, "width": 60, "height": 0.0, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 316592941, "version": 1, "versionNonce": 712476974, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [60, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e479", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e481", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e500", "type": "text", "x": 1896.7, "y": 6306.7, "width": 26.7, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 545332599, "version": 1, "versionNonce": 1399159378, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "yes", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "yes", "autoResize": true, "lineHeight": 1.25}, {"id": "e501", "type": "arrow", "x": 870.0, "y": 6388.2, "width": 5.0, "height": 30.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 1596046910, "version": 1, "versionNonce": 1487963129, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0.0, 0.0], [0.0, 15.0], [-5.0, 15.0], [-5.0, 30.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e470", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e484", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e502", "type": "arrow", "x": 1805.0, "y": 6388.2, "width": 31.5, "height": 30.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 653730826, "version": 1, "versionNonce": 1333911086, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0.0, 0.0], [0.0, 15.0], [31.5, 15.0], [31.5, 30.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e479", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e487", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e503", "type": "arrow", "x": 2105.0, "y": 6388.2, "width": 0.0, "height": 30.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1219258965, "version": 1, "versionNonce": 286562392, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0.0, 0.0], [0.0, 30.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e481", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e490", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e504", "type": "text", "x": 130, "y": 6538.2, "width": 1008.3, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 26777431, "version": 1, "versionNonce": 1035990566, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "The loop 2 -> 3 -> 4 repeats for every target. A rollback anywhere (including the inbox claim) leaves no trace, so a redelivery starts clean.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The loop 2 -> 3 -> 4 repeats for every target. A rollback anywhere (including the inbox claim) leaves no trace, so a redelivery starts clean.", "autoResize": true, "lineHeight": 1.25}, {"id": "e505", "type": "rectangle", "x": 60, "y": 6638.2, "width": 1120, "height": 859.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g95"], "frameId": null, "roundness": {"type": 3}, "seed": 130268530, "version": 1, "versionNonce": 1043243375, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e506", "type": "text", "x": 74, "y": 6652.2, "width": 280.4, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g95"], "frameId": null, "roundness": null, "seed": 577185114, "version": 1, "versionNonce": 2088447191, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "contracts.js   -   the whole API surface", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "contracts.js   -   the whole API surface", "autoResize": true, "lineHeight": 1.25}, {"id": "e507", "type": "text", "x": 74, "y": 6678.2, "width": 1001.6, "height": 805.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g95"], "frameId": null, "roundness": null, "seed": 1443112403, "version": 1, "versionNonce": 213715570, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "// ---------- value objects ----------\n\n/** The data field carries tokens and non-PII business fields only. */\nclass EventEnvelope {\n  constructor({ id, tenantId, type, schemaVersion, aggregateId, sequence, occurredAt, traceId, data }) {\n    Object.assign(this, { id, tenantId, type, schemaVersion, aggregateId, sequence, occurredAt, traceId, data });\n    Object.freeze(this);\n  }\n}\n\nclass Endpoint {\n  constructor({ id, tenantId, partnerId, url, secrets, status, maxConcurrency, fieldAllowlist }) {\n    Object.assign(this, { id, tenantId, partnerId, url, secrets, status, maxConcurrency, fieldAllowlist });\n    // secrets: [{ kid, secret, notBefore, notAfter }]  -- two live at once during rotation\n    // status : 'active' | 'paused' | 'disabled'\n  }\n}\n\nclass Delivery {\n  // state: 'pending' | 'in_flight' | 'retrying' | 'delivered' | 'dead'\n  constructor({ id, eventId, tenantId, channel, target, lane, attempt = 0, state = 'pending', nextAttemptAt }) {\n    Object.assign(this, { id, eventId, tenantId, channel, target, lane, attempt, state, nextAttemptAt });\n  }\n}\n\nclass ConsentDecision {\n  constructor({ allow, reason, basis, decisionId, ledgerVersion }) {\n    Object.assign(this, { allow, reason, basis, decisionId, ledgerVersion });\n    Object.freeze(this);\n  }\n}\n\n// ---------- STRATEGY: one interface per channel ----------\n\nclass Channel {\n  /** @returns {Promise<{ outcome: 'ok'|'retry'|'dead'|'pause'|'disable', retryAfterMs?: number, status?: number }>} */\n  async send(delivery, payload, ctx) { throw new Error('Channel.send not implemented'); }\n}\n\n// ---------- PORTS: all outside-world access, all injectable ----------\n\nclass TokenVault   { async tokenize(kind, value) {}  async reveal(token, { purpose, actor }) {} }\nclass ConsentLedger{ async snapshot(borrowerRef) {} }           // append-only; returns latest state + version\nclass AuditSink    { async intent(tx, tenantId, record) {} }     // writes to the audit OUTBOX inside tx\nconst SystemClock = { now: () => Date.now() };\nconst SystemRng   = { next: () => Math.random() };", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "// ---------- value objects ----------\n\n/** The data field carries tokens and non-PII business fields only. */\nclass EventEnvelope {\n  constructor({ id, tenantId, type, schemaVersion, aggregateId, sequence, occurredAt, traceId, data }) {\n    Object.assign(this, { id, tenantId, type, schemaVersion, aggregateId, sequence, occurredAt, traceId, data });\n    Object.freeze(this);\n  }\n}\n\nclass Endpoint {\n  constructor({ id, tenantId, partnerId, url, secrets, status, maxConcurrency, fieldAllowlist }) {\n    Object.assign(this, { id, tenantId, partnerId, url, secrets, status, maxConcurrency, fieldAllowlist });\n    // secrets: [{ kid, secret, notBefore, notAfter }]  -- two live at once during rotation\n    // status : 'active' | 'paused' | 'disabled'\n  }\n}\n\nclass Delivery {\n  // state: 'pending' | 'in_flight' | 'retrying' | 'delivered' | 'dead'\n  constructor({ id, eventId, tenantId, channel, target, lane, attempt = 0, state = 'pending', nextAttemptAt }) {\n    Object.assign(this, { id, eventId, tenantId, channel, target, lane, attempt, state, nextAttemptAt });\n  }\n}\n\nclass ConsentDecision {\n  constructor({ allow, reason, basis, decisionId, ledgerVersion }) {\n    Object.assign(this, { allow, reason, basis, decisionId, ledgerVersion });\n    Object.freeze(this);\n  }\n}\n\n// ---------- STRATEGY: one interface per channel ----------\n\nclass Channel {\n  /** @returns {Promise<{ outcome: 'ok'|'retry'|'dead'|'pause'|'disable', retryAfterMs?: number, status?: number }>} */\n  async send(delivery, payload, ctx) { throw new Error('Channel.send not implemented'); }\n}\n\n// ---------- PORTS: all outside-world access, all injectable ----------\n\nclass TokenVault   { async tokenize(kind, value) {}  async reveal(token, { purpose, actor }) {} }\nclass ConsentLedger{ async snapshot(borrowerRef) {} }           // append-only; returns latest state + version\nclass AuditSink    { async intent(tx, tenantId, record) {} }     // writes to the audit OUTBOX inside tx\nconst SystemClock = { now: () => Date.now() };\nconst SystemRng   = { next: () => Math.random() };", "autoResize": true, "lineHeight": 1.25}, {"id": "e508", "type": "rectangle", "x": 1220, "y": 6638.2, "width": 1120, "height": 736.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g96"], "frameId": null, "roundness": {"type": 3}, "seed": 1486456352, "version": 1, "versionNonce": 467493146, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e509", "type": "text", "x": 1234, "y": 6652.2, "width": 418.8, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g96"], "frameId": null, "roundness": null, "seed": 1451071152, "version": 1, "versionNonce": 1051438732, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "dispatcher.js   -   Chain of Responsibility, one transaction", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "dispatcher.js   -   Chain of Responsibility, one transaction", "autoResize": true, "lineHeight": 1.25}, {"id": "e510", "type": "text", "x": 1234, "y": 6678.2, "width": 833.6, "height": 682.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g96"], "frameId": null, "roundness": null, "seed": 624609530, "version": 1, "versionNonce": 1522288719, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "class Dispatcher {\n  constructor({ db, router, consent, audit, clock = SystemClock }) {\n    Object.assign(this, { db, router, consent, audit, clock });\n  }\n\n  /** Called once per bus message. The bus is at-least-once, so this MUST be idempotent. */\n  async handle(envelope) {\n    const targets = this.router.resolve(envelope);          // tenant routing rules -> targets\n\n    await this.db.withTenant(envelope.tenantId, async (tx) => {\n      // 1. inbox: claim the event id inside the same tx as everything below\n      const first = await tx.claimInbox(envelope.tenantId, 'bus', envelope.id, envelope);\n      if (!first) return;                                   // duplicate bus delivery: ack and stop\n\n      for (const target of targets) {\n        // 2. consent / legal basis, evaluated NOW, not when the event was created\n        const decision = target.audience === 'borrower'\n          ? await this.consent.decide({ borrowerRef: envelope.data.borrower_ref,\n                                        purpose: target.purpose, channel: target.channel,\n                                        legalBasis: target.legalBasis })\n          : ConsentPolicy.NOT_APPLICABLE;\n\n        // 3. audit INTENT goes to the audit outbox in the same tx: it cannot be lost\n        await this.audit.intent(tx, envelope.tenantId, {\n          kind: 'dispatch_decision', eventId: envelope.id, target: target.id,\n          allow: decision.allow, reason: decision.reason, decisionId: decision.decisionId,\n        });\n        if (!decision.allow) continue;\n\n        // 4. enqueue the delivery; workers pick it up with SKIP LOCKED\n        await tx.insertDelivery(new Delivery({\n          id: newId(), eventId: envelope.id, tenantId: envelope.tenantId,\n          channel: target.channel, target: target.id, lane: target.lane,\n          nextAttemptAt: this.clock.now(),\n        }));\n      }\n    });\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class Dispatcher {\n  constructor({ db, router, consent, audit, clock = SystemClock }) {\n    Object.assign(this, { db, router, consent, audit, clock });\n  }\n\n  /** Called once per bus message. The bus is at-least-once, so this MUST be idempotent. */\n  async handle(envelope) {\n    const targets = this.router.resolve(envelope);          // tenant routing rules -> targets\n\n    await this.db.withTenant(envelope.tenantId, async (tx) => {\n      // 1. inbox: claim the event id inside the same tx as everything below\n      const first = await tx.claimInbox(envelope.tenantId, 'bus', envelope.id, envelope);\n      if (!first) return;                                   // duplicate bus delivery: ack and stop\n\n      for (const target of targets) {\n        // 2. consent / legal basis, evaluated NOW, not when the event was created\n        const decision = target.audience === 'borrower'\n          ? await this.consent.decide({ borrowerRef: envelope.data.borrower_ref,\n                                        purpose: target.purpose, channel: target.channel,\n                                        legalBasis: target.legalBasis })\n          : ConsentPolicy.NOT_APPLICABLE;\n\n        // 3. audit INTENT goes to the audit outbox in the same tx: it cannot be lost\n        await this.audit.intent(tx, envelope.tenantId, {\n          kind: 'dispatch_decision', eventId: envelope.id, target: target.id,\n          allow: decision.allow, reason: decision.reason, decisionId: decision.decisionId,\n        });\n        if (!decision.allow) continue;\n\n        // 4. enqueue the delivery; workers pick it up with SKIP LOCKED\n        await tx.insertDelivery(new Delivery({\n          id: newId(), eventId: envelope.id, tenantId: envelope.tenantId,\n          channel: target.channel, target: target.id, lane: target.lane,\n          nextAttemptAt: this.clock.now(),\n        }));\n      }\n    });\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e511", "type": "rectangle", "x": 60, "y": 7533.2, "width": 2280, "height": 91.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": {"type": 3}, "seed": 1109251957, "version": 1, "versionNonce": 613200081, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e512", "type": "text", "x": 74, "y": 7547.2, "width": 370.4, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": null, "seed": 997855888, "version": 1, "versionNonce": 1000507494, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "INTERVIEWER BAIT - ANSWER IT BEFORE THEY ASK", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "INTERVIEWER BAIT - ANSWER IT BEFORE THEY ASK", "autoResize": true, "lineHeight": 1.25}, {"id": "e513", "type": "text", "x": 74, "y": 7570.8, "width": 2219.3, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": null, "seed": 1001455707, "version": 1, "versionNonce": 1647484528, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "\"What if the bus delivers the same message twice, or two dispatchers race on it?\" The inbox claim is an INSERT ... ON CONFLICT DO NOTHING inside the same transaction as the delivery inserts. A racing second transaction blocks on the unique index until the first commits, then sees the conflict and\ndoes nothing. If the first rolls back, the second proceeds. No lock service, no Redis, no timing assumption.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"What if the bus delivers the same message twice, or two dispatchers race on it?\" The inbox claim is an INSERT ... ON CONFLICT DO NOTHING inside the same transaction as the delivery inserts. A racing second transaction blocks on the unique index until the first commits, then sees the conflict and\ndoes nothing. If the first rolls back, the second proceeds. No lock service, no Redis, no timing assumption.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1100", "type": "rectangle", "x": 0, "y": 7784.8, "width": 2400, "height": 10132.5, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 752333749, "version": 1, "versionNonce": 1277160634, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e515", "type": "rectangle", "x": 60, "y": 7824.8, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": {"type": 3}, "seed": 1919126527, "version": 1, "versionNonce": 1179132832, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e516", "type": "text", "x": 74, "y": 7831.8, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": null, "seed": 427886183, "version": 1, "versionNonce": 669316237, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "05", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "05", "autoResize": true, "lineHeight": 1.25}, {"id": "e517", "type": "text", "x": 144, "y": 7826.8, "width": 402.9, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": null, "seed": 2100509031, "version": 1, "versionNonce": 184370611, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "The six core mechanisms", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The six core mechanisms", "autoResize": true, "lineHeight": 1.25}, {"id": "e518", "type": "text", "x": 60, "y": 7886.8, "width": 1135.2, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2010590888, "version": 1, "versionNonce": 1015642022, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Each one is small. Each one is also where a plausible-looking implementation is quietly wrong. Know what the failure looks like for all six.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Each one is small. Each one is also where a plausible-looking implementation is quietly wrong. Know what the failure looks like for all six.", "autoResize": true, "lineHeight": 1.25}, {"id": "e519", "type": "text", "x": 60, "y": 7937.2, "width": 551.4, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 37590537, "version": 1, "versionNonce": 621887389, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Mechanism, protection, home, and the classic mistake", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Mechanism, protection, home, and the classic mistake", "autoResize": true, "lineHeight": 1.25}, {"id": "e520", "type": "rectangle", "x": 60, "y": 7977.2, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 985632350, "version": 1, "versionNonce": 164205699, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e521", "type": "text", "x": 69, "y": 7985.2, "width": 76.4, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 1760716882, "version": 1, "versionNonce": 1087954963, "isDeleted": false, "boundElements": null, "updated": 17920119522