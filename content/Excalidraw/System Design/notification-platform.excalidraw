ight": 23.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g36"], "frameId": null, "roundness": null, "seed": 1673007633, "version": 1, "versionNonce": 1079533638, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Audit and idempotency sizing", "fontSize": 19, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Audit and idempotency sizing", "autoResize": true, "lineHeight": 1.25}, {"id": "e169", "type": "text", "x": 1407, "y": 2006.4, "width": 571, "height": 40.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g36"], "frameId": null, "roundness": null, "seed": 707950178, "version": 1, "versionNonce": 1366748639, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "audit: 72M events/day x 2 KB ~ 150 GB/day (tier it). Idempotency keys:\n~10M/day x 30 days = 300M x ~100 B ~ 30 GB (fine in Postgres)", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "audit: 72M events/day x 2 KB ~ 150 GB/day (tier it). Idempotency keys:\n~10M/day x 30 days = 300M x ~100 B ~ 30 GB (fine in Postgres)", "autoResize": true, "lineHeight": 1.25}, {"id": "e170", "type": "rectangle", "x": 60, "y": 2132.5, "width": 2280, "height": 91.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g37"], "frameId": null, "roundness": {"type": 3}, "seed": 478978338, "version": 1, "versionNonce": 1316897578, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e171", "type": "text", "x": 74, "y": 2146.5, "width": 227.5, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g37"], "frameId": null, "roundness": null, "seed": 1742707121, "version": 1, "versionNonce": 1693074521, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "THE CONCLUSION THIS DRIVES", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE CONCLUSION THIS DRIVES", "autoResize": true, "lineHeight": 1.25}, {"id": "e172", "type": "text", "x": 74, "y": 2170.0, "width": 2235.9, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g37"], "frameId": null, "roundness": null, "seed": 2115112582, "version": 1, "versionNonce": 1628484994, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Raw throughput is not the constraint. The constraints are failure isolation (one slow partner must not consume the worker pool), fairness (one tenant's backfill must not delay another's bounce alert), and correctness under duplicates and retries. That is why section 05 and section 07 carry the weight of the\ndesign.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Raw throughput is not the constraint. The constraints are failure isolation (one slow partner must not consume the worker pool), fairness (one tenant's backfill must not delay another's bounce alert), and correctness under duplicates and retries. That is why section 05 and section 07 carry the weight of the\ndesign.", "autoResize": true, "lineHeight": 1.25}, {"id"