l, "locked": false, "text": "What I do instead", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What I do instead", "autoResize": true, "lineHeight": 1.25}, {"id": "e1793", "type": "rectangle", "x": 60, "y": 30910.0, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 226387588, "version": 1, "versionNonce": 1010875045, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1794", "type": "text", "x": 69, "y": 30919.0, "width": 306.4, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 695609492, "version": 1, "versionNonce": 798193936, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Crypto, signing, hash-chain canonicalisation", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Crypto, signing, hash-chain canonicalisation", "autoResize": true, "lineHeight": 1.25}, {"id": "e1795", "type": "text", "x": 629, "y": 30919.0, "width": 519.1, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 551925912, "version": 1, "versionNonce": 837621948, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Timing-unsafe compares, non-deterministic serialisation, invented API calls", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Timing-unsafe compares, non-deterministic serialisation, invented API calls", "autoResize": true, "lineHeight": 1.25}, {"id": "e1796", "type": "text", "x": 1389, "y": 30919.0, "width": 717.4, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 266596282, "version": 1, "versionNonce": 805270192, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Vetted libraries, hand-written test vectors, human security review, an independently written chain verifier", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Vetted libraries, hand-written test vectors, human security review, an independently written chain verifier", "autoResize": true, "lineHeight": 1.25}, {"id": "e1797", "type": "rectangle", "x": 60, "y": 30946.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 1033612109, "version": 1, "versionNonce": 815283715, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1798", "type": "text", "x": 69, "y": 30955.8, "width": 283.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 362016708, "version": 1, "versionNonce": 947866705, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Idempotency and transaction boundaries", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Idempotency and transaction boundaries", "autoResize": true, "lineHeight": 1.25}, {"id": "e1799", "type": "text", "x": 629, "y": 30955.8, "width": 416.2, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 512083490, "version": 1, "versionNonce": 1734209116, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Check-then-insert races, side effects outside the transaction", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Check-then-insert races, side effects outside the transaction", "autoResize": true, "lineHeight": 1.25}, {"id": "e1800", "type": "text", "x": 1389, "y": 30955.8, "width": 656.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 307410799, "version": 1, "versionNonce": 1963441037, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "I design the constraints and transaction scope; test concurrent duplicates against real Postgres", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "I design the constraints and transaction scope; test concurrent duplicates against real Postgres", "autoResize": true, "lineHeight": 1.25}, {"id": "e1801", "type": "rectangle", "x": 60, "y": 30983.5, "width": 2280, "height": 55.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 1455226607, "version": 1, "versionNonce": 1915920027, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1802", "type": "text", "x": 69, "y": 30992.5, "width": 301.2, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 27088492, "version": 1, "versionNonce": 1004803755, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Authorisation, RLS, IAM, consent decisions", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Authorisation, RLS, IAM, consent decisions", "autoResize": true, "lineHeight": 1.25}, {"id": "e1803", "type": "text", "x": 629, "y": 30992.5, "width": 465.9, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g358"], "frameId": null, "roundness": null, "seed": 1540232626, "version": 1, "versionNonce": 1959765322, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Over-permissive wildcards; policies that pass only happy-path tests", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Over-permissive wildcards; policies that pass only happy-path tests", "autoResize": true, "lineHeight": 1.25}, {"id": "e1804", "type": "text", "x": 1389, "y": 30992.5, "width": 938.5, "height": 37.5, "angle": 0, "strokeColor": "