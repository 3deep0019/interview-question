 "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [-45, 0.0], [-45, -505.0], [0, -505.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e1429", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e1415", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1447", "type": "arrow", "x": 1740, "y": 22966.5, "width": 100, "height": 0.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 122541593, "version": 1, "versionNonce": 183137250, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0, 0.0], [100, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e1412", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e1432", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1448", "type": "rectangle", "x": 60, "y": 23696.5, "width": 1120, "height": 526.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g295"], "frameId": null, "roundness": {"type": 3}, "seed": 1777901453, "version": 1, "versionNonce": 1212446278, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1449", "type": "text", "x": 74, "y": 23710.5, "width": 404.3, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g295"], "frameId": null, "roundness": null, "seed": 1945203460, "version": 1, "versionNonce": 697289833, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "fair-scheduler.js   -   O(1) per pick, one per priority lane", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "fair-scheduler.js   -   O(1) per pick, one per priority lane", "autoResize": true, "lineHeight": 1.25}, {"id": "e1450", "type": "text", "x": 74, "y": 23736.5, "width": 968.0, "height": 472.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g295"], "frameId": null, "roundness": null, "seed": 1683709712, "version": 1, "versionNonce": 2024245350, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "/**\n * Deficit round robin: each tenant earns `quantum * weight` credit per visit and spends it on work.\n * A tenant with a million queued items cannot starve a tenant with ten.\n * Run ONE of these per priority lane so critical events never wait behind low-priority ones.\n */\nclass TenantFairScheduler {\n  constructor({ quantum = 100 } = {}) {\n    this.quantum = quantum; this.queues = new Map(); this.ring = []; this.cur = 0; this.visiting = false;\n  }\n  enqueue(tenantId, item, { weight = 1, cost = 1 } = {}) {\n    let q = this.queues.get(tenantId);\n    if (!q) { q = { items: [], deficit: 0, weight }; this.queues.set(tenantId, q); this.ring.push(tenantId); }\n    q.items.push({ item, cost });\n  }\n  next() {\n    const n = this.ring.length;\n    for (let guard = 0; guard < 2 * n; guard++) {\n      const q = this.queues.get(this.ring[this.cur]);\n      if (q.items.length === 0) { q.deficit = 0; this.#advance(); continue; }\n      if (!this.visiting) { q.deficit += this.quantum * q.weight; this.visiting = true; }\n      if (q.items[0].cost <= q.deficit) { const { item, cost } = q.items.shift(); q.deficit -= cost; return item; }\n      this.#advance();\n    }\n    return null;\n  }\n  #advance() { this.cur = (this.cur + 1) % this.ring.length; this.visiting = false; }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "/**\n * Deficit round robin: each tenant earns `quantum * weight` credit per visit and spends it on work.\n * A tenant with a million queued items cannot starve a tenant with ten.\n * Run ONE of these per priority lane so critical events never wait behind low-priority ones.\n */\nclass TenantFairScheduler {\n  constructor({ quantum = 100 } = {}) {\n    this.quantum = quantum; this.queues = new Map(); this.ring = []; this.cur = 0; this.visiting = false;\n  }\n  enqueue(tenantId, item, { weight = 1, cost = 1 } = {}) {\n    let q = this.queues.get(tenantId);\n    if (!q) { q = { items: [], deficit: 0, weight }; this.queues.set(tenantId, q); this.ring.push(tenantId); }\n    q.items.push({ item, cost });\n  }\n  next() {\n    const n = this.ring.length;\n    for (let guard = 0; guard < 2 * n; guard++) {\n      const q = this.queues.get(this.ring[this.cur]);\n      if (q.items.length === 0) { q.deficit = 0; this.#advance(); continue; }\n      if (!this.visiting) { q.deficit += this.quantum * q.weight; this.visiting = true; }\n      if (q.items[0].cost <= q.deficit) { const { item, cost } = q.items.shift(); q.deficit -= cost; return item; }\n      this.#advance();\n    }\n    return null;\n  }\n  #advance() { this.cur = (this.cur + 1) % this.ring.length; this.visiting = false; }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e1451", "type": "rectangle", "x": 1220, "y": 23696.5, "width": 1120, "height": 91.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g296"], "frameId": null, "roundness": {"type": 3}, "seed": 301510384, "version": 1, "versionNonce": 1139557516, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1452", "type": "text", "x": 1234, "y": 23710.5, "width": 160.6, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g296"], "frameId": null, "roundness": null, "seed": 1785263285, "version": 1, "versionNonce": 741204439, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "THE LINE THAT LANDS", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE LINE THAT LANDS", "autoResize": true, "lineHeight": 1.25}, {"id": "e1453", "type": "text", "x": 1234, "y": 23734.0, "width": 1030.9, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g296"], "frameId": null, "roundness": null, "seed": 1359705730, "version": 1, "versionNonce": 1250813332, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "\"The scheduling problem here is not speed, it is who waits. I would rather give every tenant a guaranteed slice and let spare capacity flow to\nwhoever has work, than optimise total throughput and let one team's backfill decide everyone else's latency.\"", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"The scheduling problem here is not speed, it is who waits. I would rather give every tenant a guaranteed slice and let spare capacity flow to\nwhoever has work, than optimise total throughput and let one team's backfill decide everyone else's latency.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1591", "type": "rectangle", "x": 0, "y": 24383.0, "width": 2400, "height": 2367.2, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 30344902, "version": 1, "versionNonce": 1460208927, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1455", "type": "rectangle", "x": 60, "y": 24423.0, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g297"], "frameId": null, "roundness": {"type": 3}, "seed": 24651104, "version": 1, "versionNonce": 450433556, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1456", "type": "text", "x": 74, "y": 24430.0, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g297"], "frameId": null, "roundness": null, "seed": 2043907457, "version": 1, "versionNonce": 154617938, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "08", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "08", "autoResize": true, "lineHeight": 1.25}, {"id": "e1457", "type": "text", "x": 144, "y": 24425.0, "width": 226.1, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g297"], "frameId": null, "roundness": null, "seed": 1408656376, "version": 1, "versionNonce": 629196368, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Failure modes", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Failure modes", "autoResize": true, "lineHeight": 1.25}, {"id": "e1458", "type": "text", "x": 60, "y": 24485.0, "width": 939.2, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 536927950, "version": 1, "versionNonce": 1306100831, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "For every component, say what happens when it is slow, down, duplicated, or hostile. Then say which way it fails.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "For every component, say what happens when it is slow, down, duplicated, or hostile. Then say which way it fails.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1459", "type": "rectangle", "x": 60, "y": 24535.5, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g298"], "frameId": null, "roundness": null, "seed": 217995230, "version": 1, "versionNonce": 1242291618, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1460", "type": "text", "x": 69, "y": 24543.5, "width": 46.5, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g298"], "frameId": null, "roundness": null, "seed": 306515824, "version": 1, "versionNonce": 1834324354, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Failure", "fontSize": 14