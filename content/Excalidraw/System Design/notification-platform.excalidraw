eleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Follow-ups & AI use", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Follow-ups & AI use", "autoResize": true, "lineHeight": 1.25}, {"id": "e1754", "type": "text", "x": 60, "y": 30073.5, "width": 1455.8, "height": 45.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1869742965, "version": 1, "versionNonce": 1515200762, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "The second half of the round. For this role, expect one question on how you use AI tools - and the strongest answer is as specific about where you refuse to trust them as about\nwhere you do.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The second half of the round. For this role, expect one question on how you use AI tools - and the strongest answer is as specific about where you refuse to trust them as about\nwhere you do.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1755", "type": "text", "x": 60, "y": 30146.5, "width": 496.7, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 984150813, "version": 1, "versionNonce": 1045471203, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Where AI helps, and where it must not be trusted", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where AI helps, and where 