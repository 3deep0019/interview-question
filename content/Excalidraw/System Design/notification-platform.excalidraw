"e1222", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e1213", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1232", "type": "text", "x": 1850, "y": 19895.2, "width": 106.4, "height": 52.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1660060449, "version": 1, "versionNonce": 211096597, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "due again:\nnext_attempt_at\n<= now", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "due again:\nnext_attempt_at\n<= now", "autoResize": true, "lineHeight": 1.25}, {"id": "e1233", "type": "text", "x": 1242, "y": 19955.2, "width": 313.8, "height": 56.2, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 744707958, "version": 1, "versionNonce": 1007044569, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "lane = $1 keeps a worker pool on one priority\nlane; LIMIT 200 bounds a claim; the reaper\nturns a dead worker's lease into a plain retry.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "lane = $1 keeps a worker pool on one priority\nlane; LIMIT 200 bounds a claim; the reaper\nturns a dead worker's lease into a plain retry.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1234", "type": "text", "x": 60, "y": 20124.2, "width": 359.4, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1513244699, "version": 1, "versionNonce": 103330681, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Tenant isolation that survives a bug", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Tenant isolation that survives a bug", "autoResize": true, "lineHeight": 1.25}, {"id": "e1235", "type": "rectangle", "x": 60, "y": 20165.8, "width": 1120, "height": 211.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g260"], "frameId": null, "roundness": {"type": 3}, "seed": 1155089677, "version": 1, "versionNonce": 1215684962, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1236", "type": "text", "x": 74, "y": 20179.8, "width": 45.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g260"], "frameId": null, "roundness": null, "seed": 465089671, "version": 1, "versionNonce": 1534140994, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "rls.sql", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "rls.sql", "autoResize": true, "lineHeight": 1.25}, {"id": "e1237", "type": "text", "x": 74, "y": 20205.8, "width": 791.6, "height": 157.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g260"], "frameId": null, "roundness": null, "seed": 1851644844, "version": 1, "versionNonce": 1777750953, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "CREATE ROLE app_rw LOGIN NOSUPERUSER NOBYPASSRLS;     -- the application never owns the tables\n\nALTER TABLE deliveries ENABLE ROW LEVEL SECURITY;\nALTER TABLE deliveries FORCE  ROW LEVEL SECURITY;     -- applies even to the table owner\n\nCREATE POLICY tenant_isolation ON deliveries\n  USING      (tenant_id = current_setting('app.tenant_id', true))\n  WITH CHECK (tenant_id = current_setting('app.tenant_id', true));\n-- current_setting(..., true) returns NULL when unset; NULL matches no rows: it fails closed.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CREATE ROLE app_rw LOGIN NOSUPERUSER NOBYPASSRLS;     -- the application never owns the tables\n\nALTER TABLE deliveries ENABLE ROW LEVEL SECURITY;\nALTER TABLE deliveries FORCE  ROW LEVEL SECURITY;     -- applies even to the table owner\n\nCREATE POLICY tenant_isolation ON deliveries\n  USING      (tenant_id = current_setting('app.tenant_id', true))\n  WITH CHECK (tenant_id = current_setting('app.tenant_id', true));\n-- current_setting(..., true) returns NULL when unset; NULL matches no rows: it fails closed.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1238", "type": "rectangle", "x": 1220, "y": 20165.8, "width": 1120, "height": 229.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g261"], "frameId": null, "roundness": {"type": 3}, "seed": 195183801, "version": 1, "versionNonce": 1233817213, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1239", "type": "text", "x": 1234, "y": 20179.8, "width": 83.4, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g261"], "frameId": null, "roundness": null, "seed": 1760531049, "version": 1, "versionNonce": 616563347, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "tenant-tx.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "tenant-tx.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e1240", "type": "text", "x": 1234, "y": 20205.8, "width": 934.4, "height": 175.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g261"], "frameId": null, "roundness": null, "seed": 365869491, "version": 1, "versionNonce": 936426327, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "async withTenant(tenantId, fn) {\n  const tx = await this.pool.begin();\n  try {\n    // set_config(..., true) is transaction-local AND parameterisable (SET LOCAL is not); safe behind PgBouncer\n    await tx.query(`SELECT set_config('app.tenant_id', $1, true)`, [tenantId]);\n    const out = await fn(tx);\n    await tx.commit();\n    return out;\n  } catch (e) { await tx.rollback(); throw e; }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "async withTenant(tenantId, fn) {\n  const tx = await this.pool.begin();\n  try {\n    // set_config(..., true) is transaction-local AND parameterisable (SET LOCAL is not); safe behind PgBouncer\n    await tx.query(`SELECT set_config('app.tenant_id', $1, true)`, [tenantId]);\n    const out = await fn(tx);\n    await tx.commit();\n    return out;\n  } catch (e) { await tx.rollback(); throw e; }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e1241", "type": "rectangle", "x": 60, "y": 20424.8, "width": 2280, "height": 480, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g262"], "frameId": null, "roundness": {"type": 3}, "seed": 2789706, "version": 1, "versionNonce": 1124327392, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1242", "type": "text", "x": 110, "y": 20438.8, "width": 246.6, "height": 21.2, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 433867219, "version": 1, "versionNonce": 619193971, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "EVERY REQUEST OR EVENT", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "EVERY REQUEST OR EVENT", "autoResize": true, "lineHeight": 1.25}, {"id": "e1243", "type": "rectangle", "x": 110, "y": 20474.8, "width": 380, "height": 150, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g263"], "frameId": null, "roundness": {"type": 3}, "seed": 1636771276, "version": 1, "versionNonce": 1611726094, "isDeleted": false, "boundElements": [{"id": "e1258", "type": "arrow"}], "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1244", "type": "text", "x": 121, "y": 20516.8, "width": 358, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g263"], "frameId": null, "roundness": null, "seed": 2099950619, "version": 1, "versionNonce": 115887913, "isDeleted": false, "bound