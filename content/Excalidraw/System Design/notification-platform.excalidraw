Arrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1201", "type": "text", "x": 1342, "y": 19224.8, "width": 338.0, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1963677896, "version": 1, "versionNonce": 1527390141, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "<- applyEvent(state, ev) on each arrival", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "<- applyEvent(state, ev) on each arrival", "autoResize": true, "lineHeight": 1.25}, {"id": "e1202", "type": "text", "x": 1242, "y": 19374.8, "width": 682.4, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2027924215, "version": 1, "versionNonce": 824295858, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "applyEvent = (state, ev) => (!state || ev.sequence > state.sequence) ? ev : state", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "applyEvent = (state, ev) => (!state || ev.sequence > state.sequence) ? ev : state", "autoResize": true, "lineHeight": 1.25}, {"id": "e1203", "type": "text", "x": 1242, "y": 19410.8, "width": 823.3, "height": 18.8, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 230029626, "version": 1, "versionNonce": 529520929, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "The receiver keeps the highest sequence it has seen: out-of-order delivery converges instead of becoming a bug class.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The receiver keeps the highest sequence it has seen: out-of-order delivery converges instead of becoming a bug class.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1204", "type": "text", "x": 60, "y": 19518.8, "width": 353.8, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 441787665, "version": 1, "versionNonce": 436283732, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Workers sharing one delivery table", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Workers sharing one delivery table", "autoResize": true, "lineHeight": 1.25}, {"id": "e1205", "type": "rectangle", "x": 60, "y": 19560.2, "width": 1120, "height": 351.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g253"], "frameId": null, "roundness": {"type": 3}, "seed": 240453157, "version": 1, "versionNonce": 72715147, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1206", "type": "text", "x": 74, "y": 19574.2, "width": 277.6, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g253"], "frameId": null, "roundness": null, "seed": 73931039, "version": 1, "versionNonce": 2038501987, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "claim.sql   -   lease-based, crash-safe", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "claim.sql   -   lease-based, crash-safe", "autoResize": true, "lineHeight": 1.25}, {"id": "e1207", "type": "text", "x": 74, "y": 19600.2, "width": 850.4, "height": 297.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g253"], "frameId": null, "roundness": null, "seed": 1820458919, "version": 1, "versionNonce": 1956596612, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "WITH due AS (\n  SELECT id FROM deliveries\n   WHERE state IN ('pending', 'retrying')\n     AND next_attempt_at <= now()\n     AND lane = $1\n   ORDER BY next_attempt_at\n   LIMIT 200\n     FOR UPDATE SKIP LOCKED\n)\nUPDATE deliveries d\n   SET state = 'in_flight', locked_until = now() + interval '60 seconds'\n  FROM due WHERE d.id = due.id\nRETURNING d.id, d.tenant_id;\n\n-- reaper: a worker that died mid-attempt leaves a lease that expires; the delivery is simply retried\nUPDATE deliveries SET state = 'retrying'\n WHERE state = 'in_flight' AND locked_until < now();", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WITH due AS (\n  SELECT id FROM deliveries\n   WHERE state IN ('pending', 'retrying')\n     AND next_attempt_at <= now()\n     AND lane = $1\n   ORDER BY next_attempt_at\n   LIMIT 200\n     FOR UPDATE SKIP LOCKED\n)\nUPDATE deliveries d\n   SET state = 'in_flight', locked_until = now() + interval '60 seconds'\n  FROM due WHERE d.id = due.id\nRETURNING d.id, d.tenant_id;\n\n-- reaper: a worker that died mid-attempt leaves a lease that expires; the delivery is simply retried\nUPDATE deliveries SET state = 'retrying'\n WHERE state = 'in_flight' AND locked_until < now();", "autoResize": true, "lineHeight": 1.25}, {"id": "e1208", "type": "rectangle", "x": 1220, "y": 19560.2, "width": 1120, "height": 520, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g254"], "frameId": null, "roundness": {"type": 3}, "seed": 1743797554, "version": 1, "versionNonce": 1618677975, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1209", "type": "text", "x": 1242, "y": 19572.2, "width": 413.2, "height": 20.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1361875629, "version": 1, "versionNonce": 187839777, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "DELIVERY STATE MACHINE - lease-based, crash-safe", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "DELIVERY STATE MACHINE - lease-based, crash-safe", "autoResize": true, "lineHeight": 1.25}, {"id": "e1210", "type": "rectangle", "x": 1250, "y": 19720.2, "width": 200, "height": 120, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g255"], "frameId": null, "roundness": {"type": 3}, "seed": 1771803430, "version": 1, "versionNonce": 1613675954, "isDeleted": false, "boundElements": [{"id": "e1225", "type": "arrow"}], "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1211", "type": "text", "x": 1261, "y": 19745.4, "width": 178, "height": 23.8, "angle