copy into a no-op, a rollback un-claims it. No lock service,\nno Redis, no timing assumption", "autoResize": true, "lineHeight": 1.25}, {"id": "e1150", "type": "arrow", "x": 1016.0, "y": 18513.8, "width": 0.0, "height": 100.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1378691333, "version": 1, "versionNonce": 1994090307, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0.0, 0.0], [0.0, 100.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e1115", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e1132", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1151", "type": "text", "x": 1024.0, "y": 18555.0, "width": 121.3, "height": 17.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2072624111, "version": 1, "versionNonce": 1920232554, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "crash before mark", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "crash before mark", "autoResize": true, "lineHeight": 1.25}, {"id": "e1152", "type": "arrow", "x": 1486.0, "y": 18513.8, "width": 232.0, "height": 100.0, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 465994358, "version": 1, "versionNonce": 183440437, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0.0, 0.0], [0.0, 62.0], [232.0, 62.0], [232.0, 100.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e1118", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e1138", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1153", "type": "text", "x": 1506, "y": 18583.8, "width": 148.5, "height": 17.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1889882673, "version": 1, "versionNonce": 1089694565, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "row already committed", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "row already committed", "autoResize": true, "lineHeight": 1.25}, {"id": "e1154", "type": "text", "x": 110, "y": 18833.8, "width": 1552.2, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 32701251, "version": 1, "versionNonce": 364577408, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "A crash between publish and mark means a duplicate publish, which the inbox absorbs: the relay is idempotent by construction, and nothing is lost because the event row only leaves the outbox after it is marked.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A crash between publish and mark means a duplicate publish, which the inbox absorbs: the relay is idempotent by construction, and nothing is lost because the event row only leaves the outbox after it is marked.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1155", "type": "rectangle", "x": 60, "y": 18933.8, "width": 1120, "height": 281.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g241"], "frameId": null, "roundness": {"type": 3}, "seed": 559137409, "version": 1, "versionNonce": 1942833878, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1156", "type": "text", "x": 74, "y": 18947.8, "width": 343.7, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g241"], "frameId": null, "roundness": null, "seed": 507040844, "version": 1, "versionNonce": 1807586154, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "outbox.sql   -   the source service's transaction", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "outbox.sql   -   the source service's transaction", "autoResize": true, "lineHeight": 1.25}, {"id": "e1157", "type": "text", "x": 74, "y": 18973.8, "width": 867.2, "height": 227.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g241"], "frameId": null, "roundness": null, "seed": 1597467275, "version": 1, "versionNonce": 435458962, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "BEGIN;\n  UPDATE loans SET status = 'DISBURSED', event_seq = event_seq + 1\n   WHERE id = $1 RETURNING event_seq;                      -- per-loan sequence, assigned atomically\n\n  INSERT INTO outbox (tenant_id, aggregate_id, sequence, type, payload)\n  VALUES ($2, $1, $3, 'loan.disbursed', $4);               -- payload: tokens + business fields, no PII\nCOMMIT;\n\n-- relay: publish, then mark. A crash in between means a duplicate publish, which the inbox absorbs.\nSELECT id, tenant_id, aggregate_id, sequence, type, payload\n  FROM outbox WHERE published_at IS NULL\n ORDER BY id LIMIT 500\n   FOR UPDATE SKIP LOCKED;", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "BEGIN;\n  UPDATE loans SET status = 'DISBURSED', event_seq = event_seq + 1\n   WHERE id = $1 RETURNING event_seq;                      -- per-loan sequence, assigned atomically\n\n  INSERT INTO outbox (tenant_id, aggregate_id, sequence, type, payload)\n  VALUES ($2, $1, $3, 'loan.disbursed', $4);               -- payload: tokens + business fields, no PII\nCOMMIT;\n\n-- relay: publish, then mark. A crash in between means a duplicate publish, which the inbox absorbs.\nSELECT id, tenant_id, aggregate_id, sequence, type, payload\n  FROM outbox WHERE published_at IS NULL\n ORDER BY id LIMIT 500\n   FOR UPDATE SKIP LOCKED;", "autoResize": true, "lineHeight": 1.25}, {"id": "e1158", "type": "text", "x": 1220, "y": 18933.8, "width": 385.9, "height": 25.0, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2028723286, "version": 1, "versionNonce": 341850003, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "What ordering can you honestly promise?", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What ordering can you honestly promise?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1159", "type": "text", "x": 1220, "y": 18972.8, "width": 1102.7, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1602347811, "version": 1, "versionNonce": 1964858218, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Per-loan ordering is available from the bus (Pub/Sub ordering keys, Kafka partitions keyed by loan id) and you should use it - but treat it as an\noptimisation, not a guarantee. Multiple relays with SKIP LOCKED can publish one loan's events out of order, retries reorder webhooks, and partners\nreorder callbacks. So the contract is: every event carries a per-loan sequence and the full current status. A receiver keeps the highest sequence it has\nseen and ignores anything lower. Out-of-order delivery then becomes harmless instead of a bug class.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Per-loan ordering is available from the bus (Pub/Sub ordering keys, Kafka partitions keyed by loan id) and you should use it - but treat it as an\noptimisation, not a guarantee. Multiple relays with SKIP LOCKED can publish one loan's events out of order, retries reorder webhooks, and partners\nreorder callbacks. So the contract is: every event carries a per-loan sequence and the full current status. A receiver keeps the highest sequence it has\nseen and ignores anything lower. Out-of-order delivery then becomes harmless instead of a bug class.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1160", "type": "rectangle", "x": 1220, "y": 19074.8, "width": 1120, "height": 400, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g242"], "frameId": null, "roundness": {"type": 3}, "seed": 701950988, "version": 1, "versionNonce": 412181515, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1161", "type": "text", "x": 1242, "y": 19086.8, "width": 315.0, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1890139507, "version": 1, "versionNonce": 834742308, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "ARRIVAL ORDER - duplicated and reordered", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ARRIVAL ORDER - duplicated and reordered", "autoResize": true, "lineHeight": 1.25}, {"id": "e1162", "type": "rectangle", "x": 1242, "y": 19118.8, "width": 180, "height": 90, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g243"], "frameId": null, "roundness": {"type": 3}, "seed": 705563755, "version": 1, "versionNonce": 1291133579, "isDeleted": false, "boundElements": [{"id": "e1168", "type": "arrow"}, {"id": "e1176", "type": "arrow"}], "updated": 1792011952237, "link": null, "locked": false}, {"id": "e1163", "type": "text", "x": 1253, "y": 19141.4, "width": 158, "height": 21.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g243"], "frameId": null, "roundness": null, "seed": 513608834, "version": 1, "versionNonce": 814860382, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "seq 14", "fontSize": 17, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText