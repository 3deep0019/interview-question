], [15.0, 70.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e925", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e947", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e951", "type": "text", "x": 1608.0, "y": 13921.5, "width": 72.8, "height": 17.5, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1780667040, "version": 1, "versionNonce": 1015663570, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "recompute", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "recompute", "autoResize": true, "lineHeight": 1.25}, {"id": "e952", "type": "arrow", "x": 2100.0, "y": 13912.8, "width": 35.0, "height": 70.0, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 392915505, "version": 1, "versionNonce": 1214245834, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "points": [[0.0, 0.0], [0.0, 35.0], [-35.0, 35.0], [-35.0, 70.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e940", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e947", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e953", "type": "text", "x": 2108.0, "y": 13921.5, "width": 60.6, "height": 17.5, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 468445385, "version": 1, "versionNonce": 89577081, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "compare", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "compare", "autoResize": true, "lineHeight": 1.25}, {"id": "e954", "type": "text", "x": 110, "y": 13922.8, "width": 1080.6, "height": 40.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 858447097, "version": 1, "versionNonce": 2015518746, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "RFC 6962 domain separation: 0x00 prefixes a leaf and 0x01 an interior node, so a leaf can never be mistaken for a node. An odd node at a level is\npromoted unchanged. One writer per tenant shard: the FOR UPDATE on the head row serialises the chain.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RFC 6962 domain separation: 0x00 prefixes a leaf and 0x01 an interior node, so a leaf can never be mistaken for a node. An odd node at a level is\npromoted unchanged. One writer per tenant shard: the FOR UPDATE on the head row serialises the chain.", "autoResize": true, "lineHeight": 1.25}, {"id": "e955", "type": "text", "x": 110, "y": 14052.8, "width": 1149.5, "height": 40.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1112165718, "version": 1, "versionNonce": 336035887, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "Records are canonicalised with RFC 8785 (JCS) so equal data always hashes to the same bytes. They hold tokens, hashes, decision ids and status codes -\nnever raw PII and never response bodies.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Records are canonicalised with RFC 8785 (JCS) so equal data always hashes to the same bytes. They hold tokens, hashes, decision ids and status codes -\nnever raw PII and never response bodies.", "autoResize": true, "lineHeight": 1.25}, {"id": "e956", "type": "rectangle", "x": 60, "y": 14192.8, "width": 1120, "height": 771.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g188"], "frameId": null, "roundness": {"type": 3}, "seed": 823723986, "version": 1, "versionNonce": 771392593, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e957", "type": "text", "x": 74, "y": 14206.8, "width": 100.0, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g188"], "frameId": null, "roundness": null, "seed": 264262261, "version": 1, "versionNonce": 320978248, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "audit-chain.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "audit-chain.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e958", "type": "text", "x": 74, "y": 14232.8, "width": 976.4, "height": 717.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g188"], "frameId": null, "roundness": null, "seed": 530554938, "version": 1, "versionNonce": 2084545831, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "import { createHash } from 'node:crypto';\nimport canonicalize from 'canonicalize';              // RFC 8785 JSON Canonicalization: stable bytes for equal data\n\nconst sha = (...parts) => createHash('sha256').update(Buffer.concat(parts.map(p => Buffer.from(p)))).digest();\n\n// Domain separation (as in RFC 6962): a leaf can never be mistaken for an interior node.\nconst leafHash = (record) => sha([0x00], canonicalize(record));\nconst nodeHash = (l, r)   => sha([0x01], l, r);\n\nfunction merkleRoot(leaves) {\n  let level = leaves;\n  while (level.length > 1) {\n    const next = [];\n    for (let i = 0; i < level.length; i += 2)\n      next.push(i + 1 < level.length ? nodeHash(level[i], level[i + 1]) : level[i]);\n    level = next;\n  }\n  return level[0];\n}\n\n/** One writer per tenant shard: the FOR UPDATE on the head row serialises the chain. */\nasync function appendBatch(tx, tenantId, records) {\n  const head = await tx.one(\n    `SELECT seq, batch_hash FROM audit_head WHERE tenant_id = $1 FOR UPDATE`, [tenantId]);\n  const root      = merkleRoot(records.map(leafHash));\n  const seq       = head.seq + 1;\n  const batchHash = sha(head.batch_hash, root, String(seq));\n\n  await tx.insertAuditBatch({ tenantId, seq, prevHash: head.batch_hash, root, batchHash, records });\n  await tx.query(`UPDATE audit_head SET seq = $2, batch_hash = $3 WHERE tenant_id = $1`,\n                 [tenantId, seq, batchHash]);\n  return { seq, batchHash };\n}\n\n/** Every N batches or T seconds: sign the head and write it OUTSIDE the database. */\nasync function checkpoint({ kms, worm, tenantId, seq, batchHash }) {\n  const statement = canonicalize({ tenantId, seq, batchHash: batchHash.toString('hex'),\n                                   at: new Date().toISOString() });\n  const signature = await kms.sign(Buffer.from(statement));      // asymmetric key held in KMS/HSM\n  await worm.put(`checkpoints/${tenantId}/${seq}.json`, { statement, signature });  // object lock, compliance mode\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "import { createHash } from 'node:crypto';\nimport canonicalize from 'canonicalize';              // RFC 8785 JSON Canonicalization: stable bytes for equal data\n\nconst sha = (...parts) => createHash('sha256').update(Buffer.concat(parts.map(p => Buffer.from(p)))).digest();\n\n// Domain separation (as in RFC 6962): a leaf can never be mistaken for an interior node.\nconst leafHash = (record) => sha([0x00], canonicalize(record));\nconst nodeHash = (l, r)   => sha([0x01], l, r);\n\nfunction merkleRoot(leaves) {\n  let level = leaves;\n  while (level.length > 1) {\n    const next = [];\n    for (let i = 0; i < level.length; i += 2)\n      next.push(i + 1 < level.length ? nodeHash(level[i], level[i + 1]) : level[i]);\n    level = next;\n  }\n  return level[0];\n}\n\n/** One writer per tenant shard: the FOR UPDATE on the head row serialises the chain. */\nasync function appendBatch(tx, tenantId, records) {\n  const head = await tx.one(\n    `SELECT seq, batch_hash FROM audit_head WHERE tenant_id = $1 FOR UPDATE`, [tenantId]);\n  const root      = merkleRoot(records.map(leafHash));\n  const seq       = head.seq + 1;\n  const batchHash = sha(head.batch_hash, root, String(seq));\n\n  await tx.insertAuditBatch({ tenantId, seq, prevHash: head.batch_hash, root, batchHash, records });\n  await tx.query(`UPDATE audit_head SET seq = $2, batch_hash = $3 WHERE tenant_id = $1`,\n                 [tenantId, seq, batchHash]);\n  return { seq, batchHash };\n}\n\n/** Every N batches or T seconds: sign the head and write it OUTSIDE the database. */\nasync function checkpoint({ kms, worm, tenantId, seq, batchHash }) {\n  const statement = canonicalize({ tenantId, seq, batchHash: batchHash.toString('hex'),\n                                   at: new Date().toISOString() });\n  const signature = await kms.sign(Buffer.from(statement));      // asymmetric key held in KMS/HSM\n  await worm.put(`checkpoints/${tenantId}/${seq}.json`, { statement, signature });  // object lock, compliance mode\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e959", "type": "rectangle", "x": 1220, "y": 14192.8, "width": 1120, "height": 151.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g189"], "frameId": null, "roundness": {"type": 3}, "seed": 1556673713, "version": 1, "versionNonce": 1751594467, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e960", "type": "text", "x": 1234, "y": 14206.8, "width": 390.7, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g189"], "frameId": null, "roundness": null, "seed": 1926926392, "version": 1, "versionNonce": 413596100, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "WHAT \"TAMPER-EVIDENT\" DOES AND DOES NOT MEAN", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHAT \"TAMPER-EVIDENT\" DOES AND DOES NOT MEAN", "autoResize": true, "lineHeight": 1.25}, {"id": "e961", "type": "text", "x": 1234, "y": 14230.2, "width": 1093.2, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g189"], "frameId": null, "roundness": null, "seed": 88259492, "version": 1, "versionNonce": 1898080304, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "A hash chain inside a database proves nothing against someone with write access to that database - they can recompute the whole chain. The proof\ncomes from the signed checkpoint in a write-once store: to forge history an attacker must also forge a signature and rewrite an object under\nretention lock. An independent verifier, ideally written by someone other than the writer's author, recomputes the chain from stored records and\ncompares it with the latest checkpoints. Mismatch is a security incident, not a bug ticket. Audit records hold tokens, hashes, decision ids and status\ncodes - never raw PII and never response bodies - so crypto-shredding a vault entry for an erasure request leaves the chain intact.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A hash chain inside a database proves nothing against someone with write access to that database - they can recompute the whole chain. The proof\ncomes from the signed checkpoint in a write-once store: to forge history an attacker must also forge a signature and rewrite an object under\nretention lock. An independent verifier, ideally written by someone other than the writer's author, recomputes the chain from stored records and\ncompares it with the latest checkpoints. Mismatch is a security incident, not a bug ticket. Audit records hold tokens, hashes, decision ids and status\ncodes - never raw PII and never response bodies - so crypto-shredding a vault entry for an erasure request leaves the chain intact.", "autoResize": true, "lineHeight": 1.25}, {"id": "e962", "type": "rectangle", "x": 60, "y": 15014.2, "width": 2280, "height": 52, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g190"], "frameId": null, "roundness": {"type": 3}, "seed": 1207622972, "version": 1, "versionNonce": 1809222740, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e963", "type": "rectangle", "x": 60, "y": 15014.2, "width": 110, "height": 52, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#0b7285", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g190"], "frameId": null, "roundness": null, "seed": 1626635660, "version": 1, "versionNonce": 1443653288, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e964", "type": "text", "x": 76, "y": 15024.2, "width": 54.6, "height": 32.5, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g190"], "frameId": null, "roundness": null, "seed": 81880762, "version": 1, "versionNonce": 1434296651, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "05.5", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "05.5", "autoResize": true, "lineHeight": 1.25}, {"id": "e965", "type": "text", "x": 190, "y": 15024.2, "width": 251.6, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g190"], "frameId": null, "roundness": null, "seed": 1800029943, "version": 1, "versionNonce": 696220221, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "consent_decision", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "consent_decision", "autoResize": true, "lineHeight": 1.25}, {"id": "e966", "type": "rectangle", "x": 60, "y": 15088.2, "width": 2280, "height": 49.2, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g191"], "frameId": null, "roundness": {"type": 3}, "seed": 252825435, "version": 1, "versionNonce": 837167550, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e967", "type": "text", "x": 74, "y": 15102.2, "width": 2202.4, "height": 21.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g191"], "frameId": null, "roundness": null, "seed": 1287458912, "version": 1, "versionNonce": 978680225, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "A pure function of the request and a ledger snapshot. Same inputs, same decision, always - so it can be replayed during an audit and unit-tested exhaustively. The decision id and ledger version go into the audit trail; \"why did this borrower get that message\" has a one-query answer.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A pure function of the request and a ledger snapshot. Same inputs, same decision, always - so it can be replayed during an audit and unit-tested exhaustively. The decision id and ledger version go into the audit trail; \"why did this borrower get that message\" has a one-query answer.", "autoResize": true, "lineHeight": 1.25}, {"id": "e968", "type": "rectangle", "x": 60, "y": 15165.5, "width": 2280, "height": 740, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g192"], "frameId": null, "roundness": {"type": 3}, "seed": 1181227313, "version": 1, "versionNonce": 1823234292, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false}, {"id": "e969", "type": "rectangle", "x": 110, "y": 15215.5, "width": 360, "height": 130, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g193"], "frameId": null, "roundness": {"type": 3}, "seed": 1346563344, "version": 1, "versionNonce": 1670927334, "isDeleted": false, "boundElements": [{"id": "e978", "type": "arrow"}], "updated": 1792011952237, "link": null, "locked": false}, {"id": "e970", "type": "text", "x": 121, "y": 15238.1, "width": 338, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g193"], "frameId": null, "roundness": null, "seed": 657589867, "version": 1, "versionNonce": 1393776716, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "ConsentPolicy.decide()", "fontSize": 18, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "ConsentPolicy.decide()", "autoResize": true, "lineHeight": 1.25}, {"id": "e971", "type": "text", "x": 121, "y": 15266.6, "width": 338, "height": 56.2, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g193"], "frameId": null, "roundness": null, "seed": 902097458, "version": 1, "versionNonce": 661879424, "isDeleted": false, "boundElements": null, "updated": 1792011952237, "link": null, "locked": false, "text": "{ borrowerRef, purpose, channel, legalBasis }  -\ncalled for each borrower-audience target at\ndispatch time", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "{ borrowerRef, purpose, channel, legalBasis }  -\nc