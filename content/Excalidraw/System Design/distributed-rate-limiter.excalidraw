ily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Say", "autoResize": true, "lineHeight": 1.25}, {"id": "e1060", "type": "rectangle", "x": 60, "y": 23540.2, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 544714594, "version": 1, "versionNonce": 665875492, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1061", "type": "text", "x": 69, "y": 23549.2, "width": 24.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 1372752813, "version": 1, "versionNonce": 2074377369, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "0-4", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "0-4", "autoResize": true, "lineHeight": 1.25}, {"id": "e1062", "type": "text", "x": 219, "y": 23549.2, "width": 373.0, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 2113242445, "version": 1, "versionNonce": 1868947590, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Clarify. Write functional + non-functional on the board.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Clarify. Write functional + non-functional on the board.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1063", "type": "text", "x": 1219, "y": 23549.2, "width": 565.9, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 1258146941, "version": 1, "versionNonce": 1993851002, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "\"Before I design, let me pin down what we're limiting on and how hard the limit is.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Before I design, let me pin down what we're limiting on and how hard the limit is.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1064", "type": "rectangle", "x": 60, "y": 23577.0, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 1425281729, "version": 1, "versionNonce": 1923550451, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1065", "type": "text", "x": 69, "y": 23586.0, "width": 24.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 671408213, "version": 1, "versionNonce": 1574188796, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "4-8", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4-8", "autoResize": true, "lineHeight": 1.25}, {"id": "e1066", "type": "text", "x": 219, "y": 23586.0, "width": 500.2, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 3846067, "version": 1, "versionNonce": 1604427522, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Back-of-envelope. Land on \"coordination is the bottleneck, not memory.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Back-of-envelope. Land on \"coordination is the bottleneck, not memory.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1067", "type": "text", "x": 1219, "y": 23586.0, "width": 646.1, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 72570248, "version": 1, "versionNonce": 475962933, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "\"300k limiter ops/sec across 50 nodes - so the question is how many round trips per request.\"", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"300k limiter ops/sec across 50 nodes - so the question is how many round trips per request.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e1068", "type": "rectangle", "x": 60, "y": 23613.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 320758383, "version": 1, "versionNonce": 624856799, "isDeleted": false, "boundE