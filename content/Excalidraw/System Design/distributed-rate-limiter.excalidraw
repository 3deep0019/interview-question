d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g37"], "frameId": null, "roundness": null, "seed": 383372480, "version": 1, "versionNonce": 931846999, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "points": [[0, 0.0], [0, 217.2]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e208", "type": "rectangle", "x": 60, "y": 3018.2, "width": 2280, "height": 71.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g38"], "frameId": null, "roundness": {"type": 3}, "seed": 1694655440, "version": 1, "versionNonce": 1365460771, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e209", "type": "text", "x": 74, "y": 3032.2, "width": 187.0, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g38"], "frameId": null, "roundness": null, "seed": 714075261, "version": 1, "versionNonce": 186293890, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "PLACEMENT IN PRACTICE", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "PLACEMENT IN PRACTICE", "autoResize": true, "lineHeight": 1.25}, {"id": "e210", "type": "text", "x": 74, "y": 3055.8, "width": 1290.7, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g38"], "frameId": null, "roundness": null, "seed": 1719755505, "version": 1, "versionNonce": 2031874606, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Realistic answer: layered. Crude IP limits at the edge, identity-aware limits at the gateway, and cost-aware limits inside the two or three endpoints that are genuinely expensive.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Realistic answer: layered. Crude IP limits at the edge, identity-aware limits at the gateway, and cost-aware limits inside the two or three endpoints that are genuinely expensive.", "autoResize": true, "lineHeight": 1.25}, {"id": "e211", "type": "text", "x": 60, "y": 3129.8, "width": 256.3, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2086618137, "version": 1, "versionNonce": 1550106814, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Centralized vs. local-only", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Centralized vs. local-only", "autoResize": true, "lineHeight": 1.25}, {"id": "e212", "type": "rectangle", "x": 60, "y": 3171.8, "width": 540, "height": 131.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g39"], "frameId": null, "roundness": {"type": 3}, "seed": 850056704, "version": 1, "versionNonce": 994629688, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e213", "type": "text", "x": 74, "y": 3185.8, "width": 91.8, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g39"], "frameId": null, "roundness": null, "seed": 861971624, "version": 1, "versionNonce": 1596337780, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "LOCAL ONLY", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "LOCAL ONLY", "autoResize": true, "lineHeight": 1.25}, {"id": "e214", "type": "text", "x": 74, "y": 3209.2, "width": 502.1, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g39"], "frameId": null, "roundness": null, "seed": 2033231095, "version": 1, "versionNonce": 182362696, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Each node keeps its own counters. Zero latency, zero dependency -\nbut with N nodes the real limit is Nxlimit unless traffic is perfectly\nbalanced, and it collapses on autoscale. Fine for coarse safety\nvalves.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Each node keeps its own counters. Zero latency, zero dependency -\nbut with N nodes the real limit is Nxlimit unless traffic is perfectly\nbalanced, and it collapses on autoscale. Fine for coarse safety\nvalves.", "autoResize": true, "lineHeight": 1.25}, {"id": "e215", "type": "rectangle", "x": 640, "y": 3171.8, "width": 540, "height": 131.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": {"type": 3}, "seed": 1556493282, "version": 1, "versionNonce": 341140777, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e216", "type": "text", "x": 654, "y": 3185.8, "width": 161.4, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": null, "seed": 365080080, "version": 1, "versionNonce": 2132692552, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "CENTRALIZED (REDIS)", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CENTRALIZED (REDIS)", "autoResize": true, "lineHeight": 1.25}, {"id": "e217", "type": "text", "x": 654, "y": 3209.2, "width": 504.9, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": null, "seed": 272812827, "version": 1, "versionNonce": 59160709, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "One source of truth, accurate, rules apply fleet-wide. Costs a round\ntrip and creates a dependency you must degrade around. This is the\nstandard answer.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "One source of truth, accurate, rules apply fleet-wide. Costs a round\ntrip and creates a dependency you must degrade around. This is the\nstandard answer.", "autoResize": true, "lineHeight": 1.25}, {"id": "e218", "type": "rectangle", "x": 1220, "y": 3171.8, "width": 540, "height": 131.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g41"], "frameId": null, "roundness": {"type": 3}, "seed": 324593663, "version": 1, "versionNonce": 1268759748, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e219", "type": "text", "x": 1234, "y": 3185.8, "width": 172.7, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g41"], "frameId": null, "roundness": null, "seed": 1943155077, "version": 1, "versionNonce": 999339856, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "TWO-TIER (SECTION 07)", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "TWO-TIER (SECTION 07)", "autoResize": true, "lineHeight": 1.25}, {"id": "e220", "type": "text", "x": 1234, "y": 3209.2, "width": 512.9, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g41"], "frameId": null, "roundness": null, "seed": 1731949819, "version": 1, "versionNonce": 1408444750, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Local bucket absorbs the common case, Redis reconciles in batches.\nBest latency/accuracy trade, most code. Say this is where you'd go at\nvery high QPS.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Local bucket absorbs the common case, Redis reconciles in batches.\nBest latency/accuracy trade, most code. Say this is where you'd go at\nvery high QPS.", "autoResize": true, "lineHeight": 1.25}, {"id": "e221", "type": "rectangle", "x": 1800, "y": 3171.8, "width": 540, "height": 131.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g42"], "frameId": null, "roundness": {"type": 3}, "seed": 313906941, "version": 1, "versionNonce": 1313343736, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e222", "type": "text", "x": 1814, "y": 3185.8, "width": 125.5, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g42"], "frameId": null, "roundness": null, "seed": 1774917740, "version": 1, "versionNonce": 1279621630, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "STICKY ROUTING", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "STICKY ROUTING", "autoResize": true, "lineHeight": 1.25}, {"id": "e223", "type": "text", "x": 1814, "y": 3209.2, "width": 511.6, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g42"], "frameId": null, "roundness": null, "seed": 2105190988, "version": 1, "versionNonce": 1018673751, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Hash the limit key at the LB so one node owns it - then local counters\nare accurate. Elegant, but rebalancing on deploy resets state and hot\nkeys still hot-spot a node.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Hash the limit key at the LB so one node owns it - then local counters\nare accurate. Elegant, but rebalancing on deploy resets state and hot\nkeys still hot-spot a node.", "autoResize": true, "lineHeight": 1.25}, {"id": "e471", "type": "rectangle", "x": 0, "y": 3463.2, "widt