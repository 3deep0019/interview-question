e", "x": 1600, "y": 8748.5, "width": 740, "height": 91.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g89"], "frameId": null, "roundness": {"type": 3}, "seed": 622411543, "version": 1, "versionNonce": 543769092, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e557", "type": "text", "x": 1614, "y": 8762.5, "width": 118.0, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g89"], "frameId": null, "roundness": null, "seed": 799340671, "version": 1, "versionNonce": 139537805, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "WHY IT SCORES", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHY IT SCORES", "autoResize": true, "lineHeight": 1.25}, {"id": "e558", "type": "text", "x": 1614, "y": 8786.0, "width": 705.0, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g89"], "frameId": null, "roundness": null, "seed": 843744994, "version": 1, "versionNonce": 837864501, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "The fixed-window boundary burst. Naming this unprompted is the single cheapest way to sound\nlike you've shipped one.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The fixed-window boundary burst. Naming this unprompted is the single cheapest way to sound\nlike you've shipped one.", "autoResize": true, "lineHeight": 1.25}, {"id": "e559", "type": "rectangle", "x": 1600, "y": 8860.0, "width": 740, "height": 91.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g90"], "frameId": null, "roundness": {"type": 3}, "seed": 2144890576, "version": 1, "versionNonce": 1868250484, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e560", "type": "text", "x": 1614, "y": 8874.0, "width": 75.1, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g90"], "frameId": null, "roundness": null, "seed": 1265247240, "version": 1, "versionNonce": 164069245, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "THE FLAW", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE FLAW", "autoResize": true, "lineHeight": 1.25}, {"id": "e561", "type": "text", "x": 1614, "y": 8897.5, "width": 705.0, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g90"], "frameId": null, "roundness": null, "seed": 774617368, "version": 1, "versionNonce": 1987314637, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "100 requests in the last seconds of window 1 and 100 more in the first seconds of window 2 are\nboth legal. Any 60 s span across the boundary then carries 200 requests - twice the limit.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "100 requests in the last seconds of window 1 and 100 more in the first seconds of window 2 are\nboth legal. Any 60 s span across the boundary then carries 200 requests - twice the limit.", "autoResize": true, "lineHeight": 1.25}, {"id": "e562", "type": "text", "x": 60, "y": 9198.5, "width": 806.6, "height": 27.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 919236279, "version": 1, "versionNonce": 1622759757, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "The six implementations - one card per tab: explanation, JS strategy, Redis Lua", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The six implementations - one card per tab: explanation, JS strategy, Redis Lua", "autoResize": true, "lineHeight": 1.25}, {"id": "e579", "type": "rectangle", "x": 60, "y": 9248.5, "width": 2280, "height": 903.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 70, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2020136364, "version": 1, "versionNonce": 1190034463, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e563", "type": "rectangle", "x": 84, "y": 9258.5, "width": 70, "height": 44, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g91"], "frameId": null, "roundness": {"type": 3}, "seed": 590891402, "version": 1, "versionNonce": 1834499221, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e564", "type": "text", "x": 94, "y": 9267.5, "width": 33.8, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g91"], "frameId": null, "roundness": null, "seed": 103654957, "version": 1, "versionNonce": 602664893, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "1/6", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1/6", "autoResize": true, "lineHeight": 1.25}, {"id": "e565", "type": "text", "x": 174, "y": 9262.5, "width": 232.4, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g91"], "frameId": null, "roundness": null, "seed": 218420257, "version": 1, "versionNonce": 110847767, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "token_bucket", "fontSize": 32, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "token_bucket", "autoResize": true, "lineHeight": 1.25}, {"id": "e566", "type": "text", "x": 84, "y": 9314.5, "width": 1052.4, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1792453041, "version": 1, "versionNonce": 1421587326, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Memory/key: O(1)   |   Accuracy: GOOD: Exact   |   Burst: Explicit, capped   |   Redis ops: HMGET+HSET   |   Pick it when: Best default for APIs", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Memory/key: O(1)   |   Accuracy: GOOD: Exact   |   Burst: Explicit, capped   |   Redis ops: HMGET+HSET   |   Pick it when: Best default for APIs", "autoResize": true, "lineHeight": 1.25}, {"id": "e567", "type": "rectangle", "x": 84, "y": 9356.5, "width": 560, "height": 136.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g92"], "frameId": null, "roundness": {"type": 3}, "seed": 613371131, "version": 1, "versionNonce": 1363573721, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e568", "type": "text", "x": 98, "y": 9370.5, "width": 108.1, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g92"], "frameId": null, "roundness": null, "seed": 2009163986, "version": 1, "versionNonce": 319791216, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "How it works", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "How it works", "autoResize": true, "lineHeight": 1.25}, {"id": "e569", "type": "text", "x": 98, "y": 9399.0, "width": 518.1, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g92"], "frameId": null, "roundness": null, "seed": 535420749, "version": 1, "versionNonce": 2085289515, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Tokens refill at a constant rate up to a capacity; a request spends one.\nThe capacity is the burst allowance. Key trick: never run a refill timer -\ncompute the refill lazily from the elapsed time on read. That's what\nmakes it O(1) memory and stateless between calls.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Tokens refill at a constant rate up to a capacity; a request spends one.\nThe capacity is the burst allowance. Key trick: never run a refill timer -\ncompute the refill lazily from the elapsed time on read. That's what\nmakes it O(1) memory and stateless between calls.", "autoResize": true, "lineHeight": 1.25}, {"id": "e570", "type": "rectangle", "x": 84, "y": 9513.0, "width": 560, "height": 171.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g93"], "frameId": null, "roundness": {"type": 3}, "seed": 570646570, "version": 1, "versionNonce": 936819868, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e571", "type": "text", "x": 98, "y": 9527.0, "width": 382.3, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g93"], "frameId": null, "roundness": null, "seed": 1097284664, "version": 1, "versionNonce": 677748798, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "WHY NOW_MS IS PASSED IN, NOT READ FROM REDIS", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHY NOW_MS IS PASSED IN, NOT READ FROM REDIS", "autoResize": true, "lineHeight": 1.25}, {"id": "e572", "type": "text", "x": 98, "y": 9550.5, "width": 529.8, "height": 120.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g93"], "frameId": null, "roundness": null, "seed": 407697721, "version": 1, "versionNonce": 1660399230, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Calling redis.call('TIME') used to make a script non-deterministic and\nunsafe to replicate. Modern Redis replicates effects rather than\ncommands, so it's allowed - but passing the caller's timestamp keeps\nthe script pure and testable. The cost: you now depend on client clocks.\nMention NTP, and mention that a client with a fast clock could refill early\n- so clamp now against the stored ts if the limit is security-critical.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Calling redis.call('TIME') used to make a script non-deterministic and\nunsafe to replicate. Modern Redis replicates effects rather than\ncommands, so it's allowed - but passing the caller's timestamp keeps\nthe script pure and testable. The cost: you now depend on client clocks.\nMention NTP, and mention that a client with a fast clock could refill early\n- so clamp now against the stored ts if the limit is security-critical.", "autoResize": true, "lineHeight": 1.25}, {"id": "e573", "type": "rectangle", "x": 684, "y": 9356.5, "width": 840, "height": 771.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g94"], "frameId": null, "roundness": {"type": 3}, "seed": 801761473, "version": 1, "versionNonce": 1686081053, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e574", "type": "text", "x": 698, "y": 9370.5, "width": 190.7, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g94"], "frameId": null, "roundness": null, "seed": 2053349270, "version": 1, "versionNonce": 918581055, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "strategies/token-bucket.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/token-bucket.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e575", "type": "text", "x": 698, "y": 9396.5, "width": 758.0, "height": 717.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g94"], "frameId": null, "roundness": null, "seed": 1898947983, "version": 1, "versionNonce": 62301318, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "class TokenBucket extends RateLimitStrategy {\n  constructor({ store, clock }) { super(); this.store = store; this.clock = clock; }\n\n  async consume(key, rule, cost = 1) {\n    const [ok, tokens, retryMs] = await this.store.eval('token_bucket', [key], [\n      rule.burst,          // capacity\n      rule.refillPerSec,   // refill rate\n      cost,\n      this.clock.now(),\n    ]);\n    const full = Math.ceil((rule.burst / rule.refillPerSec) * 1000);\n    const base = { ruleId: rule.id, limit: rule.burst, remaining: tokens, resetMs: full };\n    return ok === 1 ? Decision.allow(base)\n                    : Decision.deny({ ...base, retryAfterMs: retryMs });\n  }\n\n  async peek(key, rule, cost = 1) { return this.consume(key, rule, 0); }\n}\n\n// ---- pure in-memory version: identical math, no network. Use it in tests\n// ---- and as the L1 tier in section 07.\nclass LocalTokenBucket {\n  constructor({ capacity, refillPerSec, clock = SystemClock }) {\n    this.capacity = capacity;\n    this.rate     = refillPerSec;\n    this.clock    = clock;\n    this.tokens   = capacity;\n    this.ts       = clock.now();\n  }\n  #refill() {\n    const now     = this.clock.now();\n    const elapsed = Math.max(0, now - this.ts) / 1000;\n    this.tokens   = Math.min(this.capacity, this.tokens + elapsed * this.rate);\n    this.ts       = now;\n  }\n  tryConsume(cost = 1) {\n    this.#refill();\n    if (this.tokens >= cost) { this.tokens -= cost; return { ok: true, retryMs: 0 }; }\n    return { ok: false, retryMs: Math.ceil(((cost - this.tokens) / this.rate) * 1000) };\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class TokenBucket extends RateLimitStrategy {\n  constructor({ store, clock }) { super(); this.store = store; this.clock = clock; }\n\n  async consume(key, rule, cost = 1) {\n    const [ok, tokens, retryMs] = await this.store.eval('token_bucket', [key], [\n      rule.burst,          // capacity\n      rule.refillPerSec,   // refill rate\n      cost,\n      this.clock.now(),\n    ]);\n    const full = Math.ceil((rule.burst / rule.refillPerSec) * 1000);\n    const base = { ruleId: rule.id, limit: rule.burst, remaining: tokens, resetMs: full };\n    return ok === 1 ? Decision.allow(base)\n                    : Decision.deny({ ...base, retryAfterMs: retryMs });\n  }\n\n  async peek(key, rule, cost = 1) { return this.consume(key, rule, 0); }\n}\n\n// ---- pure in-memory version: identical math, no network. Use it in tests\n// ---- and as the L1 tier in section 07.\nclass LocalTokenBucket {\n  constructor({ capacity, refillPerSec, clock = SystemClock }) {\n    this.capacity = capacity;\n    this.rate     = refillPerSec;\n    this.clock    = clock;\n    this.tokens   = capacity;\n    this.ts       = clock.now();\n  }\n  #refill() {\n    const now     = this.clock.now();\n    const elapsed = Math.max(0, now - this.ts) / 1000;\n    this.tokens   = Math.min(this.capacity, this.tokens + elapsed * this.rate);\n    this.ts       = now;\n  }\n  tryConsume(cost = 1) {\n    this.#refill();\n    if (this.tokens >= cost) { this.tokens -= cost; return { ok: true, retryMs: 0 }; }\n    return { ok: false, retryMs: Math.ceil(((cost - this.tokens) / this.rate) * 1000) };\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e576", "type": "rectangle", "x": 1564, "y": 9356.5, "width": 752, "height": 666.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g95"], "frameId": null, "roundness": {"type": 3}, "seed": 1743675692, "version": 1, "versionNonce": 1635642450, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e577", "type": "text", "x": 1578, "y": 9370.5, "width": 492.2, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g95"], "frameId": null, "roundness": null, "seed": 1354838420, "version": 1, "versionNonce": 859082925, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "scripts/token_bucket.lua   -   atomic - read-modify-write in one shot", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "scripts/token_bucket.lua   -   atomic - read-modify-write in one shot", "autoResize": true, "lineHeight": 1.25}, {"id": "e578", "type": "text", "x": 1578, "y": 9396.5, "width": 598.4, "height": 612.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g95"], "frameId": null, "roundness": null, "seed": 1961562853, "version": 1, "versionNonce": 1880608058, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "-- KEYS[1] bucket key\n-- ARGV: capacity, refill_per_sec, cost, now_ms\nlocal key      = KEYS[1]\nlocal capacity = tonumber(ARGV[1])\nlocal rate     = tonumber(ARGV[2])\nlocal cost     = tonumber(ARGV[3])\nlocal now      = tonumber(ARGV[4])\n\nlocal state  = redis.call('HMGET', key, 'tokens', 'ts')\nlocal tokens = tonumber(state[1])\nlocal ts     = tonumber(state[2])\n\nif tokens == nil then          -- first sight of this key: start full\n  tokens = capacity\n  ts     = now\nend\n\n-- lazy refill: no background job, no timer, no clock in Redis\nlocal elapsed = math.max(0, now - ts) / 1000\ntokens = math.min(capacity, tokens + elapsed * rate)\n\nlocal allowed, retry = 0, 0\nif tokens >= cost then\n  tokens  = tokens - cost\n  allowed = 1\nelse\n  retry = math.ceil(((cost - tokens) / rate) * 1000)\nend\n\nredis.call('HSET', key, 'tokens', tokens, 'ts', now)\n-- expire once the bucket would be provably full again: bounded memory,\n-- and a re-created key starts full, which is the same state anyway.\nredis.call('PEXPIRE', key, math.ceil((capacity / rate) * 1000) + 1000)\n\nreturn { allowed, math.floor(tokens), retry }", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "-- KEYS[1] bucket key\n-- ARGV: capacity, refill_per_sec, cost, now_ms\nlocal key      = KEYS[1]\nlocal capacity = tonumber(ARGV[1])\nlocal rate     = tonumber(ARGV[2])\nlocal cost     = tonumber(ARGV[3])\nlocal now      = tonumber(ARGV[4])\n\nlocal state  = redis.call('HMGET', key, 'tokens', 'ts')\nlocal tokens = tonumber(state[1])\nlocal ts     = tonumber(state[2])\n\nif tokens == nil then          -- first sight of this key: start full\n  tokens = capacity\n  ts     = now\nend\n\n-- lazy refill: no background job, no timer, no clock in Redis\nlocal elapsed = math.max(0, now - ts) / 1000\ntokens = math.min(capacity, tokens + elapsed * rate)\n\nlocal allowed, retry = 0, 0\nif tokens >= cost then\n  tokens  = tokens - cost\n  allowed = 1\nelse\n  retry = math.ceil(((cost - tokens) / rate) * 1000)\nend\n\nredis.call('HSET', key, 'tokens', tokens, 'ts', now)\n-- expire once the bucket would be provably full again: bounded memory,\n-- and a re-created key starts full, which is the same state anyway.\nredis.call('PEXPIRE', key, math.ceil((capacity / rate) * 1000) + 1000)\n\nreturn { allowed, math.floor(tokens), retry }", "autoResize": true, "lineHeight": 1.25}, {"id": "e596", "type": "rectangle", "x": 60, "y": 10192.0, "width": 2280, "height": 606.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 70, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 558708797, "version": 1, "versionNonce": 872327757, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e580", "type": "rectangle", "x": 84, "y": 10202.0, "width": 70, "height": 44, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g96"], "frameId": null, "roundness": {"type": 3}, "seed": 1179458473, "version": 1, "versionNonce": 436875076, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e581", "type": "text", "x": 94, "y": 10211.0, "width": 33.8, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g96"], "frameId": null, "roundness": null, "seed": 1545270355, "version": 1, "versionNonce": 173037574, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "2/6", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2/6", "autoResize": true, "lineHeight": 1.25}, {"id": "e582", "type": "text", "x": 174, "y": 10206.0, "width": 232.4, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g96"], "frameId": null, "roundness": null, "seed": 106248970, "version": 1, "versionNonce": 2004601575, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "fixed_window", "fontSize": 32, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "fixed_window", "autoResize": true, "lineHeight": 1.25}, {"id": "e583", "type": "text", "x": 84, "y": 10258.0, "width": 1029.8, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1572714952, "version": 1, "versionNonce": 882370993, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Memory/key: O(1)   |   Accuracy: BAD: 2x at edges   |   Burst: Uncontrolled   |   Redis ops: 1 INCR   |   Pick it when: Simplicity, coarse quotas", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Memory/key: O(1)   |   Accuracy: BAD: 2x at edges   |   Burst: Uncontrolled   |   Redis ops: 1 INCR   |   Pick it when: Simplicity, coarse quotas", "autoResize": true, "lineHeight": 1.25}, {"id": "e584", "type": "rectangle", "x": 84, "y": 10300.0, "width": 560, "height": 96.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": {"type": 3}, "seed": 968215377, "version": 1, "versionNonce": 1320517920, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e585", "type": "text", "x": 98, "y": 10314.0, "width": 108.1, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": null, "seed": 1616342243, "version": 1, "versionNonce": 297582243, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "How it works", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "How it works", "autoResize": true, "lineHeight": 1.25}, {"id": "e586", "type": "text", "x": 98, "y": 10342.5, "width": 533.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": null, "seed": 1384033251, "version": 1, "versionNonce": 1867191607, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "One counter per (key, window index). The simplest thing that works, and\nthe one with the famous 2x boundary flaw shown above.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "One counter per (key, window index). The simplest thing that works, and\nthe one with the famous 2x boundary flaw shown above.", "autoResize": true, "lineHeight": 1.25}, {"id": "e587", "type": "rectangle", "x": 84, "y": 10416.5, "width": 560, "height": 111.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": {"type": 3}, "seed": 614627688, "version": 1, "versionNonce": 1042764546, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e588", "type": "text", "x": 98, "y": 10430.5, "width": 69.7, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": null, "seed": 105177089, "version": 1, "versionNonce": 1958301600, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "THE TELL", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE TELL", "autoResize": true, "lineHeight": 1.25}, {"id": "e589", "type": "text", "x": 98, "y": 10454.0, "width": 522.2, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": null, "seed": 1990238558, "version": 1, "versionNonce": 1181348365, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "If you write GET then SET from Node instead of using INCR or Lua,\nyou've written a read-modify-write race and every interviewer is trained\nto spot it. Atomicity is the whole point of the storage choice.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "If you write GET then SET from Node instead of using INCR or Lua,\nyou've written a read-modify-write race and every interviewer is trained\nto spot it. Atomicity is the whole point of the storage choice.", "autoResize": true, "lineHeight": 1.25}, {"id": "e590", "type": "rectangle", "x": 684, "y": 10300.0, "width": 840, "height": 246.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": {"type": 3}, "seed": 273398983, "version": 1, "versionNonce": 366710325, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e591", "type": "text", "x": 698, "y": 10314.0, "width": 190.7, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 1014007609, "version": 1, "versionNonce": 890919353, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "strategies/fixed-window.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/fixed-window.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e592", "type": "text", "x": 698, "y": 10340.0, "width": 707.6, "height": 192.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 738010355, "version": 1, "versionNonce": 605045017, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "class FixedWindowCounter extends RateLimitStrategy {\n  constructor({ store, clock }) { super(); this.store = store; this.clock = clock; }\n\n  async consume(key, rule, cost = 1) {\n    const [ok, remaining, resetMs] = await this.store.eval('fixed_window',\n      [key], [rule.limit, rule.windowMs, cost, this.clock.now()]);\n    const base = { ruleId: rule.id, limit: rule.limit, remaining, resetMs };\n    return ok === 1 ? Decision.allow(base)\n                    : Decision.deny({ ...base, retryAfterMs: resetMs });\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class FixedWindowCounter extends RateLimitStrategy {\n  constructor({ store, clock }) { super(); this.store = store; this.clock = clock; }\n\n  async consume(key, rule, cost = 1) {\n    const [ok, remaining, resetMs] = await this.store.eval('fixed_window',\n      [key], [rule.limit, rule.windowMs, cost, this.clock.now()]);\n    const base = { ruleId: rule.id, limit: rule.limit, remaining, resetMs };\n    return ok === 1 ? Decision.allow(base)\n                    : Decision.deny({ ...base, retryAfterMs: resetMs });\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e593", "type": "rectangle", "x": 1564, "y": 10300.0, "width": 752, "height": 474.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g100"], "frameId": null, "roundness": {"type": 3}, "seed": 639460223, "version": 1, "versionNonce": 549203428, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e594", "type": "text", "x": 1578, "y": 10314.0, "width": 180.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g100"], "frameId": null, "roundness": null, "seed": 1587060216, "version": 1, "versionNonce": 1586443402, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "scripts/fixed_window.lua", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "scripts/fixed_window.lua", "autoResize": true, "lineHeight": 1.25}, {"id": "e595", "type": "text", "x": 1578, "y": 10340.0, "width": 682.4, "height": 420.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g100"], "frameId": null, "roundness": null, "seed": 2096580069, "version": 1, "versionNonce": 1401915610, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "local key    = KEYS[1]\nlocal limit  = tonumber(ARGV[1])\nlocal window = tonumber(ARGV[2])\nlocal cost   = tonumber(ARGV[3])\nlocal now    = tonumber(ARGV[4])\n\n-- window index derives from the clock, so every node agrees without coordination\nlocal bucket = math.floor(now / window)\nlocal bkey   = key .. ':' .. bucket\nlocal count  = tonumber(redis.call('INCRBY', bkey, cost))\n\nif count == cost then                       -- we just created it\n  redis.call('PEXPIRE', bkey, window * 2)\nend\n\nlocal reset = (bucket + 1) * window - now\n\nif count > limit then\n  -- give the permits back: a rejected request must not inflate the counter,\n  -- or a client hammering at 10x rate stays blocked long past the window.\n  redis.call('DECRBY', bkey, cost)\n  return { 0, 0, reset }\nend\nreturn { 1, limit - count, reset }", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "local key    = KEYS[1]\nlocal limit  = tonumber(ARGV[1])\nlocal window = tonumber(ARGV[2])\nlocal cost   = tonumber(ARGV[3])\nlocal now    = tonumber(ARGV[4])\n\n-- window index derives from the clock, so every node agrees without coordination\nlocal bucket = math.floor(now / window)\nlocal bkey   = key .. ':' .. bucket\nlocal count  = tonumber(redis.call('INCRBY', bkey, cost))\n\nif count == cost then                       -- we just created it\n  redis.call('PEXPIRE', bkey, window * 2)\nend\n\nlocal reset = (bucket + 1) * window - now\n\nif count > limit then\n  -- give the permits back: a rejected request must not inflate the counter,\n  -- or a client hammering at 10x rate stays blocked long past the window.\n  redis.call('DECRBY', bkey, cost)\n  return { 0, 0, reset }\nend\nreturn { 1, limit - count, reset }", "autoResize": true, "lineHeight": 1.25}, {"id": "e610", "type": "rectangle", "x": 60, "y": 10838.0, "width": 2280, "height": 588.5, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 70, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 299780266, "version": 1, "versionNonce": 1176359981, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e597", "type": "rectangle", "x": 84, "y": 10848.0, "width": 70, "height": 44, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g101"], "frameId": null, "roundness": {"type": 3}, "seed": 1408739247, "version": 1, "versionNonce": 512529239, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e598", "type": "text", "x": 94, "y": 10857.0, "width": 33.8, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g101"], "frameId": null, "roundness": null, "seed": 646041018, "version": 1, "versionNonce": 1037625491, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "3/6", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3/6", "autoResize": true, "lineHeight": 1.25}, {"id": "e599", "type": "text", "x": 174, "y": 10852.0, "width": 213.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g101"], "frameId": null, "roundness": null, "seed": 1196839237, "version": 1, "versionNonce": 1436400256, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "sliding_log", "fontSize": 32, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "sliding_log", "autoResize": true, "lineHeight": 1.25}, {"id": "e600", "type": "text", "x": 84, "y": 10904.0, "width": 1058.6, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 846898357, "version": 1, "versionNonce": 257145109, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Memory/key: O(limit)   |   Accuracy: GOOD: Exact   |   Burst: None   |   Redis ops: ZREM+ZCARD+ZADD   |   Pick it when: Small limits, hard cap", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Memory/key: O(limit)   |   Accuracy: GOOD: Exact   |   Burst: None   |   Redis ops: ZREM+ZCARD+ZADD   |   Pick it when: Small limits, hard cap", "autoResize": true, "lineHeight": 1.25}, {"id": "e601", "type": "rectangle", "x": 84, "y": 10946.0, "width": 560, "height": 136.5, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g102"], "frameId": null, "roundness": {"type": 3}, "seed": 359343733, "version": 1, "versionNonce": 1381272297, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e602", "type": "text", "x": 98, "y": 10960.0, "width": 108.1, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g102"], "frameId": null, "roundness": null, "seed": 347155685, "version": 1, "versionNonce": 161427626, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "How it works", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "How it works", "autoResize": true, "lineHeight": 1.25}, {"id": "e603", "type": "text", "x": 98, "y": 10988.5, "width": 524.6, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g102"], "frameId": null, "roundness": null, "seed": 446402843, "version": 1, "versionNonce": 1075040594, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Store a timestamp per request in a sorted set; evict anything older than\nthe window; count what's left. Perfectly accurate, and gives you an\nexact Retry-After for free - the oldest entry's expiry. Cost is O(limit)\nmemory per key, so it does not scale to large limits.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Store a timestamp per request in a sorted set; evict anything older than\nthe window; count what's left. Perfectly accurate, and gives you an\nexact Retry-After for free - the oldest entry's expiry. Cost is O(limit)\nmemory per key, so it does not scale to large limits.", "autoResize": true, "lineHeight": 1.25}, {"id": "e604", "type": "rectangle", "x": 684, "y": 10946.0, "width": 840, "height": 299.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g103"], "frameId": null, "roundness": {"type": 3}, "seed": 1945534087, "version": 1, "versionNonce": 1743384250, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e605", "type": "text", "x": 698, "y": 10960.0, "width": 170.3, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g103"], "frameId": null, "roundness": null, "seed": 1067462117, "version": 1, "versionNonce": 1181946104, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "strategies/sliding-log.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/sliding-log.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e606", "type": "text", "x": 698, "y": 10986.0, "width": 766.4, "height": 245.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g103"], "frameId": null, "roundness": null, "seed": 472500639, "version": 1, "versionNonce": 972780191, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "class SlidingWindowLog extends RateLimitStrategy {\n  constructor({ store, clock }) { super(); this.store = store; this.clock = clock; }\n\n  async consume(key, rule, cost = 1) {\n    // member must be unique or two requests in the same millisecond collapse\n    // into one ZSET entry and you silently under-count.\n    const member = `${this.clock.now()}-${Math.random().toString(36).slice(2, 8)}`;\n    const [ok, remaining, retryMs] = await this.store.eval('sliding_log',\n      [key], [rule.limit, rule.windowMs, this.clock.now(), member, cost]);\n    const base = { ruleId: rule.id, limit: rule.limit, remaining, resetMs: rule.windowMs };\n    return ok === 1 ? Decision.allow(base)\n                    : Decision.deny({ ...base, retryAfterMs: retryMs });\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class SlidingWindowLog extends RateLimitStrategy {\n  constructor({ store, clock }) { super(); this.store = store; this.clock = clock; }\n\n  async consume(key, rule, cost = 1) {\n    // member must be unique or two requests in the same millisecond collapse\n    // into one ZSET entry and you silently under-count.\n    const member = `${this.clock.now()}-${Math.random().toString(36).slice(2, 8)}`;\n    const [ok, remaining, retryMs] = await this.store.eval('sliding_log',\n      [key], [rule.limit, rule.windowMs, this.clock.now(), member, cost]);\n    const base = { ruleId: rule.id, limit: rule.limit, remaining, resetMs: rule.windowMs };\n    return ok === 1 ? Decision.allow(base)\n                    : Decision.deny({ ...base, retryAfterMs: retryMs });\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e607", "type": "rectangle", "x": 1564, "y": 10946.0, "width": 752, "height": 456.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g104"], "frameId": null, "roundness": {"type": 3}, "seed": 1946177225, "version": 1, "versionNonce": 714756123, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e608", "type": "text", "x": 1578, "y": 10960.0, "width": 160.2, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g104"], "frameId": null, "roundness": null, "seed": 2139914010, "version": 1, "versionNonce": 1630472360, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "scripts/sliding_log.lua", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "scripts/sliding_log.lua", "autoResize": true, "lineHeight": 1.25}, {"id": "e609", "type": "text", "x": 1578, "y": 10986.0, "width": 707.6, "height": 402.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g104"], "frameId": null, "roundness": null, "seed": 966282699, "version": 1, "versionNonce": 917883966, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "local key    = KEYS[1]\nlocal limit  = tonumber(ARGV[1])\nlocal window = tonumber(ARGV[2])\nlocal now    = tonumber(ARGV[3])\nlocal member = ARGV[4]\nlocal cost   = tonumber(ARGV[5])\n\nredis.call('ZREMRANGEBYSCORE', key, 0, now - window)   -- evict expired\nlocal count = tonumber(redis.call('ZCARD', key))\n\nif count + cost <= limit then\n  for i = 1, cost do                                    -- weighted cost = N entries\n    redis.call('ZADD', key, now, member .. ':' .. i)\n  end\n  redis.call('PEXPIRE', key, window)\n  return { 1, limit - count - cost, 0 }\nend\n\n-- exact retry: when the oldest entry falls out of the window\nlocal oldest = redis.call('ZRANGE', key, 0, 0, 'WITHSCORES')\nlocal retry  = math.ceil((tonumber(oldest[2]) + window) - now)\nredis.call('PEXPIRE', key, window)\nreturn { 0, 0, retry }", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "local key    = KEYS[1]\nlocal limit  = tonumber(ARGV[1])\nlocal window = tonumber(ARGV[2])\nlocal now    = tonumber(ARGV[3])\nlocal member = ARGV[4]\nlocal cost   = tonumber(ARGV[5])\n\nredis.call('ZREMRANGEBYSCORE', key, 0, now - window)   -- evict expired\nlocal count = tonumber(redis.call('ZCARD', key))\n\nif count + cost <= limit then\n  for i = 1, cost do                                    -- weighted cost = N entries\n    redis.call('ZADD', key, now, member .. ':' .. i)\n  end\n  redis.call('PEXPIRE', key, window)\n  return { 1, limit - count - cost, 0 }\nend\n\n-- exact retry: when the oldest entry falls out of the window\nlocal oldest = redis.call('ZRANGE', key, 0, 0, 'WITHSCORES')\nlocal retry  = math.ceil((tonumber(oldest[2]) + window) - now)\nredis.call('PEXPIRE', key, window)\nreturn { 0, 0, retry }", "autoResize": true, "lineHeight": 1.25}, {"id": "e624", "type": "rectangle", "x": 60, "y": 11466.5, "width": 2280, "height": 676.0, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 70, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 726285630, "version": 1, "versionNonce": 1615146092, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e611", "type": "rectangle", "x": 84, "y": 11476.5, "width": 70, "height": 44, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g105"], "frameId": null, "roundness": {"type": 3}, "seed": 413191099, "version": 1, "versionNonce": 524169908, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e612", "type": "text", "x": 94, "y": 11485.5, "width": 33.8, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g105"], "frameId": null, "roundness": null, "seed": 194807922, "version": 1, "versionNonce": 375154855, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "4/6", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4/6", "autoResize": true, "lineHeight": 1.25}, {"id": "e613", "type": "text", "x": 174, "y": 11480.5, "width": 290.0, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g105"], "frameId": null, "roundness": null, "seed": 734343277, "version": 1, "versionNonce": 1193730514, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "sliding_counter", "fontSize": 32, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "sliding_counter", "autoResize": true, "lineHeight": 1.25}, {"id": "e614", "type": "text", "x": 84, "y": 11532.5, "width": 1050.1, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 195623613, "version": 1, "versionNonce": 685665214, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Memory/key: O(1)   |   Accuracy: MID: ~0.003% err   |   Burst: Smoothed   |   Redis ops: 2 GET + INCR   |   Pick it when: Best default for quotas", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Memory/key: O(1)   |   Accuracy: MID: ~0.003% err   |   Burst: Smoothed   |   Redis ops: 2 GET + INCR   |   Pick it when: Best default for quotas", "autoResize": true, "lineHeight": 1.25}, {"id": "e615", "type": "rectangle", "x": 84, "y": 11574.5, "width": 1120, "height": 136.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g106"], "frameId": null, "roundness": {"type": 3}, "seed": 513520418, "version": 1, "versionNonce": 790929686, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e616", "type": "text", "x": 98, "y": 11588.5, "width": 108.1, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g106"], "frameId": null, "roundness": null, "seed": 554818646, "version": 1, "versionNonce": 1738084018, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "How it works", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "How it works", "autoResize": true, "lineHeight": 1.25}, {"id": "e617", "type": "text", "x": 98, "y": 11617.0, "width": 1044.4, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g106"], "frameId": null, "roundness": null, "seed": 1223244794, "version": 1, "versionNonce": 434096300, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Two fixed-window counters, blended by how far into the current window you are. O(1) memory with the boundary flaw mostly gone. Cloudflare\npublished that it holds ~0.003% error at scale - worth quoting.\n\nEstimate = prev x (1 - elapsedFraction) + current. At 25% into the window you still count 75% of the previous window's traffic.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Two fixed-window counters, blended by how far into the current window you are. O(1) memory with the boundary flaw mostly gone. Cloudflare\npublished that it holds ~0.003% error at scale - worth quoting.\n\nEstimate = prev x (1 - elapsedFraction) + current. At 25% into the window you still count 75% of the previous window's traffic.", "autoResize": true, "lineHeight": 1.25}, {"id": "e618", "type": "rectangle", "x": 84, "y": 11731.0, "width": 1120, "height": 91.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g107"], "frameId": null, "roundness": {"type": 3}, "seed": 1905358007, "version": 1, "versionNonce": 43125184, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e619", "type": "text", "x": 98, "y": 11745.0, "width": 170.8, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g107"], "frameId": null, "roundness": null, "seed": 1609877447, "version": 1, "versionNonce": 1869632546, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "ASSUMPTION TO STATE", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ASSUMPTION TO STATE", "autoResize": true, "lineHeight": 1.25}, {"id": "e620", "type": "text", "x": 98, "y": 11768.5, "width": 1087.0, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g107"], "frameId": null, "roundness": null, "seed": 886441858, "version": 1, "versionNonce": 822138090, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "The blend assumes traffic was uniformly distributed across the previous window. It isn't, so the estimate can be slightly wrong in both directions. For\na billing quota that's unacceptable and you use the log; for abuse protection it's perfect.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The blend assumes traffic was uniformly distributed across the previous window. It isn't, so the estimate can be slightly wrong in both directions. For\na billing quota that's unacceptable and you use the log; for abuse protection it's perfect.", "autoResize": true, "lineHeight": 1.25}, {"id": "e621", "type": "rectangle", "x": 1244, "y": 11574.5, "width": 1072, "height": 544.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g108"], "frameId": null, "roundness": {"type": 3}, "seed": 888808202, "version": 1, "versionNonce": 1601680382, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e622", "type": "text", "x": 1258, "y": 11588.5, "width": 192.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g108"], "frameId": null, "roundness": null, "seed": 1125642521, "version": 1, "versionNonce": 450982165, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "scripts/sliding_counter.lua", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "scripts/sliding_counter.lua", "autoResize": true, "lineHeight": 1.25}, {"id": "e623", "type": "text", "x": 1258, "y": 11614.5, "width": 690.8, "height": 490.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g108"], "frameId": null, "roundness": null, "seed": 809313178, "version": 1, "versionNonce": 580335655, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "local key    = KEYS[1]\nlocal limit  = tonumber(ARGV[1])\nlocal window = tonumber(ARGV[2])\nlocal now    = tonumber(ARGV[3])\nlocal cost   = tonumber(ARGV[4])\n\nlocal cur  = math.floor(now / window)\nlocal ckey = key .. ':' .. cur\nlocal pkey = key .. ':' .. (cur - 1)\n\nlocal ccount = tonumber(redis.call('GET', ckey)) or 0\nlocal pcount = tonumber(redis.call('GET', pkey)) or 0\n\nlocal elapsed  = (now % window) / window          -- 0.0 .. 1.0 through window\nlocal estimate = pcount * (1 - elapsed) + ccount\nlocal reset    = window - (now % window)\n\nif estimate + cost > limit then\n  -- retry when enough of the previous window has aged out\n  local need  = estimate + cost - limit\n  local retry = reset\n  if pcount > 0 then retry = math.ceil((need / pcount) * window) end\n  return { 0, 0, math.min(retry, reset) }\nend\n\nredis.call('INCRBY', ckey, cost)\nredis.call('PEXPIRE', ckey, window * 2)          -- must outlive its use as \"prev\"\nreturn { 1, math.floor(limit - estimate - cost), reset }", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "local key    = KEYS[1]\nlocal limit  = tonumber(ARGV[1])\nlocal window = tonumber(ARGV[2])\nlocal now    = tonumber(ARGV[3])\nlocal cost   = tonumber(ARGV[4])\n\nlocal cur  = math.floor(now / window)\nlocal ckey = key .. ':' .. cur\nlocal pkey = key .. ':' .. (cur - 1)\n\nlocal ccount = tonumber(redis.call('GET', ckey)) or 0\nlocal pcount = tonumber(redis.call('GET', pkey)) or 0\n\nlocal elapsed  = (now % window) / window          -- 0.0 .. 1.0 through window\nlocal estimate = pcount * (1 - elapsed) + ccount\nlocal reset    = window - (now % window)\n\nif estimate + cost > limit then\n  -- retry when enough of the previous window has aged out\n  local need  = estimate + cost - limit\n  local retry = reset\n  if pcount > 0 then retry = math.ceil((need / pcount) * window) end\n  return { 0, 0, math.min(retry, reset) }\nend\n\nredis.call('INCRBY', ckey, cost)\nredis.call('PEXPIRE', ckey, window * 2)          -- must outlive its use as \"prev\"\nreturn { 1, math.floor(limit - estimate - cost), reset }", "autoResize": true, "lineHeight": 1.25}, {"id": "e672", "type": "rectangle", "x": 60, "y": 12182.5, "width": 2280, "height": 964.0, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 70, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1500193234, "version": 1, "versionNonce": 1640342610, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e625", "type": "rectangle", "x": 84, "y": 12192.5, "width": 70, "height": 44, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g109"], "frameId": null, "roundness": {"type": 3}, "seed": 133271799, "version": 1, "versionNonce": 1069760176, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e626", "type": "text", "x": 94, "y": 12201.5, "width": 33.8, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g109"], "frameId": null, "roundness": null, "seed": 595961815, "version": 1, "versionNonce": 1233258552, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "5/6", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "5/6", "autoResize": true, "lineHeight": 1.25}, {"id": "e627", "type": "text", "x": 174, "y": 12196.5, "width": 232.4, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g109"], "frameId": null, "roundness": null, "seed": 2078088284, "version": 1, "versionNonce": 773406007, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "leaky_bucket", "fontSize": 32, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "leaky_bucket", "autoResize": true, "lineHeight": 1.25}, {"id": "e628", "type": "text", "x": 84, "y": 12248.5, "width": 1207.7, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 270311932, "version": 1, "versionNonce": 1474791228, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Memory/key: O(1) meter   |   Accuracy: GOOD: Exact   |   Burst: None - smooths   |   Redis ops: HMGET+HSET   |   Pick it when: Protecting a fixed-rate downstream", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Memory/key: O(1) meter   |   Accuracy: GOOD: Exact   |   Burst: None - smooths   |   Redis ops: HMGET+HSET   |   Pick it when: Protecting a fixed-rate downstream", "autoResize": true, "lineHeight": 1.25}, {"id": "e629", "type": "rectangle", "x": 84, "y": 12290.5, "width": 1120, "height": 176.5, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g110"], "frameId": null, "roundness": {"type": 3}, "seed": 1081034144, "version": 1, "versionNonce": 1136503526, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e630", "type": "text", "x": 98, "y": 12304.5, "width": 108.1, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g110"], "frameId": null, "roundness": null, "seed": 1352113483, "version": 1, "versionNonce": 1697181866, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "How it works", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "How it works", "autoResize": true, "lineHeight": 1.25}, {"id": "e631", "type": "text", "x": 98, "y": 12333.0, "width": 1082.7, "height": 120.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g110"], "frameId": null, "roundness": null, "seed": 1852980625, "version": 1, "versionNonce": 1822423948, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Two different things share this name. Be explicit about which one you mean - interviewers use it loosely and the distinction is a free point.\n\n- Leaky bucket as a queue: requests enter a FIFO that drains at a fixed rate. Excess is queued (adds latency) or dropped when the queue is full.\nOutput is perfectly smooth. Use when the downstream literally cannot go faster.\n- Leaky bucket as a meter: a counter that leaks at a fixed rate; a request is admitted if adding it doesn't overflow. Mathematically this is the mirror of\nthe token bucket - same behaviour, no burst allowance.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Two different things share this name. Be explicit about which one you mean - interviewers use it loosely and the distinction is a free point.\n\n- Leaky bucket as a queue: requests enter a FIFO that drains at a fixed rate. Excess is queued (adds latency) or dropped when the queue is full.\nOutput is perfectly smooth. Use when the downstream literally cannot go faster.\n- Leaky bucket as a meter: a counter that leaks at a fixed rate; a request is admitted if adding it doesn't overflow. Mathematically this is the mirror of\nthe token bucket - same behaviour, no burst allowance.", "autoResize": true, "lineHeight": 1.25}, {"id": "e632", "type": "rectangle", "x": 84, "y": 12487.0, "width": 1120, "height": 91.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g111"], "frameId": null, "roundness": {"type": 3}, "seed": 463777328, "version": 1, "versionNonce": 198853031, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e633", "type": "text", "x": 98, "y": 12501.0, "width": 100.7, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g111"], "frameId": null, "roundness": null, "seed": 582012897, "version": 1, "versionNonce": 1925842145, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "SAY THE RISK", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "SAY THE RISK", "autoResize": true, "lineHeight": 1.25}, {"id": "e634", "type": "text", "x": 98, "y": 12524.5, "width": 1086.4, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g111"], "frameId": null, "roundness": null, "seed": 533550147, "version": 1, "versionNonce": 825837949, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Queueing converts a rate problem into a latency problem. Under sustained overload the queue sits full and every admitted request waits the\nmaximum. Always pair a queue with a deadline: if a request's remaining timeout is less than its queue wait, shed it immediately instead of holding it.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Queueing converts a rate problem into a latency problem. Under sustained overload the queue sits full and every admitted request waits the\nmaximum. Always pair a queue with a deadline: if a request's remaining timeout is less than its queue wait, shed it immediately instead of holding it.", "autoResize": true, "lineHeight": 1.25}, {"id": "e635", "type": "rectangle", "x": 84, "y": 12602.5, "width": 1120, "height": 520, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g112"], "frameId": null, "roundness": {"type": 3}, "seed": 858471907, "version": 1, "versionNonce": 1386827139, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e636", "type": "text", "x": 104, "y": 12616.5, "width": 390.7, "height": 21.2, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 957473606, "version": 1, "versionNonce": 927362216, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "QUEUE variant - shapes traffic (per-process only)", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "QUEUE variant - shapes traffic (per-process only)", "autoResize": true, "lineHeight": 1.25}, {"id": "e637", "type": "rectangle", "x": 104, "y": 12656.5, "width": 170, "height": 90, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g113"], "frameId": null, "roundness": {"type": 3}, "seed": 2048578234, "version": 1, "versionNonce": 670049282, "isDeleted": false, "boundElements": [{"id": "e650", "type": "arrow"}], "updated": 1792011375077, "link": null, "locked": false}, {"id": "e638", "type": "text", "x": 114, "y": 12690.2, "width": 150, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g113"], "frameId": null, "roundness": null, "seed": 1822534305, "version": 1, "versionNonce": 1748779612, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "requests", "fontSize": 18, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "requests", "autoResize": true, "lineHeight": 1.25}, {"id": "e639", "type": "rectangle", "x": 334, "y": 12656.5, "width": 250, "height": 90, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g114"], "frameId": null, "roundness": {"type": 3}, "seed": 1874519106, "version": 1, "versionNonce": 2078850911, "isDeleted": false, "boundElements": [{"id": "e650", "type": "arrow"}, {"id": "e651", "type": "arrow"}, {"id": "e653", "type": "arrow"}], "updated": 1792011375077, "link": null, "locked": false}, {"id": "e640", "type": "text", "x": 344, "y": 12677.9, "width": 230, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transpare