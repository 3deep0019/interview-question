inerId": null, "originalText": "-", "autoResize": true, "lineHeight": 1.25}, {"id": "e1003", "type": "text", "x": 829, "y": 21125.2, "width": 423.5, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g179"], "frameId": null, "roundness": null, "seed": 1840544059, "version": 1, "versionNonce": 142551403, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Client exceeded quota. Not 503 - that means server overload", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Client exceeded quota. Not 503 - that means server overload", "autoResize": true, "lineHeight": 1.25}, {"id": "e1004", "type": "line", "x": 580, "y": 20935.8, "width": 0, "height": 217.2, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g179"], "frameId": null, "roundness": null, "seed": 2139160385, "version": 1, "versionNonce": 1318820761, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "points": [[0, 0.0], [0, 217.2]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e1005", "type": "line", "x": 820, "y": 20935.8, "width": 0, "height": 217.2, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g179"], "frameId": null, "roundness": null, "seed": 1572139257, "version": 1, "versionNonce": 1487238827, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "points": [[0, 0.0], [0, 217.2]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e1006", "type": "rectangle", "x": 60, "y": 21193.0, "width": 1120, "height": 841.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g180"], "frameId": null, "roundness": {"type": 3}, "seed": 1750176521, "version": 1, "versionNonce": 235338531, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1007", "type": "text", "x": 74, "y": 21207.0, "width": 333.1, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g180"], "frameId": null, "roundness": null, "seed": 415983267, "version": 1, "versionNonce": 282646378, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "middleware.js   -   Express wiring, end to end", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "middleware.js   -   Express wiring, end to end", "autoResize": true, "lineHeight": 1.25}, {"id": "e1008", "type": "text", "x": 74, "y": 21233.0, "width": 665.6, "height": 787.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g180"], "frameId": null, "roundness": null, "seed": 2108245016, "version": 1, "versionNonce": 1902015410, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "function rateLimit({ limiter, costOf = () => 1, exempt = () => false }) {\n  return async function rateLimitMiddleware(req, res, next) {\n    if (exempt(req)) return next();\n\n    const ctx = {\n      apiKey: req.get('x-api-key'),\n      userId: req.user?.id,\n      ip:     normalizeIp(req.ip),\n      route:  req.route?.path ?? req.path,\n      method: req.method,\n      plan:   req.user?.plan ?? 'free',\n    };\n\n    let d;\n    try {\n      d = await limiter.check(ctx, costOf(req));\n    } catch (err) {\n      req.log.error({ err }, 'rate limiter failed unexpectedly');\n      return next();                       // fail open on an unhandled bug too\n    }\n\n    res.set({\n      'RateLimit-Limit':     String(d.limit),\n      'RateLimit-Remaining': String(d.remaining),\n      'RateLimit-Reset':     String(Math.ceil(d.resetMs / 1000)),\n    });\n\n    if (d.allowed) return next();\n\n    const retryS = Math.max(1, Math.ceil(d.retryAfterMs / 1000));\n    res.set('Retry-After', String(retryS));\n    return res.status(429).json({\n      error: 'rate_limit_exceeded',\n      message: `Too many requests. Retry in ${retryS}s.`,\n      rule: d.ruleId,                      // tells the client WHICH tier bit\n      retryAfterSeconds: retryS,\n    });\n  };\n}\n\n/** IPv6 /64 - a single client can own the whole rest of the address space. */\nfunction normalizeIp(ip) {\n  if (!ip.includes(':')) return ip;\n  return ip.split(':').slice(0, 4).join(':') + '::/64';\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "function rateLimit({ limiter, costOf = () => 1, exempt = () => false }) {\n  return async function rateLimitMiddleware(req, res, next) {\n    if (exempt(req)) return next();\n\n    const ctx = {\n      apiKey: req.get('x-api-key'),\n      userId: req.user?.id,\n      ip:     normalizeIp(req.ip),\n      route:  req.route?.path ?? req.path,\n      method: req.method,\n      plan:   req.user?.plan ?? 'free',\n    };\n\n    let d;\n    try {\n      d = await limiter.check(ctx, costOf(req));\n    } catch (err) {\n      req.log.error({ err }, 'rate limiter failed unexpectedly');\n      return next();                       // fail open on an unhandled bug too\n    }\n\n    res.set({\n      'RateLimit-Limit':     String(d.limit),\n      'RateLimit-Remaining': String(d.remaining),\n      'RateLimit-Reset':     String(Math.ceil(d.resetMs / 1000)),\n    });\n\n    if (d.allowed) return next();\n\n    const retryS = Math.max(1, Math.ceil(d.retryAfterMs / 1000));\n    res.set('Retry-After', String(retryS));\n    return res.status(429).json({\n      error: 'rate_limit_exceeded',\n      message: `Too many requests. Retry in ${retryS}s.`,\n      rule: d.ruleId,                      // tells the client WHICH tier bit\n      retryAfterSeconds: retryS,\n    });\n  };\n}\n\n/** IPv6 /64 - a single client can own the whole rest of the address space. */\nfunction normalizeIp(ip) {\n  if (!ip.includes(':')) return ip;\n  return ip.split(':').slice(0, 4).join(':') + '::/64';\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e1009", "type": "text", "x": 1220, "y": 21189.0, "width": 395.5, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1056282711, "version": 1, "versionNonce": 618221024, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Testing - say this, it's rare and it scores", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Testing - say this, it's rare and it scores", "autoResize": true, "lineHeight": 1.25}, {"id": "e1010", "type": "rectangle", "x": 1220, "y": 21233.0, "width": 1120, "height": 596.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g181"], "frameId": null, "roundness": {"type": 3}, "seed": 2054367220, "version": 1, "versionNonce": 1741598339, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1011", "type": "text", "x": 1234, "y": 21247.0, "width": 145.4, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g181"], "frameId": null, "roundness": null, "seed": 1967183538, "version": 1, "versionNonce": 1707197694, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "token-bucket.test.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "token-bucket.test.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e1012", "type": "text", "x": 1234, "y": 21273.0, "width": 674.0, "height": 542.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g181"], "frameId": null, "roundness": null, "seed": 354574282, "version": 1, "versionNonce": 1473461446, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "// A fake clock makes rate-limiter tests instant and deterministic.\n// If your suite contains a sleep, the design has a testability bug.\nconst fakeClock = (start = 0) => ({\n  t: start,\n  now() { return this.t; },\n  advance(ms) { this.t += ms; },\n});\n\ntest('refills at exactly the configured rate', () => {\n  const clock  = fakeClock();\n  const bucket = new LocalTokenBucket({ capacity: 10, refillPerSec: 5, clock });\n\n  for (let i = 0; i < 10; i++) expect(bucket.tryConsume().ok).toBe(true);\n  expect(bucket.tryConsume().ok).toBe(false);          // drained\n\n  clock.advance(1000);                                  // +5 tokens\n  for (let i = 0; i < 5; i++) expect(bucket.tryConsume().ok).toBe(true);\n  expect(bucket.tryConsume().ok).toBe(false);\n\n  clock.advance(60_000);                                // caps at capacity\n  let allowed = 0;\n  while (bucket.tryConsume().ok) allowed++;\n  expect(allowed).toBe(10);\n});\n\ntest('retryAfter is the exact wait for one token', () => {\n  const clock  = fakeClock();\n  const bucket = new LocalTokenBucket({ capacity: 1, refillPerSec: 2, clock });\n  bucket.tryConsume();\n  expect(bucket.tryConsume().retryMs).toBe(500);        // 1 token / 2 per sec\n});", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "// A fake clock makes rate-limiter tests instant and deterministic.\n// If your suite contains a sleep, the design has a testability bug.\nconst fakeClock = (start = 0) => ({\n  t: start,\n  now() { return this.t; },\n  advance(ms) { this.t += ms; },\n});\n\ntest('refills at exactly the configured rate', () => {\n  const clock  = fakeClock();\n  const bucket = new LocalTokenBucket({ capacity: 10, refillPerSec: 5, clock });\n\n  for (let i = 0; i < 10; i++) expect(bucket.tryConsume().ok).toBe(true);\n  expect(bucket.tryConsume().ok).toBe(false);          // drained\n\n  clock.advance(1000);                                  // +5 tokens\n  for (let i = 0; i < 5; i++) expect(bucket.tryConsume().ok).toBe(true);\n  expect(bucket.tryConsume().ok).toBe(false);\n\n  clock.advance(60_000);                                // caps at capacity\n  let allowed = 0;\n  while (bucket.tryConsume().ok) allowed++;\n  expect(allowed).toBe(10);\n});\n\ntest('retryAfter is the exact wait for one token', () => {\n  const clock  = fakeClock();\n  const bucket = new LocalTokenBucket({ capacity: 1, refillPerSec: 2, clock });\n  bucket.tryConsume();\n  expect(bucket.tryConsume().retryMs).toBe(500);        // 1 token / 2 per sec\n});", "autoResize": true, "lineHeight": 1.25}, {"id": "e1013", "type": "rectangle", "x": 1220, "y": 21853.5, "width": 1120, "height": 91.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g182"], "frameId": null, "roundness": {"type": 3}, "seed": 1693036428, "version": 1, "versionNonce": 1548505991, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1014", "type": "text", "x": 1234, "y": 21867.5, "width": 161.9, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g182"], "frameId": null, "roundness": null, "seed": 1998412805, "version": 1, "versionNonce": 474866159, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "ALSO WORTH NAMING", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ALSO WORTH NAMING", "autoResize": true, "lineHeight": 1.25}, {"id": "e1015", "type": "text", "x": 1234, "y": 21891.0, "width": 1072.5, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g182"], "frameId": null, "roundness": null, "seed": 140694978, "version": 1, "versionNonce": 1788931372, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "A concurrency test that fires 1000 parallel consume calls against a real Redis and asserts exactly limit succeeded - that's the test that proves your\nLua is actually atomic.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A concurrency test that fires 1000 parallel consume calls against a real Redis and asserts exactly limit succeeded - that's the test that proves your\nLua is actually atomic.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1051", "type": "rectangle", "x": 0, "y": 22194.5, "width": 2400, "height": 1017.2, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2127078792, "version": 1, "versionNonce": 792302230, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1017", "type": "rectangle", "x": 60, "y": 22234.5, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g183"], "frameId": null, "roundness": {"type": 3}, "seed": 1623883690, "version": 1, "versionNonce": 541639981, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1018", "type": "text", "x": 74, "y": 22241.5, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g183"], "frameId": null, "roundness": null, "seed": 340950508, "version": 1, "versionNonce": 695438973, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "10", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "10", "autoResize": true, "lineHeight": 1.25}, {"id": "e1019", "type": "text", "x": 144, "y": 22236.5, "width": 314.5, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g183"], "frameId": null, "roundness": null, "seed": 1925299070, "version": 1, "versionNonce": 1317549340, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Follow-ups they ask", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Follow-ups they ask", "autoResize": true, "lineHeight": 1.25}, {"id": "e1020", "type": "text", "x": 60, "y": 22296.5, "width": 622.3, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 590542093, "version": 1, "versionNonce": 1943606261, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Rehearse these. They're the second half of almost every rate-limiter round.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Rehearse these. They're the second half of almost every rate-limiter round.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1021", "type": "rectangle", "x": 60, "y": 22347.0, "width": 1120, "height": 157.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g184"], "frameId": null, "roundness": {"type": 3}, "seed": 1751544906, "version": 1, "versionNonce": 980117648, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1022", "type": "text", "x": 74, "y": 22361.0, "width": 525.9, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g184"], "frameId": null, "roundness": null, "seed": 308319159, "version": 1, "versionNonce": 545807455, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q1  How do you enforce a global limit across three regions?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q1  How do you enforce a global limit across three regions?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1023", "type": "text", "x": 74, "y": 22390.8, "width": 1083.0, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g184"], "frameId": null, "roundness": null, "seed": 1078504792, "version": 1, "versionNonce": 2070878176, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Don't, synchronously. Cross-region RTT is 70-150 ms - a synchronous check would dominate your latency budget. Three real options: (1) Regional\nquotas - split the global limit by historical traffic share, rebalance every few minutes from an aggregator. Simple, slightly unfair at the margins, and\nwhat most companies actually run. (2) Async reconciliation - each region enforces locally and streams consumption to a global aggregator that\nadjusts regional allowances; converges within seconds, over-admits briefly. (3) Home region per tenant - route each tenant's traffic to one region so\nits counter has one owner; accurate, but a cross-region failover resets state. State the accuracy SLO up front and pick (1) or (3).", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Don't, synchronously. Cross-region RTT is 70-150 ms - a synchronous check would dominate your latency budget. Three real options: (1) Regional\nquotas - split the global limit by historical traffic share, rebalance every few minutes from an aggregator. Simple, slightly unfair at the margins, and\nwhat most companies actually run. (2) Async reconciliation - each region enforces locally and streams consumption to a global aggregator that\nadjusts regional allowances; converges within seconds, over-admits briefly. (3) Home region per tenant - route each tenant's traffic to one region so\nits counter has one owner; accurate, but a cross-region failover resets state. State the accuracy SLO up front and pick (1) or (3).", "autoResize": true, "lineHeight": 1.25}, {"id": "e1024", "type": "rectangle", "x": 1220, "y": 22347.0, "width": 1120, "height": 157.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g185"], "frameId": null, "roundness": {"type": 3}, "seed": 1975486987, "version": 1, "versionNonce": 1031023171, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1025", "type": "text", "x": 1234, "y": 22361.0, "width": 545.3, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g185"], "frameId": null, "roundness": null, "seed": 447370965, "version": 1, "versionNonce": 1271069309, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q2  How do you support different plans - free, pro, enterprise?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q2  How do you support different plans - free, pro, enterprise?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1026", "type": "text", "x": 1234, "y": 22390.8, "width": 1091.2, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g185"], "frameId": null, "roundness": null, "seed": 564504011, "version": 1, "versionNonce": 1322562682, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Plan is part of rule resolution, not of the algorithm. The resolver returns the most specific matching rule (plan:route -> route -> *), so a plan change is\na config write, not a deploy. Store plan quotas in the control plane keyed by plan ID, keep the tenant->plan mapping in a short-TTL local cache, and\ntreat an upgrade as: write the new plan, invalidate, next request picks it up. Never bake plan limits into the key - you'd have to migrate keys on\nupgrade.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Plan is part of rule resolution, not of the algorithm. The resolver returns the most specific matching rule (plan:route -> route -> *), so a plan change is\na config write, not a deploy. Store plan quotas in the control plane keyed by plan ID, keep the tenant->plan mapping in a short-TTL local cache, and\ntreat an upgrade as: write the new plan, invalidate, next request picks it up. Never bake plan limits into the key - you'd have to migrate keys on\nupgrade.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1027", "type": "rectangle", "x": 60, "y": 22528.8, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g186"], "frameId": null, "roundness": {"type": 3}, "seed": 1086641699, "version": 1, "versionNonce": 509810849, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1028", "type": "text", "x": 74, "y": 22542.8, "width": 622.5, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g186"], "frameId": null, "roundness": null, "seed": 685213755, "version": 1, "versionNonce": 799437186, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q3  A client's requests aren't all equal in cost. How do you handle that?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q3  A client's requests aren't all equal in cost. How do you handle that?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1029", "type": "text", "x": 74, "y": 22572.5, "width": 1083.4, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g186"], "frameId": null, "roundness": null, "seed": 79098385, "version": 1, "versionNonce": 427225016, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Two layers. Pre-cost: charge an estimated cost before executing (GraphQL query complexity, page size, model tokens requested) - that's the cost\nparameter threaded through every strategy above. Post-cost reconciliation: after the request completes, adjust by the actual cost with a second\nconsume call carrying the delta, which can be negative. Token bucket handles this naturally because it's just arithmetic on a balance. Fixed-window\ncounters handle it too; sliding-log doesn't, since entries are unit-sized.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Two layers. Pre-cost: charge an estimated cost before executing (GraphQL query complexity, page size, model tokens requested) - that's the cost\nparameter threaded through every strategy above. Post-cost reconciliation: after the request completes, adjust by the actual cost with a second\nconsume call carrying the delta, which can be negative. Token bucket handles this naturally because it's just arithmetic on a balance. Fixed-window\ncounters handle it too; sliding-log doesn't, since entries are unit-sized.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1030", "type": "rectangle", "x": 1220, "y": 22528.8, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g187"], "frameId": null, "roundness": {"type": 3}, "seed": 391049018, "version": 1, "versionNonce": 866435467, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1031", "type": "text", "x": 1234, "y": 22542.8, "width": 742.2, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g187"], "frameId": null, "roundness": null, "seed": 346237381, "version": 1, "versionNonce": 1367027484, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q4  Redis just failed over and you lost 3 seconds of counters. Is your system wrong?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q4  Redis just failed over and you lost 3 seconds of counters. Is your system wrong?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1032", "type": "text", "x": 1234, "y": 22572.5, "width": 1083.1, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g187"], "frameId": null, "roundness": null, "seed": 2010911763, "version": 1, "versionNonce": 597426025, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "It's degraded within a stated bound, not wrong. Rate limiting is soft state: I'd declare an SLO like \"never exceed 2x the limit for longer than 5\nseconds\" and show that a failover satisfies it, because buckets refill from empty-or-full within one window. If the business needs a hard cap I'd push\nback that a rate limiter is the wrong tool - that needs a durable ledger with idempotency keys, and the limiter sits in front of it as cheap first-line\ndefence.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "It's degraded within a stated bound, not wrong. Rate limiting is soft state: I'd declare an SLO like \"never exceed 2x the limit for longer than 5\nseconds\" and show that a failover satisfies it, because buckets refill from empty-or-full within one window. If the business needs a hard cap I'd push\nback that a rate limiter is the wrong tool - that needs a durable ledger with idempotency keys, and the limiter sits in front of it as cheap first-line\ndefence.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1033", "type": "rectangle", "x": 60, "y": 22690.5, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g188"], "frameId": null, "roundness": {"type": 3}, "seed": 1459601587, "version": 1, "versionNonce": 703997386, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1034", "type": "text", "x": 74, "y": 22704.5, "width": 420.4, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g188"], "frameId": null, "roundness": null, "seed": 1922885004, "version": 1, "versionNonce": 809259524, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q5  Why not just use a distributed lock per key?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q5  Why not just use a distributed lock per key?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1035", "type": "text", "x": 74, "y": 22734.2, "width": 1089.7, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g188"], "frameId": null, "roundness": null, "seed": 362370773, "version": 1, "versionNonce": 1701073679, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "A lock adds two round trips and a failure mode (lock holder dies) to buy something Lua already gives you for free: Redis executes a script atomically\nbecause it's single-threaded. Redlock in particular is contested and unnecessary here - the whole operation is a single read-modify-write on a single\nkey on a single shard. Locks would also serialize a hot key, which is exactly the throughput problem you're trying to avoid.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A lock adds two round trips and a failure mode (lock holder dies) to buy something Lua already gives you for free: Redis executes a script atomically\nbecause it's single-threaded. Redlock in particular is contested and unnecessary here - the whole operation is a single read-modify-write on a single\nkey on a single shard. Locks would also serialize a hot key, which is exactly the throughput problem you're trying to avoid.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1036", "type": "rectangle", "x": 1220, "y": 22690.5, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g189"], "frameId": null, "roundness": {"type": 3}, "seed": 1685494026, "version": 1, "versionNonce": 567667671, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1037", "type": "text", "x": 1234, "y": 22704.5, "width": 604.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g189"], "frameId": null, "roundness": null, "seed": 247129618, "version": 1, "versionNonce": 1649838084, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q6  How would you rate limit WebSockets or long-lived connections?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q6  How would you rate limit WebSockets or long-lived connections?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1038", "type": "text", "x": 1234, "y": 22734.2, "width": 1088.6, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g189"], "frameId": null, "roundness": null, "seed": 1139715181, "version": 1, "versionNonce": 104306663, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Limit three separate things: connection establishment (a normal per-IP/per-user limit on the upgrade request), concurrent connections (a counter\nincremented on open, decremented on close, with a TTL heartbeat so a crashed node's connections eventually decay), and message rate per\nconnection (a purely local token bucket held in the connection object - no Redis needed, since the connection lives on one node). The third is where\nconcurrency limiting beats rate limiting: what you're protecting is a resource held over time, not a request count.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Limit three separate things: connection establishment (a normal per-IP/per-user limit on the upgrade request), concurrent connections (a counter\nincremented on open, decremented on close, with a TTL heartbeat so a crashed node's connections eventually decay), and message rate per\nconnection (a purely local token bucket held in the connection object - no Redis needed, since the connection lives on one node). The third is where\nconcurrency limiting beats rate limiting: what you're protecting is a resource held over time, not a request count.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1039", "type": "rectangle", "x": 60, "y": 22852.2, "width": 1120, "height": 157.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g190"], "frameId": null, "roundness": {"type": 3}, "seed": 1366483948, "version": 1, "versionNonce": 1843161526, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1040", "type": "text", "x": 74, "y": 22866.2, "width": 744.5, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g190"], "frameId": null, "roundness": null, "seed": 772619777, "version": 1, "versionNonce": 2074801886, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q7  Rate limiting vs. concurrency limiting vs. load shedding - when do you use each?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q7  Rate limiting vs. concurrency limiting vs. load shedding - when do you use each?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1041", "type": "text", "x": 74, "y": 22896.0, "width": 1089.2, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g190"], "frameId": null, "roundness": null, "seed": 1874650360, "version": 1, "versionNonce": 972892965, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Rate limiting caps requests per unit time - fairness and quota enforcement, per identity. Concurrency limiting caps requests in flight - protects a\nbounded resource like a connection pool, and adapts naturally to how slow the downstream currently is. Load shedding is server-health-driven:\nwhen queue depth or p99 crosses a threshold, drop the lowest-priority traffic regardless of who sent it. A mature system runs all three: quotas at the\ngateway, concurrency limits at the service boundary (see Netflix's adaptive concurrency / TCP Vegas approach), and priority shedding when the box\nis genuinely in trouble.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Rate limiting caps requests per unit time - fairness and quota enforcement, per identity. Concurrency limiting caps requests in flight - protects a\nbounded resource like a connection pool, and adapts naturally to how slow the downstream currently is. Load shedding is server-health-driven:\nwhen queue depth or p99 crosses a threshold, drop the lowest-priority traffic regardless of who sent it. A mature system runs all three: quotas at the\ngateway, concurrency limits at the service boundary (see Netflix's adaptive concurrency / TCP Vegas approach), and priority shedding when the box\nis genuinely in trouble.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1042", "type": "rectangle", "x": 1220, "y": 22852.2, "width": 1120, "height": 157.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g191"], "frameId": null, "roundness": {"type": 3}, "seed": 1192240239, "version": 1, "versionNonce": 1119810743, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1043", "type": "text", "x": 1234, "y": 22866.2, "width": 564.3, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g191"], "frameId": null, "roundness": null, "seed": 1245634327, "version": 1, "versionNonce": 1479033640, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q8  How do you roll out a new limit without breaking customers?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q8  How do you roll out a new limit without breaking customers?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1044", "type": "text", "x": 1234, "y": 22896.0, "width": 1085.8, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g191"], "frameId": null, "roundness": null, "seed": 1895229344, "version": 1, "versionNonce": 1924362394, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Shadow mode first - evaluate the rule, log wouldHaveBlocked, enforce nothing. Look at the distribution: which tenants would be hit, how hard. Then\nnotify the top offenders, ship the rule at a generous multiple of the intended limit, and ratchet down over weeks. Canary by node percentage, not by\ntenant, so an error in the rule affects a slice of everyone rather than all of someone. Keep a per-tenant override so you can exempt one customer at\n3 a.m. without a deploy.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Shadow mode first - evaluate the rule, log wouldHaveBlocked, enforce nothing. Look at the distribution: which tenants would be hit, how hard. Then\nnotify the top offenders, ship the rule at a generous multiple of the intended limit, and ratchet down over weeks. Canary by node percentage, not by\ntenant, so an error in the rule affects a slice of everyone rather than all of someone. Keep a per-tenant override so you can exempt one customer at\n3 a.m. without a deploy.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1045", "type": "rectangle", "x": 60, "y": 23034.0, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g192"], "frameId": null, "roundness": {"type": 3}, "seed": 224645687, "version": 1, "versionNonce": 541233724, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1046", "type": "text", "x": 74, "y": 23048.0, "width": 232.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g192"], "frameId": null, "roundness": null, "seed": 2132353792, "version": 1, "versionNonce": 1150409724, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q9  What do you monitor?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q9  What do you monitor?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1047", "type": "text", "x": 74, "y": 23077.8, "width": 1083.9, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g192"], "frameId": null, "roundness": null, "seed": 1352434115, "version": 1, "versionNonce": 1839533183, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Allow/deny rate per rule (a rule denying ~0% is dead config; ~100% is a misconfiguration), limiter added latency p50/p99, Redis error and timeout\nrate, circuit-breaker state changes, distinct-key cardinality, and the top-N throttled identities. Alert on breaker open and on a sudden change in deny\nrate - both directions. Ship all of it off the hot path via a sampled async sink; never let metrics emission add latency to a request.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Allow/deny rate per rule (a rule denying ~0% is dead config; ~100% is a misconfiguration), limiter added latency p50/p99, Redis error and timeout\nrate, circuit-breaker state changes, distinct-key cardinality, and the top-N throttled identities. Alert on breaker open and on a sudden change in deny\nrate - both directions. Ship all of it off the hot path via a sampled async sink; never let metrics emission add latency to a request.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1048", "type": "rectangle", "x": 1220, "y": 23034.0, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g193"], "frameId": null, "roundness": {"type": 3}, "seed": 846659187, "version": 1, "versionNonce": 1584677836, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1049", "type": "text", "x": 1234, "y": 23048.0, "width": 376.5, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g193"], "frameId": null, "roundness": null, "seed": 1712984588, "version": 1, "versionNonce": 797717635, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Q10  Is this the same as a DDoS defence?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q10  Is this the same as a DDoS defence?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1050", "type": "text", "x": 1234, "y": 23077.8, "width": 1091.3, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g193"], "frameId": null, "roundness": null, "seed": 568555152, "version": 1, "versionNonce": 806895035, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "No, and saying so is a point in your favour. Application rate limiting assumes you've already parsed the request and know who sent it - which means\nyou spent resources on it. A volumetric attack has to be absorbed upstream: L3/L4 scrubbing, SYN cookies, connection limits, and coarse IP filtering\nat the edge, before anything reaches your gateway. The application limiter handles the abusive-but-legitimate client: the one with a valid key and a\nrunaway loop.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "No, and saying so is a point in your favour. Application rate limiting assumes you've already parsed the request and know who sent it - which means\nyou spent resources on it. A volumetric attack has to be absorbed upstream: L3/L4 scrubbing, SYN cookies, connection limits, and coarse IP filtering\nat the edge, before anything reaches your gateway. The application limiter handles the abusive-but-legitimate client: the one with a valid key and a\nrunaway loop.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1100", "type": "rectangle", "x": 0, "y": 23331.8, "width": 2400, "height": 741.5, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#dbe4ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 752333749, "version": 1, "versionNonce": 1277160634, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1052", "type": "rectangle", "x": 60, "y": 23371.8, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g194"], "frameId": null, "roundness": {"type": 3}, "seed": 1239872261, "version": 1, "versionNonce": 313952322, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e1053", "type": "text", "x": 74, "y": 23378.8, "width": 27.9, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g194"], "frameId": null, "roundness": null, "seed": 773633968, "version": 1, "versionNonce": 710449537, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "11", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "11", "autoResize": true, "lineHeight": 1.25}, {"id": "e1054", "type": "text", "x": 144, "y": 23373.8, "width": 324.3, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g194"], "frameId": null, "roundness": null, "seed": 1642050165, "version": 1, "versionNonce": 174774099, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "The 45-minute script", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The 45-minute script", "autoResize": true, "lineHeight": 1.25}, {"id": "e1055", "type": "text", "x": 60, "y": 23433.8, "width": 1452.2, "height": 45.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 949792569, "version": 1, "versionNonce": 494022827, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "A pacing plan. The commonest failure in these rounds isn't ignorance, it's spending 25 minutes on the algorithm and never reaching the distributed part - which is the part being\ngraded.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A pacing plan. The commonest failure in these rounds isn't ignorance, it's spending 25 minutes on the algorithm and never reaching the distributed part - which is the part being\ngraded.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1056", "type": "rectangle", "x": 60, "y": 23506.8, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roun