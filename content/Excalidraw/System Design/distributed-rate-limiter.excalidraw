y": 19274.2, "width": 0, "height": 90.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1036668715, "version": 1, "versionNonce": 675439392, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "points": [[0, 0.0], [0, 90.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e912", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e918", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e940", "type": "text", "x": 1092, "y": 19298.2, "width": 152.8, "height": 20.0, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 114620966, "version": 1, "versionNonce": 1304907074, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "no fallback, failOpen", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "no fallback, failOpen", "autoResize": true, "lineHeight": 1.25}, {"id": "e941", "type": "arrow", "x": 1700, "y": 19274.2, "width": 0, "height": 90.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1988930238, "version": 1, "versionNonce": 1366589281, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "points": [[0, 0.0], [0, 90.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e912", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e921", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e942", "type": "text", "x": 1712, "y": 19298.2, "width": 138.9, "height": 20.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 832998570, "version": 1, "versionNonce": 185315870, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "no fallback, closed", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "no fallback, closed", "autoResize": true, "lineHeight": 1.25}, {"id": "e943", "type": "rectangle", "x": 60, "y": 19624.2, "width": 1120, "height": 999.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g174"], "frameId": null, "roundness": {"type": 3}, "seed": 1941799483, "version": 1, "versionNonce": 1529674677, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e944", "type": "text", "x": 74, "y": 19638.2, "width": 389.1, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g174"], "frameId": null, "roundness": null, "seed": 1332176384, "version": 1, "versionNonce": 1477933820, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "resilience.js   -   decorators: breaker + shadow mode", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "resilience.js   -   decorators: breaker + shadow mode", "autoResize": true, "lineHeight": 1.25}, {"id": "e945", "type": "text", "x": 74, "y": 19664.2, "width": 732.8, "height": 945.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g174"], "frameId": null, "roundness": null, "seed": 1770719987, "version": 1, "versionNonce": 1913702788, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "class CircuitBreakerLimiter extends RateLimitStrategy {\n  constructor({ inner, fallback, timeoutMs = 5, threshold = 10, cooldownMs = 3000,\n                failOpen = true, clock = SystemClock }) {\n    super();\n    Object.assign(this, { inner, fallback, timeoutMs, threshold, cooldownMs,\n                          failOpen, clock });\n    this.failures = 0;\n    this.openUntil = 0;\n  }\n\n  async consume(key, rule, cost = 1) {\n    const now = this.clock.now();\n    if (now < this.openUntil) return this.#degrade(key, rule, cost);\n\n    try {\n      const d = await this.#withTimeout(this.inner.consume(key, rule, cost));\n      this.failures = 0;                       // half-open success closes it\n      return d;\n    } catch (err) {\n      if (++this.failures >= this.threshold) this.openUntil = now + this.cooldownMs;\n      return this.#degrade(key, rule, cost);\n    }\n  }\n\n  #withTimeout(p) {\n    return Promise.race([\n      p,\n      new Promise((_, rej) =>\n        setTimeout(() => rej(new Error('limiter timeout')), this.timeoutMs).unref?.()),\n    ]);\n  }\n\n  async #degrade(key, rule, cost) {\n    // Local bucket keeps *some* protection instead of none. If there is no\n    // fallback, the failOpen flag decides - and for a public API that is\n    // almost always \"open\": a limiter outage must not become an API outage.\n    if (this.fallback) return this.fallback.consume(key, rule, cost);\n    return this.failOpen\n      ? Decision.allow({ ruleId: rule.id, limit: rule.limit,\n                         remaining: rule.limit, resetMs: rule.windowMs })\n      : Decision.deny({ ruleId: rule.id, limit: rule.limit,\n                        resetMs: rule.windowMs, retryAfterMs: 1000 });\n  }\n}\n\n/** Ship every new rule through this first. Enforces nothing, logs everything. */\nclass ShadowLimiter extends RateLimitStrategy {\n  constructor({ inner, sink }) { super(); this.inner = inner; this.sink = sink; }\n  async consume(key, rule, cost = 1) {\n    const d = await this.inner.consume(key, rule, cost);\n    if (!d.allowed) this.sink.wouldHaveBlocked({ key, ruleId: rule.id });\n    return Decision.allow({ ...d, allowed: true });\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class CircuitBreakerLimiter extends RateLimitStrategy {\n  constructor({ inner, fallback, timeoutMs = 5, threshold = 10, cooldownMs = 3000,\n                failOpen = true, clock = SystemClock }) {\n    super();\n    Object.assign(this, { inner, fallback, timeoutMs, threshold, cooldownMs,\n                          failOpen, clock });\n    this.failures = 0;\n    this.openUntil = 0;\n  }\n\n  async consume(key, rule, cost = 1) {\n    const now = this.clock.now();\n    if (now < this.openUntil) return this.#degrade(key, rule, cost);\n\n    try {\n      const d = await this.#withTimeout(this.inner.consume(key, rule, cost));\n      this.failures = 0;                       // half-open success closes it\n      return d;\n    } catch (err) {\n      if (++this.failures >= this.threshold) this.openUntil = now + this.cooldownMs;\n      return this.#degrade(key, rule, cost);\n    }\n  }\n\n  #withTimeout(p) {\n    return Promise.race([\n      p,\n      new Promise((_, rej) =>\n        setTimeout(() => rej(new Error('limiter timeout')), this.timeoutMs).unref?.()),\n    ]);\n  }\n\n  async #degrade(key, rule, cost) {\n    // Local bucket keeps *some* protection instead of none. If there is no\n    // fallback, the failOpen flag decides - and for a public API that is\n    // almost always \"open\": a limiter outage must not become an API outage.\n    if (this.fallback) return this.fallback.consume(key, rule, cost);\n    return this.failOpen\n      ? Decision.allow({ ruleId: rule.id, limit: rule.limit,\n                         remaining: rule.limit, resetMs: rule.windowMs })\n      : Decision.deny({ ruleId: rule.id, limit: rule.limit,\n                        resetMs: rule.windowMs, retryAfterMs: 1000 });\n  }\n}\n\n/** Ship every new rule through this first. Enforces nothing, logs everything. */\nclass ShadowLimiter extends RateLimitStrategy {\n  constructor({ inner, sink }) { super(); this.inner = inner; this.sink = sink; }\n  async consume(key, rule, cost = 1) {\n    const d = await this.inner.consume(key, rule, cost);\n    if (!d.allowed) this.sink.wouldHaveBlocked({ key, ruleId: rule.id });\n    return Decision.allow({ ...d, allowed: true });\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e946", "type": "rectangle", "x": 1220, "y": 19624.2, "width": 1120, "height": 111.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g175"], "frameId": null, "roundness": {"type": 3}, "seed": 344190404, "version": 1, "versionNonce": 1375086234, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e947", "type": "text", "x": 1234, "y": 19638.2, "width": 208.1, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g175"], "frameId": null, "roundness": null, "seed": 1687547566, "version": 1, "versionNonce": 1839507747, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "FAIL OPEN OR FAIL CLOSED?", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "FAIL OPEN OR FAIL CLOSED?", "autoResize": true, "lineHeight": 1.25}, {"id": "e948", "type": "text", "x": 1234, "y": 19661.8, "width": 1088.8, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g175"], "frameId": null, "roundness": null, "seed": 476902614, "version": 1, "versionNonce": 1333701354, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Default open - the limiter exists to protect the service, and taking the API down to enforce a quota inverts the goal. Fail closed only where exceeding\nthe limit is worse than being unavailable: paid metering, SMS/email sending, anything that spends money per call, and login endpoints where the\nlimit is the brute-force defence. Say which endpoints you'd flip and why; a blanket answer either way is the weaker one.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Default open - the limiter exists to protect the service, and taking the API down to enforce a quota inverts the goal. Fail closed only where exceeding\nthe limit is worse than being unavailable: paid metering, SMS/email sending, anything that spends money per call, and login endpoints where the\nlimit is the brute-force defence. Say which endpoints you'd flip and why; a blanket answer either way is the weaker one.", "autoResize": true, "lineHeight": 1.25}, {"id": "e949", "type": "text", "x": 1220, "y": 19763.8, "width": 317.4, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 868623965, "version": 1, "versionNonce": 1320120701, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Where you would flip each way", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where you would flip each way", "autoResize": true, "lineHeight": 1.25}, {"id": "e950", "type": "rectangle", "x": 1220, "y": 19803.8, "width": 1120, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g176"], "frameId": null, "roundness": null, "seed": 1817525746, "version": 1, "versionNonce": 421149334, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e951", "type": "text", "x": 1229, "y": 19811.8, "width": 96.7, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g176"], "frameId": null, "roundness": null, "seed": 1780667040, "version": 1, "versionNonce": 1015663570, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Endpoint class", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Endpoint class", "autoResize": true, "lineHeight": 1.25}, {"id": "e952", "type": "text", "x": 1609, "y": 19811.8, "width": 48.1, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g176"], "frameId": null, "roundness": null, "seed": 392915505, "version": 1, "versionNonce": 1214245834, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Default