rue, "lineHeight": 1.25}, {"id": "e41", "type": "rectangle", "x": 1734.6, "y": 282, "width": 196.2, "height": 36, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g15"], "frameId": null, "roundness": {"type": 3}, "seed": 973206041, "version": 1, "versionNonce": 776492205, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e42", "type": "text", "x": 1744.6, "y": 290.0, "width": 176.2, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g15"], "frameId": null, "roundness": null, "seed": 643744727, "version": 1, "versionNonce": 533492028, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "10 Follow-ups they ask", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "10 Follow-ups they ask", "autoResize": true, "lineHeight": 1.25}, {"id": "e43", "type": "rectangle", "x": 1940.8, "y": 282, "width": 166.3, "height": 36, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g16"], "frameId": null, "roundness": {"type": 3}, "seed": 1705916948, "version": 1, "versionNonce": 386046158, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e44", "type": "text", "x": 1950.8, "y": 290.0, "width": 146.3, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g16"], "frameId": null, "roundness": null, "seed": 1501079115, "version": 1, "versionNonce": 1674671377, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "11 45-minute script", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "11 45-minute script", "autoResize": true, "lineHeight": 1.25}, {"id": "e75", "type": "rectangle", "x": 0, "y": 340, "width": 2400, "height": 563.2, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#dbe4ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1765070035, "version": 1, "versionNonce": 957006265, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e45", "type": "rectangle", "x": 60, "y": 380, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g17"], "frameId": null, "roundness": {"type": 3}, "seed": 524193278, "version": 1, "versionNonce": 175782304, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e46", "type": "text", "x": 74, "y": 387, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g17"], "frameId": null, "roundness": null, "seed": 1233565528, "version": 1, "versionNonce": 644780075, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "01", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "01", "autoResize": true, "lineHeight": 1.25}, {"id": "e47", "type": "text", "x": 144, "y": 382, "width": 300.7, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g17"], "frameId": null, "roundness": null, "seed": 1127850897, "version": 1, "versionNonce": 1063254276, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Frame the problem", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Frame the problem", "autoResize": true, "lineHeight": 1.25}, {"id": "e48", "type": "text", "x": 60, "y": 442, "width": 1043.7, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1879343460, "version": 1, "versionNonce": 737608423, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Don't start coding. Spend 3-4 minutes here - interviewers score this heavily, and the answers dictate which algorithm you pick.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Don't start coding. Spend 3-4 minutes here - interviewers score this heavily, and the answers dictate which algorithm you pick.", "autoResize": true, "lineHeight": 1.25}, {"id": "e49", "type": "rectangle", "x": 60, "y": 492.5, "width": 1120, "height": 199.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g18"], "frameId": null, "roundness": {"type": 3}, "seed": 1566471825, "version": 1, "versionNonce": 963864094, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e50", "type": "text", "x": 74, "y": 506.5, "width": 156.9, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g18"], "frameId": null, "roundness": null, "seed": 618341637, "version": 1, "versionNonce": 1307729535, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Questions to ask", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Questions to ask", "autoResize": true, "lineHeight": 1.25}, {"id": "e51", "type": "text", "x": 74, "y": 537.5, "width": 844.2, "height": 140.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g18"], "frameId": null, "roundness": null, "seed": 2104909469, "version": 1, "versionNonce": 157197672, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "- What are we limiting on? API key, user ID, IP, tenant, endpoint, or a tuple of them? Usually several tiers at once.\n- Where does it run? Inside each service, in the API gateway, or as a standalone service other services call?\n- Hard or soft limit? Must we never exceed N (billing, a fragile downstream), or is a small overshoot acceptable?\n- Are all requests equal? Or is there a cost per request (GraphQL complexity, tokens, payload bytes)?\n- Burst tolerance? 100/min smooth, or 100/min with a burst of 20 allowed instantly?\n- What happens on breach? 429 + Retry-After, queue and delay, or degrade (serve cached)?\n- Latency budget? If the limiter must add <1ms p99, a network hop to Redis on every request is already a problem.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "- What are we limiting on? API key, user ID, IP, tenant, endpoint, or a tuple of them? Usually several tiers at once.\n- Where does it run? Inside each service, in the API gateway, or as a standalone service other services call?\n- Hard or soft limit? Must we never exceed N (billing, a fragile downstream), or is a small overshoot acceptable?\n- Are all requests equal? Or is there a cost per request (GraphQL complexity, tokens, payload bytes)?\n- Burst tolerance? 100/min smooth, or 100/min with a burst of 20 allowed instantly?\n- What happens on breach? 429 + Retry-After, queue and delay, or degrade (serve cached)?\n- Latency budget? If the limiter must add <1ms p99, a network hop to Redis on every request is already a problem.", "autoResize": true, "lineHeight": 1.25}, {"id": "e52", "type": "text", "x": 1220, "y": 490.5, "width": 414.1, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 253544329, "version": 1, "versionNonce": 1099367391, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "The requirements you write on the board", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The requirements you write on the board", "autoResize": true, "lineHeight": 1.25}, {"id": "e53", "type": "rectangle", "x": 1220, "y": 530.5, "width": 1120, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 897911925, "version": 1, "versionNonce": 354253419, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e54", "type": "text", "x": 1229, "y": 538.5, "width": 69.2, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1625947776, "version": 1, "versionNonce": 734559256, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Functional", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Functional", "autoResize": true, "lineHeight": 1.25}, {"id": "e55", "type": "text", "x": 1789, "y": 538.5, "width": 95.9, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 326384299, "version": 1, "versionNonce": 2004182514, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Non-functional", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Non-functional", "autoResize": true, "lineHeight": 1.25}, {"id": "e56", "type": "rectangle", "x": 1220, "y": 564.0, "width": 1120, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1050040258, "version": 1, "versionNonce": 905590325, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e57", "type": "text", "x": 1229, "y": 573.0, "width": 407.0, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 84196940, "version": 1, "versionNonce": 2065920251, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Limit requests per identity per window, by configurable rule", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Limit requests per identity per window, by configurable rule", "autoResize": true, "lineHeight": 1.25}, {"id": "e58", "type": "text", "x": 1789, "y": 573.0, "width": 414.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1434982633, "version": 1, "versionNonce": 166688708, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Low added latency: p99 < 5ms (ideally < 1ms with local tier)", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Low added latency: p99 < 5ms (ideally < 1ms with local tier)", "autoResize": true, "lineHeight": 1.25}, {"id": "e59", "type": "rectangle", "x": 1220, "y": 600.8, "width": 1120, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1641903440, "version": 1, "versionNonce": 1198458558, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e60", "type": "text", "x": 1229, "y": 609.8, "width": 476.9, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1230563834, "version": 1, "versionNonce": 1694566832, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Support multiple simultaneous tiers (per-key AND per-IP AND global)", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Support multiple simultaneous tiers (per-key AND per-IP AND global)", "autoResize": true, "lineHeight": 1.25}, {"id": "e61", "type": "text", "x": 1789, "y": 609.8, "width": 394.8, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 1880074284, "version": 1, "versionNonce": 1757400422, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Highly available - the limiter must not become the outage", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Highly available - the limiter must not become the outage", "autoResize": true, "lineHeight": 1.25}, {"id": "e62", "type": "rectangle", "x": 1220, "y": 637.5, "width": 1120, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g19"], "frameId": null, "roundness": null, "seed": 673767655, "version": 1, "versionNonce": 730407202, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e63", "type": "text", "x": 1229, "y": 646.5, "width": 389.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness":