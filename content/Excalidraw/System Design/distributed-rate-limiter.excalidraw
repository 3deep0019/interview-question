"overflow: deny", "autoResize": true, "lineHeight": 1.25}, {"id": "e665", "type": "arrow", "x": 274, "y": 13003.5, "width": 60, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 499454942, "version": 1, "versionNonce": 1222739143, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "points": [[0, 0.0], [60, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e656", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e658", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e666", "type": "arrow", "x": 804, "y": 12973.5, "width": 70, "height": 0.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1975513398, "version": 1, "versionNonce": 80727632, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "points": [[0, 0.0], [70, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e658", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e661", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e667", "type": "arrow", "x": 804, "y": 13033.5, "width": 70, "height": 0.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1386213093, "version": 1, "versionNonce": 1535497261, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "points": [[0, 0.0], [70, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e658", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e663", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e668", "type": "text", "x": 334, "y": 13072.5, "width": 487.6, "height": 18.8, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 652367431, "version": 1, "versionNonce": 2066813208, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Mirror image of the token bucket: same behaviour, no burst allowance.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Mirror image of the token bucket: same behaviour, no burst allowance.", "autoResize": true, "lineHeight": 1.25}, {"id": "e669", "type": "rectangle", "x": 1244, "y": 12290.5, "width": 1072, "height": 771.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g122"], "frameId": null, "roundness": {"type": 3}, "seed": 274806713, "version": 1, "versionNonce": 1345339959, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e670", "type": "text", "x": 1258, "y": 12304.5, "width": 430.8, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g122"], "frameId": null, "roundness": null, "seed": 540723384, "version": 1, "versionNonce": 1134414978, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "strategies/leaky-bucket.js   -   queue variant, shapes traffic", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/leaky-bucket.js   -   queue variant, shapes traffic", "autoResize": true, "lineHeight": 1.25}, {"id": "e671", "type": "text", "x": 1258, "y": 12330.5, "width": 657.2, "height": 717.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g122"], "frameId": null, "roundness": null, "seed": 1366424734, "version": 1, "versionNonce": 939374902, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "/**\n * Admission + shaping. Returns a promise that resolves when the request is\n * allowed to proceed, or rejects immediately if the queue is full.\n * Only correct per-process - for a distributed version use the meter variant.\n */\nclass LeakyBucketQueue {\n  constructor({ ratePerSec, capacity, clock = SystemClock }) {\n    this.interval = 1000 / ratePerSec;\n    this.capacity = capacity;\n    this.clock    = clock;\n    this.queue    = [];\n    this.draining = false;\n  }\n\n  admit() {\n    if (this.queue.length >= this.capacity) {\n      const waitMs = Math.ceil(this.queue.length * this.interval);\n      return Promise.reject(\n        Decision.deny({ ruleId: 'leaky', limit: this.capacity,\n                        resetMs: waitMs, retryAfterMs: waitMs }));\n    }\n    return new Promise(resolve => {\n      this.queue.push(resolve);\n      this.#drain();\n    });\n  }\n\n  #drain() {\n    if (this.draining) return;\n    this.draining = true;\n    const tick = () => {\n      const next = this.queue.shift();\n      if (!next) { this.draining = false; return; }\n      next(Decision.allow({ ruleId: 'leaky', limit: this.capacity,\n                            remaining: this.capacity - this.queue.length,\n                            resetMs: 0 }));\n      setTimeout(tick, this.interval);\n    };\n    tick();\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "/**\n * Admission + shaping. Returns a promise that resolves when the request is\n * allowed to proceed, or rejects immediately if the queue is full.\n * Only correct per-process - for a distributed version use the meter variant.\n */\nclass LeakyBucketQueue {\n  constructor({ ratePerSec, capacity, clock = SystemClock }) {\n    this.interval = 1000 / ratePerSec;\n    this.capacity = capacity;\n    this.clock    = clock;\n    this.queue    = [];\n    this.draining = false;\n  }\n\n  admit() {\n    if (this.queue.length >= this.capacity) {\n      const waitMs = Math.ceil(this.queue.length * this.interval);\n      return Promise.reject(\n        Decision.deny({ ruleId: 'leaky', limit: this.capacity,\n                        resetMs: waitMs, retryAfterMs: waitMs }));\n    }\n    return new Promise(resolve => {\n      this.queue.push(resolve);\n      this.#drain();\n    });\n  }\n\n  #drain() {\n    if (this.draining) return;\n    this.draining = true;\n    const tick = () => {\n      const next = this.queue.shift();\n      if (!next) { this.draining = false; return; }\n      next(Decision.allow({ ruleId: 'leaky', limit: this.capacity,\n                            remaining: this.capacity - this.queue.length,\n                            resetMs: 0 }));\n      setTimeout(tick, this.interval);\n    };\n    tick();\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e689", "type": "rectangle", "x": 60, "y": 13186.5, "width": 2280, "height": 553.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 70, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2062903347, "version": 1, "versionNonce": 884355564, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e673", "type": "rectangle", "x": 84, "y": 13196.5, "width": 70, "height": 44, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g123"], "frameId": null, "roundness": {"type": 3}, "seed": 240803115, "version": 1, "versionNonce": 213556057, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e674", "type": "text", "x": 94, "y": 13205.5, "width": 33.8, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g123"], "frameId": null, "roundness": null, "seed": 151079576, "version": 1, "versionNonce": 644995175, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "6/6", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "6/6", "autoResize": true, "lineHeight": 1.25}, {"id": "e675", "type": "text", "x": 174, "y": 13200.5, "width": 78.8, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g123"], "frameId": null, "roundness": null, "seed": 1126219185, "version": 1, "versionNonce": 2026237704, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "gcra", "fontSize": 32, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "gcra", "autoResize": true, "lineHeight": 1.25}, {"id": "e676", "type": "text", "x": 84, "y": 13252.5, "width": 1205.0, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1251748844, "version": 1, "versionNonce": 411676405, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Memory/key: O(1) - 1 field   |   Accuracy: GOOD: Exact   |   Burst: Explicit   |   Redis ops: 1 GET+SET   |   Pick it when: Senior flex: bucket behaviour, one timestamp", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Memory/key: O(1) - 1 field   |   Accuracy: GOOD: Exact   |   Burst: Explicit   |   Redis ops: 1 GET+SET   |   Pick it when: Senior flex: bucket behaviour, one timestamp", "autoResize": true, "lineHeight": 1.25}, {"id": "e677", "type": "rectangle", "x": 84, "y": 13294.5, "width": 560, "height": 216.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g124"], "frameId": null, "roundness": {"type": 3}, "seed": 833399648, "version": 1, "versionNonce": 560239581, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e678", "type": "text", "x": 98, "y": 13308.5, "width": 108.1, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g124"], "frameId": null, "roundness": null, "seed": 480140911, "version": 1, "versionNonce": 1697558335, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "How it works", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "How it works", "autoResize": true, "lineHeight": 1.25}, {"id": "e679", "type": "text", "x": 98, "y": 13337.0, "width": 530.1, "height": 160.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g124"], "frameId": null, "roundness": null, "seed": 1290768462, "version": 1, "versionNonce": 2473961, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Generic Cell Rate Algorithm - token-bucket behaviour stored as a single\ntimestamp, the \"theoretical arrival time\" (TAT). One key, one value, no\nhash, no clamping loop. This is what redis-cell implements and it's the\nanswer that makes an interviewer sit up.\n\nEmission interval T = window / limit. Burst tolerance tau = T x burst. A\nrequest is allowed if now >= TAT - tau; on allow, TAT = max(TAT, now) +\nT.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Generic Cell Rate Algorithm - token-bucket behaviour stored as a single\ntimestamp, the \"theoretical arrival time\" (TAT). One key, one value, no\nhash, no clamping loop. This is what redis-cell implements and it's the\nanswer that makes an interviewer sit up.\n\nEmission interval T = window / limit. Burst tolerance tau = T x burst. A\nrequest is allowed if now >= TAT - tau; on allow, TAT = max(TAT, now) +\nT.", "autoResize": true, "lineHeight": 1.25}, {"id": "e680", "type": "rectangle", "x": 84, "y": 13531.0, "width": 560, "height": 111.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g125"], "frameId": null, "roundness": {"type": 3}, "seed": 22466198, "version": 1, "versionNonce": 1154221609, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e681", "type": "text", "x": 98, "y": 13545.0, "width": 365.9, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g125"], "frameId": null, "roundness": null, "seed": 647512051, "version": 1, "versionNonce": 2139696987, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "WHY IT'S BETTER THAN A TOKEN BUCKET IN REDIS", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHY IT'S BETTER THAN A TOKEN BUCKET IN REDIS", "autoResize": true, "lineHeight": 1.25}, {"id": "e682", "type": "text", "x": 98, "y": 13568.5, "width": 526.5, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g125"], "frameId": null, "roundness": null, "seed": 989325594, "version": 1, "versionNonce": 598296779, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "One string instead of a hash, one GET+SET instead of HMGET+HSET,\nno floating-point token balance to drift, and the retry time falls out of the\narithmetic exactly. Same semantics, strictly less state.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "One string instead of a hash, one GET+SET instead of HMGET+HSET,\nno floating-point token balance to drift, and the retry time falls out of the\narithmetic exactly. Same semantics, strictly less state.", "autoResize": true, "lineHeight": 1.25}, {"id": "e683", "type": "rectangle", "x": 684, "y": 13294.5, "width": 840, "height": 281.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g126"], "frameId": null, "roundness": {"type": 3}, "seed": 2059307909, "version": 1, "versionNonce": 679371540, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e684", "type": "text", "x": 698, "y": 13308.5, "width": 127.8, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g126"], "frameId": null, "roundness": null, "seed": 1384215637, "version": 1, "versionNonce": 1802621840, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "strategies/gcra.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/gcra.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e685", "type": "text", "x": 698, "y": 13334.5, "width": 774.8, "height": 227.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g126"], "frameId": null, "roundness": null, "seed": 1897890279, "version": 1, "versionNonce": 520458983, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "class GCRA extends RateLimitStrategy {\n  constructor({ store, clock }) { super(); this.store = store; this.clock = clock; }\n\n  async consume(key, rule, cost = 1) {\n    const T   = rule.windowMs / rule.limit;\n    const tau = T * rule.burst;\n    const [ok, remaining, retryMs] =\n      await this.store.eval('gcra', [key], [T, tau, this.clock.now(), cost]);\n    const base = { ruleId: rule.id, limit: rule.burst, remaining, resetMs: Math.ceil(tau) };\n    return ok === 1 ? Decision.allow(base)\n                    : Decision.deny({ ...base, retryAfterMs: retryMs });\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class GCRA extends RateLimitStrategy {\n  constructor({ store, clock }) { super(); this.store = store; this.clock = clock; }\n\n  async consume(key, rule, cost = 1) {\n    const T   = rule.windowMs / rule.limit;\n    const tau = T * rule.burst;\n    const [ok, remaining, retryMs] =\n      await this.store.eval('gcra', [key], [T, tau, this.clock.now(), cost]);\n    const base = { ruleId: rule.id, limit: rule.burst, remaining, resetMs: Math.ceil(tau) };\n    return ok === 1 ? Decision.allow(base)\n                    : Decision.deny({ ...base, retryAfterMs: retryMs });\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e686", "type": "rectangle", "x": 1564, "y": 13294.5, "width": 752, "height": 421.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g127"], "frameId": null, "roundness": {"type": 3}, "seed": 1020708045, "version": 1, "versionNonce": 1130172783, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e687", "type": "text", "x": 1578, "y": 13308.5, "width": 113.9, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g127"], "frameId": null, "roundness": null, "seed": 504160651, "version": 1, "versionNonce": 1174678355, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "scripts/gcra.lua", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "scripts/gcra.lua", "autoResize": true, "lineHeight": 1.25}, {"id": "e688", "type": "text", "x": 1578, "y": 13334.5, "width": 640.4, "height": 367.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g127"], "frameId": null, "roundness": null, "seed": 530553846, "version": 1, "versionNonce": 62880150, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "local key   = KEYS[1]\nlocal T     = tonumber(ARGV[1])   -- emission interval, ms  (window / limit)\nlocal tau   = tonumber(ARGV[2])   -- burst tolerance, ms    (T * burst)\nlocal now   = tonumber(ARGV[3])\nlocal cost  = tonumber(ARGV[4])\n\nlocal inc = T * cost\nlocal tat = tonumber(redis.call('GET', key)) or now\nif tat < now then tat = now end\n\nlocal allow_at = tat - tau       -- earliest instant this request may arrive\n\nif now < allow_at then\n  return { 0, 0, math.ceil(allow_at - now) }\nend\n\nlocal new_tat = tat + inc\nredis.call('SET', key, new_tat, 'PX', math.ceil(new_tat - now + tau))\n-- remaining burst, expressed in whole requests\nlocal remaining = math.floor((now - (new_tat - tau)) / T)\nreturn { 1, math.max(0, remaining), 0 }", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "local key   = KEYS[1]\nlocal T     = tonumber(ARGV[1])   -- emission interval, ms  (window / limit)\nlocal tau   = tonumber(ARGV[2])   -- burst tolerance, ms    (T * burst)\nlocal now   = tonumber(ARGV[3])\nlocal cost  = tonumber(ARGV[4])\n\nlocal inc = T * cost\nlocal tat = tonumber(redis.call('GET', key)) or now\nif tat < now then tat = now end\n\nlocal allow_at = tat - tau       -- earliest instant this request may arrive\n\nif now < allow_at then\n  return { 0, 0, math.ceil(allow_at - now) }\nend\n\nlocal new_tat = tat + inc\nredis.call('SET', key, new_tat, 'PX', math.ceil(new_tat - now + tau))\n-- remaining burst, expressed in whole requests\nlocal remaining = math.floor((now - (new_tat - tau)) / T)\nreturn { 1, math.max(0, remaining), 0 }", "autoResize": true, "lineHeight": 1.25}, {"id": "e754", "type": "rectangle", "x": 0, "y": 13900.0, "width": 2400, "height": 1324.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1764315916, "version": 1, "versionNonce": 662926510, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e691", "type": "rectangle", "x": 60, "y": 13940.0, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": {"type": 3}, "seed": 660131814, "version": 1, "versionNonce": 118774568, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e692", "type": "text", "x": 74, "y": 13947.0, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 46788050, "version": 1, "versionNonce": 416859278, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "06", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "06", "autoResize": true, "lineHeight": 1.25}, {"id": "e693", "type": "text", "x": 144, "y": 13942.0, "width": 269.3, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 1070113092, "version": 1, "versionNonce": 1900197732, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Going distributed", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Going distributed", "autoResize": true, "lineHeight": 1.25}, {"id": "e694", "type": "text", "x": 60, "y": 14002.0, "width": 1262.8, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1448398825, "version": 1, "versionNonce": 1389783457, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "The algorithms above are the easy part. What makes this a distributed systems question is atomicity, sharding, and what happens when Redis fails over.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The algorithms above are the easy part. What makes this a distributed systems question is atomicity, sharding, and what happens when Redis fails over.", "autoResize": true, "lineHeight": 1.25}, {"id": "e695", "type": "text", "x": 60, "y": 14052.5, "width": 182.6, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 901977222, "version": 1, "versionNonce": 174143894, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "The store adapter", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The store adapter", "autoResize": true, "lineHeight": 1.25}, {"id": "e696", "type": "rectangle", "x": 60, "y": 14092.5, "width": 1120, "height": 649.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g129"], "frameId": null, "roundness": {"type": 3}, "seed": 552453320, "version": 1, "versionNonce": 489283772, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e697", "type": "text", "x": 74, "y": 14106.5, "width": 138.9, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g129"], "frameId": null, "roundness": null, "seed": 1433134049, "version": 1, "versionNonce": 911225420, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "store/redis-store.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "store/redis-store.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e698", "type": "text", "x": 74, "y": 14132.5, "width": 682.4, "height": 595.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g129"], "frameId": null, "roundness": null, "seed": 1986767750, "version": 1, "versionNonce": 795037170, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "import { createHash } from 'node:crypto';\n\nclass RedisStore extends Store {\n  /** @param {import('ioredis').Redis|import('ioredis').Cluster} client */\n  constructor(client, scripts) {\n    super();\n    this.client  = client;\n    this.scripts = scripts;              // { name: luaSource }\n    this.shas    = new Map();\n    for (const [name, src] of Object.entries(scripts)) {\n      this.shas.set(name, createHash('sha1').update(src).digest('hex'));\n    }\n  }\n\n  async eval(name, keys, args) {\n    const sha = this.shas.get(name);\n    try {\n      // EVALSHA sends 40 bytes instead of the whole script on every request.\n      return await this.client.evalsha(sha, keys.length, ...keys, ...args);\n    } catch (err) {\n      // A failover or SCRIPT FLUSH empties the script cache. Reload once,\n      // then retry. Do NOT loop - that turns a blip into a stampede.\n      if (String(err.message).includes('NOSCRIPT')) {\n        await this.client.script('LOAD', this.scripts[name]);\n        return this.client.evalsha(sha, keys.length, ...keys, ...args);\n      }\n      throw err;\n    }\n  }\n\n  async healthy() {\n    try { return (await this.client.ping()) === 'PONG'; } catch { return false; }\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "import { createHash } from 'node:crypto';\n\nclass RedisStore extends Store {\n  /** @param {import('ioredis').Redis|import('ioredis').Cluster} client */\n  constructor(client, scripts) {\n    super();\n    this.client  = client;\n    this.scripts = scripts;              // { name: luaSource }\n    this.shas    = new Map();\n    for (const [name, src] of Object.entries(scripts)) {\n      this.shas.set(name, createHash('sha1').update(src).digest('hex'));\n    }\n  }\n\n  async eval(name, keys, args) {\n    const sha = this.shas.get(name);\n    try {\n      // EVALSHA sends 40 bytes instead of the whole script on every request.\n      return await this.client.evalsha(sha, keys.length, ...keys, ...args);\n    } catch (err) {\n      // A failover or SCRIPT FLUSH empties the script cache. Reload once,\n      // then retry. Do NOT loop - that turns a blip into a stampede.\n      if (String(err.message).includes('NOSCRIPT')) {\n        await this.client.script('LOAD', this.scripts[name]);\n        return this.client.evalsha(sha, keys.length, ...keys, ...args);\n      }\n      throw err;\n    }\n  }\n\n  async healthy() {\n    try { return (await this.client.ping()) === 'PONG'; } catch { return false; }\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e699", "type": "text", "x": 1220, "y": 14052.5, "width": 344.9, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 487019377, "version": 1, "versionNonce": 1058588012, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Why Lua and not MULTI/pipelines", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Why Lua and not MULTI/pipelines", "autoResize": true, "lineHeight": 1.25}, {"id": "e700", "type": "rectangle", "x": 1220, "y": 14092.5, "width": 1120, "height": 148.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g130"], "frameId": null, "roundness": {"type": 3}, "seed": 73223661, "version": 1, "versionNonce": 1494268061, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e701", "type": "text", "x": 1234, "y": 14106.5, "width": 1073.0, "height": 120.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g130"], "frameId": null, "roundness": null, "seed": 725960213, "version": 1, "versionNonce": 1542606748, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "- Lua is atomic and can branch. Token-bucket refill needs to read the current balance and decide - MULTI can't do conditional logic on values it\nhasn't seen.\n- WATCH/optimistic retry works but degrades. Under contention on a hot key it retries repeatedly; Lua takes the lock-free path in one server-side\nround trip.\n- One RTT. A pipeline of 3 commands is still 3 commands' worth of parsing and no atomicity.\n- Keep scripts short. Redis is single-threaded - a slow script blocks every other client. No loops over unbounded input, no KEYS, no network calls.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "- Lua is atomic and can branch. Token-bucket refill needs to read the current balance and decide - MULTI can't do conditional logic on values it\nhasn't seen.\n- WATCH/optimistic retry works but degrades. Under contention on a hot key it retries repeatedly; Lua takes the lock-free path in one server-side\nround trip.\n- One RTT. A pipeline of 3 commands is still 3 commands' worth of parsing and no atomicity.\n- Keep scripts short. Redis is single-threaded - a slow script blocks every other client. No loops over unbounded input, no KEYS, no network calls.", "autoResize": true, "lineHeight": 1.25}, {"id": "e702", "type": "rectangle", "x": 1220, "y": 14264.5, "width": 1120, "height": 131.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g131"], "frameId": null, "roundness": {"type": 3}, "seed": 903138945, "version": 1, "versionNonce": 778076036, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e703", "type": "text", "x": 1234, "y": 14278.5, "width": 334.5, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g131"], "frameId": null, "roundness": null, "seed": 1465800790, "version": 1, "versionNonce": 851172779, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "THE CORRECTNESS ANSWER TO HAVE READY", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE CORRECTNESS ANSWER TO HAVE READY", "autoResize": true, "lineHeight": 1.25}, {"id": "e704", "type": "text", "x": 1234, "y": 14302.0, "width": 1080.1, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g131"], "frameId": null, "roundness": null, "seed": 425372799, "version": 1, "versionNonce": 14502958, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "\"Redis replication is asynchronous, so a primary failover can lose acknowledged writes - your limiter can over-admit.\" Correct, and the right\nresponse is not to reach for Redlock or Raft. It's to say: rate limiting is soft state with an explicit accuracy SLO (\"never more than 2x the limit for\nmore than 5 seconds\"). If you need a hard, auditable cap - metered billing, regulatory quotas - that's a different system: an append-only ledger with\nidempotency keys, reconciled asynchronously, with the rate limiter in front of it as a cheap first line of defence.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Redis replication is asynchronous, so a primary failover can lose acknowledged writes - your limiter can over-admit.\" Correct, and the right\nresponse is not to reach for Redlock or Raft. It's to say: rate limiting is soft state with an explicit accuracy SLO (\"never more than 2x the limit for\nmore than 5 seconds\"). If you need a hard, auditable cap - metered billing, regulatory quotas - that's a different system: an append-only ledger with\nidempotency keys, reconciled asynchronously, with the rate limiter in front of it as a cheap first line of defence.", "autoResize": true, "lineHeight": 1.25}, {"id": "e705", "type": "text", "x": 1220, "y": 14426.0, "width": 517.1, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1711682370, "version": 1, "versionNonce": 627304034, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Hash tag = one slot per identity = one atomic script", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Hash tag = one slot per identity = one atomic script", "autoResize": true, "lineHeight": 1.25}, {"id": "e706", "type": "rectangle", "x": 1220, "y": 14470.0, "width": 1120, "height": 380, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g132"], "frameId": null, "roundness": {"type": 3}, "seed": 1587267919, "version": 1, "versionNonce": 1814945206, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e707", "type": "rectangle", "x": 1250, "y": 14600.0, "width": 250, "height": 120, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g133"], "frameId": null, "roundness": {"type": 3}, "seed": 1084218087, "version": 1, "versionNonce": 144810112, "isDeleted": false, "boundElements": [{"id": "e720", "type": "arrow"}], "updated": 1792011375077, "link": null, "locked": false}, {"id": "e708", "type": "text", "x": 1260, "y": 14625.1, "width": 230, "height": 23.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g133"], "frameId": null, "roundness": null, "seed": 440703565, "version": 1, "versionNonce": 1064498220, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Gateway node", "fontSize": 19, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Gateway node", "autoResize": true, "lineHeight": 1.25}, {"id": "e709", "type": "text", "x": 1260, "y": 14654.9, "width": 230, "height": 40.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g133"], "frameId": null, "roundness": null, "seed": 2082755756, "version": 1, "versionNonce": 430385368, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "one EVALSHA covers all of an\nidentity's rules", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "one EVALSHA covers all of an\nidentity's rules", "autoResize": true, "lineHeight": 1.25}, {"id": "e710", "type": "rectangle", "x": 1620, "y": 14510.0, "width": 360, "height": 173.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g134"], "frameId": null, "roundness": {"type": 3}, "seed": 669404463, "version": 1, "versionNonce": 1644665605, "isDeleted": false, "boundElements": [{"id": "e720", "type": "arrow"}], "updated": 1792011375077, "link": null, "locked": false}, {"id": "e711", "type": "rectangle", "x": 1620, "y": 14510.0, "width": 360, "height": 44, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g134"], "frameId": null, "rou