"elbowed": false}, {"id": "e447", "type": "rectangle", "x": 100, "y": 5904.5, "width": 540, "height": 150, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": {"type": 3}, "seed": 1555112682, "version": 1, "versionNonce": 1328663531, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e448", "type": "text", "x": 110, "y": 5942.8, "width": 520, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": null, "seed": 1381303259, "version": 1, "versionNonce": 310853019, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "NOT ATOMIC ACROSS RULES", "fontSize": 20, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "NOT ATOMIC ACROSS RULES", "autoResize": true, "lineHeight": 1.25}, {"id": "e449", "type": "text", "x": 110, "y": 5973.8, "width": 520, "height": 42.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": null, "seed": 94034160, "version": 1, "versionNonce": 1771367215, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "peek and commit are separate round trips, so phase 2 can still\nlose a race. Accepted: tiny overshoot + rollback.", "fontSize": 17, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "peek and commit are separate round trips, so phase 2 can still\nlose a race. Accepted: tiny overshoot + rollback.", "autoResize": true, "lineHeight": 1.25}, {"id": "e450", "type": "text", "x": 100, "y": 5370.5, "width": 731.0, "height": 21.2, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1793770640, "version": 1, "versionNonce": 1535474426, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "CompositeLimiter.check(ctx, cost) - peek everything first, commit in order, undo on a lost race", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CompositeLimiter.check(ctx, cost) - peek everything first, commit in order, undo on a lost race", "autoResize": true, "lineHeight": 1.25}, {"id": "e451", "type": "rectangle", "x": 60, "y": 6124.5, "width": 1120, "height": 1121.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g80"], "frameId": null, "roundness": {"type": 3}, "seed": 1915431631, "version": 1, "versionNonce": 1101618755, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e452", "type": "text", "x": 74, "y": 6138.5, "width": 280.4, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g80"], "frameId": null, "roundness": null, "seed": 1347185481, "version": 1, "versionNonce": 921795984, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "contracts.js   -   the whole API surface", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "contracts.js   -   the whole API surface", "autoResize": true, "lineHeight": 1.25}, {"id": "e453", "type": "text", "x": 74, "y": 6164.5, "width": 749.6, "height": 1067.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g80"], "frameId": null, "roundness": null, "seed": 1575935438, "version": 1, "versionNonce": 1505500479, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "// ---------- value objects ----------\n\n/**\n * A rule is pure config. It lives in a DB/JSON, not in code.\n * scope    : what we bucket by  -> 'apiKey' | 'ip' | 'user' | 'global'\n * algorithm: which strategy runs -> 'token_bucket' | 'sliding_window' | ...\n */\nclass Rule {\n  constructor({ id, scope, algorithm, limit, windowMs, burst = null, priority = 0 }) {\n    this.id        = id;\n    this.scope     = scope;\n    this.algorithm = algorithm;\n    this.limit     = limit;        // permits per window\n    this.windowMs  = windowMs;\n    this.burst     = burst ?? limit; // token-bucket capacity\n    this.priority  = priority;     // lower = evaluated first\n    Object.freeze(this);\n  }\n  get refillPerSec() { return this.limit / (this.windowMs / 1000); }\n}\n\nclass Decision {\n  constructor({ allowed, ruleId, limit, remaining, resetMs, retryAfterMs = 0 }) {\n    this.allowed      = allowed;\n    this.ruleId       = ruleId;\n    this.limit        = limit;\n    this.remaining    = Math.max(0, remaining);\n    this.resetMs      = resetMs;       // ms until the window rolls\n    this.retryAfterMs = retryAfterMs;  // ms until this request would pass\n    Object.freeze(this);\n  }\n  static allow(o) { return new Decision({ ...o, allowed: true }); }\n  static deny(o)  { return new Decision({ ...o, allowed: false, remaining: 0 }); }\n}\n\n// ---------- STRATEGY: the one interface ----------\n\nclass RateLimitStrategy {\n  /**\n   * @param {string} key  fully-qualified bucket key\n   * @param {Rule}   rule\n   * @param {number} cost how many permits this request consumes\n   * @returns {Promise<Decision>}\n   */\n  async consume(key, rule, cost = 1) {\n    throw new Error('RateLimitStrategy.consume not implemented');\n  }\n  /** Optional: peek without consuming. Needed for the two-phase commit in section 04. */\n  async peek(key, rule, cost = 1) { return this.consume(key, rule, 0); }\n}\n\n// ---------- ADAPTER: storage port ----------\n\nclass Store {\n  /** Run a named atomic script. Redis impl uses EVALSHA; memory impl runs JS. */\n  async eval(scriptName, keys, args) { throw new Error('not implemented'); }\n  async healthy() { return true; }\n}\n\n// ---------- injected clock, so tests are deterministic ----------\nconst SystemClock = { now: () => Date.now() };", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "// ---------- value objects ----------\n\n/**\n * A rule is pure config. It lives in a DB/JSON, not in code.\n * scope    : what we bucket by  -> 'apiKey' | 'ip' | 'user' | 'global'\n * algorithm: which strategy runs -> 'token_bucket' | 'sliding_window' | ...\n */\nclass Rule {\n  constructor({ id, scope, algorithm, limit, windowMs, burst = null, priority = 0 }) {\n    this.id        = id;\n    this.scope     = scope;\n    this.algorithm = algorithm;\n    this.limit     = limit;        // permits per window\n    this.windowMs  = windowMs;\n    this.burst     = burst ?? limit; // token-bucket capacity\n    this.priority  = priority;     // lower = evaluated first\n    Object.freeze(this);\n  }\n  get refillPerSec() { return this.limit / (this.windowMs / 1000); }\n}\n\nclass Decision {\n  constructor({ allowed, ruleId, limit, remaining, resetMs, retryAfterMs = 0 }) {\n    this.allowed      = allowed;\n    this.ruleId       = ruleId;\n    this.limit        = limit;\n    this.remaining    = Math.max(0, remaining);\n    this.resetMs      = resetMs;       // ms until the window rolls\n    this.retryAfterMs = retryAfterMs;  // ms until this request would pass\n    Object.freeze(this);\n  }\n  static allow(o) { return new Decision({ ...o, allowed: true }); }\n  static deny(o)  { return new Decision({ ...o, allowed: false, remaining: 0 }); }\n}\n\n// ---------- STRATEGY: the one interface ----------\n\nclass RateLimitStrategy {\n  /**\n   * @param {string} key  fully-qualified bucket key\n   * @param {Rule}   rule\n   * @param {number} cost how many permits this request consumes\n   * @returns {Promise<Decision>}\n   */\n  async consume(key, rule, cost = 1) {\n    throw new Error('RateLimitStrategy.consume not implemented');\n  }\n  /** Optional: peek without consuming. Needed for the two-phase commit in section 04. */\n  async peek(key, rule, cost = 1) { return this.consume(key, rule, 0); }\n}\n\n// ---------- ADAPTER: storage port ----------\n\nclass Store {\n  /** Run a named atomic script. Redis impl uses EVALSHA; memory impl runs JS. */\n  async eval(scriptName, keys, args) { throw new Error('not implemented'); }\n  async healthy() { return true; }\n}\n\n// ---------- injected clock, so tests are deterministic ----------\nconst SystemClock = { now: () => Date.now() };", "autoResize": true, "lineHeight": 1.25}, {"id": "e454", "type": "text", "x": 60, "y": 7282.0, "width": 515.8, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1744226846, "version": 1, "versionNonce": 1085641114, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Key building - this is where Redis Cluster bites you", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Key building - this is where Redis Cluster bites you", "autoResize": true, "lineHeight": 1.25}, {"id": "e455", "type": "rectangle", "x": 60, "y": 7322.0, "width": 1120, "height": 456.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g81"], "frameId": null, "roundness": {"type": 3}, "seed": 299160814, "version": 1, "versionNonce": 1953968849, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e456", "type": "text", "x": 74, "y": 7336.0, "width": 52.9, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g81"], "frameId": null, "roundness": null, "seed": 1124760195, "version": 1, "versionNonce": 1616769911, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "keys.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "keys.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e457", "type": "text", "x": 74, "y": 7362.0, "width": 682.4, "height": 402.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g81"], "frameId": null, "roundness": null, "seed": 1083128588, "version": 1, "versionNonce": 1220800418, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "class KeyBuilder {\n  constructor(prefix = 'rl') { this.prefix = prefix; }\n\n  /**\n   * Hash tag {...} forces every key for one identity onto the SAME cluster slot.\n   * Without it, a multi-key Lua script gets CROSSSLOT errors, and you lose\n   * the ability to evaluate several rules in one round trip.\n   */\n  build(rule, identity) {\n    return `${this.prefix}:{${rule.scope}:${identity}}:${rule.id}`;\n  }\n\n  /** Identity extraction is policy, not plumbing - keep it pluggable. */\n  static identityFor(scope, ctx) {\n    switch (scope) {\n      case 'apiKey': return ctx.apiKey ?? 'anon';\n      case 'user':   return ctx.userId ?? ctx.ip;\n      case 'ip':     return ctx.ip;              // normalize IPv6 to /64 first\n      case 'global': return `${ctx.method}:${ctx.route}`;\n      default: throw new Error(`unknown scope ${scope}`);\n    }\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class KeyBuilder {\n  constructor(prefix = 'rl') { this.prefix = prefix; }\n\n  /**\n   * Hash tag {...} forces every key for one identity onto the SAME cluster slot.\n   * Without it, a multi-key Lua script gets CROSSSLOT errors, and you lose\n   * the ability to evaluate several rules in one round trip.\n   */\n  build(rule, identity) {\n    return `${this.prefix}:{${rule.scope}:${identity}}:${rule.id}`;\n  }\n\n  /** Identity extraction is policy, not plumbing - keep it pluggable. */\n  static identityFor(scope, ctx) {\n    switch (scope) {\n      case 'apiKey': return ctx.apiKey ?? 'anon';\n      case 'user':   return ctx.userId ?? ctx.ip;\n      case 'ip':     return ctx.ip;              // normalize IPv6 to /64 first\n      case 'global': return `${ctx.method}:${ctx.route}`;\n      default: throw new Error(`unknown scope ${scope}`);\n    }\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e458", "type": "rectangle", "x": 60, "y": 7802.5, "width": 1120, "height": 91.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g82"], "frameId": null, "roundness": {"type": 3}, "seed": 1793014830, "version": 1, "versionNonce": 1745701031, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e459", "type": "text", "x": 74, "y": 7816.5, "width": 161.6, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g82"], "frameId": null, "roundness": null, "seed": 1728032015, "version": 1, "versionNonce": 34531019, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "TRAP WORTH NAMING", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "TRAP WORTH NAMING", "autoResize": true, "lineHeight": 1.25}, {"id": "e460", "type": "text", "x": 74, "y": 7840.0, "width": 1077.3, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g82"], "frameId": null, "roundness": null, "seed": 1774700067, "version": 1, "versionNonce": 1474186837, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Limiting raw IPv6 addresses is useless - a single client may hold a /64 with 18 quintillion addresses. Truncate to the /64 prefix. Same idea for IPv4\nbehind carrier-grade NAT: an IP limit punishes a whole mobile network, which is why identity-based limits beat IP limits wherever you have identity.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Limiting raw IPv6 addresses is useless - a single client may hold a /64 with 18 quintillion addresses. Truncate to the /64 prefix. Same idea for IPv4\nbehind carrier-grade NAT: an IP limit punishes a whole mobile network, which is why identity-based limits beat IP limits wherever you have identity.", "autoResize": true, "lineHeight": 1.25}, {"id": "e461", "type": "rectangle", "x": 1220, "y": 6124.5, "width": 1120, "height": 806.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g83"], "frameId": null, "roundness": {"type": 3}, "seed": 1254262545, "version": 1, "versionNonce": 1713621484, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e462", "type": "text", "x": 1234, "y": 6138.5, "width": 381.2, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g83"], "frameId": null, "roundness": null, "seed": 1917337253, "version": 1, "versionNonce": 1527260611, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "composite.js   -   the subtle part of the whole design", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "composite.js   -   the subtle part of the whole design", "autoResize": true, "lineHeight": 1.25}, {"id": "e463", "type": "text", "x": 1234, "y": 6164.5, "width": 716.0, "height": 752.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g83"], "frameId": null, "roundness": null, "seed": 1466506632, "version": 1, "versionNonce": 2053161236, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "class CompositeLimiter {\n  constructor({ resolver, factory, keys, onDecision = () => {} }) {\n    this.resolver = resolver;   // ctx -> Rule[]\n    this.factory  = factory;    // Rule -> RateLimitStrategy\n    this.keys     = keys;\n    this.emit     = onDecision; // async metrics sink\n  }\n\n  async check(ctx, cost = 1) {\n    const rules = this.resolver.resolve(ctx).sort((a, b) => a.priority - b.priority);\n\n    // PHASE 1 - peek every rule. Cheap, no side effects, catches the common\n    // denial before we mutate anything.\n    const peeks = await Promise.all(rules.map(r => {\n      const k = this.keys.build(r, KeyBuilder.identityFor(r.scope, ctx));\n      return this.factory.from(r).peek(k, r, cost).then(d => ({ r, k, d }));\n    }));\n    const blocked = peeks.find(p => !p.d.allowed);\n    if (blocked) { this.emit(blocked.d); return blocked.d; }\n\n    // PHASE 2 - commit. Sequential and ordered so rollback is well-defined.\n    const committed = [];\n    for (const { r, k } of peeks) {\n      const d = await this.factory.from(r).consume(k, r, cost);\n      if (!d.allowed) {\n        // We raced another request between peek and commit. Give back what we\n        // already took so a rejected request doesn't burn quota on other tiers.\n        await Promise.allSettled(\n          committed.map(c => this.factory.from(c.r).consume(c.k, c.r, -cost))\n        );\n        this.emit(d);\n        return d;\n      }\n      committed.push({ r, k, d });\n    }\n\n    // Report the tightest remaining quota - that's what the client cares about.\n    const tightest = committed.reduce((a, b) =>\n      a.d.remaining <= b.d.remaining ? a : b).d;\n    this.emit(tightest);\n    return tightest;\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class CompositeLimiter {\n  constructor({ resolver, factory, keys, onDecision = () => {} }) {\n    this.resolver = resolver;   // ctx -> Rule[]\n    this.factory  = factory;    // Rule -> RateLimitStrategy\n    this.keys     = keys;\n    this.emit     = onDecision; // async metrics sink\n  }\n\n  async check(ctx, cost = 1) {\n    const rules = this.resolver.resolve(ctx).sort((a, b) => a.priority - b.priority);\n\n    // PHASE 1 - peek every rule. Cheap, no side effects, catches the common\n    // denial before we mutate anything.\n    const peeks = await Promise.all(rules.map(r => {\n      const k = this.keys.build(r, KeyBuilder.identityFor(r.scope, ctx));\n      return this.factory.from(r).peek(k, r, cost).then(d => ({ r, k, d }));\n    }));\n    const blocked = peeks.find(p => !p.d.allowed);\n    if (blocked) { this.emit(blocked.d); return blocked.d; }\n\n    // PHASE 2 - commit. Sequential and ordered so rollback is well-defined.\n    const committed = [];\n    for (const { r, k } of peeks) {\n      const d = await this.factory.from(r).consume(k, r, cost);\n      if (!d.allowed) {\n        // We raced another request between peek and commit. Give back what we\n        // already took so a rejected request doesn't burn quota on other tiers.\n        await Promise.allSettled(\n          committed.map(c => this.factory.from(c.r).consume(c.k, c.r, -cost))\n        );\n        this.emit(d);\n        return d;\n      }\n      committed.push({ r, k, d });\n    }\n\n    // Report the tightest remaining quota - that's what the client cares about.\n    const tightest = committed.reduce((a, b) =>\n      a.d.remaining <= b.d.remaining ? a : b).d;\n    this.emit(tightest);\n    return tightest;\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e464", "type": "rectangle", "x": 1220, "y": 6955.0, "width": 1120, "height": 111.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g84"], "frameId": null, "roundness": {"type": 3}, "seed": 1488906539, "version": 1, "versionNonce": 1380595339, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e465", "type": "text", "x": 1234, "y": 6969.0, "width": 370.4, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g84"], "frameId": null, "roundness": null, "seed": 493793940, "version": 1, "versionNonce": 182733056, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "INTERVIEWER BAIT - ANSWER IT BEFORE THEY ASK", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "INTERVIEWER BAIT - ANSWER IT BEFORE THEY ASK", "autoResize": true, "lineHeight": 1.25}, {"id": "e466", "type": "text", "x": 1234, "y": 6992.5, "width": 1055.3, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g84"], "frameId": null, "roundness": null, "seed": 66916732, "version": 1, "versionNonce": 89898181, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "\"Peek-then-commit isn't atomic across rules.\" Correct. Three honest options: (a) accept a tiny overshoot and roll back, as above - cheapest and\nwhat most production limiters do; (b) co-locate all of one identity's keys via the hash tag and evaluate every rule inside one Lua script, which is\natomic - best answer if the rules share an identity; (c) a real distributed transaction - correct and far too slow. Name (b) as the upgrade path.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"Peek-then-commit isn't atomic across rules.\" Correct. Three honest options: (a) accept a tiny overshoot and roll back, as above - cheapest and\nwhat most production limiters do; (b) co-locate all of one identity's keys via the hash tag and evaluate every rule inside one Lua script, which is\natomic - best answer if the rules share an identity; (c) a real distributed transaction - correct and far too slow. Name (b) as the upgrade path.", "autoResize": true, "lineHeight": 1.25}, {"id": "e467", "type": "text", "x": 1220, "y": 7102.5, "width": 248.1, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 285815457, "version": 1, "versionNonce": 1368204527, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Factory + rule resolution", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Factory + rule resolution", "autoResize": true, "lineHeight": 1.25}, {"id": "e468", "type": "rectangle", "x": 1220, "y": 7142.5, "width": 1120, "height": 911.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g85"], "frameId": null, "roundness": {"type": 3}, "seed": 774613398, "version": 1, "versionNonce": 2060545085, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e469", "type": "text", "x": 1234, "y": 7156.5, "width": 67.3, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g85"], "frameId": null, "roundness": null, "seed": 225306415, "version": 1, "versionNonce": 808781558, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "factory.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "factory.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e470", "type": "text", "x": 1234, "y": 7182.5, "width": 674.0, "height": 857.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g85"], "frameId": null, "roundness": null, "seed": 1794912354, "version": 1, "versionNonce": 969344444, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "class LimiterFactory {\n  constructor(store, clock = SystemClock) {\n    this.store = store;\n    this.clock = clock;\n    this.cache = new Map(); // strategies are stateless -> safe to share\n  }\n  from(rule) {\n    if (this.cache.has(rule.algorithm)) return this.cache.get(rule.algorithm);\n    const deps = { store: this.store, clock: this.clock };\n    const impl = {\n      fixed_window:    () => new FixedWindowCounter(deps),\n      sliding_log:     () => new SlidingWindowLog(deps),\n      sliding_counter: () => new SlidingWindowCounter(deps),\n      token_bucket:    () => new TokenBucket(deps),\n      leaky_bucket:    () => new LeakyBucket(deps),\n      gcra:            () => new GCRA(deps),\n    }[rule.algorithm];\n    if (!impl) throw new Error(`unknown algorithm: ${rule.algorithm}`);\n    const s = impl();\n    this.cache.set(rule.algorithm, s);\n    return s;\n  }\n}\n\n/** OBSERVER: rules are pushed, not polled, so a limit change is live in ~1s. */\nclass RuleResolver {\n  constructor(bus) {\n    this.rules = new Map();               // route pattern -> Rule[]\n    bus.on('rules:updated', snapshot => this.#load(snapshot));\n  }\n  #load(snapshot) {\n    const next = new Map();\n    for (const raw of snapshot) {\n      const rule = new Rule(raw);\n      const list = next.get(raw.match) ?? [];\n      list.push(rule);\n      next.set(raw.match, list);\n    }\n    this.rules = next;                    // atomic swap, never a torn read\n  }\n  resolve(ctx) {\n    // Most specific first: tier override > route rule > default.\n    return [\n      ...(this.rules.get(`${ctx.plan}:${ctx.route}`) ?? []),\n      ...(this.rules.get(ctx.route) ?? []),\n      ...(this.rules.get('*') ?? []),\n    ];\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class LimiterFactory {\n  constructor(store, clock = SystemClock) {\n    this.store = store;\n    this.clock = clock;\n    this.cache = new Map(); // strategies are stateless -> safe to share\n  }\n  from(rule) {\n    if (this.cache.has(rule.algorithm)) return this.cache.get(rule.algorithm);\n    const deps = { store: this.store, clock: this.clock };\n    const impl = {\n      fixed_window:    () => new FixedWindowCounter(deps),\n      sliding_log:     () => new SlidingWindowLog(deps),\n      sliding_counter: () => new SlidingWindowCounter(deps),\n      token_bucket:    () => new TokenBucket(deps),\n      leaky_bucket:    () => new LeakyBucket(deps),\n      gcra:            () => new GCRA(deps),\n    }[rule.algorithm];\n    if (!impl) throw new Error(`unknown algorithm: ${rule.algorithm}`);\n    const s = impl();\n    this.cache.set(rule.algorithm, s);\n    return s;\n  }\n}\n\n/** OBSERVER: rules are pushed, not polled, so a limit change is live in ~1s. */\nclass RuleResolver {\n  constructor(bus) {\n    this.rules = new Map();               // route pattern -> Rule[]\n    bus.on('rules:updated', snapshot => this.#load(snapshot));\n  }\n  #load(snapshot) {\n    const next = new Map();\n    for (const raw of snapshot) {\n      const rule = new Rule(raw);\n      const list = next.get(raw.match) ?? [];\n      list.push(rule);\n      next.set(raw.match, list);\n    }\n    this.rules = next;                    // atomic swap, never a torn read\n  }\n  resolve(ctx) {\n    // Most specific first: tier override > route rule > default.\n    return [\n      ...(this.rules.get(`${ctx.plan}:${ctx.route}`) ?? []),\n      ...(this.rules.get(ctx.route) ?? []),\n      ...(this.rules.get('*') ?? []),\n    ];\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e690", "type": "rectangle", "x": 0, "y": 8214.0, "width": 2400, "height": 5566.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1513232211, "version": 1, "versionNonce": 1395112714, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e472", "type": "rectangle", "x": 60, "y": 8254.0, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g86"], "frameId": null, "roundness": {"type": 3}, "seed": 1348119603, "version": 1, "versionNonce": 40460037, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e473", "type": "text", "x": 74, "y": 8261.0, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g86"], "frameId": null, "roundness": null, "seed": 1344811085, "version": 1, "versionNonce": 1141266945, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "05", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "05", "autoResize": true, "lineHeight": 1.25}, {"id": "e474", "type": "text", "x": 144, "y": 8256.0, "width": 511.0, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g86"], "frameId": null, "roundness": null, "seed": 1461715186, "version": 1, "versionNonce": 525187912, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "The five algorithms (plus GCRA)", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The five algorithms (plus GCRA)", "autoResize": true, "lineHeight": 1.25}, {"id": "e475", "type": "text", "x": 60, "y": 8316.0, "width": 860.5, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1050751544, "version": 1, "versionNonce": 566490942, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Know all five cold. Interviewers almost always ask you to compare at least two and then implement one.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Know all five cold. Interviewers almost always ask you to compare at least two and then implement one.", "autoResize": true, "lineHeight": 1.25}, {"id": "e476", "type": "text", "x": 60, "y": 8366.5, "width": 507.2, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7117467, "version": 1, "versionNonce": 981289482, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Comparison - memory, accuracy, burst, Redis ops", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Comparison - memory, accuracy, burst, Redis ops", "autoResize": true, "lineHeight": 1.25}, {"id": "e477", "type": "rectangle", "x": 60, "y": 8406.5, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g87"], "frameId": null, "roundness": null, "seed": 1713042459, "version": 1, "versionNonce": 150563367, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false}, {"id": "e478", "type": "text", "x": 69, "y": 8414.5, "width": 63.5, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g87"], "frameId": null, "roundness": null, "seed": 1606887638, "version": 1, "versionNonce": 2002538489, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Algorithm", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Algorithm", "autoResize": true, "lineHeight": 1.25}, {"id": "e479", "type": "text", "x": 329, "y": 8414.5, "width": 89.4, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g87"], "frameId": null, "roundness": null, "seed": 1080122105, "version": 1, "versionNonce": 1928134465, "isDeleted": false, "boundElements": null, "updated": 1792011375077, "link": null, "locked": false, "text": "Memory / key", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Memory / key", "autoResize": true, "lineHeight": 1.25}, {"id": "e480", "type": "text", "x": 589, "y": 8414.5, "width": 61.9, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g87"], "frameId": null, "roundness": null, "seed"