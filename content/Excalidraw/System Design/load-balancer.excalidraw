originalText": "heartbeat", "autoResize": true, "lineHeight": 1.25}, {"id": "e254", "type": "rectangle", "x": 60, "y": 3526.0, "width": 1120, "height": 96.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": {"type": 3}, "seed": 40168391, "version": 1, "versionNonce": 1874335756, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e255", "type": "text", "x": 74, "y": 3540.0, "width": 144.0, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": null, "seed": 945161047, "version": 1, "versionNonce": 1667534282, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Anycast + ECMP", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Anycast + ECMP", "autoResize": true, "lineHeight": 1.25}, {"id": "e256", "type": "text", "x": 74, "y": 3568.5, "width": 1078.0, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": null, "seed": 393221199, "version": 1, "versionNonce": 1306861148, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Every LB node advertises the same VIP via BGP, routers spread flows across whichever nodes are up, and losing a node just removes one ECMP\npath. The scale-out answer, and what cloud load balancers use internally.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Every LB node advertises the same VIP via BGP, routers spread flows across whichever nodes are up, and losing a node just removes one ECMP\npath. The scale-out answer, and what cloud load balancers use internally.", "autoResize": true, "lineHeight": 1.25}, {"id": "e257", "type": "rectangle", "x": 1220, "y": 3526.0, "width": 1120, "height": 76.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g56"], "frameId": null, "roundness": {"type": 3}, "seed": 8444937, "version": 1, "versionNonce": 1666530987, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e258", "type": "text", "x": 1234, "y": 3540.0, "width": 189.3, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g56"], "frameId": null, "roundness": null, "seed": 1716205476, "version": 1, "versionNonce": 321698388, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Active / passive VRRP", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Active / passive VRRP", "autoResize": true, "lineHeight": 1.25}, {"id": "e259", "type": "text", "x": 1234, "y": 3568.5, "width": 873.0, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g56"], "frameId": null, "roundness": null, "seed": 370111760, "version": 1, "versionNonce": 303995577, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "A floating IP held by one node; a standby takes over on heartbeat loss. Simpler, and common on-prem with two boxes.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A floating IP held by one node; a standby takes over on heartbeat loss. Simpler, and common on-prem with two boxes.", "autoResize": true, "lineHeight": 1.25}, {"id": "e494", "type": "rectangle", "x": 0, "y": 3782.5, "width": 2400, "height": 4609.2, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#dbe4ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1468227196, "version": 1, "versionNonce": 617013205, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e261", "type": "rectangle", "x": 60, "y": 3822.5, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g57"], "frameId": null, "roundness": {"type": 3}, "seed": 1557340696, "version": 1, "versionNonce": 258420911, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e262", "type": "text", "x": 74, "y": 3829.5, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g57"], "frameId": null, "roundness": null, "seed": 1195022320, "version": 1, "versionNonce": 132618470, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "04", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "04", "autoResize": true, "lineHeight": 1.25}, {"id": "e263", "type": "text", "x": 144, "y": 3824.5, "width": 346.0, "he