2011532160, "link": null, "locked": false, "text": "implements / extends", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "implements / extends", "autoResize": true, "lineHeight": 1.25}, {"id": "e416", "type": "rectangle", "x": 60, "y": 5662.8, "width": 1120, "height": 824.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": {"type": 3}, "seed": 2065420853, "version": 1, "versionNonce": 706363564, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e417", "type": "text", "x": 74, "y": 5676.8, "width": 271.1, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": null, "seed": 2088691973, "version": 1, "versionNonce": 2115080917, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "contracts.js  -  the whole API surface", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "contracts.js  -  the whole API surface", "autoResize": true, "lineHeight": 1.25}, {"id": "e418", "type": "text", "x": 74, "y": 5702.8, "width": 665.6, "height": 770.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g79"], "frameId": null, "roundness": null, "seed": 1174831130, "version": 1, "versionNonce": 694783758, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "// ---------- value objects ----------\n\n/** A backend is mutable state the pool owns; strategies only ever read it. */\nclass Backend {\n  constructor({ id, host, port, weight = 1 }) {\n    this.id     = id;\n    this.host   = host;\n    this.port   = port;\n    this.weight = weight;          // relative capacity, 1 = baseline\n\n    // live counters - updated by the proxy pipeline and health checker\n    this.activeConnections = 0;\n    this.ewmaLatencyMs     = 0;\n    this.consecutiveFails  = 0;\n    this.consecutiveOks    = 0;\n    this.state             = 'healthy';   // healthy | draining | unhealthy\n  }\n  get isRoutable() { return this.state === 'healthy'; }\n}\n\nclass Pool {\n  constructor(backends = []) {\n    this.backends = new Map(backends.map(b => [b.id, b]));\n  }\n  healthy() { return [...this.backends.values()].filter(b => b.isRoutable); }\n  get(id)   { return this.backends.get(id); }\n  upsert(backend) { this.backends.set(backend.id, backend); }\n  remove(id)       { this.backends.delete(id); }\n}\n\n// ---------- STRATEGY: the one interface ----------\n\nclass LbStrategy {\n  /**\n   * @param {Backend[]} candidates  already filtered to healthy backends\n   * @param {object}    ctx         { clientKey, path, headers, ... }\n   * @returns {Backend|null}\n   */\n  pick(candidates, ctx) { throw new Error('LbStrategy.pick not implemented'); }\n}\n\n// ---------- injected clock + rng, so tests are deterministic ----------\nconst SystemClock = { now: () => Date.now() };\nconst SystemRng    = { next: () => Math.random() };", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "// ---------- value objects ----------\n\n/** A backend is mutable state the pool owns; strategies only ever read it. */\nclass Backend {\n  constructor({ id, host, port, weight = 1 }) {\n    this.id     = id;\n    this.host   = host;\n    this.port   = port;\n    this.weight = weight;          // relative capacity, 1 = baseline\n\n    // live counters - updated by the proxy pipeline and health checker\n    this.activeConnections = 0;\n    this.ewmaLatencyMs     = 0;\n    this.consecutiveFails  = 0;\n    this.consecutiveOks    = 0;\n    this.state             = 'healthy';   // healthy | draining | unhealthy\n  }\n  get isRoutable() { return this.state === 'healthy'; }\n}\n\nclass Pool {\n  constructor(backends = []) {\n    this.backends = new Map(backends.map(b => [b.id, b]));\n  }\n  healthy() { return [...this.backends.values()].filter(b => b.isRoutable); }\n  get(id)   { return this.backends.get(id); }\n  upsert(backend) { this.backends.set(backend.id, backend); }\n  remove(id)       { this.backends.delete(id); }\n}\n\n// ---------- STRATEGY: the one interface ----------\n\nclass LbStrategy {\n  /**\n   * @param {Backend[]} candidates  already filtered to healthy backends\n   * @param {object}    ctx         { clientKey, path, headers, ... }\n   * @returns {Backend|null}\n   */\n  pick(candidates, ctx) { throw new Error('LbStrategy.pick not implemented'); }\n}\n\n// ---------- injected clock + rng, so tests are deterministic ----------\nconst SystemClock = { now: () => Date.now() };\nconst SystemRng    = { next: () => Math.random() };", "autoResize": true, "lineHeight": 1.25}, {"id": "e419", "type": "text", "x": 1220, "y": 5660.8, "width": 464.9, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 524944859, "version": 1, "versionNonce": 73973769, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Routing rules - this is where L7 earns its keep", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Routing rules - this is where L7 earns its keep", "autoResize": true, "lineHeight": 1.25}, {"id": "e420", "type": "rectangle", "x": 1220, "y": 5700.8, "width": 1120, "height": 509.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g80"], "frameId": null, "roundness": {"type": 3}, "seed": 2073753588, "version": 1, "versionNonce": 1894915036, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e421", "type": "text", "x": 1234, "y": 5714.8, "width": 61.2, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g80"], "frameId": null, "roundness": null, "seed": 664749104, "version": 1, "versionNonce": 467863373, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "router.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "router.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e422", "type": "text", "x": 1234, "y": 5740.8, "width": 749.6, "height": 455.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g80"], "frameId": null, "roundness": null, "seed": 765758129, "version": 1, "versionNonce": 392899081, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "/**\n * Composite: several route rules, each pointing at its own Pool + strategy.\n * Most specific match wins - same idea as the rate limiter's rule resolver.\n */\nclass Router {\n  constructor(rules) { this.rules = rules; }   // [{ match, pool, strategy }]\n\n  resolve(ctx) {\n    for (const rule of this.rules) {\n      if (rule.match.host && rule.match.host !== ctx.host) continue;\n      if (rule.match.pathPrefix && !ctx.path.startsWith(rule.match.pathPrefix)) continue;\n      return rule;\n    }\n    throw new NoRouteError(ctx.path);\n  }\n}\n\n/** Client key for hashing/affinity - pluggable, same shape as identity extraction. */\nfunction clientKeyFor(ctx, mode) {\n  switch (mode) {\n    case 'ip':     return normalizeIp(ctx.ip);\n    case 'cookie':  return ctx.cookies?.lb_affinity ?? ctx.ip;\n    case 'header':  return ctx.headers['x-shard-key'] ?? ctx.ip;\n    default: throw new Error(`unknown affinity mode: ${mode}`);\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "/**\n * Composite: several route rules, each pointing at its own Pool + strategy.\n * Most specific match wins - same idea as the rate limiter's rule resolver.\n */\nclass Router {\n  constructor(rules) { this.rules = rules; }   // [{ match, pool, strategy }]\n\n  resolve(ctx) {\n    for (const rule of this.rules) {\n      if (rule.match.host && rule.match.host !== ctx.host) continue;\n      if (rule.match.pathPrefix && !ctx.path.startsWith(rule.match.pathPrefix)) continue;\n      return rule;\n    }\n    throw new NoRouteError(ctx.path);\n  }\n}\n\n/** Client key for hashing/affinity - pluggable, same shape as identity extraction. */\nfunction clientKeyFor(ctx, mode) {\n  switch (mode) {\n    case 'ip':     return normalizeIp(ctx.ip);\n    case 'cookie':  return ctx.cookies?.lb_affinity ?? ctx.ip;\n    case 'header':  return ctx.headers['x-shard-key'] ?? ctx.ip;\n    default: throw new Error(`unknown affinity mode: ${mode}`);\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e423", "type": "text", "x": 60, "y": 6536.8, "width": 447.1, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2295477, "version": 1, "versionNonce": 720121671, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Chain of Responsibility: the request pipeline", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Chain of Responsibility: the request pipeline", "autoResize": true, "lineHeight": 1.25}, {"id": "e424", "type": "rectangle", "x": 60, "y": 6582.8, "width": 2280, "height": 800, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g81"], "frameId": null, "roundness": {"type": 3}, "seed": 819536903, "version": 1, "versionNonce": 180153606, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e425", "type": "text", "x": 80, "y": 6596.8, "width": 389.5, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1019289434, "version": 1, "versionNonce": 598995198, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "ProxyPipeline.handle(ctx)  -  one request, left to right", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ProxyPipeline.handle(ctx)  -  one request, left to right", "autoResize": true, "lineHeight": 1.25}, {"id": "e426", "type": "rectangle", "x": 90, "y": 6652.8, "width": 260, "height": 110, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g82"], "frameId": null, "roundness": {"type": 3}, "seed": 1079677478, "version": 1, "versionNonce": 1408787664, "isDeleted": false, "boundElements": [{"id": "e444", "type": "arrow"}], "updated": 1792011532160, "link": null, "locked": false}, {"id": "e427", "type": "text", "x": 100, "y": 6671.6, "width": 240, "height": 23.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g82"], "frameId": null, "roundness": null, "seed": 431601383, "version": 1, "versionNonce": 532961197, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Request in", "fontSize": 19, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Request in", "autoResize": true, "lineHeight": 1.25}, {"id": "e428", "type": "text", "x": 100, "y": 6701.4, "width": 240, "height": 42.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g82"], "frameId": null, "roundness": null, "seed": 1083911527, "version": 1, "versionNonce": 1666958584, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "ctx: host, path, ip, cookies,\nheaders, clientKey", "fontSize": 17, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "ctx: host, path, ip, cookies,\nheaders, clientKey", "autoResize": true, "lineHeight": 1.25}, {"id": "e429", "type": "rectangle", "x": 412, "y": 6652.8, "width": 340, "height": 110, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g83"], "frameId": null, "roundness": {"type": 3}, "seed": 10631190, "version": 1, "versionNonce": 195102539, "isDeleted": false, "boundElements": [{"id": "e444", "type": "arrow"}, {"id": "e445", "type": "arrow"}], "updated": 1