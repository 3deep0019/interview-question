 "link": null, "locked": false, "text": "One backend down", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "One backend down", "autoResize": true, "lineHeight": 1.25}, {"id": "e912", "type": "text", "x": 509, "y": 17528.0, "width": 217.1, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 1936236941, "version": 1, "versionNonce": 336224796, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Its requests error until detected", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Its requests error until detected", "autoResize": true, "lineHeight": 1.25}, {"id": "e913", "type": "text", "x": 1269, "y": 17528.0, "width": 465.1, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 910006514, "version": 1, "versionNonce": 243823769, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Health checks (section 06) eject it; algorithm routes around the rest", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Health checks (section 06) eject it; algorithm routes around the rest", "autoResize": true, "lineHeight": 1.25}, {"id": "e914", "type": "rectangle", "x": 60, "y": 17555.8, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["