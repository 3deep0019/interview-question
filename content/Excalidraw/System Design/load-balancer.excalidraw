nter", "verticalAlign": "top", "containerId": null, "originalText": "K2", "autoResize": true, "lineHeight": 1.25}, {"id": "e839", "type": "arrow", "x": 2162.2, "y": 15613.6, "width": 17.7, "height": 63.9, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 531350006, "version": 1, "versionNonce": 398865925, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0.0, 0.0], [6.4, 15.4], [11.5, 31.2], [15.3, 47.5], [17.7, 63.9]], "lastCommittedPoint": null, "startBinding": {"elementId": "e837", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e808", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e840", "type": "rectangle", "x": 820, "y": 15438.5, "width": 760, "height": 176.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g158"], "frameId": null, "roundness": {"type": 3}, "seed": 526864279, "version": 1, "versionNonce": 505741023, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e841", "type": "text", "x": 834, "y": 15452.5, "width": 139.4, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g158"], "frameId": null, "roundness": null, "seed": 329256913, "version": 1, "versionNonce": 604203320, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Reading the ring", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Reading the ring", "autoResize": true, "lineHeight": 1.25}, {"id": "e842", "type": "text", "x": 834, "y": 15481.0, "width": 677.9, "height": 120.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g158"], "frameId": null, "roundness": null, "seed": 1898735925, "version": 1, "versionNonce": 1948987929, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "- Each backend sits at many points (vnodes): 4 each here, ~150 in the code.\n- To route a key: hash it onto the ring, walk CLOCKWISE to the first backend point.\n- K1 (17 deg): B before, D after - this key moved.\n- K2 (60 deg): C before and after - unchanged.\n- Red arcs = the only keys that moved: the arc immediately behind each of D's vnodes.\n- Total moved here: ~95 of 360 degrees = ~1/n for n = 4. Every other key keeps its backend.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "- Each backend sits at many points (vnodes): 4 each here, ~150 in the code.\n- To route a key: hash it onto the ring, walk CLOCKWISE to the first backend point.\n- K1 (17 deg): B before, D after - this key moved.\n- K2 (60 deg): C before and after - unchanged.\n- Red arcs = the only keys that moved: the arc immediately behind each of D's vnodes.\n- Total moved here: ~95 of 360 degrees = ~1/n for n = 4. Every other key keeps its backend.", "autoResize": true, "lineHeight": 1.25}, {"id": "e843", "type": "ellipse", "x": 820, "y": 15858.5, "width": 36, "height": 36, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#74c0fc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1241848476, "version": 1, "versionNonce": 404264090, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e844", "type": "text", "x": 868, "y": 15866.5, "width": 79.7, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 700805345, "version": 1, "versionNonce": 139165732, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "backend A", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "backend A", "autoResize": true, "lineHeight": 1.25}, {"id": "e845", "type": "ellipse", "x": 1010, "y": 15858.5, "width": 36, "height": 36, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#8ce99a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 850552987, "version": 1, "versionNonce": 540422298, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e846", "type": "text", "x": 1058, "y": 15866.5, "width": 80.6, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2131267423, "version": 1, "versionNonce": 528171948, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "backend B", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "backend B", "autoResize": true, "lineHeight": 1.25}, {"id": "e847", "type": "ellipse", "x": 1200, "y": 15858.5, "width": 36, "height": 36, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffc078", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1089471102, "version": 1, "versionNonce": 1130239437, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e848", "type": "text", "x": 1248, "y": 15866.5, "width": 81.6, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 496886794, "version": 1, "versionNonce": 1395092684, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "backend C", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "backend C", "autoResize": true, "lineHeight": 1.25}, {"id": "e849", "type": "ellipse", "x": 1390, "y": 15858.5, "width": 36, "height": 36, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "#ff8787", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1736117890, "version": 1, "versionNonce": 215913249, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e850", "type": "text", "x": 1438, "y": 15866.5, "width": 81.6, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1403008090, "version": 1, "versionNonce": 996251367, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "backend D", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "backend D", "autoResize": true, "lineHeight": 1.25}, {"id": "e851", "type": "text", "x": 820, "y": 15914.5, "width": 620.4, "height": 20.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2128061066, "version": 1, "versionNonce": 79506594, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Compare with modulo hashing: adding one backend to 200 remaps ~99.5% of keys.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Compare with modulo hashing: adding one backend to 200 remaps ~99.5% of keys.", "autoResize": true, "lineHeight": 1.25}, {"id": "e852", "type": "rectangle", "x": 60, "y": 16082.5, "width": 1120, "height": 894.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g159"], "frameId": null, "roundness": {"type": 3}, "seed": 219757212, "version": 1, "versionNonce": 9646716, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e853", "type": "text", "x": 74, "y": 16096.5, "width": 135.2, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g159"], "frameId": null, "roundness": null, "seed": 1019545261, "version": 1, "versionNonce": 1895852301, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "consistent-hash.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "consistent-hash.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e854", "type": "text", "x": 74, "y": 16122.5, "width": 732.8, "height": 840.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g159"], "frameId": null, "roundness": null, "seed": 1759009670, "version": 1, "versionNonce": 496312590, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "import { createHash } from 'node:crypto';\n\nfunction hash32(str) {\n  return createHash('sha1').update(str).digest().readUInt32BE(0);\n}\n\nclass ConsistentHashRing extends LbStrategy {\n  constructor({ vnodesPerBackend = 150 } = {}) {\n    super();\n    this.vnodes = vnodesPerBackend;\n    this.ring   = [];                 // sorted [{ hash, backendId }]\n    this.byId   = new Map();\n  }\n\n  /** Call on every pool membership change - O(vnodes log vnodes), off the hot path. */\n  rebuild(backends) {\n    this.byId = new Map(backends.map(b => [b.id, b]));\n    const points = [];\n    for (const b of backends) {\n      const copies = this.vnodes * b.weight;         // more weight = more points\n      for (let i = 0; i < copies; i++) {\n        points.push({ hash: hash32(`${b.id}#${i}`), backendId: b.id });\n      }\n    }\n    points.sort((a, b) => a.hash - b.hash);\n    this.ring = points;\n  }\n\n  pick(candidates, ctx) {\n    if (this.ring.length === 0) return null;\n    const target = hash32(ctx.clientKey);\n\n    // binary search for the first point with hash >= target, wrapping around\n    let lo = 0, hi = this.ring.length;\n    while (lo < hi) {\n      const mid = (lo + hi) >>> 1;\n      if (this.ring[mid].hash < target) lo = mid + 1; else hi = mid;\n    }\n    for (let i = 0; i < this.ring.length; i++) {\n      const point = this.ring[(lo + i) % this.ring.length];\n      const backend = this.byId.get(point.backendId);\n      // walk forward past any backend that's currently unhealthy -\n      // graceful degradation instead of a hard failure on one dead vnode\n      if (backend && candidates.includes(backend)) return backend;\n    }\n    return null;\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "import { createHash } from 'node:crypto';\n\nfunction hash32(str) {\n  return createHash('sha1').update(str).digest().readUInt32BE(0);\n}\n\nclass ConsistentHashRing extends LbStrategy {\n  constructor({ vnodesPerBackend = 150 } = {}) {\n    super();\n    this.vnodes = vnodesPerBackend;\n    this.ring   = [];                 // sorted [{ hash, backendId }]\n    this.byId   = new Map();\n  }\n\n  /** Call on every pool membership change - O(vnodes log vnodes), off the hot path. */\n  rebuild(backends) {\n    this.byId = new Map(backends.map(b => [b.id, b]));\n    const points = [];\n    for (const b of backends) {\n      const copies = this.vnodes * b.weight;         // more weight = more points\n      for (let i = 0; i < copies; i++) {\n        points.push({ hash: hash32(`${b.id}#${i}`), backendId: b.id });\n      }\n    }\n    points.sort((a, b) => a.hash - b.hash);\n    this.ring = points;\n  }\n\n  pick(candidates, ctx) {\n    if (this.ring.length === 0) return null;\n    const target = hash32(ctx.clientKey);\n\n    // binary search for the first point with hash >= target, wrapping around\n    let lo = 0, hi = this.ring.length;\n    while (lo < hi) {\n      const mid = (lo + hi) >>> 1;\n      if (this.ring[mid].hash < target) lo = mid + 1; else hi = mid;\n    }\n    for (let i = 0; i < this.ring.length; i++) {\n      const point = this.ring[(lo + i) % this.ring.length];\n      const backend = this.byId.get(point.backendId);\n      // walk forward past any backend that's currently unhealthy -\n      // graceful degradation instead of a hard failure on one dead vnode\n      if (backend && candidates.includes(backend)) return backend;\