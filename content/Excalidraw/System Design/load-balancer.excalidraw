mittedPoint": null, "startBinding": {"elementId": "e709", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e712", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e721", "type": "text", "x": 700, "y": 13359.5, "width": 980, "height": 45.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1428708536, "version": 1, "versionNonce": 121154750, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "consecutiveFails >= failThreshold (3)\n3 probes x 2 s = ~6 s worst-case detection", "fontSize": 18, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "consecutiveFails >= failThreshold (3)\n3 probes x 2 s = ~6 s worst-case detection", "autoResize": true, "lineHeight": 1.25}, {"id": "e722", "type": "arrow", "x": 1960, "y": 13529.5, "width": 540, "height": 180.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 2037449383, "version": 1, "versionNonce": 1277327932, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 180.0], [-540, 180.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e712", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e715", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e723", "type": "text", "x": 1460, "y": 13639.5, "width": 283.2, "height": 60.0, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 314355213, "version": 1, "versionNonce": 1979815734, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "consecutiveOks >= healThreshold (2):\nstate = draining,\nslowStartUntil = now + 30 s", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "consecutiveOks >= healThreshold (2):\nstate = draining,\nslowStartUntil = now + 30 s", "autoResize": true, "lineHeight": 1.25}, {"id": "e724", "type": "arrow", "x": 1420, "y": 13799.5, "width": 700, "height": 270.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 844948879, "version": 1, "versionNonce": 116733736, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [700, 0.0], [700, -270.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e715", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e712", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e725", "type": "text", "x": 1450, "y": 13809.5, "width": 274.8, "height": 40.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 457304671, "version": 1, "versionNonce": 50742275, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "consecutiveFails >= 3 while ramping:\nrelapse -> unhealthy", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "consecutiveFails >= 3 while ramping:\nrelapse -> unhealthy", "autoResize": true, "lineHeight": 1.25}, {"id": "e726", "type": "arrow", "x": 980, "y": 13709.5, "width": 500, "height": 180.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 2091906129, "version": 1, "versionNonce": 1280173295, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [-500, 0.0], [-500, -180.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e715", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e709", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e727", "type": "text", "x": 530, "y": 13635.5, "width": 273.5, "height": 40.0, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 304751717, "version": 1, "versionNonce": 892032354, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "now > slowStartUntil on an ok probe:\nramp complete, full share", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "now > slowStartUntil on an ok probe:\nramp complete, full share", "autoResize": true, "lineHeight": 1.25}, {"id": "e728", "type": "arrow", "x": 280, "y": 13529.5, "width": 700, "height": 270.0, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 111326705, "version": 1, "versionNonce": 1524409722, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 270.0], [700, 270.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e709", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e715", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e729", "type": "text", "x": 310, "y": 13809.5, "width": 292.4, "height": 40.0, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 129139485, "version": 1, "versionNonce": 395362106, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "planned removal (deploy / scale-down):\nstop NEW requests, let in-flight finish", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "planned removal (deploy / scale-down):\nstop NEW requests, let in-flight finish", "autoResize": true, "lineHeight": 1.25}, {"id": "e730", "type": "arrow", "x": 1200, "y": 13849.5, "width": 0, "height": 80.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 844651915, "version": 1, "versionNonce": 965598753, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 80.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e715", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e718", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e731", "type": "text", "x": 1212, "y": 13875.5, "width": 208.7, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1928799817, "version": 1, "versionNonce": 1529082965, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "drain timeout, or in-flight = 0", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "drain timeout, or in-flight = 0", "autoResize": true, "lineHeight": 1.25}, {"id": "e732", "type": "rectangle", "x": 90, "y": 13879.5, "width": 780, "height": 91.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g148"], "frameId": null, "roundness": {"type": 3}, "seed": 1897481419, "version": 1, "versionNonce": 674739287, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e733", "type": "text", "x": 104, "y": 13893.5, "width": 63.0, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g148"], "frameId": null, "roundness": null, "seed": 1573512310, "version": 1, "versionNonce": 243107076, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Defaults", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Defaults", "autoResize": true, "lineHeight": 1.25}, {"id": "e734", "type": "text", "x": 104, "y": 13919.5, "width": 712.2, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g148"], "frameId": null, "roundness": null, "seed": 2142178960, "version": 1, "versionNonce": 170426852, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "intervalMs 2000  -  failThreshold 3  -  healThreshold 2  -  slow-start window 30 000 ms  -  probe timeout\ncounts as failure", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "intervalMs 2000  -  failThreshold 3  -  healThreshold 2  -  slow-start window 30 000 ms  -  probe timeout\ncounts as failure", "autoResize": true, "lineHeight": 1.25}, {"id": "e735", "type": "rectangle", "x": 1480, "y": 13899.5, "width": 830, "height": 110.2, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g149"], "frameId": null, "roundness": {"type": 3}, "seed": 2000586098, "version": 1, "versionNonce": 355695754, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e736", "type": "text", "x": 1494, "y": 13913.5, "width": 114.8, "height": 20.0, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g149"], "frameId": null, "roundness": null, "seed": 707043441, "version": 1, "versionNonce": 409489757, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Why hysteresis", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Why hysteresis", "autoResize": true, "lineHeight": 1.25}, {"id": "e737", "type": "text", "x": 1494, "y": 13939.5, "width": 782.5, "height": 56.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g149"], "frameId": null, "roundness": null, "seed": 398384389, "version": 1, "versionNonce": 1401164884, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Flip healthy <-> unhealthy on a single failed probe and you get FLAPPING: one dropped packet ejects a fine\nbackend, the pool oscillates, and every ejection is itself a mini load spike for the survivors. Require N consecutive\nsignals in a direction before the state changes.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Flip healthy <-> unhealthy on a single failed probe and you get FLAPPING: one dropped packet ejects a fine\nbackend, the pool oscillates, and every ejection is itself a mini load spike for the survivors. Require N consecutive\nsignals in a direction before the state changes.", "autoResize": true, "lineHeight": 1.25}, {"id": "e738", "type": "rectangle", "x": 60, "y": 14083.5, "width": 1120, "height": 754.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g150"], "frameId": null, "roundness": {"type": 3}, "seed": 2009790325, "version": 1, "versionNonce": 1126994210, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e739", "type": "text", "x": 74, "y": 14097.5, "width": 126.9, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g150"], "frameId": null, "roundness": null, "seed": 1602685169, "version": 1, "versionNonce": 1004197350, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "health-checker.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "health-checker.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e740", "type": "text", "x": 74, "y": 14123.5, "width": 783.2, "height": 700.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g150"], "frameId": null, "roundness": null, "seed": 68491175, "version": 1, "versionNonce": 669643693, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "/** OBSERVER: emits pool-membership changes; never consulted synchronously\n * on the request path - the pipeline only ever reads Backend.state. */\nclass HealthChecker {\n  constructor({ pool, probe, clock = SystemClock,\n                intervalMs = 2000, failThreshold = 3, healThreshold = 2 }) {\n    Object.assign(this, { pool, probe, clock, intervalMs, failThreshold, healThreshold });\n  }\n\n  start() {\n    this.timer = setInterval(() => this.#tick(), this.intervalMs);\n    this.timer.unref?.();\n  }\n  stop() { clearInterval(this.timer); }\n\n  async #tick() {\n    await Promise.all(this.pool.backends.values().map(b => this.#check(b)));\n  }\n\n  async #check(backend) {\n    const ok = await this.probe(backend).catch(() => false);\n\n    if (ok) {\n      backend.consecutiveOks++;\n      backend.consecutiveFails = 0;\n      if (backend.state === 'unhealthy' && backend.consecutiveOks >= this.healThreshold) {\n        // Don't snap straight back to full traffic - see slow start below.\n        backend.state = 'draining';\n        backend.slowStartUntil = this.clock.now() + 30_000;\n      } else if (backend.state === 'draining' && this.clock.now() > backend.slowStartUntil) {\n        backend.state = 'healthy';\n      }\n    } else {\n      backend.consecutiveFails++;\n      backend.consecutiveOks = 0;\n      if (backend.state !== 'unhealthy' && backend.consecutiveFails >= this.failThreshold) {\n        backend.state = 'unhealthy';\n      }\n    }\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "/** OBSERVER: emits pool-membership changes; never consulted synchronously\n * on the request path - the pipeline only ever reads Backend.state. */\nclass HealthChecker {\n  constructor({ pool, probe, clock = SystemClock,\n                intervalMs = 2000, failThreshold = 3, healThreshold = 2 }) {\n    Object.assign(this, { pool, probe, clock, intervalMs, failThreshold, healThreshold });\n  }\n\n  start() {\n    this.timer = setInterval(() => this.#tick(), this.intervalMs);\n    this.timer.unref?.();\n  }\n  stop() { clearInterval(this.timer); }\n\n  async #tick() {\n    await Promise.all(this.pool.backends.values().map(b => this.#check(b)));\n  }\n\n  async #check(backend) {\n    const ok = await this.probe(backend).catch(() => false);\n\n    if (ok) {\n      backend.consecutiveOks++;\n      backend.consecutiveFails = 0;\n      if (backend.state === 'unhealthy' && backend.consecutiveOks >= this.healThreshold) {\n        // Don't snap straight back to full traffic - see slow start below.\n        backend.state = 'draining';\n        backend.slowStartUntil = this.clock.now() + 30_000;\n      } else if (backend.state === 'draining' && this.clock.now() > backend.slowStartUntil) {\n        backend.state = 'healthy';\n      }\n    } else {\n      backend.consecutiveFails++;\n      backend.consecutiveOks = 0;\n      if (backend.state !== 'unhealthy' && backend.consecutiveFails >= this.failThreshold) {\n        backend.state = 'unhealthy';\n      }\n    }\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e741", "type": "rectangle", "x": 1220, "y": 14083.5, "width": 1120, "height": 116.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g151"], "frameId": null, "roundness": {"type": 3}, "seed": 1426852259, "version": 1, "versionNonce": 1557735922, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e742", "type": "text", "x": 1234, "y": 14097.5, "width": 498.4, "height": 22.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g151"], "frameId": null, "roundness": null, "seed": 813078993, "version": 1, "versionNonce": 1802011518, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Slow start: a newly healthy backend is not ready for full load", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Slow start: a newly healthy backend is not ready for full load", "autoResize": true, "lineHeight": 1.25}, {"id": "e743", "type": "text", "x": 1234, "y": 14126.0, "width": 1087.8, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g151"], "frameId": null, "roundness": null, "seed": 802908947, "version": 1, "versionNonce": 2115234626, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "A backend that just booted (cold caches, cold JIT, cold connection pools to its own downstreams) or just recovered will fall over again if it is instantly\nhanded its full steady-state share. Ramp it in: for a fixed window after it turns healthy, artificially inflate its effective load in the algorithm's eyes (or\ncap its share directly) so traffic climbs linearly rather than jumping to 1/N immediately.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A backend that just booted (cold caches, cold JIT, cold connection pools to its own downstreams) or just recovered will fall over again if it is instantly\nhanded its full steady-state share. Ramp it in: for a fixed window after it turns healthy, artificially inflate its effective load in the algorithm's eyes (or\ncap its share directly) so traffic climbs linearly rather than jumping to 1/N immediately.", "autoResize": true, "lineHeight": 1.25}, {"id": "e744", "type": "rectangle", "x": 1220, "y": 14224.0, "width": 1120, "height": 369.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g152"], "frameId": null, "roundness": {"type": 3}, "seed": 712314929, "version": 1, "versionNonce": 950122255, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e745", "type": "text", "x": 1234, "y": 14238.0, "width": 337.7, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g152"], "frameId": null, "roundness": null, "seed": 363485116, "version": 1, "versionNonce": 233984750, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "slow-start.js  -  decorator over any LbStrategy", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "slow-start.js  -  decorator over any LbStrategy", "autoResize": true, "lineHeight": 1.25}, {"id": "e746", "type": "text", "x": 1234, "y": 14264.0, "width": 690.8, "height": 315.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g152"], "frameId": null, "roundness": null, "seed": 6164838, "version": 1, "versionNonce": 168023450, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "class SlowStartDecorator extends LbStrategy {\n  constructor({ inner, clock = SystemClock, rampMs = 30_000 }) {\n    super(); this.inner = inner; this.clock = clock; this.rampMs = rampMs;\n  }\n  pick(candidates, ctx) {\n    const now = this.clock.now();\n    // Present a phantom higher connection count for ramping backends, so\n    // least-connections-style strategies naturally send them less until ramped.\n    const shaped = candidates.map(b => {\n      if (b.state !== 'draining') return b;\n      const elapsed  = now - (b.slowStartUntil - this.rampMs);\n      const fraction = Math.min(1, Math.max(0, elapsed / this.rampMs));\n      const phantom  = Math.round(b.activeConnections / Math.max(fraction, 0.05));\n      return { ...b, activeConnections: phantom };\n    });\n    return this.inner.pick(shaped, ctx);\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class SlowStartDecorator extends LbStrategy {\n  constructor({ inner, clock = SystemClock, rampMs = 30_000 }) {\n    super(); this.inner = inner; this.clock = clock; this.rampMs = rampMs;\n  }\n  pick(candidates, ctx) {\n    const now = this.clock.now();\n    // Present a phantom higher connection count for ramping backends, so\n    // least-connections-style strategies naturally send them less until ramped.\n    const shaped = candidates.map(b => {\n      if (b.state !== 'draining') return b;\n      const elapsed  = now - (b.slowStartUntil - this.rampMs);\n      const fraction = Math.min(1, Math.max(0, elapsed / this.rampMs));\n      const phantom  = Math.round(b.activeConnections / Math.max(fraction, 0.05));\n      return { ...b, activeConnections: phantom };\n    });\n    return this.inner.pick(shaped, ctx);\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e747", "type": "rectangle", "x": 1220, "y": 14617.0, "width": 1120, "height": 116.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g153"], "frameId": null, "roundness": {"type": 3}, "seed": 600879731, "version": 1, "versionNonce": 173437158, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e748", "type": "text", "x": 1234, "y": 14631.0, "width": 338.2, "height": 22.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g153"], "frameId": null, "roundness": null, "seed": 754769341, "version": 1, "versionNonce": 902336460, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Connection draining on planned removal", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Connection draining on planned removal", "autoResize": true, "lineHeight": 1.25}, {"id": "e749", "type": "text", "x": 1234, "y": 14659.5, "width": 1082.0, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g153"], "frameId": null, "roundness": null, "seed": 2051952478, "version": 1, "versionNonce": 1900893814, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "A deploy or scale-down must not sever in-flight requests. Mark the backend draining - stop routing NEW requests to it immediately, but let existing\nconnections finish (bounded by a drain timeout), then remove it from the pool. This is the same draining state used above for ramp-in, entered from\nthe opposite direction.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A deploy or scale-down must not sever in-flight requests. Mark the backend draining - stop routing NEW requests to it immediately, but let existing\nconnections finish (bounded by a drain timeout), then remove it from the pool. This is the same draining state used above for ramp-in, entered from\nthe opposite direction.", "autoResize": true, "lineHeight": 1.25}, {"id": "e750", "type": "rectangle", "x": 1220, "y": 14757.5, "width": 1120, "height": 111.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g154"], "frameId": null, "roundness": {"type": 3}, "seed": 265661507, "version": 1, "versionNonce": 1205015164, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e751", "type": "text", "x": 1234, "y": 14771.5, "width": 324.0, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g154"], "frameId": null, "roundness": null, "seed": 2070756658, "version": 1, "versionNonce": 1629521257, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "NUMBERS TO DEFEND ON THE WHITEBOARD", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "NUMBERS TO DEFEND ON THE WHITEBOARD", "autoResize": true, "lineHeight": 1.25}, {"id": "e752", "type": "text", "x": 1234, "y": 14795.0, "width": 1083.3, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g154"], "frameId": null, "roundness": null, "seed": 445393340, "version": 1, "versionNonce": 816322296, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Health-check interval trades detection speed against probe load and flap risk: 2 s interval x 3-fail threshold = ~6 s worst-case detection, generating\none probe per backend per interval per LB node - cheap. Tighten the interval for latency-critical tiers, loosen it (and raise the threshold) for anything\nwhere a probe failure is often just a blip.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Health-check interval trades detection speed against probe load and flap risk: 2 s interval x 3-fail threshold = ~6 s worst-case detection, generating\none probe per backend per interval per LB node - cheap. Tighten the interval for latency-critical tiers, loosen it (and raise the threshold) for anything\nwhere a probe failure is often just a blip.", "autoResize": true, "lineHeight": 1.25}, {"id": "e901", "type": "rectangle", "x": 0, "y": 15029.0, "width": 2400, "height": 2184.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#dbe4ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 670792035, "version": 1, "versionNonce": 1600600227, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e754", "type": "rectangle", "x": 60, "y": 15069.0, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g155"], "frameId": null, "roundness": {"type": 3}, "seed": 1764315916, "version": 1, "versionNonce": 662926510, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e755", "type": "text", "x": 74, "y": 15076.0, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g155"], "frameId": null, "roundness": null, "seed": 1765248700, "version": 1, "versionNonce": 1726439941, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "07", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "07", "autoResize": true, "lineHeight": 1.25}, {"id": "e756", "type": "text", "x": 144, "y": 15071.0, "width": 511.1, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g155"], "frameId": null, "roundness": null, "seed": 928677885, "version": 1, "versionNonce": 188463736, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Consistent hashing & pool churn", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Consistent hashing & pool churn", "autoResize": true, "lineHeight": 1.25}, {"id": "e757", "type": "text", "x": 60, "y": 15131.0, "width": 1469.2, "height": 45.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 105779320, "version": 1, "versionNonce": 1514526779, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Section 05's naive hash % n remaps almost everything whenever the pool changes size. This section is where the interview goes when it's going well - it's the same shape as the\nrate limiter's hot-key problem, one layer down.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Section 05's naive hash % n remaps almost everything whenever the pool changes size. This section is where the interview goes when it's going well - it's the same shape as the\nrate limiter's hot-key problem, one layer down.", "autoResize": true, "lineHeight": 1.25}, {"id": "e758", "type": "text", "x": 60, "y": 15204.0, "width": 85.9, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1016756317, "version": 1, "versionNonce": 420296545, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "The ring", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The ring", "autoResize": true, "lineHeight": 1.25}, {"id": "e759", "type": "rectangle", "x": 60, "y": 15244.0, "width": 2280, "height": 70.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g156"], "frameId": null, "roundness": {"type": 3}, "seed": 800398061, "version": 1, "versionNonce": 1162924751, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e760", "type": "text", "x": 74, "y": 15258.0, "width": 2222.8, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g156"], "frameId": null, "roundness": null, "seed": 1974624995, "version": 1, "versionNonce": 958523967, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Place each backend at several pseudo-random points (\"virtual nodes\") on a fixed hash-space ring (0 to 2^32 - 1). To route a key, hash it onto the same ring and walk clockwise to the first backend point. Adding or removing one backend only touches the ring's arc immediately behind its\nvirtual nodes - everyone else's mapping is untouched.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Place each backend at several pseudo-random points (\"virtual nodes\") on a fixed hash-space ring (0 to 2^32 - 1). To route a key, hash it onto the same ring and walk clockwise to the first backend point. Adding or removing one backend only touches the ring's arc immediately behind its\nvirtual nodes - everyone else's mapping is untouched.", "autoResize": true, "lineHeight": 1.25}, {"id": "e761", "type": "rectangle", "x": 60, "y": 15338.5, "width": 2280, "height": 700, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g157"], "frameId": null, "roundness": {"type": 3}, "seed": 414520586, "version": 1, "versionNonce": 694301198, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e762", "type": "text", "x": 185, "y": 15362.5, "width": 264.5, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 782218472, "version": 1, "versionNonce": 1583382221, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "BEFORE:  backends A, B, C", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "BEFORE:  backends A, B, C", "autoResize": true, "lineHeight": 1.25}, {"id": "e763", "type": "text", "x": 1745, "y": 15362.5, "width": 277.2, "height": 25.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1926278589, "version": 1, "versionNonce": 1019054749, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "AFTER:  add backend D (red)", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "AFTER:  add backend D (red)", "autoResize": true, "lineHeight": 1.25}, {"id": "e764", "type": "ellipse", "x": 185, "y": 15463.5, "width": 470, "height": 470, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 65030223, "version": 1, "versionNonce": 1356484092, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e765", "type": "text", "x": 340, "y": 15674.5, "width": 160, "height": 40.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 882190216, "version": 1, "versionNonce": 532603958, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "hash space\n0 .. 2^32 - 1", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "hash space\n0 .. 2^32 - 1", "autoResize": true, "lineHeight": 1.25}, {"id": "e766", "type": "ellipse", "x": 462.8, "y": 15453.5, "width": 36, "height": 36, "angle": 0, "strokeColor": "#1971c2", "backgroundColor"