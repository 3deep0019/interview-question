: 4098075, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Terminates connections - more CPU, more state, another TLS hop", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Terminates connections - more CPU, more state, another TLS hop", "autoResize": true, "lineHeight": 1.25}, {"id": "e198", "type": "text", "x": 1799, "y": 2749.5, "width": 451.2, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": null, "seed": 1029661341, "version": 1, "versionNonce": 1952490402, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Everywhere you need smart routing - almost always the inner tier", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Everywhere you need smart routing - almost always the inner tier", "autoResize": true, "lineHeight": 1.25}, {"id": "e199", "type": "line", "x": 310, "y": 2670.2, "width": 0, "height": 125.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": null, "seed": 1402259677, "version": 1, "versionNonce": 738749192, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 125.8]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e200", "type": "line", "x": 650, "y": 2670.2, "width": 0, "height": 125.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": null, "seed": 1717221869, "version": 1, "versionNonce": 1381117824, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 125.8]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e201", "type": "line", "x": 1190, "y": 2670.2, "width": 0, "height": 125.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": null, "seed": 182060406, "version": 1, "versionNonce": 1792394663, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 125.8]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e202", "type": "line", "x": 1790, "y": 2670.2, "width": 0, "height": 125.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": null, "seed": 1418596893, "version": 1, "versionNonce": 257491077, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 125.8]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e203", "type": "rectangle", "x": 60, "y": 2820.0, "width": 2280, "height": 71.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g41"], "frameId": null, "roundness": {"type": 3}, "seed": 1953731525, "version": 1, "versionNonce": 834374148, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e204", "type": "text", "x": 74, "y": 2834.0, "width": 219.4, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g41"], "frameId": null, "roundness": null, "seed": 1679982649, "version": 1, "versionNonce": 1527919545, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "REALISTIC ANSWER: LAYERED", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "REALISTIC ANSWER: LAYERED", "autoResize": true, "lineHeight": 1.25}, {"id": "e205", "type": "text", "x": 74, "y": 2857.5, "width": 1673.2, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g41"], "frameId": null, "roundness": null, "seed": 1610914378, "version": 1, "versionNonce": 428035153, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Same shape as the rate limiter's edge/gateway split. Cheap, dumb L4 spreads raw connections across a fleet of L7 proxies by ECMP or anycast; the L7 tier does TLS, routing, retries, and the interesting load-balancing algorithm.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Same shape as the rate limiter's edge/gateway split. Cheap, dumb L4 spreads raw connections across a fleet of L7 proxies by ECMP or anycast; the L7 tier does TLS, routing, retries, and the interesting load-balancing algorithm.", "autoResize": true, "lineHeight": 1.25}, {"id": "e206", "type": "text", "x": 60, "y": 2931.5, "width": 250.0, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1026567497, "version": 1, "versionNonce": 1909136608, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Where does the LB run?", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where does the LB run?", "autoResize": true, "lineHeight": 1.25}, {"id": "e207", "type": "rectangle", "x": 60, "y": 2971.5, "width": 540, "height": 116.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g42"], "frameId": null, "roundness": {"type": 3}, "seed": 383372480, "version": 1, "versionNonce": 931846999, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e208", "type": "text", "x": 74, "y": 2985.5, "width": 168.5, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g42"], "frameId": null, "roundness": null, "seed": 1694655440, "version": 1, "versionNonce": 1365460771, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Hardware appliance", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Hardware appliance", "autoResize": true, "lineHeight": 1.25}, {"id": "e209", "type": "text", "x": 74, "y": 3014.0, "width": 497.7, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g42"], "frameId": null, "roundness": null, "seed": 714075261, "version": 1, "versionNonce": 186293890, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "F5 / Citrix-class boxes. Extremely fast, expensive, a physical SPOF\nunless paired - mention it exists, then move to software, which is\nwhat gets built and asked about today.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "F5 / Citrix-class boxes. Extremely fast, expensive, a physical SPOF\nunless paired - mention it exists, then move to software, which is\nwhat gets built and asked about today.", "autoResize": true, "lineHeight": 1.25}, {"id": "e210", "type": "rectangle", "x": 640, "y": 2971.5, "width": 540, "height": 116.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g43"], "frameId": null, "roundness": {"type": 3}, "seed": 1719755505, "version": 1, "versionNonce": 2031874606, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e211", "type": "text", "x": 654, "y": 2985.5, "width": 174.7, "height": 22.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g43"], "frameId": null, "roundness": null, "seed": 2086618137, "version": 1, "versionNonce": 1550106814, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Software LB (this kit)", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Software LB (this kit)", "autoResize": true, "lineHeight": 1.25}, {"id": "e212", "type": "text", "x": 654, "y": 3014.0, "width": 493.7, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g43"], "frameId": null, "roundness": null, "seed": 850056704, "version": 1, "versionNonce": 994629688, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "nginx, HAProxy, Envoy running on commodity boxes or containers.\nHorizontally scalable, configuration-as-code, the default modern\nanswer.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "nginx, HAProxy, Envoy running on commodity boxes or containers.\nHorizontally scalable, configuration-as-code, the default modern\nanswer.", "autoResize": true, "lineHeight": 1.25}, {"id": "e213", "type": "rectangle", "x": 1220, "y": 2971.5, "width": 540, "height": 116.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g44"], "frameId": null, "roundness": {"type": 3}, "seed": 861971624, "version": 1, "versionNonce": 1596337780, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e214", "type": "text", "x": 1234, "y": 2985.5, "width": 107.1, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g44"], "frameId": null, "roundness": null, "seed": 2033231095, "version": 1, "versionNonce": 182362696, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "DNS / GSLB", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "DNS / GSLB", "autoResize": true, "lineHeight": 1.25}, {"id": "e215", "type": "text", "x": 1234, "y": 3014.0, "width": 497.2, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g44"], "frameId": null, "roundness": null, "seed": 1556493282, "version": 1, "versionNonce": 341140777, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Round-robin or latency-based DNS answers routing clients to a\nregion. Coarse, cached by resolvers (slow to react), but it's the only\ntool that works BEFORE a packet reaches any datacenter.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Round-robin or latency-based DNS answers routing clients to a\nregion. Coarse, cached by resolvers (slow to react), but it's the only\ntool that works BEFORE a packet reaches any datacenter.", "autoResize": true, "lineHeight": 1.25}, {"id": "e216", "type": "rectangle", "x": 1800, "y": 2971.5, "width": 540, "height": 116.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g45"], "frameId": null, "roundness": {"type": 3}, "seed": 365080080, "version": 1, "versionNonce": 2132692552, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e217", "type": "text", "x": 1814, "y": 2985.5, "width": 118.5, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g45"], "frameId": null, "roundness": null, "seed": 272812827, "version": 1, "versionNonce": 59160709, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Client-side LB", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Client-side LB", "autoResize": true, "lineHeight": 1.25}, {"id": "e218", "type": "text", "x": 1814, "y": 3014.0, "width": 492.2, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g45"], "frameId": null, "roundness": null, "seed": 324593663, "version": 1, "versionNonce": 1268759748, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "The caller holds the pool and picks a backend itself (gRPC + xDS,\nNetflix Ribbon). Removes a network hop and a SPOF entirely - the\ntrade is every client now needs the pool view and the smarts.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The caller holds the pool and picks a backend itself (gRPC + xDS,\nNetflix Ribbon). Removes a network hop and a SPOF entirely - the\ntrade is every client now needs the pool view and the smarts.", "autoResize": true, "lineHeight": 1.25}, {"id": "e219", "type": "text", "x": 60, "y": 3128.0, "width": 852.1, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1943155077, "version": 1, "versionNonce": 999339856, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "The LB tier can't itself be a single point of failure - two standard answers, name both", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The LB tier can't itself be a single point of failure - two standard answers, name both", "autoResize": true