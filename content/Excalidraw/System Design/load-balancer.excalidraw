tAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE DECISION GRADERS LISTEN FOR", "autoResize": true, "lineHeight": 1.25}, {"id": "e484", "type": "text", "x": 104, "y": 6920.2, "width": 931.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g95"], "frameId": null, "roundness": null, "seed": 541581476, "version": 1, "versionNonce": 1737784112, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Every backend down: this is the branch interviewers wait for. Policy, not a bug: fail CLOSED (503) by default, or fail OPEN to a\nstatic sorry-page pool only if the route configured one. Never hang forever.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Every backend down: this is the branch interviewers wait for. Policy, not a bug: fail CLOSED (503) by default, or fail OPEN to a\nstatic sorry-page pool only if the route configured one. Never hang forever.", "autoResize": true, "lineHeight": 1.25}, {"id": "e485", "type": "rectangle", "x": 90, "y": 6994.2, "width": 700, "height": 112.8, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g96"], "frameId": null, "roundness": {"type": 3}, "seed": 159880154, "version": 1, "versionNonce": 1817058138, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e486", "type": "text", "x": 104, "y": 7008.2, "width": 238.2, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g96"], "frameId": null, "roundness": null, "seed": 570281951, "version": 1, "versionNonce": 504198284, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Counters ride the same path", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Counters ride the same path", "autoResize": true, "lineHeight": 1.25}, {"id": "e487", "type": "text", "x": 104, "y": 7036.8, "width": 672.4, "height": 56.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g96"], "frameId": null, "roundness": null, "seed": 1566235066, "version": 1, "versionNonce": 1624445551, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "activeConnections is incremented before forwarding and decremented in finally, so\nleast-connections and power-of-two always read a live number. consecutiveFails feeds the health\nchecker; ewmaLatencyMs feeds least-response-time.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "activeConnections is incremented before forwarding and decremented in finally, so\nleast-connections and power-of-two always read a live number. consecutiveFails feeds the health\nchecker; ewmaLatencyMs feeds least-response-time.", "autoResize": true, "lineHeight": 1.25}, {"id": "e488", "type": "rectangle", "x": 60, "y": 7422.8, "width": 1120, "height": 929.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": {"type": 3}, "seed": 440701292, "version": 1, "versionNonce": 495502061, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e489", "type": "text", "x": 74, "y": 7436.8, "width": 353.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": null, "seed": 1588769799, "version": 1, "versionNonce": 1395718935, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "pipeline.js  -  the subtle part of the whole design", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "pipeline.js  -  the subtle part of the whole design", "autoResize": true, "lineHeight": 1.25}, {"id": "e490", "type": "text", "x": 74, "y": 7462.8, "width": 657.2, "height": 875.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g97"], "frameId": null, "roundness": null, "seed": 2095375165, "version": 1, "versionNonce": 988572755, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "class ProxyPipeline {\n  constructor({ router, factory, breaker, onDecision = () => {} }) {\n    this.router  = router;\n    this.factory = factory;   // policy name -> LbStrategy instance\n    this.breaker = breaker;   // wraps forwarding with a circuit breaker\n    this.emit    = onDecision;\n  }\n\n  async handle(ctx) {\n    const rule     = this.router.resolve(ctx);          // 1. match route\n    const strategy = this.factory.from(rule.policy);     // 2. pick algorithm\n    const healthy  = rule.pool.healthy();\n\n    if (healthy.length === 0) {\n      // Every backend down: this is the decision graders actually listen for.\n      this.emit({ event: 'pool_exhausted', rule: rule.id });\n      return this.#allExhausted(rule);\n    }\n\n    const backend = strategy.pick(healthy, ctx);          // 3. select\n    if (!backend) return this.#allExhausted(rule);\n\n    backend.activeConnections++;\n    const start = Date.now();\n    try {\n      const res = await this.breaker.forward(backend, ctx);   // 4. proxy\n      backend.consecutiveFails = 0;\n      backend.ewmaLatencyMs = ewma(backend.ewmaLatencyMs, Date.now() - start);\n      this.emit({ event: 'ok', backendId: backend.id });\n      return res;\n    } catch (err) {\n      backend.consecutiveFails++;\n      this.emit({ event: 'error', backendId: backend.id, err });\n      throw err;\n    } finally {\n      backend.activeConnections--;\n    }\n  }\n\n  #allExhausted(rule) {\n    // Policy call, not a bug: fail closed (503) by default, or fail open to a\n    // static sorry-page pool if the route configured one. Never hang forever.\n    if (rule.sorryPool) return this.breaker.forward(rule.sorryPool.any(), {});\n    throw new ServiceUnavailableError(rule.id);\n  }\n}\n\nfunction ewma(prev, sample, alpha = 0.2) {\n  return prev === 0 ? sample : alpha * sample + (1 - alpha) * prev;\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class ProxyPipeline {\n  constructor({ router, factory, breaker, onDecision = () => {} }) {\n    this.router  = router;\n    this.factory = factory;   // policy name -> LbStrategy instance\n    this.breaker = breaker;   // wraps forwarding with a circuit breaker\n    this.emit    = onDecision;\n  }\n\n  async handle(ctx) {\n    const rule     = this.router.resolve(ctx);          // 1. match route\n    const strategy = this.factory.from(rule.policy);     // 2. pick algorithm\n    const healthy  = rule.pool.healthy();\n\n    if (healthy.length === 0) {\n      // Every backend down: this is the decision graders actually listen for.\n      this.emit({ event: 'pool_exhausted', rule: rule.id });\n      return this.#allExhausted(rule);\n    }\n\n    const backend = strategy.pick(healthy, ctx);          // 3. select\n    if (!backend) return this.#allExhausted(rule);\n\n    backend.activeConnections++;\n    const start = Date.now();\n    try {\n      const res = await this.breaker.forward(backend, ctx);   // 4. proxy\n      backend.consecutiveFails = 0;\n      backend.ewmaLatencyMs = ewma(backend.ewmaLatencyMs, Date.now() - start);\n      this.emit({ event: 'ok', backendId: backend.id });\n      return res;\n    } catch (err) {\n      backend.consecutiveFails++;\n      this.emit({ event: 'error', backendId: backend.id, err });\n      throw err;\n    } finally {\n      backend.activeConnections--;\n    }\n  }\n\n  #allExhausted(rule) {\n    // Policy call, not a bug: fail closed (503) by default, or fail open to a\n    // static sorry-page pool if the route configured one. Never hang forever.\n    if (rule.sorryPool) return this.breaker.forward(rule.sorryPool.any(), {});\n    throw new ServiceUnavailableError(rule.id);\n  }\n}\n\nfunction ewma(prev, sample, alpha = 0.2) {\n  return prev === 0 ? sample : alpha * sample + (1 - alpha) * prev;\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e491", "type": "rectangle", "x": 1220, "y": 7422.8, "width": 1120, "height": 191.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": {"type": 3}, "seed": 1060746928, "version": 1, "versionNonce": 1815764541, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e492", "type": "text", "x": 1234, "y": 7436.8, "width": 370.4, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": null, "seed": 821542377, "version": 1, "versionNonce": 164797632, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "INTERVIEWER BAIT - ANSWER IT BEFORE THEY ASK", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "INTERVIEWER BAIT - ANSWER IT BEFORE THEY ASK", "autoResize": true, "lineHeight": 1.25}, {"id": "e493", "type": "text", "x": 1234, "y": 7460.2, "width": 1093.4, "height": 140.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g98"], "frameId": null, "roundness": null, "seed": 1028666489, "version": 1, "versionNonce": 1955212270, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "\"What if two requests race and both see the same 'least loaded' backend?\" Correct catch - pick() reads counters without locking. Three honest\nanswers:\n(a) accept it, as above - the counters are approximate signals, not a reservation system, and the error self-corrects within one request's latency;\n(b) increment activeConnections as part of an atomic pick-and-reserve if the strategy and pool share a single-threaded event loop (true for one Node\nprocess, false across a cluster);\n(c) for cross-process strategies, treat the counter as an ESTIMATE refreshed by passive telemetry rather than a synchronously-consistent value.\nName (a) as the pragmatic default and (c) as what actually happens once the LB itself is horizontally scaled.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\"What if two requests race and both see the same 'least loaded' backend?\" Correct catch - pick() reads counters without locking. Three honest\nanswers:\n(a) accept it, as above - the counters are approximate signals, not a reservation system, and the error self-corrects within one request's latency;\n(b) increment activeConnections as part of an atomic pick-and-reserve if the strategy and pool share a single-threaded event loop (true for one Node\nprocess, false across a cluster);\n(c) for cross-process strategies, treat the counter as an ESTIMATE refreshed by passive telemetry rather than a synchronously-consistent value.\nName (a) as the pragmatic default and (c) as what actually happens once the LB itself is horizontally scaled.", "autoResize": true, "lineHeight": 1.25}, {"id": "e679", "type": "rectangle", "x": 0, "y": 8511.8, "width": 2400, "height": 4126.8, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1290768462, "version": 1, "versionNonce": 2473961, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e495", "type": "rectangle", "x": 60, "y": 8551.8, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": {"type": 3}, "seed": 1647055768, "version": 1, "versionNonce": 100389471, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e496", "type": "text", "x": 74, "y": 8558.8, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 1324941616, "version": 1, "versionNonce": 1358912275, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "05", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "05", "autoResize": true, "lineHeight": 1.25}, {"id": "e497", "type": "text", "x": 144, "y": 8553.8, "width": 340.1, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g99"], "frameId": null, "roundness": null, "seed": 1380322991, "version": 1, "versionNonce": 425824803, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "The seven algorithms", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The seven algorithms", "autoResize": true, "lineHeight": 1.25}, {"id": "e498", "type": "text", "x": 60, "y": 8613.8, "width": 857.4, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 166369464, "version": 1, "versionNonce": 1287857265, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Know all seven cold. Interviewers almost always ask you to compare a couple and then implement one.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Know all seven cold. Interviewers almost always ask you to compare a couple and then implement one.", "autoResize": true, "lineHeight": 1.25}, {"id": "e499", "type": "text", "x": 60, "y": 8664.2, "width": 354.3, "height": 27.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 316592941, "version": 1, "versionNonce": 712476974, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Comparison - all seven at a glance", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Comparison - all seven at a glance", "autoResize": true, "lineHeight": 1.25}, {"id": "e500", "type": "rectangle", "x": 60, "y": 8702.2, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g100"], "frameId": null, "roundness": null, "seed": 545332599, "version": 1, "versionNonce": 1399159378, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e501", "type": "text", "x": 69, "y": 8710.2, "width": 63.5, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g100"], "frameId": null, "roundness": null, "seed": 1596046910, "version": 1, "versionNonce": 1487963129, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Algorithm", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Algorithm", "autoResize": true, "lineHeight": 1.25}, {"id": "e502", "type": "text", "x": 399, "y": 8710.2, "width": 36.0, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g100"], "frameId": null, "roundness": null, "seed": 653730826, "version": 1, "versionNonce": 1333911086, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "State", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "