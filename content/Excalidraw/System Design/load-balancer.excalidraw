originalText": "C", "autoResize": true, "lineHeight": 1.25}, {"id": "e618", "type": "rectangle", "x": 1700, "y": 10386.0, "width": 76, "height": 56, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g117"], "frameId": null, "roundness": {"type": 3}, "seed": 1905358007, "version": 1, "versionNonce": 43125184, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e619", "type": "text", "x": 1710, "y": 10400.2, "width": 56, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g117"], "frameId": null, "roundness": null, "seed": 1609877447, "version": 1, "versionNonce": 1869632546, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "A", "fontSize": 22, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "A", "autoResize": true, "lineHeight": 1.25}, {"id": "e620", "type": "rectangle", "x": 1788, "y": 10386.0, "width": 76, "height": 56, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g118"], "frameId": null, "roundness": {"type": 3}, "seed": 886441858, "version": 1, "versionNonce": 822138090, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e621", "type": "text", "x": 1798, "y": 10400.2, "width": 56, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g118"], "frameId": null, "roundness": null, "seed": 888808202, "version": 1, "versionNonce": 1601680382, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "A", "fontSize": 22, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "A", "autoResize": true, "lineHeight": 1.25}, {"id": "e622", "type": "rectangle", "x": 1260, "y": 10458.0, "width": 1080, "height": 68.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g119"], "frameId": null, "roundness": {"type": 3}, "seed": 1125642521, "version": 1, "versionNonce": 450982165, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e623", "type": "text", "x": 1274, "y": 10472.0, "width": 1026.8, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g119"], "frameId": null, "roundness": null, "seed": 809313178, "version": 1, "versionNonce": 580335655, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "A A B A C A A - A gets 5 of every 7 picks, but never five in an unbroken row. Compare that to naive 'repeat A five times then B then C', which\nbursts and defeats connection pooling on the client side.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A A B A C A A - A gets 5 of every 7 picks, but never five in an unbroken row. Compare that to naive 'repeat A five times then B then C', which\nbursts and defeats connection pooling on the client side.", "autoResize": true, "lineHeight": 1.25}, {"id": "e624", "type": "rectangle", "x": 60, "y": 10641.5, "width": 156.0, "height": 44, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g120"], "frameId": null, "roundness": {"type": 3}, "seed": 726285630, "version": 1, "versionNonce": 1615146092, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e625", "type": "text", "x": 78, "y": 10650.5, "width": 122.0, "height": 25.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g120"], "frameId": null, "roundness": null, "seed": 133271799, "version": 1, "versionNonce": 1069760176, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "least_conn", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "least_conn", "autoResize": true, "lineHeight": 1.25}, {"id": "e626", "type": "text", "x": 240.0, "y": 10647.5, "width": 495.8, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 595961815, "version": 1, "versionNonce": 1233258552, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "3  Least connections (+ weighted variant)", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3  Least connections (+ weighted variant)", "autoResize": true, "lineHeight": 1.25}, {"id": "e627", "type": "rectangle", "x": 60, "y": 10705.5, "width": 1160, "height": 386.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g121"], "frameId": null, "roundness": {"type": 3}, "seed": 2078088284, "version": 1, "versionNonce": 773406007, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e628", "type": "text", "x": 74, "y": 10719.5, "width": 224.9, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g121"], "frameId": null, "roundness": null, "seed": 270311932, "version": 1, "versionNonce": 1474791228, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "strategies/least-connections.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/least-connections.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e629", "type": "text", "x": 74, "y": 10745.5, "width": 564.8, "height": 332.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g121"], "frameId": null, "roundness": null, "seed": 1081034144, "version": 1, "versionNonce": 1136503526, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "class LeastConnections extends LbStrategy {\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    return candidates.reduce((best, b) =>\n      b.activeConnections < best.activeConnections ? b : best);\n  }\n}\n\n/** Weighted variant: normalize load by capacity, not raw count. */\nclass WeightedLeastConnections extends LbStrategy {\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    return candidates.reduce((best, b) => {\n      const bLoad = b.activeConnections / b.weight;\n      const bestLoad = best.activeConnections / best.weight;\n      return bLoad < bestLoad ? b : best;\n    });\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class LeastConnections extends LbStrategy {\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    return candidates.reduce((best, b) =>\n      b.activeConnections < best.activeConnections ? b : best);\n  }\n}\n\n/** Weighted variant: normalize load by capacity, not raw count. */\nclass WeightedLeastConnections extends LbStrategy {\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    return candidates.reduce((best, b) => {\n      const bLoad = b.activeConnections / b.weight;\n      const bestLoad = best.activeConnections / best.weight;\n      return bLoad < bestLoad ? b : best;\n    });\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e630", "type": "rectangle", "x": 1260, "y": 10705.5, "width": 1080, "height": 68.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g122"], "frameId": null, "roundness": {"type": 3}, "seed": 1352113483, "version": 1, "versionNonce": 1697181866, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e631", "type": "text", "x": 1274, "y": 10719.5, "width": 1035.6, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g122"], "frameId": null, "roundness": null, "seed": 1852980625, "version": 1, "versionNonce": 1822423948, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Send the next request to whoever has the fewest requests in flight right now. Self-correcting: a backend that's slow accumulates connections\nand stops receiving new ones automatically, no separate health signal required. The standard default for anything where request cost varies.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Send the next request to whoever has the fewest requests in flight right now. Self-correcting: a backend that's slow accumulates connections\nand stops receiving new ones automatically, no separate health signal required. The standard default for anything where request cost varies.", "autoResize": true, "lineHeight": 1.25}, {"id": "e632", "type": "rectangle", "x": 1260, "y": 10793.5, "width": 1080, "height": 111.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g123"], "frameId": null, "roundness": {"type": 3}, "seed": 463777328, "version": 1, "versionNonce": 198853031, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e633", "type": "text", "x": 1274, "y": 10807.5, "width": 170.8, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g123"], "frameId": null, "roundness": null, "seed": 582012897, "version": 1, "versionNonce": 1925842145, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "THE SCAN IS THE COST", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE SCAN IS THE COST", "autoResize": true, "lineHeight": 1.25}, {"id": "e634", "type": "text", "x": 1274, "y": 10831.0, "width": 1035.1, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g123"], "frameId": null, "roundness": null, "seed": 533550147, "version": 1, "versionNonce": 825837949, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "O(n) per pick is fine for hundreds of backends and irrelevant next to a network round trip, but say the upgrade path: a min-heap keyed by\nactiveConnections gives O(log n) pick and update, which is what you'd reach for past a few thousand backends (rare - that's usually sharded\ninto multiple pools long before then).", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "O(n) per pick is fine for hundreds of backends and irrelevant next to a network round trip, but say the upgrade path: a min-heap keyed by\nactiveConnections gives O(log n) pick and update, which is what you'd reach for past a few thousand backends (rare - that's usually sharded\ninto multiple pools long before then).", "autoResize": true, "lineHeight": 1.25}, {"id": "e635", "type": "rectangle", "x": 60, "y": 11148.0, "width": 264.0, "height": 44, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g124"], "frameId": null, "roundness": {"type": 3}, "seed": 858471907, "version": 1, "versionNonce": 1386827139, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e636", "type": "text", "x": 78, "y": 11157.0, "width": 230.0, "height": 25.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g124"], "frameId": null, "roundness": null, "seed": 957473606, "version": 1, "versionNonce": 927362216, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "least_response_time", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "least_response_time", "autoResize": true, "lineHeight": 1.25}, {"id": "e637", "type": "text", "x": 348.0, "y": 11154.0, "width": 275.6, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2048578234, "version": 1, "versionNonce": 670049282, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "4  Least response time", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4  Least response time", "autoResize": true, "lineHeight": 1.25}, {"id": "e638", "type": "rectangle", "x": 60, "y": 11212.0, "width": 1160, "height": 264.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g125"], "frameId": null, "roundness": {"type": 3}, "seed": 1822534305, "version": 1, "versionNonce": 1748779612, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e639", "type": "text", "x": 74, "y": 11226.0, "width": 241.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g125"], "frameId": null, "roundness": null, "seed": 1874519106, "version": 1, "versionNonce": 2078850911, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "strategies/least-response-time.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/least-response-time.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e640", "type": "text", "x": 74, "y": 11252.0, "width": 766.4, "height": 210.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g125"], "frameId": null, "roundness": null, "seed": 46837725, "version": 1, "versionNonce": 273260902, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "class LeastResponseTime extends LbStrategy {\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    return candidates.reduce((best, b) => {\n      // +1 avoids a fresh, latency-unknown backend scoring exactly 0 and\n      // absorbing a thundering herd before it's proven itself (see section 06 slow start).\n      const score     = (b.activeConnections + 1) * (b.ewmaLatencyMs || 1);\n      const bestScore = (best.activeConnections + 1) * (best.ewmaLatencyMs || 1);\n      return score < bestScore ? b : best;\n    });\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class LeastResponseTime extends LbStrategy {\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    return candidates.reduce((best, b) => {\n      // +1 avoids a fresh, latency-unknown backend scoring exactly 0 and\n      // absorbing a thundering herd before it's proven itself (see section 06 slow start).\n      const score     = (b.activeConnections + 1) * (b.ewmaLatencyMs || 1);\n      const bestScore = (best.activeConnections + 1) * (best.ewmaLatencyMs || 1);\n      return score < bestScore ? b : best;\n    });\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e641", "type": "rectangle", "x": 1260, "y": 11212.0, "width": 1080, "height": 68.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g126"], "frameId": null, "roundness": {"type": 3}, "seed": 69242372, "version": 1, "versionNonce": 913109782, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e642", "type": "text", "x": 1274, "y": 11226.0, "width": 1050.1, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g126"], "frameId": null, "roundness": null, "seed": 1523664945, "version": 1, "versionNonce": 1640013428, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Least connections plus a latency signal - score each backend by connections x EWMA latency, so a backend that's technically idle but recently\nslow (GC pause, noisy neighbor) doesn't get hammered just because its connection count looks good.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Least connections plus a latency signal - score each backend by connections x EWMA latency, so a backend that's technically idle but recently\nslow (GC pause, noisy neighbor) doesn't get hammered just because its connection count looks good.", "autoResize": true, "lineHeight": 1.25}, {"id": "e643", "type": "rectangle", "x": 1260, "y": 11300.0, "width": 1080, "height": 111.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g127"], "frameId": null, "roundness": {"type": 3}, "seed": 1923493620, "version": 1, "versionNonce": 1727112150, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e644", "type": "text", "x": 1274, "y": 11314.0, "width": 245.8, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g127"], "frameId": null, "roundness": null, "seed": 1016335885, "version": 1, "versionNonce": 2079368191, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "WHY EWMA, NOT A RAW AVERAGE", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHY EWMA, NOT A RAW AVERAGE", "autoResize": true, "lineHeight": 1.25}, {"id": "e645", "type": "text", "x": 1274, "y": 11337.5, "width": 1019.5, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g127"], "frameId": null, "roundness": null, "seed": 1260951916, "version": 1, "versionNonce": 1051889819, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "A simple moving average over the last N requests needs a ring buffer per backend and weights every sample equally, so a spike from ten\nminutes ago still counts. An exponentially weighted moving average is one float, O(1) to update, and naturally forgets old data - exactly the\nshape you want for \"how is this backend doing RIGHT NOW.\"", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A simple moving average over the last N requests needs a ring buffer per backend and weights every sample equally, so a spike from ten\nminutes ago still counts. An exponentially weighted moving average is one float, O(1) to update, and naturally forgets old data - exactly the\nshape you want for \"how is this backend doing RIGHT NOW.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e646", "type": "rectangle", "x": 60, "y": 11532.0, "width": 180.0, "height": 44, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": {"type": 3}, "seed": 383741, "version": 1, "versionNonce": 157062401, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e647", "type": "text", "x": 78, "y": 11541.0, "width": 146.0, "height": 25.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g128"], "frameId": null, "roundness": null, "seed": 840785138, "version": 1, "versionNonce": 1997671970, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "power_of_two", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "power_of_two", "autoResize": true, "lineHeight": 1.25}, {"id": "e648", "type": "text", "x": 264.0, "y": 11538.0, "width": 287.6, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1990346408, "version": 1, "versionNonce": 1993209948, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "5  Power of two choices", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "5  Power of two choices", "autoResize": true, "lineHeight": 1.25}, {"id": "e649", "type": "rectangle", "x": 60, "y": 11596.0, "width": 1160, "height": 334.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g129"], "frameId": null, "roundness": {"type": 3}, "seed": 1772939326, "version": 1, "versionNonce": 1133573757, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e650", "type": "text", "x": 74, "y": 11610.0, "width": 253.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g129"], "frameId": null, "roundness": null, "seed": 1837092102, "version": 1, "versionNonce": 1005347509, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "strategies/power-of-two-choices.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/power-of-two-choices.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e651", "type": "text", "x": 74, "y": 11636.0, "width": 674.0, "height": 280.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g129"], "frameId": null, "roundness": null, "seed": 2087871919, "version": 1, "versionNonce": 964113688, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "class PowerOfTwoChoices extends LbStrategy {\n  constructor({ rng = SystemRng } = {}) { super(); this.rng = rng; }\n\n  pick(candidates) {\n    const n = candidates.length;\n    if (n === 0) return null;\n    if (n === 1) return candidates[0];\n\n    const i = Math.floor(this.rng.next() * n);\n    let j = Math.floor(this.rng.next() * (n - 1));\n    if (j >= i) j++;                       // ensure i !== j, uniform over pairs\n\n    const a = candidates[i], b = candidates[j];\n    return a.activeConnections <= b.activeConnections ? a : b;\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class PowerOfTwoChoices extends LbStrategy {\n  constructor({ rng = SystemRng } = {}) { super(); this.rng = rng; }\n\n  pick(candidates) {\n    const n = candidates.length;\n    if (n === 0) return null;\n    if (n === 1) return candidates[0];\n\n    const i = Math.floor(this.rng.next() * n);\n    let j = Math.floor(this.rng.next() * (n - 1));\n    if (j >= i) j++;                       // ensure i !== j, uniform over pairs\n\n    const a = candidates[i], b = candidates[j];\n    return a.activeConnections <= b.activeConnections ? a : b;\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e652", "type": "rectangle", "x": 1260, "y": 11596.0, "width": 1080, "height": 88.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g130"], "frameId": null, "roundness": {"type": 3}, "seed": 533575130, "version": 1, "versionNonce": 1681709874, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e653", "type": "text", "x": 1274, "y": 11610.0, "width": 1044.1, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g130"], "frameId": null, "roundness": null, "seed": 234174512, "version": 1, "versionNonce": 480607733, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Sample two backends at random, pick the less loaded of the two. The classic result (Mitzenmacher): full least-connections needs to see every\nbackend to make an optimal choice; sampling just two gets exponentially better load distribution than pure random, for O(1) cost instead of\nO(n). This is what Nginx's 'random two least_conn' and many modern service meshes actually run in production at scale.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Sample two backends at random, pick the less loaded of the two. The classic result (Mitzenmacher): full least-connections needs to see every\nbackend to make an optimal choice; sampling just two gets exponentially better load distribution than pure random, for O(1) cost instead of\nO(n). This is what Nginx's 'random two least_conn' and many modern service meshes actually run in production at scale.", "autoResize": true, "lineHeight": 1.25}, {"id": "e654", "type": "rectangle", "x": 1260, "y": 11704.0, "width": 1080, "height": 111.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g131"], "frameId": null, "roundness": {"type": 3}, "seed": 331525069, "version": 1, "versionNonce": 326564063, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e655", "type": "text", "x": 1274, "y": 11718.0, "width": 465.1, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g131"], "frameId": null, "roundness": null, "seed": 1121771598, "version": 1, "versionNonce": 2087112546, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "WHY THIS IS THE ANSWER THAT MAKES AN INTERVIEWER SIT UP", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHY THIS IS THE ANSWER THAT MAKES AN INTERVIEWER SIT UP", "autoResize": true, "lineHeight": 1.25}, {"id": "e656", "type": "text", "x": 1274, "y": 11741.5, "width": 1044.7, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g131"], "frameId": null, "roundness": null, "seed": 1464745055, "version": 1, "versionNonce": 233840377, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "It sidesteps the two problems that plague full least-connections at scale: it needs no synchronized global view (each pick only touches two\nbackends' counters), and it's O(1) regardless of pool size - a pool of 10,000 backends costs the same per pick as a pool of 10. Mention it's the\nsame family of idea as CDN request-coalescing and consistent-hash \"choose the better of two ring positions.\"", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "It sidesteps the two problems that plague full least-connections at scale: it needs no synchronized global view (each pick only touches two\nbackends' counters), and it's O(1) regardless of pool size - a pool of 10,000 backends costs the same per pick as a pool of 10. Mention it's the\nsame family of idea as CDN request-coalescing and consistent-hash \"choose the better of two ring positions.\"", "autoResize": true, "lineHeight": 1.25}, {"id": "e657", "type": "rectangle", "x": 60, "y": 11986.0, "width": 120.0, "height": 44, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g132"], "frameId": null, "roundness": {"type": 3}, "seed": 2021835572, "version": 1, "versionNonce": 1772523015, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e658", "type": "text", "x": 78, "y": 11995.0, "width": 86.0, "height": 25.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g132"], "frameId": null, "roundness": null, "seed": 1549914730, "version": 1, "versionNonce": 1505394012, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "ip_hash", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ip_hash", "autoResize": true, "lineHeight": 1.25}, {"id": "e659", "type": "text", "x": 204.0, "y": 11992.0, "width": 226.5, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1390169496, "version": 1, "versionNonce": 1817863193, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "6  IP hash (affinity)", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "6  IP hash (affinity)", "autoResize": true, "lineHeight": 1.25}, {"id": "e660", "type": "rectangle", "x": 60, "y": 12050.0, "width": 1160, "height": 229.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g133"], "frameId": null, "roundness": {"type": 3}, "seed": 1642396658, "version": 1, "versionNonce": 1921754975, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e661", "type": "text", "x": 74, "y": 12064.0, "width": 602.3, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g133"], "frameId": null, "roundness": null, "seed": 982098052, "version": 1, "versionNonce": 182543374, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "strategies/ip-hash.js  -  naive modulo, see section 07 for why this breaks on churn", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/ip-hash.js  -  naive modulo, see section 07 for why this breaks on churn", "autoResize": true, "lineHeight": 1.25}, {"id": "e662", "type": "text", "x": 74, "y": 12090.0, "width": 539.6, "height": 175.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g133"], "frameId": null, "roundness": null, "seed": 1184339188, "version": 1, "versionNonce": 1668297630, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "import { createHash } from 'node:crypto';\n\nclass IpHash extends LbStrategy {\n  pick(candidates, ctx) {\n    if (candidates.length === 0) return null;\n    const h = createHash('sha1').update(ctx.clientKey).digest();\n    const idx = h.readUInt32BE(0) % candidates.length;\n    return candidates[idx];\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "import { createHash } from 'node:crypto';\n\nclass IpHash extends LbStrategy {\n  pick(candidates, ctx) {\n    if (candidates.length === 0) return null;\n    const h = createHash('sha1').update(ctx.clientKey).digest();\n    const idx = h.readUInt32BE(0) % candidates.length;\n    return candidates[idx];\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e663", "type": "rectangle", "x": 1260, "y": 12050.0, "width": 1080, "height": 68.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g134"], "frameId": null, "roundness": {"type": 3}, "seed": 84924958, "version": 1, "versionNonce": 2933550, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e664", "type": "text", "x": 1274, "y": 12064.0, "width": 1038.5, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g134"], "frameId": null, "roundness": null, "seed": 1679973503, "version": 1, "versionNonce": 269835134, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Hash a client key (IP, cookie, header) to deterministically pick the same backend every time. This is the only family here that solves affinity, at\nthe direct cost of load awareness - a hot client key sends disproportionate load to one backend regardless of how busy it is.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Hash a client key (IP, cookie, header) to deterministically pick the same backend every time. This is the only family here that solves affinity, at\nthe direct cost of load awareness - a hot client key sends disproportionate load to one backend regardless of how busy it is.", "autoResize": true, "lineHeight": 1.25}, {"id": "e665", "type": "rectangle", "x": 1260, "y": 12138.0, "width": 1080, "height": 111.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g135"], "frameId": null, "roundness": {"type": 3}, "seed": 499454942, "version": 1, "versionNonce": 1222739143, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e666", "type": "text", "x": 1274, "y": 12152.0, "width": 277.4, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g135"], "frameId": null, "roundness": null, "seed": 1975513398, "version": 1, "versionNonce": 80727632, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "THE TRAP THIS TAB EXISTS TO SET UP", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "THE TRAP THIS TAB EXISTS TO SET UP", "autoResize": true, "lineHeight": 1.25}, {"id": "e667", "type": "text", "x": 1274, "y": 12175.5, "width": 1052.8, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g135"], "frameId": null, "roundness": null, "seed": 1386213093, "version": 1, "versionNonce": 1535497261, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "hash % n means every backend add or remove changes n and reshuffles nearly every key's target backend - exactly the 99.5%-remap number\nfrom section 02. That's fine for a stateless pool but destroys session affinity and cache hit rates on every deploy. Section 07 fixes this with a\nconsistent-hash ring.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "hash % n means every backend add or remove changes n and reshuffles nearly every key's target backend - exactly the 99.5%-remap number\nfrom section 02. That's fine for a stateless pool but destroys session affinity and cache hit rates on every deploy. Section 07 fixes this with a\nconsistent-hash ring.", "autoResize": true, "lineHeight": 1.25}, {"id": "e668", "type": "rectangle", "x": 60, "y": 12335.0, "width": 108.0, "height": 44, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g136"], "frameId": null, "roundness": {"type": 3}, "seed": 652367431, "version": 1, "versionNonce": 2066813208, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e669", "type": "text", "x": 78, "y": 12344.0, "width": 74.0, "height": 25.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g136"], "frameId": null, "roundness": null, "seed": 274806713, "version": 1, "versionNonce": 1345339959, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "random", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "random", "autoResize": true, "lineHeight": 1.25}, {"id": "e670", "type": "text", "x": 192.0, "y": 12341.0, "width": 134.3, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 540723384, "version": 1, "versionNonce": 1134414978, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "7  Random", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "7  Random", "autoResize": true, "lineHeight": 1.25}, {"id": "e671", "type": "rectangle", "x": 60, "y": 12399.0, "width": 1160, "height": 176.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g137"], "frameId": null, "roundness": {"type": 3}, "seed": 1366424734, "version": 1, "versionNonce": 939374902, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e672", "type": "text", "x": 74, "y": 12413.0, "width": 151.8, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g137"], "frameId": null, "roundness": null, "seed": 1500193234, "version": 1, "versionNonce": 1640342610, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "strategies/random.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/random.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e673", "type": "text", "x": 74, "y": 12439.0, "width": 598.4, "height": 122.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g137"], "frameId": null, "roundness": null, "seed": 240803115, "version": 1, "versionNonce": 213556057, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "class Random extends LbStrategy {\n  constructor({ rng = SystemRng } = {}) { super(); this.rng = rng; }\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    return candidates[Math.floor(this.rng.next() * candidates.length)];\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class Random extends LbStrategy {\n  constructor({ rng = SystemRng } = {}) { super(); this.rng = rng; }\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    return candidates[Math.floor(this.rng.next() * candidates.length)];\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e674", "type": "rectangle", "x": 1260, "y": 12399.0, "width": 1080, "height": 68.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g138"], "frameId": null, "roundness": {"type": 3}, "seed": 151079576, "version": 1, "versionNonce": 644995175, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e675", "type": "text", "x": 1274, "y": 12413.0, "width": 1005.6, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g138"], "frameId": null, "roundness": null, "seed": 1126219185, "version": 1, "versionNonce": 2026237704, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Pick uniformly at random. Sounds naive, but at high enough request volume the law of large numbers makes it converge to roughly even\ndistribution, with zero state and zero coordination - no cursor to keep consistent across LB nodes, unlike round robin.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Pick uniformly at random. Sounds naive, but at high enough request volume the law of large numbers makes it converge to roughly even\ndistribution, with zero state and zero coordination - no cursor to keep consistent across LB nodes, unlike round robin.", "autoResize": true, "lineHeight": 1.25}, {"id": "e676", "type": "rectangle", "x": 1260, "y": 12487.0, "width": 1080, "height": 111.5, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g139"], "frameId": null, "roundness": {"type": 3}, "seed": 1251748844, "version": 1, "versionNonce": 411676405, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e677", "type": "text", "x": 1274, "y": 12501.0, "width": 275.6, "height": 17.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g139"], "frameId": null, "roundness": null, "seed": 833399648, "version": 1, "versionNonce": 560239581, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "WHEN IT'S ACTUALLY THE RIGHT CALL", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHEN IT'S ACTUALLY THE RIGHT CALL", "autoResize": true, "lineHeight": 1.25}, {"id": "e678", "type": "text", "x": 1274, "y": 12524.5, "width": 1040.8, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g139"], "frameId": null, "roundness": null, "seed": 480140911, "version": 1, "versionNonce": 1697558335, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Multiple independent LB nodes running round robin with unsynchronized cursors already degrade toward random-like behavior in aggregate -\nso at high fan-out, pure random is often just an honest, stateless version of what you'd get anyway. It's a poor choice under low request\nvolume, where variance dominates and one backend can get unlucky.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Multiple independent LB nodes running round robin with unsynchronized cursors already degrade toward random-like behavior in aggregate -\nso at high fan-out, pure random is often just an honest, stateless version of what you'd get anyway. It's a poor choice under low request\nvolume, where variance dominates and one backend can get unlucky.", "autoResize": true, "lineHeight": 1.25}, {"id": "e753", "type": "rectangle", "x": 0, "y": 12758.5, "width": 2400, "height": 2150.5, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 765855418, "version": 1, "versionNonce": 1650839581, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e680", "type": "rectangle", "x": 60, "y": 12798.5, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g140"], "frameId": null, "roundness": {"type": 3}, "seed": 22466198, "version": 1, "versionNonce": 1154221609, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e681", "type": "text", "x": 74, "y": 12805.5, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g140"], "frameId": null, "roundness": null, "seed": 647512051, "version": 1, "versionNonce": 2139696987, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "06", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "06", "autoResize": true, "lineHeight": 1.25}, {"id": "e682", "type": "text", "x": 144, "y": 12800.5, "width": 253.6, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g140"], "frameId": null, "roundness": null, "seed": 989325594, "version": 1, "versionNonce": 598296779, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Health checking", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Health checking", "autoResize": true, "lineHeight": 1.25}, {"id": "e683", "type": "text", "x": 60, "y": 12860.5, "width": 1417.3, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2059307909, "version": 1, "versionNonce": 679371540, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "The algorithm in section 05 only matters among HEALTHY backends. Getting \"healthy\" right - fast to detect, resistant to flapping - is the part that actually prevents outages.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The algorithm in section 05 only matters among HEALTHY backends. Getting \"healthy\" right - fast to detect, resistant to flapping - is the part that actually prevents outages.", "autoResize": true, "lineHeight": 1.25}, {"id": "e684", "type": "text", "x": 60, "y": 12911.0, "width": 183.8, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1384215637, "version": 1, "versionNonce": 1802621840, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Active vs. passive", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Active vs. passive", "autoResize": true, "lineHeight": 1.25}, {"id": "e685", "type": "rectangle", "x": 60, "y": 12949.0, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 1897890279, "version": 1, "versionNonce": 520458983, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e686", "type": "text", "x": 69, "y": 12957.0, "width": 31.1, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 1020708045, "version": 1, "versionNonce": 1130172783, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Kind", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Kind", "autoResize": true, "lineHeight": 1.25}, {"id": "e687", "type": "text", "x": 269, "y": 12957.0, "width": 31.1, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 504160651, "version": 1, "versionNonce": 1174678355, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "How", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "How", "autoResize": true, "lineHeight": 1.25}, {"id": "e688", "type": "text", "x": 969, "y": 12957.0, "width": 24.7, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 530553846, "version": 1, "versionNonce": 62880150, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Pro", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Pro", "autoResize": true, "lineHeight": 1.25}, {"id": "e689", "type": "text", "x": 1659, "y": 12957.0, "width": 28.7, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 2062903347, "version": 1, "versionNonce": 884355564, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Con", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Con", "autoResize": true, "lineHeight": 1.25}, {"id": "e690", "type": "rectangle", "x": 60, "y": 12982.5, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 1513232211, "version": 1, "versionNonce": 1395112714, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e691", "type": "text", "x": 69, "y": 12991.5, "width": 44.5, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 660131814, "version": 1, "versionNonce": 118774568, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Active", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Active", "autoResize": true, "lineHeight": 1.25}, {"id": "e692", "type": "text", "x": 269, "y": 12991.5, "width": 531.0, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 46788050, "version": 1, "versionNonce": 416859278, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "LB proactively probes each backend (GET /healthz, TCP connect) on a timer", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "LB proactively probes each backend (GET /healthz, TCP connect) on a timer", "autoResize": true, "lineHeight": 1.25}, {"id": "e693", "type": "text", "x": 969, "y": 12991.5, "width": 420.1, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 1070113092, "version": 1, "versionNonce": 1900197732, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Catches a backend that's down before it ever gets real traffic", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Catches a backend that's down before it ever gets real traffic", "autoResize": true, "lineHeight": 1.25}, {"id": "e694", "type": "text", "x": 1659, "y": 12991.5, "width": 410.5, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 1448398825, "version": 1, "versionNonce": 1389783457, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Extra load on backends; interval is a floor on detection time", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Extra load on backends; interval is a floor on detection time", "autoResize": true, "lineHeight": 1.25}, {"id": "e695", "type": "rectangle", "x": 60, "y": 13019.2, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 901977222, "version": 1, "versionNonce": 174143894, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e696", "type": "text", "x": 69, "y": 13028.2, "width": 56.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 552453320, "version": 1, "versionNonce": 489283772, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Passive", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Passive", "autoResize": true, "lineHeight": 1.25}, {"id": "e697", "type": "text", "x": 269, "y": 13028.2, "width": 520.6, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 1433134049, "version": 1, "versionNonce": 911225420, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Observe real request outcomes - errors, timeouts, latency - as they happen", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Observe real request outcomes - errors, timeouts, latency - as they happen", "autoResize": true, "lineHeight": 1.25}, {"id": "e698", "type": "text", "x": 969, "y": 13028.2, "width": 670.6, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 1986767750, "version": 1, "versionNonce": 795037170, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Zero extra load, detects issues active probes miss (a healthy /healthz but a broken real endpoint)", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Zero extra load, detects issues active probes miss (a healthy /healthz but a broken real endpoint)", "autoResize": true, "lineHeight": 1.25}, {"id": "e699", "type": "text", "x": 1659, "y": 13028.2, "width": 572.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g141"], "frameId": null, "roundness": null, "seed": 487019377, "version": 1, "versionNonce": 1058588012, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Needs live traffic to detect anything; the first few requests to a bad backend still fail", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": nu