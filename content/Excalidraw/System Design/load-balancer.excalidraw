"roundness": null, "seed": 1082168684, "version": 1, "versionNonce": 1921713305, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "failures >= threshold (5):\nopenUntil = now + 10 s", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "failures >= threshold (5):\nopenUntil = now + 10 s", "autoResize": true, "lineHeight": 1.25}, {"id": "e1000", "type": "arrow", "x": 1430, "y": 18684.5, "width": 390, "height": 0.0, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 811453816, "version": 1, "versionNonce": 1401760612, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [390, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e992", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e995", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1001", "type": "text", "x": 1440, "y": 18618.5, "width": 370, "height": 37.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2041973435, "version": 1, "versionNonce": 1684148540, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "cooldown elapsed\n(now >= openUntil)", "fontSize": 15, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "cooldown elapsed\n(now >= openUntil)", "autoResize": true, "lineHeight": 1.25}, {"id": "e1002", "type": "arrow", "x": 1950, "y": 18754.5, "width": 740, "height": 50.0, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 292456607, "version": 1, "versionNonce": 55526383, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 50.0], [-740, 50.0], [-740, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e995", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e992", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1003", "type": "text", "x": 1240, "y": 18812.5, "width": 497.2, "height": 18.8, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1840544059, "version": 1, "versionNonce": 142551403, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "trial fails: failures is already >= threshold, so it re-opens for another 10 s", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "trial fails: failures is already >= threshold, so it re-opens for another 10 s", "autoResize": true, "lineHeight": 1.25}, {"id": "e1004", "type": "arrow", "x": 2130, "y": 18754.5, "width": 1750, "height": 130.0, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 2139160385, "version": 1, "versionNonce": 1318820761, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 130.0], [-1750, 130.0], [-1750, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e995", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e989", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1005", "type": "text", "x": 410, "y": 18892.5, "width": 291.2, "height": 18.8, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1572139257, "version": 1, "versionNonce": 1487238827, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "trial succeeds: failures = 0, back to closed", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "trial succeeds: failures = 0, back to closed", "autoResize": true, "lineHeight": 1.25}, {"id": "e1006", "type": "rectangle", "x": 60, "y": 19008.5, "width": 1120, "height": 771.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g180"], "frameId": null, "roundness": {"type": 3}, "seed": 1750176521, "version": 1, "versionNonce": 235338531, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1007", "type": "text", "x": 74, "y": 19022.5, "width": 345.1, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g180"], "frameId": null, "roundness": null, "seed": 415983267, "version": 1, "versionNonce": 282646378, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "breaker.js  -  decorator over the forwarding call", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "breaker.js  -  decorator over the forwarding call", "autoResize": true, "lineHeight": 1.25}, {"id": "e1008", "type": "text", "x": 74, "y": 19048.5, "width": 732.8, "height": 717.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g180"], "frameId": null, "roundness": null, "seed": 2108245016, "version": 1, "versionNonce": 1902015410, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "class CircuitBreaker {\n  constructor({ threshold = 5, cooldownMs = 10_000, timeoutMs = 2000,\n                clock = SystemClock, httpClient }) {\n    Object.assign(this, { threshold, cooldownMs, timeoutMs, clock, httpClient });\n    this.state = new Map();  // backendId -> { failures, openUntil }\n  }\n\n  async forward(backend, ctx) {\n    const s = this.state.get(backend.id) ?? { failures: 0, openUntil: 0 };\n    const now = this.clock.now();\n\n    if (now < s.openUntil) {\n      throw new BackendUnavailableError(backend.id);   // fail fast, no wasted RTT\n    }\n\n    try {\n      const res = await this.#withTimeout(this.httpClient.forward(backend, ctx));\n      s.failures = 0;\n      this.state.set(backend.id, s);\n      return res;\n    } catch (err) {\n      s.failures++;\n      if (s.failures >= this.threshold) {\n        s.openUntil = now + this.cooldownMs;\n        // Tripping the breaker is itself a pool-membership-relevant event -\n        // an OBSERVER can promote this to a full HealthChecker ejection\n        // instead of waiting out the next active-probe interval.\n      }\n      this.state.set(backend.id, s);\n      throw err;\n    }\n  }\n\n  #withTimeout(p) {\n    return Promise.race([\n      p,\n      new Promise((_, rej) =>\n        setTimeout(() => rej(new Error('backend timeout')), this.timeoutMs).unref?.()),\n    ]);\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class CircuitBreaker {\n  constructor({ threshold = 5, cooldownMs = 10_000, timeoutMs = 2000,\n                clock = SystemClock, httpClient }) {\n    Object.assign(this, { threshold, cooldownMs, timeoutMs, clock, httpClient });\n    this.state = new Map();  // backendId -> { failures, openUntil }\n  }\n\n  async forward(backend, ctx) {\n    const s = this.state.get(backend.id) ?? { failures: 0, openUntil: 0 };\n    const now = this.clock.now();\n\n    if (now < s.openUntil) {\n      throw new BackendUnavailableError(backend.id);   // fail fast, no wasted RTT\n    }\n\n    try {\n      const res = await this.#withTimeout(this.httpClient.forward(backend, ctx));\n      s.failures = 0;\n      this.state.set(backend.id, s);\n      return res;\n    } catch (err) {\n      s.failures++;\n      if (s.failures >= this.threshold) {\n        s.openUntil = now + this.cooldownMs;\n        // Tripping the breaker is itself a pool-membership-relevant event -\n        // an OBSERVER can promote this to a full HealthChecker ejection\n        // instead of waiting out the next active-probe interval.\n      }\n      this.state.set(backend.id, s);\n      throw err;\n    }\n  }\n\n  #withTimeout(p) {\n    return Promise.race([\n      p,\n      new Promise((_, rej) =>\n        setTimeout(() => rej(new Error('backend timeout')), this.timeoutMs).unref?.()),\n    ]);\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e1009", "type": "rectangle", "x": 1220, "y": 19008.5, "width": 1120, "height": 111.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g181"], "frameId": null, "roundness": {"type": 3}, "seed": 1056282711, "version": 1, "versionNonce": 618221024, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1010", "type": "text", "x": 1234, "y": 19022.5, "width": 208.1, "height": 17.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g181"], "frameId": null, "roundness": null, "seed": 2054367220, "version": 1, "versionNonce": 1741598339, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "FAIL OPEN OR FAIL CLOSED?", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "FAIL OPEN OR FAIL CLOSED?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1011", "type": "text", "x": 1234, "y": 19046.0, "width": 1093.2, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g181"], "frameId": null, "roundness": null, "seed": 1967183538, "version": 1, "versionNonce": 1707197694, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Unlike the rate limiter, a load balancer with ZERO healthy backends has nothing safe to fail open TO - there's no request to let through. Default is fail\nclosed: return 503 with Retry-After, fast, so clients back off instead of hanging. The only \"open\" move available is a pre-configured static sorry-page\npool for a small number of critical routes - and that's an explicit product decision per route, not a blanket default.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Unlike the rate limiter, a load balancer with ZERO healthy backends has nothing safe to fail open TO - there's no request to let through. Default is fail\nclosed: return 503 with Retry-After, fast, so clients back off instead of hanging. The only \"open\" move available is a pre-configured static sorry-page\npool for a small number of critical routes - and that's an explicit product decision per route, not a blanket default.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1012", "type": "rectangle", "x": 1220, "y": 19144.0, "width": 1120, "height": 96.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g182"], "frameId": null, "roundness": {"type": 3}, "seed": 354574282, "version": 1, "versionNonce": 1473461446, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1013", "type": "text", "x": 1234, "y": 19158.0, "width": 251.7, "height": 22.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g182"], "frameId": null, "roundness": null, "seed": 1693036428, "version": 1, "versionNonce": 1548505991, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Breaker as an Observer event", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Breaker as an Observer event", "autoResize": true, "lineHeight": 1.25}, {"id": "e1014", "type": "text", "x": 1234, "y": 19186.5, "width": 1071.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g182"], "frameId": null, "roundness": null, "seed": 1998412805, "version": 1, "versionNonce": 474866159, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Tripping the breaker is itself a pool-membership-relevant event - an OBSERVER can promote it to a full HealthChecker ejection instead of waiting\nout the next active-probe interval. Passive signal in, same Backend.state out.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Tripping the breaker is itself a pool-membership-relevant event - an OBSERVER can promote it to a full HealthChecker ejection instead of waiting\nout the next active-probe interval. Passive signal in, same Backend.state out.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1015", "type": "rectangle", "x": 1220, "y": 19264.5, "width": 1120, "height": 96.5, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g183"], "frameId": null, "roundness": {"type": 3}, "seed": 140694978, "version": 1, "versionNonce": 1788931372, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1016", "type": "text", "x": 1234, "y": 19278.5, "width": 318.3, "height": 22.5, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g183"], "frameId": null, "roundness": null, "seed": 753546432, "version": 1, "versionNonce": 1310919882, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Why a timeout lives inside the breaker", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Why a timeout lives inside the breaker", "autoResize": true, "lineHeight": 1.25}, {"id": "e1017", "type": "text", "x": 1234, "y": 19307.0, "width": 983.8, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g183"], "frameId": null, "roundness": null, "seed": 1623883690, "version": 1, "versionNonce": 541639981, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Every LB-side operation that touches the network - a health probe, a proxied request - has a hard timeout (here timeoutMs = 2000 via\nPromise.race), because an LB that can hang is an LB that can be starved.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Every LB-side operation that touches the network - a health probe, a proxied request - has a hard timeout (here timeoutMs = 2000 via\nPromise.race), because an LB that can hang is an LB that can be starved.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1098", "type": "rectangle", "x": 0, "y": 19940.0, "width": 2400, "height": 1857.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1385013920, "version": 1, "versionNonce": 1762827844, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1019", "type": "rectangle", "x": 60, "y": 19980.0, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g184"], "frameId": null, "roundness": {"type": 3}, "seed": 1925299070, "version": 1, "versionNonce": 1317549340, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1020", "type": "text", "x": 74, "y": 19987.0, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 