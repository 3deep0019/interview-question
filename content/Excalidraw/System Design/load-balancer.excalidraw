": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1075", "type": "text", "x": 1229, "y": 20800.0, "width": 129.4, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 1402539673, "version": 1, "versionNonce": 97890256, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "X-Forwarded-Host", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "X-Forwarded-Host", "autoResize": true, "lineHeight": 1.25}, {"id": "e1076", "type": "text", "x": 1499, "y": 20800.0, "width": 88.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 47866387, "version": 1, "versionNonce": 116808155, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "original Host", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "original Host", "autoResize": true, "lineHeight": 1.25}, {"id": "e1077", "type": "text", "x": 1779, "y": 20800.0, "width": 484.9, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 5616733, "version": 1, "versionNonce": 1217883425, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Preserve the client's intended host separately from the backend's own\nhostname", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Preserve the client's intended host separately from the backend's own\nhostname", "autoResize": true, "lineHeight": 1.25}, {"id": "e1078", "type": "rectangle", "x": 1220, "y": 20846.5, "width": 1120, "height": 55.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 762276326, "version": 1, "versionNonce": 652274068, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1079", "type": "text", "x": 1229, "y": 20855.5, "width": 34.1, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 228412063, "version": 1, "versionNonce": 1123324559, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Host", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Host", "autoResize": true, "lineHeight": 1.25}, {"id": "e1080", "type": "text", "x": 1499, "y": 20855.5, "width": 192.3, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 766977113, "version": 1, "versionNonce": 1146999180, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "backend's own host:port, or\npreserved", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "backend's own host:port, or\npreserved", "autoResize": true, "lineHeight": 1.25}, {"id": "e1081", "type": "text", "x": 1779, "y": 20855.5, "width": 500.6, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 481592461, "version": 1, "versionNonce": 887422841, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Policy choice - most backends expect the original; some routing needs it\nrewritten", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Policy choice - most backends expect the original; some routing needs it\nrewritten", "autoResize": true, "lineHeight": 1.25}, {"id": "e1082", "type": "rectangle", "x": 1220, "y": 20902.0, "width": 1120, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 1253251956, "version": 1, "versionNonce": 646725408, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1083", "type": "text", "x": 1229, "y": 20911.0, "width": 80.9, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 1265064595, "version": 1, "versionNonce": 287175924, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Connection", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Connection", "autoResize": true, "lineHeight": 1.25}, {"id": "e1084", "type": "text", "x": 1499, "y": 20911.0, "width": 201.5, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 438482606, "version": 1, "versionNonce": 786482664, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "stripped hop-by-hop headers", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "stripped hop-by-hop headers", "autoResize": true, "lineHeight": 1.25}, {"id": "e1085", "type": "text", "x": 1779, "y": 20911.0, "width": 550.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 1339878524, "version": 1, "versionNonce": 1779129429, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Connection, Keep-Alive, TE, etc. are per-hop and must not be blindly forwarded", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Connection, Keep-Alive, TE, etc. are per-hop and must not be blindly forwarded", "autoResize": true, "lineHeight": 1.25}, {"id": "e1086", "type": "line", "x": 1490, "y": 20646.5, "width": 0, "height": 292.2, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 1019843881, "version": 1, "versionNonce": 340641237, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 292.2]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e1087", "type": "line", "x": 1770, "y": 20646.5, "width": 0, "height": 292.2, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g195"], "frameId": null, "roundness": null, "seed": 289370629, "version": 1, "versionNonce": 30305330, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0, 0.0], [0, 292.2]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "e1088", "type": "rectangle", "x": 60, "y": 21024.5, "width": 1120, "height": 631.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g196"], "frameId": null, "roundness": {"type": 3}, "seed": 2011313669, "version": 1, "versionNonce": 1721214107, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1089", "type": "text", "x": 74, "y": 21038.5, "width": 274.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g196"], "frameId": null, "roundness": null, "seed": 523101812, "version": 1, "versionNonce": 1519285880, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "proxy.js  -  Node.js wiring, end to end", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "proxy.js  -  Node.js wiring, end to end", "autoResize": true, "lineHeight": 1.25}, {"id": "e1090", "type": "text", "x": 74, "y": 21064.5, "width": 749.6, "height": 577.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g196"], "frameId": null, "roundness": null, "seed": 320647401, "version": 1, "versionNonce": 968199666, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "async function proxyMiddleware({ pipeline }) {\n  return async function handle(req, res) {\n    const ctx = {\n      host:  req.headers.host,\n      path:  req.url,\n      ip:    normalizeIp(req.socket.remoteAddress),\n      cookies: parseCookies(req.headers.cookie),\n      headers: req.headers,\n    };\n    ctx.clientKey = clientKeyFor(ctx, 'cookie');\n\n    req.headers['x-forwarded-for']   = appendXff(req.headers['x-forwarded-for'], ctx.ip);\n    req.headers['x-forwarded-proto'] = req.socket.encrypted ? 'https' : 'http';\n    req.headers['x-forwarded-host']  = ctx.host;\n    for (const h of ['connection', 'keep-alive', 'te', 'upgrade']) delete req.headers[h];\n\n    try {\n      await pipeline.handle({ ...ctx, req, res });\n    } catch (err) {\n      if (err instanceof ServiceUnavailableError) {\n        res.writeHead(503, { 'Retry-After': '1' });\n        return res.end('no healthy backend');\n      }\n      res.writeHead(502);\n      res.end('bad gateway');\n    }\n  };\n}\n\nfunction normalizeIp(ip) {           // IPv6 /64 - same reasoning as rate limiting\n  if (!ip.includes(':')) return ip;\n  return ip.split(':').slice(0, 4).join(':') + '::/64';\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "async function proxyMiddleware({ pipeline }) {\n  return async function handle(req, res) {\n    const ctx = {\n      host:  req.headers.host,\n      path:  req.url,\n      ip:    normalizeIp(req.socket.remoteAddress),\n      cookies: parseCookies(req.headers.cookie),\n      headers: req.headers,\n    };\n    ctx.clientKey = clientKeyFor(ctx, 'cookie');\n\n    req.headers['x-forwarded-for']   = appendXff(req.headers['x-forwarded-for'], ctx.ip);\n    req.headers['x-forwarded-proto'] = req.socket.encrypted ? 'https' : 'http';\n    req.headers['x-forwarded-host']  = ctx.host;\n    for (const h of ['connection', 'keep-alive', 'te', 'upgrade']) delete req.headers[h];\n\n    try {\n      await pipeline.handle({ ...ctx, req, res });\n    } catch (err) {\n      if (err instanceof ServiceUnavailableError) {\n        res.writeHead(503, { 'Retry-After': '1' });\n        return res.end('no healthy backend');\n      }\n      res.writeHead(502);\n      res.end('bad gateway');\n    }\n  };\n}\n\nfunction normalizeIp(ip) {           // IPv6 /64 - same reasoning as rate limiting\n  if (!ip.includes(':')) return ip;\n  return ip.split(':').slice(0, 4).join(':') + '::/64';\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e1091", "type": "text", "x": 1220, "y": 21022.5, "width": 452.2, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 205738974, "version": 1, "versionNonce": 136727366, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Testing - the concurrency test is what scores", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Testing - the concurrency test is what scores", "autoResize": true, "lineHeight": 1.25}, {"id": "e1092", "type": "rectangle", "x": 1220, "y": 21062.5, "width": 1120, "height": 579.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g197"], "frameId": null, "roundness": {"type": 3}, "seed": 1370545746, "version": 1, "versionNonce": 310722898, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1093", "type": "text", "x": 1234, "y": 21076.5, "width": 146.3, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g197"], "frameId": null, "roundness": null, "seed": 1871071581, "version": 1, "versionNonce": 1429091340, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "power-of-two.test.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "power-of-two.test.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e1094", "type": "text", "x": 1234, "y": 21102.5, "width": 766.4, "height": 525.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g197"], "frameId": null, "roundness": null, "seed": 1679667509, "version": 1, "versionNonce": 579305494, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "// A fake rng and clock make LB tests deterministic - a rate-limiter-style\n// pattern that transfers directly.\nconst fakeRng   = (seq) => { let i = 0; return { next: () => seq[i++ % seq.length] }; };\n\ntest('least connections always routes to the currently-lightest backend', () => {\n  const a = new Backend({ id: 'a' }); a.activeConnections = 3;\n  const b = new Backend({ id: 'b' }); b.activeConnections = 1;\n  const c = new Backend({ id: 'c' }); c.activeConnections = 2;\n\n  const strategy = new LeastConnections();\n  expect(strategy.pick([a, b, c]).id).toBe('b');\n});\n\ntest('consistent hash: adding one backend remaps only ~1/n of keys', () => {\n  const before = new ConsistentHashRing();\n  before.rebuild([{ id: 'a', weight: 1 }, { id: 'b', weight: 1 }, { id: 'c', weight: 1 }]);\n\n  const after = new ConsistentHashRing();\n  after.rebuild([{ id: 'a', weight: 1 }, { id: 'b', weight: 1 },\n                 { id: 'c', weight: 1 }, { id: 'd', weight: 1 }]);\n\n  const keys = Array.from({ length: 10_000 }, (_, i) => `client-${i}`);\n  let remapped = 0;\n  for (const key of keys) {\n    const b1 = before.pick(before.byId.values().toArray(), { clientKey: key });\n    const b2 = after.pick(after.byId.values().toArray(), { clientKey: key });\n    if (b1.id !== b2.id) remapped++;\n  }\n  expect(remapped / keys.length).toBeLessThan(0.30);   // ~1/4 expected, not ~100%\n});", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "// A fake rng and clock make LB tests deterministic - a rate-limiter-style\n// pattern that transfers directly.\nconst fakeRng   = (seq) => { let i = 0; return { next: () => seq[i++ % seq.length] }; };\n\ntest('least connections always routes to the currently-lightest backend', () => {\n  const a = new Backend({ id: 'a' }); a.activeConnections = 3;\n  const b = new Backend({ id: 'b' }); b.activeConnections = 1;\n  const c = new Backend({ id: 'c' }); c.activeConnections = 2;\n\n  const strategy = new LeastConnections();\n  expect(strategy.pick([a, b, c]).id).toBe('b');\n});\n\ntest('consistent hash: adding one backend remaps only ~1/n of keys', () => {\n  const before = new ConsistentHashRing();\n  before.rebuild([{ id: 'a', weight: 1 }, { id: 'b', weight: 1 }, { id: 'c', weight: 1 }]);\n\n  const after = new ConsistentHashRing();\n  after.rebuild([{ id: 'a', weight: 1 }, { id: 'b', weight: 1 },\n                 { id: 'c', weight: 1 }, { id: 'd', weight: 1 }]);\n\n  const keys = Array.from({ length: 10_000 }, (_, i) => `client-${i}`);\n  let remapped = 0;\n  for (const key of keys) {\n    const b1 = before.pick(before.byId.values().toArray(), { clientKey: key });\n    const b2 = after.pick(after.byId.values().toArray(), { clientKey: key });\n    if (b1.id !== b2.id) remapped++;\n  }\n  expect(remapped / keys.length).toBeLessThan(0.30);   // ~1/4 expected, not ~100%\n});", "autoResize": true, "lineHeight": 1.25}, {"id": "e1095", "type": "rectangle", "x": 1220, "y": 21665.5, "width": 1120, "height": 91.5, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g198"], "frameId": null, "roundness": {"type": 3}, "seed": 863187255, "version": 1, "versionNonce": 1742834433, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1096", "type": "text", "x": 1234, "y": 21679.5, "width": 370.4, "height": 17.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g198"], "frameId": null, "roundness": null, "seed": 567450723, "version": 1, "versionNonce": 2076907458, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "ALSO WORTH NAMING: A LOAD-DISTRIBUTION TEST", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ALSO WORTH NAMING: A LOAD-DISTRIBUTION TEST", "autoResize": true, "lineHeight": 1.25}, {"id": "e1097", "type": "text", "x": 1234, "y": 21703.0, "width": 992.1, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g198"], "frameId": null, "roundness": null, "seed": 24687568, "version": 1, "versionNonce": 120539463, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Fire 100k picks at a heterogeneous pool under power-of-two-choices and assert each backend's share lands within a few percent of its\nweight-proportional target - that's the test that proves the algorithm, not just the code, is correct.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Fire 100k picks at a heterogeneous pool under power-of-two-choices and assert each backend's share lands within a few percent of its\nweight-proportional target - that's the test that proves the algorithm, not just the code, is correct.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1130", "type": "rectangle", "x": 0, "y": 21917.0, "width": 2400, "height": 1077.2, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#dbe4ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1813404929, "version": 1, "versionNonce": 937693290, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1099", "type": "rectangle", "x": 60, "y": 21957.0, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g199"], "frameId": null, "roundness": {"type": 3}, "seed": 1207597002, "version": 1, "versionNonce": 1917008319, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1100", "type": "text", "x": 74, "y": 21964.0, "width": 29.8, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g199"], "frameId": null, "roundness": null, "seed": 752333749, "version": 1, "versionNonce": 1277160634, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "10", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "10", "autoResize": true, "lineHeight": 1.25}, {"id": "e1101", "type": "text", "x": 144, "y": 21959.0, "width": 314.5, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g199"], "frameId": null, "roundness": null, "seed": 1386424247, "version": 1, "versionNonce": 1242260233, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Follow-ups they ask", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Follow-ups they ask", "autoResize": true, "lineHeight": 1.25}, {"id": "e1102", "type": "text", "x": 60, "y": 22019.0, "width": 647.3, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 952954970, "version": 1, "versionNonce": 1292530606, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Rehearse these. They're the second half of almost every load-balancer round.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Rehearse these. They're the second half of almost every load-balancer round.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1103", "type": "rectangle", "x": 60, "y": 22069.5, "width": 1120, "height": 177.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g200"], "frameId": null, "roundness": {"type": 3}, "seed": 2012529594, "version": 1, "versionNonce": 1111499938, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1104", "type": "text", "x": 74, "y": 22083.5, "width": 471.7, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g200"], "frameId": null, "roundness": null, "seed": 1575227307, "version": 1, "versionNonce": 1058390889, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Q  How do you load balance globally, across regions?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How do you load balance globally, across regions?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1105", "type": "text", "x": 74, "y": 22113.2, "width": 1091.3, "height": 120.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g200"], "frameId": null, "roundness": null, "seed": 533643283, "version": 1, "versionNonce": 354547748, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Two layers, and they're solving different problems. GSLB / DNS-based answers \"which region\" before any packet leaves the client - latency-based\nor geo-based DNS responses, cached by resolvers, so it reacts in minutes not milliseconds; that's acceptable because region selection changes\nrarely. Anycast answers it at the network layer instead - the same IP is announced from every region, and BGP routes each client to its nearest\nadvertising point, reacting to outages far faster than DNS TTLs ever could, at the cost of needing your own network infrastructure. Within the chosen\nregion, everything in this kit applies unchanged. Most large-scale setups run anycast at the very edge and DNS-based GSLB as a coarser\nsecondary signal.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Two layers, and they're solving different problems. GSLB / DNS-based answers \"which region\" before any packet leaves the client - latency-based\nor geo-based DNS responses, cached by resolvers, so it reacts in minutes not milliseconds; that's acceptable because region selection changes\nrarely. Anycast answers it at the network layer instead - the same IP is announced from every region, and BGP routes each client to its nearest\nadvertising point, reacting to outages far faster than DNS TTLs ever could, at the cost of needing your own network infrastructure. Within the chosen\nregion, everything in this kit applies unchanged. Most large-scale setups run anycast at the very edge and DNS-based GSLB as a coarser\nsecondary signal.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1106", "type": "rectangle", "x": 1220, "y": 22069.5, "width": 1120, "height": 157.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g201"], "frameId": null, "roundness": {"type": 3}, "seed": 1940258939, "version": 1, "versionNonce": 858090, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1107", "type": "text", "x": 1234, "y": 22083.5, "width": 612.3, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g201"], "frameId": null, "roundness": null, "seed": 94493551, "version": 1, "versionNonce": 132131481, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Q  How do you add session affinity without wrecking load distribution?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How do you add session affinity without wrecking load distribution?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1108", "type": "text", "x": 1234, "y": 22113.2, "width": 1087.5, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g201"], "frameId": null, "roundness": null, "seed": 1141446411, "version": 1, "versionNonce": 54170800, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Prefer stateless backends and skip this entirely if you can - push session state to a shared store (Redis, a database) and any backend can serve\nany request, which is what section 05's load-aware algorithms want. When affinity is genuinely required, use consistent hashing on a stable key (an\naffinity cookie you set, not the raw client IP - IPs move behind NAT and mobile networks), and pair it with BOUNDED-LOAD consistent hashing: cap\nhow many keys any one backend's ring position can absorb, spilling overflow to the next backend on the ring, so one popular key or one legitimate\nhot session can't starve everyone routed near it.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Prefer stateless backends and skip this entirely if you can - push session state to a shared store (Redis, a database) and any backend can serve\nany request, which is what section 05's load-aware algorithms want. When affinity is genuinely required, use consistent hashing on a stable key (an\naffinity cookie you set, not the raw client IP - IPs move behind NAT and mobile networks), and pair it with BOUNDED-LOAD consistent hashing: cap\nhow many keys any one backend's ring position can absorb, spilling overflow to the next backend on the ring, so one popular key or one legitimate\nhot session can't starve everyone routed near it.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1109", "type": "rectangle", "x": 60, "y": 22271.2, "width": 1120, "height": 177.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g202"], "frameId": null, "roundness": {"type": 3}, "seed": 871854157, "version": 1, "versionNonce": 398697272, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1110", "type": "text", "x": 74, "y": 22285.2, "width": 664.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g202"], "frameId": null, "roundness": null, "seed": 510389880, "version": 1, "versionNonce": 341915098, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Q  How is this different from service discovery, and how do the two interact?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How is this different from service discovery, and how do the two interact?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1111", "type": "text", "x": 74, "y": 22315.0, "width": 1085.9, "height": 120.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g202"], "frameId": null, "roundness": null, "seed": 125368330, "version": 1, "versionNonce": 1957950958, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Service discovery answers \"what backends exist and where\" - a registry (Kubernetes endpoints, Consul, etcd) that instances register into and\nderegister from. Load balancing answers \"given that list, which one gets this request.\" They're cleanly separable: the LB subscribes to discovery for\nmembership changes (the Observer pattern in section 04) and never makes a discovery call on the request path. The interesting follow-up is\nCLIENT-SIDE load balancing (gRPC + xDS, Netflix's old Ribbon): here the client itself holds the pool view and runs the algorithm, cutting out the LB\nhop entirely - the trade is every client now needs the discovery subscription and the algorithm code, which is why it's usually reserved for internal\nservice-to-service calls, not public-facing traffic.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Service discovery answers \"what backends exist and where\" - a registry (Kubernetes endpoints, Consul, etcd) that instances register into and\nderegister from. Load balancing answers \"given that list, which one gets this request.\" They're cleanly separable: the LB subscribes to discovery for\nmembership changes (the Observer pattern in section 04) and never makes a discovery call on the request path. The interesting follow-up is\nCLIENT-SIDE load balancing (gRPC + xDS, Netflix's old Ribbon): here the client itself holds the pool view and runs the algorithm, cutting out the LB\nhop entirely - the trade is every client now needs the discovery subscription and the algorithm code, which is why it's usually reserved for internal\nservice-to-service calls, not public-facing traffic.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1112", "type": "rectangle", "x": 1220, "y": 22251.2, "width": 1120, "height": 157.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g203"], "frameId": null, "roundness": {"type": 3}, "seed": 1672615408, "version": 1, "versionNonce": 225309338, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1113", "type": "text", "x": 1234, "y": 22265.2, "width": 578.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g203"], "frameId": null, "roundness": null, "seed": 26521622, "version": 1, "versionNonce": 1315633502, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Q  How do you deploy a new version with zero dropped requests?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How do you deploy a new version with zero dropped requests?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1114", "type": "text", "x": 1234, "y": 22295.0, "width": 1088.8, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g203"], "frameId": null, "roundness": null, "seed": 1183098045, "version": 1, "versionNonce": 1410467065, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Connection draining (section 06), applied per-instance during a rolling deploy: mark the outgoing instance draining so the LB stops sending it new\nrequests immediately, wait for its in-flight requests to finish (bounded by a drain timeout - a stuck connection can't hold the deploy hostage forever),\nthen terminate it and repeat for the next instance. Combine with slow start on the way back in so the freshly deployed instance ramps up rather than\ntaking a full share the instant it reports healthy. The whole sequence is why health checks and load balancing have to share one source of truth for\nbackend state (the Backend.state field in section 04) instead of being two disconnected systems.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Connection draining (section 06), applied per-instance during a rolling deploy: mark the outgoing instance draining so the LB stops sending it new\nrequests immediately, wait for its in-flight requests to finish (bounded by a drain timeout - a stuck connection can't hold the deploy hostage forever),\nthen terminate it and repeat for the next instance. Combine with slow start on the way back in so the freshly deployed instance ramps up rather than\ntaking a full share the instant it reports healthy. The whole sequence is why health checks and load balancing have to share one source of truth for\nbackend state (the Backend.state field in section 04) instead of being two disconnected systems.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1115", "type": "rectangle", "x": 60, "y": 22473.0, "width": 1120, "height": 157.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g204"], "frameId": null, "roundness": {"type": 3}, "seed": 2020611618, "version": 1, "versionNonce": 423608701, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1116", "type": "text", "x": 74, "y": 22487.0, "width": 527.1, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g204"], "frameId": null, "roundness": null, "seed": 305515073, "version": 1, "versionNonce": 887293582, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Q  How does the load balancer avoid becoming the outage?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How does the load balancer avoid becoming the outage?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1117", "type": "text", "x": 74, "y": 22516.8, "width": 1091.7, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g204"], "frameId": null, "roundness": null, "seed": 428462209, "version": 1, "versionNonce": 1112950772, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Layered: the LB tier itself is never a single node (anycast/ECMP or VRRP, section 03); each LB node applies per-backend connection caps and a\ncircuit breaker so one bad backend can't exhaust the proxy's own resources and take healthy backends down with it (section 08's cascading-failure\nrow); and every LB-side operation that touches the network - a health probe, a proxied request - has a hard timeout, because an LB that can hang is\nan LB that can be starved. The meta-answer: a load balancer's own failure modes should look boring and well-understood, because it sits in front of\neverything else.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Layered: the LB tier itself is never a single node (anycast/ECMP or VRRP, section 03); each LB node applies per-backend connection caps and a\ncircuit breaker so one bad backend can't exhaust the proxy's own resources and take healthy backends down with it (section 08's cascading-failure\nrow); and every LB-side operation that touches the network - a health probe, a proxied request - has a hard timeout, because an LB that can hang is\nan LB that can be starved. The meta-answer: a load balancer's own failure modes should look boring and well-understood, because it sits in front of\neverything else.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1118", "type": "rectangle", "x": 1220, "y": 22433.0, "width": 1120, "height": 157.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g205"], "frameId": null, "roundness": {"type": 3}, "seed": 1305848225, "version": 1, "versionNonce": 1380174179, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1119", "type": "text", "x": 1234, "y": 22447.0, "width": 906.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g205"], "frameId": null, "roundness": null, "seed": 1088662998, "version": 1, "versionNonce": 1390703331, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Q  Weighted round robin vs. least connections vs. power of two choices - when does each actually win?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  Weighted round robin vs. least connections vs. power of two choices - when does each actually win?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1120", "type": "text", "x": 1234, "y": 22476.8, "width": 1093.8, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g205"], "frameId": null, "roundness": null, "seed": 1377761012, "version": 1, "versionNonce": 891730804, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Weighted round robin is right when backend capacity differs but is STABLE and request cost is roughly uniform - it needs no live feedback, so it's the\nsimplest thing that's still correct. Least connections wins once request cost varies (some requests are just heavier), because it's self-correcting\nwithout needing to know why a backend is loaded. Power of two choices is the answer once the pool is large enough that scanning every backend\nper pick is itself a cost worth avoiding - same quality of outcome as least connections, O(1) instead of O(n). In practice: start with weighted least\nconnections; reach for power-of-two once profiling shows the pick itself matters.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Weighted round robin is right when backend capacity differs but is STABLE and request cost is roughly uniform - it needs no live feedback, so it's the\nsimplest thing that's still correct. Least connections wins once request cost varies (some requests are just heavier), because it's self-correcting\nwithout needing to know why a backend is loaded. Power of two choices is the answer once the pool is large enough that scanning every backend\nper pick is itself a cost worth avoiding - same quality of outcome as least connections, O(1) instead of O(n). In practice: start with weighted least\nconnections; reach for power-of-two once profiling shows the pick itself matters.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1121", "type": "rectangle", "x": 60, "y": 22654.8, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g206"], "frameId": null, "roundness": {"type": 3}, "seed": 1746721970, "version": 1, "versionNonce": 1316801869, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1122", "type": "text", "x": 74, "y": 22668.8, "width": 659.8, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g206"], "frameId": null, "roundness": null, "seed": 375035418, "version": 1, "versionNonce": 1092158683, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Q  How would you protect the LB tier from a SYN flood or slow-loris attack?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  How would you protect the LB tier from a SYN flood or slow-loris attack?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1123", "type": "text", "x": 74, "y": 22698.5, "width": 1083.4, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g206"], "frameId": null, "roundness": null, "seed": 664393848, "version": 1, "versionNonce": 136938994, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "This is explicitly an L4 concern, handled before traffic ever reaches the smart L7 tier: SYN cookies so a half-open connection costs no server-side\nstate until the handshake completes, connection-rate limits per source IP at the network layer, and a read/write idle timeout that kills a connection\nsending data too slowly to ever complete a request (that's the direct defence against slow-loris). This is also the argument for keeping L4 and L7 as\nseparate tiers - you don't want your expensive request-routing logic anywhere near unauthenticated raw TCP.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "This is explicitly an L4 concern, handled before traffic ever reaches the smart L7 tier: SYN cookies so a half-open connection costs no server-side\nstate until the handshake completes, connection-rate limits per source IP at the network layer, and a read/write idle timeout that kills a connection\nsending data too slowly to ever complete a request (that's the direct defence against slow-loris). This is also the argument for keeping L4 and L7 as\nseparate tiers - you don't want your expensive request-routing logic anywhere near unauthenticated raw TCP.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1124", "type": "rectangle", "x": 1220, "y": 22614.8, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g207"], "frameId": null, "roundness": {"type": 3}, "seed": 644816686, "version": 1, "versionNonce": 1344247062, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1125", "type": "text", "x": 1234, "y": 22628.8, "width": 221.6, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g207"], "frameId": null, "roundness": null, "seed": 104133139, "version": 1, "versionNonce": 2134730482, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Q  What do you monitor?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  What do you monitor?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1126", "type": "text", "x": 1234, "y": 22658.5, "width": 1090.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g207"], "frameId": null, "roundness": null, "seed": 1909869786, "version": 1, "versionNonce": 1555435450, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Per-backend request rate, error rate, and latency (p50/p99) - a backend receiving zero traffic despite being healthy is a routing bug, not a health\nproblem. Pool size over time (healthy vs. total) and ejection/recovery events, to catch flapping. LB-added latency, separate from backend latency, so\na regression in the LB itself is visible. Circuit-breaker open/close events. And the load-distribution shape itself - a histogram of requests per backend\ncatches an algorithm or config bug (a forgotten weight, a hot ring key) long before it becomes a page.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Per-backend request rate, error rate, and latency (p50/p99) - a backend receiving zero traffic despite being healthy is a routing bug, not a health\nproblem. Pool size over time (healthy vs. total) and ejection/recovery events, to catch flapping. LB-added latency, separate from backend latency, so\na regression in the LB itself is visible. Circuit-breaker open/close events. And the load-distribution shape itself - a histogram of requests per backend\ncatches an algorithm or config bug (a forgotten weight, a hot ring key) long before it becomes a page.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1127", "type": "rectangle", "x": 60, "y": 22816.5, "width": 1120, "height": 137.8, "angle": 0, "strokeColor": "#8b5cf6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g208"], "frameId": null, "roundness": {"type": 3}, "seed": 1681424250, "version": 1, "versionNonce": 1026336692, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1128", "type": "text", "x": 74, "y": 22830.5, "width": 451.2, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g208"], "frameId": null, "roundness": null, "seed": 1536306831, "version": 1, "versionNonce": 1156218829, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Q  Is a load balancer the same as an API gateway?", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Q  Is a load balancer the same as an API gateway?", "autoResize": true, "lineHeight": 1.25}, {"id": "e1129", "type": "text", "x": 74, "y": 22860.2, "width": 1085.1, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g208"], "frameId": null, "roundness": null, "seed": 13635234, "version": 1, "versionNonce": 805647258, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Overlapping but distinct. A load balancer's one job is picking a healthy backend and forwarding traffic to it - that's this whole kit. An API gateway is a\nsuperset that also does authentication, rate limiting (the companion kit in this series), request/response transformation, and API composition - and it\ntypically USES a load balancer internally to reach each backend service once it's decided the request is legitimate. In an interview, naming this\ndistinction and then scoping your answer explicitly to load balancing is worth more than trying to design both at once.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Overlapping but distinct. A load balancer's one job is picking a healthy backend and forwarding traffic to it - that's this whole kit. An API gateway is a\nsuperset that also does authentication, rate limiting (the companion kit in this series), request/response transformation, and API composition - and it\ntypically USES a load balancer internally to reach each backend service once it's decided the request is legitimate. In an interview, naming this\ndistinction and then scoping your answer explicitly to load balancing is worth more than trying to design both at once.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1204", "type": "rectangle", "x": 0, "y": 23114.2, "width": 2400, "height": 923.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 32, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 441787665, "version": 1, "versionNonce": 436283732, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1131", "type": "rectangle", "x": 60, "y": 23154.2, "width": 64, "height": 40, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g209"], "frameId": null, "roundness": {"type": 3}, "seed": 1600277851, "version": 1, "versionNonce": 1959062825, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1132", "type": "text", "x": 74, "y": 23161.2, "width": 27.9, "height": 30.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g209"], "frameId": null, "roundness": null, "seed": 999150174, "version": 1, "versionNonce": 172826380, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "11", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "11", "autoResize": true, "lineHeight": 1.25}, {"id": "e1133", "type": "text", "x": 144, "y": 23156.2, "width": 324.3, "height": 42.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g209"], "frameId": null, "roundness": null, "seed": 1592906611, "version": 1, "versionNonce": 1407742668, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "The 45-minute script", "fontSize": 34, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The 45-minute script", "autoResize": true, "lineHeight": 1.25}, {"id": "e1134", "type": "text", "x": 60, "y": 23216.2, "width": 1480.5, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 971708948, "version": 1, "versionNonce": 376650880, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "A pacing plan. The commonest failure in these rounds is spending 25 minutes on the algorithm and never reaching health checks or failure modes - which is the part being graded.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A pacing plan. The commonest failure in these rounds is spending 25 minutes on the algorithm and never reaching health checks or failure modes - which is the part being graded.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1135", "type": "text", "x": 60, "y": 23266.8, "width": 409.6, "height": 27.5, "angle": 0, "strokeColor": "#6741d9", "backgroundC