0, "link": null, "locked": false, "text": "Fail closed with 503 by default; fail to a static sorry-page pool only where configured - never hang", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Fail closed with 503 by default; fail to a static sorry-page pool only where configured - never hang", "autoResize": true, "lineHeight": 1.25}, {"id": "e918", "type": "rectangle", "x": 60, "y": 17592.5, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 349061831, "version": 1, "versionNonce": 279119406, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e919", "type": "text", "x": 69, "y": 17601.5, "width": 82.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 31856590, "version": 1, "versionNonce": 111015032, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Retry storm", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Retry storm", "autoResize": true, "lineHeight": 1.25}, {"id": "e920", "type": "text", "x": 509, "y": 17601.5, "width": 398.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 1184440016, "version": 1, "versionNonce": 306009563, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Client retries amplify load on already-struggling backends", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Client retries amplify load on already-struggling backends", "autoResize": true, "lineHeight": 1.25}, {"id": "e921", "type": "text", "x": 1269, "y": 17601.5, "width": 834.7, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 1375821242, "version": 1, "versionNonce": 1731877347, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Bounded retry budget (e.g. retries <= 10% of request volume), exponential backoff + jitter, retry only idempotent methods", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Bounded retry budget (e.g. retries <= 10% of request volume), exponential backoff + jitter, retry only idempotent methods", "autoResize": true, "lineHeight": 1.25}, {"id": "e922", "type": "rectangle", "x": 60, "y": 17629.2, "width": 2280, "height": 55.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 1953768839, "version": 1, "versionNonce": 851947881, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e923", "type": "text", "x": 69, "y": 17638.2, "width": 122.5, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 191192858, 