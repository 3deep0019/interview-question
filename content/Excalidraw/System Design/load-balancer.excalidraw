 and falls over again", "autoResize": true, "lineHeight": 1.25}, {"id": "e929", "type": "text", "x": 1269, "y": 17693.8, "width": 156.3, "height": 18.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 1119180175, "version": 1, "versionNonce": 368906121, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Slow start (section 06)", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Slow start (section 06)", "autoResize": true, "lineHeight": 1.25}, {"id": "e930", "type": "rectangle", "x": 60, "y": 17721.5, "width": 2280, "height": 36.8, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 1987495671, "version": 1, "versionNonce": 144089163, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e931", "type": "text", "x": 69, "y": 17730.5, "width": 219.6, "height": 18.8, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g166"], "frameId": null, "roundness": null, "seed": 233630858, "version": 1, "versionNonce": 824064104, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Health checker itself slow/down", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Health checker itself slow/down", "autoResize": true, "lineHeight": 1.25}, {"id": "e932", "type": "text", "x": 509, "y": 17730.5, "width"