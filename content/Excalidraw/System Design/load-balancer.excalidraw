d": null, "roundness": null, "seed": 773633968, "version": 1, "versionNonce": 710449537, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "CircuitBreaker", "fontSize": 19, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "CircuitBreaker", "autoResize": true, "lineHeight": 1.25}, {"id": "e1054", "type": "text", "x": 1252, "y": 20486.8, "width": 280, "height": 21.2, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g193"], "frameId": null, "roundness": null, "seed": 1642050165, "version": 1, "versionNonce": 174774099, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "wraps forwarding: timeout, fail fast", "fontSize": 17, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "wraps forwarding: timeout, fail fast", "autoResize": true, "lineHeight": 1.25}, {"id": "e1055", "type": "arrow", "x": 1392.0, "y": 20432.5, "width": 0.0, "height": 45.0, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 949792569, "version": 1, "versionNonce": 494022827, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "points": [[0.0, 0.0], [0.0, -45.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e1052", "focus": 0, "gap": 4}, "endBinding": {"elementId": "e1034", "focus": 0, "gap": 4}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e1056", "type": "text", "x": 90, "y": 20432.5, "width": 549.8, "height": 40.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 379580748, "version": 1, "versionNonce": 1321504845, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "YAML is data only. The factory turns the policy string into a strategy object,\nthe same Backend.state is shared by checker and pipeline.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "YAML is data only. The factory turns the policy string into a strategy object,\nthe same Backend.state is shared by checker and pipeline.", "autoResize": true, "lineHeight": 1.25}, {"id": "e1057", "type": "text", "x": 60, "y": 20606.5, "width": 789.2, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1596857497, "version": 1, "versionNonce": 2057246237, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Pool config - the shape every real LB (nginx / HAProxy / Envoy) converges on", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Pool config - the shape every real LB (nginx / HAProxy / Envoy) converges on", "autoResize": true, "lineHeight": 1.25}, {"id": "e1058", "type": "rectangle", "x": 60, "y": 20646.5, "width": 1120, "height": 334.0, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g194"], "frameId": null, "roundness": {"type": 3}, "seed": 103705118, "version": 1, "versionNonce": 636478505, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e1059", "type": "text", "x": 74, "y": 20660.5, "width": 81.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g194"], "frameId": null, "roundness": null, "seed": 1760559272, "version": 1, "versionNonce": 1108330854, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "pools.yaml", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "pools.yaml", "autoResize": true, "lineHeight": 1.25}, {"id": "e1060", "type": "text", "x": 74, "y": 20686.5, "width": 766.4, "height": 280.0, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g194"], "frameId": null, "roundness": null, "seed": 544714594, "version": 1, "versionNonce": 665875492, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "routes:\n  - match: { host: \"api.example.com\", pathPrefix: \"/v1\" }\n    policy: weighted_least_connections\n    healthCheck: { path: \"/healthz\", intervalMs: 2000, failThreshold: 3, healThreshold: 2 }\n    pool:\n      - { id: \"b1\", host: \"10.0.1.10\", port: 8080, weight: 5 }\n      - { id: \"b2\", host: \"10.0.1.11\", port: 8080, weight: 1 }\n      - { id: \"b3\", host: \"10.0.1.12\", port: 8080, weight: 1 }\n\n  - match: { host: \"api.example.com\", pathPrefix: \"/ws\" }\n    policy: consistent_hash            # sticky, for stateful WebSocket sessions\n    affinityKey: cookie                # hash on lb_affinity cookie, not raw IP\n    healthCheck: { path: \"/healthz\", intervalMs: 2000, failThreshold: 3, healThreshold: 2 }\n    pool:\n      - { id: \"w1\", host: \"10.0.2.10\", port: 9090, weight: 1 }\n      - { id: \"w2\", host: \"10.0.2.11\", port: 9090, weight: 1 }", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "routes:\n  - match: { host: \"api.example.com\", pathPrefix: \"/v1\" }\n    policy: weighted_least_connections\n    healthCheck: { path: \"/healthz\", intervalMs: 2000, failThreshold: 3, healThreshold: 2 }\n    pool:\n      - { id: \"b1\", host: \"10.0.1.10\", port: 8080, weight: 5 }\n      - { id: \"b2\", host: \"10.0.1.11\", port: 8080, weight: 1 }\n      - { id: \"b3\", host: \"10.0.1.12\", port: 8080, weight: 1 }\n\n  - match: { host: \"api.example.com\", pathPrefix: \"/ws\" }\n    policy: consistent_hash            # sticky, for stateful WebSocket sessions\n    affinityKey: cookie                # hash on lb_affinity cookie, not raw IP\n    healthCheck: { path: \"/healthz\", intervalMs: 2000, failThreshold: 3, healThreshold: 2 }\n    pool:\n      - { id: \"w1\", host: \"10.0.2.10\", port: 9090, weight: 1 }\n      - { id: \"w2\", host: \"10.0.2.11\", port: 9090, weight: 1 }", "autoResize": true, "lineHeight": 1.25}, {"id": "e1061", "type": "text", "x": 1220, "y": 20606.5, "width": 345.3, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1372752813, "version": 1, "versionNonce": 2074377369, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Headers a reverse proxy must set", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Headers a reverse proxy must set", "autoResize": true, "lineHeight": 1.25}, {"id": "e1062", "type": "rectangle", "x": 1220, "y": 20646.5, "width": 1120, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "