20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "round_robin", "autoResize": true, "lineHeight": 1.25}, {"id": "e590", "type": "text", "x": 252.0, "y": 9844.5, "width": 179.4, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 273398983, "version": 1, "versionNonce": 366710325, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "1  Round robin", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1  Round robin", "autoResize": true, "lineHeight": 1.25}, {"id": "e591", "type": "rectangle", "x": 60, "y": 9902.5, "width": 1160, "height": 211.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g106"], "frameId": null, "roundness": {"type": 3}, "seed": 1014007609, "version": 1, "versionNonce": 890919353, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e592", "type": "text", "x": 74, "y": 9916.5, "width": 180.5, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g106"], "frameId": null, "roundness": null, "seed": 738010355, "version": 1, "versionNonce": 605045017, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "strategies/round-robin.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/round-robin.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e593", "type": "text", "x": 74, "y": 9942.5, "width": 472.4, "height": 157.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g106"], "frameId": null, "roundness": null, "seed": 639460223, "version": 1, "versionNonce": 549203428, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "class RoundRobin extends LbStrategy {\n  constructor() { super(); this.cursor = -1; }\n\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    this.cursor = (this.cursor + 1) % candidates.length;\n    return candidates[this.cursor];\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class RoundRobin extends LbStrategy {\n  constructor() { super(); this.cursor = -1; }\n\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    this.cursor = (this.cursor + 1) % candidates.length;\n    return candidates[this.cursor];\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e594", "type": "rectangle", "x": 1260, "y": 9902.5, "width": 1080, "height": 68.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g107"], "frameId": null, "roundness": {"type": 3}, "seed": 1587060216, "version": 1, "versionNonce": 1586443402, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e595", "type": "text", "x": 1274, "y": 9916.5, "width": 1030.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g107"], "frameId": null, "roundness": null, "seed": 2096580069, "version": 1, "versionNonce": 1401915610, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Cycle through the pool in order. Zero state beyond a cursor, perfectly fair by request COUNT - which is only the same as fair by LOAD when\nevery backend and every request costs the same.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Cycle through the pool in order. Zero state beyond a cursor, perfectly fair by request COUNT - which is only the same as fair by LOAD when\nevery backend and every request costs the same.", "autoResize": true, "lineHeight": 1.25}, {"id": "e596", "type": "rectangle", "x": 1260, "y": 9990.5, "width": 1080, "height": 91.5, "angle": 0, "strokeColor": "#ef4444", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g108"], "frameId": null, "roundness": {"type": 3}, "seed": 558708797, "version": 1, "versionNonce": 872327757, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e597", "type": "text", "x": 1274, "y": 10004.5, "width": 161.6, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g108"], "frameId": null, "roundness": null, "seed": 1408739247, "version": 1, "versionNonce": 512529239, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "TRAP WORTH NAMING", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "TRAP WORTH NAMING", "autoResize": true, "lineHeight": 1.25}, {"id": "e598", "type": "text", "x": 1274, "y": 10028.0, "width": 1052.7, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g108"], "frameId": null, "roundness": null, "seed": 646041018, "version": 1, "versionNonce": 1037625491, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "The cursor is per-strategy-instance state. If a request adds or removes a backend mid-cycle, the modulo shifts and you can skip or double-hit a\nbackend for one rotation. Harmless for round robin; fatal for anything that must be exactly fair (rare) - mention it, then move on.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The cursor is per-strategy-instance state. If a request adds or removes a backend mid-cycle, the modulo shifts and you can skip or double-hit a\nbackend for one rotation. Harmless for round robin; fatal for anything that must be exactly fair (rare) - mention it, then move on.", "autoResize": true, "lineHeight": 1.25}, {"id": "e599", "type": "rectangle", "x": 60, "y": 10170.0, "width": 168.0, "height": 44, "angle": 0, "strokeColor": "#12b886", "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g109"], "frameId": null, "roundness": {"type": 3}, "seed": 1196839237, "version": 1, "versionNonce": 1436400256, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e600", "type": "text", "x": 78, "y": 10179.0, "width": 134.0, "height": 25.0, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g109"], "frameId": null, "roundness": null, "seed": 846898357, "version": 1, "versionNonce": 257145109, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "weighted_rr", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "weighted_rr", "autoResize": true, "lineHeight": 1.25}, {"id": "e601", "type": "text", "x": 252.0, "y": 10176.0, "width": 385.3, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 359343733, "version": 1, "versionNonce": 1381272297, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "2  Smooth weighted round robin", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2  Smooth weighted round robin", "autoResize": true, "lineHeight": 1.25}, {"id": "e602", "type": "rectangle", "x": 60, "y": 10234.0, "width": 1160, "height": 351.5, "angle": 0, "strokeColor": "#313244", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g110"], "frameId": null, "roundness": {"type": 3}, "seed": 347155685, "version": 1, "versionNonce": 161427626, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e603", "type": "text", "x": 74, "y": 10248.0, "width": 252.7, "height": 20.0, "angle": 0, "strokeColor": "#7fd1c4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g110"], "frameId": null, "roundness": null, "seed": 446402843, "version": 1, "versionNonce": 1075040594, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "strategies/weighted-round-robin.js", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "strategies/weighted-round-robin.js", "autoResize": true, "lineHeight": 1.25}, {"id": "e604", "type": "text", "x": 74, "y": 10274.0, "width": 648.8, "height": 297.5, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g110"], "frameId": null, "roundness": null, "seed": 1945534087, "version": 1, "versionNonce": 1743384250, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "class SmoothWeightedRoundRobin extends LbStrategy {\n  constructor() { super(); this.current = new Map(); } // id -> running total\n\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    const totalWeight = candidates.reduce((s, b) => s + b.weight, 0);\n\n    let best = null, bestTotal = -Infinity;\n    for (const b of candidates) {\n      const total = (this.current.get(b.id) ?? 0) + b.weight;\n      this.current.set(b.id, total);\n      if (total > bestTotal) { bestTotal = total; best = b; }\n    }\n    this.current.set(best.id, this.current.get(best.id) - totalWeight);\n    return best;\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "class SmoothWeightedRoundRobin extends LbStrategy {\n  constructor() { super(); this.current = new Map(); } // id -> running total\n\n  pick(candidates) {\n    if (candidates.length === 0) return null;\n    const totalWeight = candidates.reduce((s, b) => s + b.weight, 0);\n\n    let best = null, bestTotal = -Infinity;\n    for (const b of candidates) {\n      const total = (this.current.get(b.id) ?? 0) + b.weight;\n      this.current.set(b.id, total);\n      if (total > bestTotal) { bestTotal = total; best = b; }\n    }\n    this.current.set(best.id, this.current.get(best.id) - totalWeight);\n    return best;\n  }\n}", "autoResize": true, "lineHeight": 1.25}, {"id": "e605", "type": "rectangle", "x": 1260, "y": 10234.0, "width": 1080, "height": 88.0, "angle": 0, "strokeColor": "#4a9eed", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g111"], "frameId": null, "roundness": {"type": 3}, "seed": 1067462117, "version": 1, "versionNonce": 1181946104, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e606", "type": "text", "x": 1274, "y": 10248.0, "width": 1045.0, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g111"], "frameId": null, "roundness": null, "seed": 472500639, "version": 1, "versionNonce": 972780191, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Smooth weighted round robin (the nginx / LVS algorithm): each backend accumulates its weight every tick, the one with the highest total is\npicked and knocked down by the sum of all weights. This spreads picks evenly across time instead of bursting - 5:1:1 weights do not send five\nin a row to the big backend.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Smooth weighted round robin (the nginx / LVS algorithm): each backend accumulates its weight every tick, the one with the highest total is\npicked and knocked down by the sum of all weights. This spreads picks evenly across time instead of bursting - 5:1:1 weights do not send five\nin a row to the big backend.", "autoResize": true, "lineHeight": 1.25}, {"id": "e607", "type": "text", "x": 1260, "y": 10342.0, "width": 309.5, "height": 22.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1946177225, "version": 1, "versionNonce": 714756123, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Sequence for weights A=5, B=1, C=1", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Sequence for weights A=5, B=1, C=1", "autoResize": true, "lineHeight": 1.25}, {"id": "e608", "type": "rectangle", "x": 1260, "y": 10386.0, "width": 76, "height": 56, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g112"], "frameId": null, "roundness": {"type": 3}, "seed": 2139914010, "version": 1, "versionNonce": 1630472360, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e609", "type": "text", "x": 1270, "y": 10400.2, "width": 56, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g112"], "frameId": null, "roundness": null, "seed": 966282699, "version": 1, "versionNonce": 917883966, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "A", "fontSize": 22, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "A", "autoResize": true, "lineHeight": 1.25}, {"id": "e610", "type": "rectangle", "x": 1348, "y": 10386.0, "width": 76, "height": 56, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g113"], "frameId": null, "roundness": {"type": 3}, "seed": 299780266, "version": 1, "versionNonce": 1176359981, "isDeleted": false, "boundElements": null, "updated": 17920115321