olid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 486919347, "version": 1, "versionNonce": 429320601, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "rules + weights", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "rules + weights", "autoResize": true, "lineHeight": 1.25}, {"id": "e178", "type": "text", "x": 90, "y": 2388.2, "width": 586.6, "height": 60.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1111620701, "version": 1, "versionNonce": 1058240950, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "L4 spreads connections cheaply and statelessly; L7 does the smart per-request\ndecision. Neither tier talks to service discovery synchronously - membership is\npushed, then read from the local pool cache.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "L4 spreads connections cheaply and statelessly; L7 does the smart per-request\ndecision. Neither tier talks to service discovery synchronously - membership is\npushed, then read from the local pool cache.", "autoResize": true, "lineHeight": 1.25}, {"id": "e179", "type": "text", "x": 60, "y": 2582.2, "width": 919.5, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 763564744, "version": 1, "versionNonce": 1569819131, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "Data plane in solid lines, control plane dashed. Neither tier talks to service discovery synchronously - membership is pushed.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Data plane in solid lines, control plane dashed. Neither tier talks to service discovery synchronously - membership is pushed.", "autoResize": true, "lineHeight": 1.25}, {"id": "e180", "type": "text", "x": 60, "y": 2632.2, "width": 376.8, "height": 27.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 62234396, "version": 1, "versionNonce": 2125157524, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false, "text": "L4 vs. L7 - pick both, at different tiers", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "L4 vs. L7 - pick both, at different tiers", "autoResize": true, "lineHeight": 1.25}, {"id": "e181", "type": "rectangle", "x": 60, "y": 2670.2, "width": 2280, "height": 33.5, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": null, "seed": 59994415, "version": 1, "versionNonce": 1696757188, "isDeleted": false, "boundElements": null, "updated": 1792011532160, "link": null, "locked": false}, {"id": "e182", "type": "text", "x": 69, "y": 2678.2, "width": 38.4, "height": 17.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g40"], "frameId": null, "roundness": null, "seed": 600046750, "version": 1, "versionNonce": 1014127815, "isDelet